# Go workspace
go.work
go.work.sum

# The vendored canvas bundles are rebuilt with a root `npm install` (see
# api/web/vendor/*/ATLAS-VENDORED.txt), so following that recipe leaves a
# node_modules here. The built artifact is committed; what built it is not.
/node_modules/

# Profiling
*.prof
*.pprof

# Local data / engine artifacts (WAL segments, state store)
/data/
/atlas-data/
*.wal
/.atlas/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Playwright output, if a run is started from the repository root rather than e2e/.
test-results/
