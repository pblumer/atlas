<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="defs" targetNamespace="http://atlas/behaviour-impact">
  <message id="m_exit" name="exit"><extensionElements><zeebe:subscription correlationKey="=personId"/></extensionElements></message>
  <!-- review receive.output-mappings: the payload no longer reaches the instance, and
       nothing in the model reads it. -->
  <process id="receive_outputs_unread" isExecutable="true">
    <startEvent id="start"/>
    <receiveTask id="wait_exit" messageRef="m_exit">
      <extensionElements><zeebe:ioMapping><zeebe:output source="=&quot;EXITED&quot;" target="state"/></zeebe:ioMapping></extensionElements>
    </receiveTask>
    <endEvent id="done"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="wait_exit"/>
    <sequenceFlow id="f2" sourceRef="wait_exit" targetRef="done"/>
  </process>
</definitions>
