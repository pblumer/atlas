{
  "id": "community.powershell-ad-lookup",
  "version": "0.4.0",
  "kind": "script-task",
  "title": "PowerShell · AD User Lookup",
  "author": "community · s.keller",
  "description": "Resolve an Active Directory user by e-mail and return department and manager. Carries a PowerShell script, so it is imported as a reviewable draft and runs only where a PowerShell worker is enabled (ADR-0047).",
  "engineCompat": ">=0.10",
  "template": {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "PowerShell · AD User Lookup",
    "id": "community.powershell-ad-lookup",
    "appliesTo": ["bpmn:ScriptTask"],
    "properties": [
      { "label": "Language", "type": "Hidden", "value": "powershell", "binding": { "type": "property", "name": "atlas:language" } },
      { "label": "Script", "type": "Hidden", "value": "param($email)\nGet-ADUser -Filter \"mail -eq '$email'\" -Properties Department,Manager | Select-Object Department,Manager", "binding": { "type": "property", "name": "atlas:script" } },
      { "label": "Result variable", "type": "String", "value": "adUser", "binding": { "type": "property", "name": "atlas:resultVariable" } }
    ]
  }
}
