{
  "id": "atlas.sharepoint-create-item",
  "version": "1.0.0",
  "kind": "connector",
  "title": "SharePoint — Create List Item",
  "author": "Atlas core",
  "description": "Create a list item in a Microsoft SharePoint site through a server-registered Graph provider. Site, list and item fields are authored in the model; the Graph base and OAuth credential live on the server, resolved from the vault (ADR-0140).",
  "engineCompat": ">=0.9",
  "template": {
    "$schema": "https://unpkg.com/@camunda/element-templates-json-schema/resources/schema.json",
    "name": "SharePoint — Create List Item",
    "id": "atlas.sharepoint-create-item",
    "appliesTo": ["bpmn:ServiceTask"],
    "properties": [
      { "label": "Connector", "type": "String", "binding": { "type": "property", "name": "atlas:connector" } },
      { "label": "Site", "type": "String", "feel": "optional", "binding": { "type": "property", "name": "atlas:site" } },
      { "label": "List", "type": "String", "feel": "optional", "binding": { "type": "property", "name": "atlas:list" } },
      { "label": "Result variable", "type": "String", "binding": { "type": "property", "name": "atlas:resultVariable" } }
    ]
  }
}
