<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference translation of ../../../models/sequence.bpmn (same element ids;
     the inline FEEL script is expressed as JavaScript for bpmn-engine). -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="d_sequence" targetNamespace="http://atlas/conformance/ref">
  <process id="sequence" isExecutable="true">
    <startEvent id="start"/>
    <scriptTask id="set_a" scriptFormat="javascript"><script>environment.variables.a = 1; next();</script></scriptTask>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="set_a"/>
    <sequenceFlow id="f2" sourceRef="set_a" targetRef="end"/>
  </process>
</definitions>
