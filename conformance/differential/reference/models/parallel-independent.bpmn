<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference translation of ../../../models/parallel-independent.bpmn (same
     element ids; FEEL scripts expressed as JavaScript). -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="d_parallel" targetNamespace="http://atlas/conformance/ref">
  <process id="parallel-independent" isExecutable="true">
    <startEvent id="start"/>
    <parallelGateway id="fork"/>
    <scriptTask id="set_x" scriptFormat="javascript"><script>environment.variables.x = 1; next();</script></scriptTask>
    <scriptTask id="set_y" scriptFormat="javascript"><script>environment.variables.y = 2; next();</script></scriptTask>
    <parallelGateway id="join"/>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="fork"/>
    <sequenceFlow id="f2" sourceRef="fork" targetRef="set_x"/>
    <sequenceFlow id="f3" sourceRef="fork" targetRef="set_y"/>
    <sequenceFlow id="f4" sourceRef="set_x" targetRef="join"/>
    <sequenceFlow id="f5" sourceRef="set_y" targetRef="join"/>
    <sequenceFlow id="f6" sourceRef="join" targetRef="end"/>
  </process>
</definitions>
