<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: a BPMN standard loop (ADR-0130).

  Start -> script "seed" (n = 0) -> script task "step" marked with a standard loop
  -> End. "step" recomputes n = n + 1 and repeats while its <loopCondition> (n < 3)
  holds, so it runs three times and the token leaves with n = 3 — the loop's own
  work is what ends it, which is the whole point of the marker. It is
  self-completing (inline FEEL, no worker), so no driver step is needed, and the
  trace shows the repetition directly: one activation of the loop body plus one per
  run.

  Carries hand-authored BPMN-DI so it renders cleanly in the catalog; the layout is
  diagram-only and does not affect execution (the compiler ignores it).
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_standard_loop" targetNamespace="http://atlas/conformance">
  <process id="standard-loop" name="Standard loop" isExecutable="true">
    <startEvent id="start" name="Start"/>
    <scriptTask id="seed" name="Seed counter">
      <extensionElements>
        <zeebe:script expression="= 0" resultVariable="n"/>
      </extensionElements>
    </scriptTask>
    <scriptTask id="step" name="Step">
      <extensionElements>
        <zeebe:script expression="= n + 1" resultVariable="n"/>
      </extensionElements>
      <standardLoopCharacteristics>
        <loopCondition>= n &lt; 3</loopCondition>
      </standardLoopCharacteristics>
    </scriptTask>
    <endEvent id="end" name="Done"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="seed"/>
    <sequenceFlow id="f2" sourceRef="seed" targetRef="step"/>
    <sequenceFlow id="f3" sourceRef="step" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="standard-loop">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start"><dc:Bounds x="160" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_seed" bpmnElement="seed"><dc:Bounds x="270" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_step" bpmnElement="step"><dc:Bounds x="430" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end"><dc:Bounds x="600" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1"><di:waypoint x="196" y="200"/><di:waypoint x="270" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2"><di:waypoint x="370" y="200"/><di:waypoint x="430" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f3" bpmnElement="f3"><di:waypoint x="530" y="200"/><di:waypoint x="600" y="200"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
