<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: a plain sequence.

  Start -> script "set_a" (= 1 -> a) -> End. The smallest self-completing model:
  one inline FEEL script means the token never parks, so an instance runs
  straight to the end event with no worker attached. Realizes WCP-1 (Sequence).

  Carries hand-authored BPMN-DI so it renders cleanly in the catalog; the layout
  is diagram-only and does not affect execution (the compiler ignores it).
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_sequence" targetNamespace="http://atlas/conformance">
  <process id="sequence" name="Sequence" isExecutable="true">
    <startEvent id="start" name="Start"/>
    <scriptTask id="set_a" name="Set a">
      <extensionElements>
        <zeebe:script expression="= 1" resultVariable="a"/>
      </extensionElements>
    </scriptTask>
    <endEvent id="end" name="Done"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="set_a"/>
    <sequenceFlow id="f2" sourceRef="set_a" targetRef="end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="sequence">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start"><dc:Bounds x="160" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_set_a" bpmnElement="set_a"><dc:Bounds x="270" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end"><dc:Bounds x="440" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1"><di:waypoint x="196" y="200"/><di:waypoint x="270" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2"><di:waypoint x="370" y="200"/><di:waypoint x="440" y="200"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
