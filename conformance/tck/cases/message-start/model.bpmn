<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: a message start event.

  A message named "order-placed" starts a new instance: messageStart "on_order"
  -> script "record" -> End. There is no CreateInstance call — the instance is
  born from the message. The suite's Start hook publishes it with
  MessageStart("order-placed", ""); the inline script then self-completes the run.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_message_start" targetNamespace="http://atlas/conformance">
  <message id="Msg_order" name="order-placed"/>
  <process id="message-start" name="Message start" isExecutable="true">
    <startEvent id="on_order">
      <messageEventDefinition messageRef="Msg_order"/>
    </startEvent>
    <scriptTask id="record">
      <extensionElements>
        <zeebe:script expression="= 1" resultVariable="recorded"/>
      </extensionElements>
    </scriptTask>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="on_order" targetRef="record"/>
    <sequenceFlow id="f2" sourceRef="record" targetRef="end"/>
  </process>
</definitions>
