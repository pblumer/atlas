<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: a sequential multi-instance activity.

  Start -> script "seed" (items = [1, 2, 3]) -> sequential multi-instance service
  task "step" -> End. A sequential multi-instance runs its iterations one at a
  time: only one job is ever active, so the driver completes them one after
  another with Complete("step") x3 — the very fact that each Complete resolves a
  single job (never an ambiguous set) is the sequential property. Contrast the
  parallel multi-instance, which activates every iteration's work at once.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_multi_instance_sequential" targetNamespace="http://atlas/conformance">
  <process id="multi-instance-sequential" name="Multi-instance (sequential)" isExecutable="true">
    <startEvent id="start"/>
    <scriptTask id="seed">
      <extensionElements>
        <zeebe:script expression="= [1, 2, 3]" resultVariable="items"/>
      </extensionElements>
    </scriptTask>
    <serviceTask id="step" name="Step">
      <extensionElements>
        <zeebe:taskDefinition type="mistep" retries="3"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="true">
        <extensionElements>
          <zeebe:loopCharacteristics inputCollection="=items" inputElement="item"/>
        </extensionElements>
      </multiInstanceLoopCharacteristics>
    </serviceTask>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="seed"/>
    <sequenceFlow id="f2" sourceRef="seed" targetRef="step"/>
    <sequenceFlow id="f3" sourceRef="step" targetRef="end"/>
  </process>
</definitions>
