<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: an event-based gateway (deferred choice).

  Start -> eventBasedGateway -> races a message catch ("go", keyless) against a
  timer catch (PT30S). Whichever fires first wins; the other is canceled. The
  outcome is decided by the environment, not by data — that is the deferred
  choice. One model, two scenarios: the message-driven run reaches "end_msg", the
  timer-driven run reaches "end_timeout".
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="defs_event_based_gateway" targetNamespace="http://atlas/conformance">
  <message id="Msg_go" name="go"/>
  <process id="event-based-gateway" name="Event-based gateway" isExecutable="true">
    <startEvent id="start"/>
    <eventBasedGateway id="gw"/>
    <intermediateCatchEvent id="got_msg" name="Got message">
      <messageEventDefinition messageRef="Msg_go"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="timed_out" name="Timed out">
      <timerEventDefinition>
        <timeDuration>PT30S</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <endEvent id="end_msg"/>
    <endEvent id="end_timeout"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="gw"/>
    <sequenceFlow id="f2" sourceRef="gw" targetRef="got_msg"/>
    <sequenceFlow id="f3" sourceRef="gw" targetRef="timed_out"/>
    <sequenceFlow id="f4" sourceRef="got_msg" targetRef="end_msg"/>
    <sequenceFlow id="f5" sourceRef="timed_out" targetRef="end_timeout"/>
  </process>
</definitions>
