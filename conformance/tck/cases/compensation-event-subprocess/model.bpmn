<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: compensation thrown from an event subprocess, waiting for its
  handlers (ADR-draft-scope-aware-messaging-and-compensation, building on ADR-0103).

  Start -> serviceTask "charge" (compensable, handler "refund") -> userTask "wait" -> End,
  with an interrupting message event subprocess "cancellation" { message start ->
  compensation throw (no activityRef, waitForCompletion by default) -> script "bill" -> End }.
  The throw sits in the event subprocess; the charge it compensates in the scope around it.

  Driver: complete charge, publish the cancellation while "wait" is parked, complete the
  refund. The trace shows the refund before "bill": the throw compensates the enclosing
  scope and goes on only once the handler is done.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_comp_es" targetNamespace="http://atlas/conformance">
  <message id="Msg_cancel" name="cancellation">
    <extensionElements><zeebe:subscription correlationKey="= &quot;O1&quot;"/></extensionElements>
  </message>
  <process id="compensation-event-subprocess" name="Compensation from an event subprocess" isExecutable="true">
    <startEvent id="start" name="Start"/>
    <serviceTask id="charge" name="Charge card">
      <extensionElements><zeebe:taskDefinition type="charge-card" retries="3"/></extensionElements>
    </serviceTask>
    <boundaryEvent id="charge_comp" attachedToRef="charge"><compensateEventDefinition/></boundaryEvent>
    <serviceTask id="refund" name="Refund card" isForCompensation="true">
      <extensionElements><zeebe:taskDefinition type="refund-card" retries="3"/></extensionElements>
    </serviceTask>
    <association id="a1" sourceRef="charge_comp" targetRef="refund"/>
    <userTask id="wait" name="Ship">
      <extensionElements><zeebe:assignmentDefinition candidateGroups="shipping"/></extensionElements>
    </userTask>
    <endEvent id="end" name="Done"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="charge"/>
    <sequenceFlow id="f2" sourceRef="charge" targetRef="wait"/>
    <sequenceFlow id="f3" sourceRef="wait" targetRef="end"/>
    <subProcess id="cancellation" name="Cancellation" triggeredByEvent="true">
      <startEvent id="cs" name="Cancellation received" isInterrupting="true">
        <messageEventDefinition messageRef="Msg_cancel"/>
      </startEvent>
      <intermediateThrowEvent id="undo" name="Undo what was done"><compensateEventDefinition/></intermediateThrowEvent>
      <scriptTask id="bill" name="Bill effort">
        <extensionElements><zeebe:script expression="=&quot;billed&quot;" resultVariable="outcome"/></extensionElements>
      </scriptTask>
      <endEvent id="ce" name="Cancelled"/>
      <sequenceFlow id="c1" sourceRef="cs" targetRef="undo"/>
      <sequenceFlow id="c2" sourceRef="undo" targetRef="bill"/>
      <sequenceFlow id="c3" sourceRef="bill" targetRef="ce"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="compensation-event-subprocess">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start"><dc:Bounds x="82" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_charge" bpmnElement="charge"><dc:Bounds x="180" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_charge_comp" bpmnElement="charge_comp"><dc:Bounds x="212" y="142" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_refund" bpmnElement="refund"><dc:Bounds x="180" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_wait" bpmnElement="wait"><dc:Bounds x="330" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end" bpmnElement="end"><dc:Bounds x="502" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_cancellation" bpmnElement="cancellation" isExpanded="true"><dc:Bounds x="60" y="340" width="560" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_cs" bpmnElement="cs"><dc:Bounds x="92" y="387" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_undo" bpmnElement="undo"><dc:Bounds x="202" y="387" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_bill" bpmnElement="bill"><dc:Bounds x="290" y="365" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_ce" bpmnElement="ce"><dc:Bounds x="462" y="387" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1"><di:waypoint x="118" y="120"/><di:waypoint x="180" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2"><di:waypoint x="280" y="120"/><di:waypoint x="330" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f3" bpmnElement="f3"><di:waypoint x="430" y="120"/><di:waypoint x="502" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_a1" bpmnElement="a1"><di:waypoint x="230" y="178"/><di:waypoint x="230" y="220"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_c1" bpmnElement="c1"><di:waypoint x="128" y="405"/><di:waypoint x="202" y="405"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_c2" bpmnElement="c2"><di:waypoint x="238" y="405"/><di:waypoint x="290" y="405"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_c3" bpmnElement="c3"><di:waypoint x="390" y="405"/><di:waypoint x="462" y="405"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
