<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: a parallel multi-instance activity.

  Start -> script "seed" (items = [10, 20, 30]) -> multi-instance script "double"
  -> End. The multi-instance runs the body once per element of the input
  collection, binding each element to "item"; each iteration's inline script
  doubles it, and the outputElement aggregates into the "results" collection. The
  body is in-engine, so all iterations self-complete and the parallel join fires
  once they all finish.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_multi_instance" targetNamespace="http://atlas/conformance">
  <process id="multi-instance" name="Multi-instance" isExecutable="true">
    <startEvent id="start"/>
    <scriptTask id="seed">
      <extensionElements>
        <zeebe:script expression="= [10, 20, 30]" resultVariable="items"/>
      </extensionElements>
    </scriptTask>
    <scriptTask id="double">
      <extensionElements>
        <zeebe:script expression="= item * 2" resultVariable="doubled"/>
      </extensionElements>
      <multiInstanceLoopCharacteristics>
        <extensionElements>
          <zeebe:loopCharacteristics inputCollection="=items" inputElement="item"
            outputCollection="results" outputElement="=doubled"/>
        </extensionElements>
      </multiInstanceLoopCharacteristics>
    </scriptTask>
    <endEvent id="end"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="seed"/>
    <sequenceFlow id="f2" sourceRef="seed" targetRef="double"/>
    <sequenceFlow id="f3" sourceRef="double" targetRef="end"/>
  </process>
</definitions>
