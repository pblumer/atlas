<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conformance micro-fixture: an interrupting boundary error event.

  Start -> serviceTask "call" -> End "done", with a boundary error event catching
  error code "BOOM" on "call" and routing to End "handled". The driver plays a
  worker that throws the business error (ThrowError) instead of completing the job;
  the boundary catches it, interrupts the host, and the token leaves via the error
  path to "handled". Driver: ThrowError("call", "BOOM").
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_boundary_error" targetNamespace="http://atlas/conformance">
  <error id="Err_boom" errorCode="BOOM" name="Boom"/>
  <process id="boundary-error" name="Boundary error" isExecutable="true">
    <startEvent id="start"/>
    <serviceTask id="call" name="Risky call">
      <extensionElements>
        <zeebe:taskDefinition type="call" retries="3"/>
      </extensionElements>
    </serviceTask>
    <boundaryEvent id="on_error" name="On error" attachedToRef="call">
      <errorEventDefinition errorRef="Err_boom"/>
    </boundaryEvent>
    <endEvent id="done"/>
    <endEvent id="handled"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="call"/>
    <sequenceFlow id="f2" sourceRef="call" targetRef="done"/>
    <sequenceFlow id="f3" sourceRef="on_error" targetRef="handled"/>
  </process>
</definitions>
