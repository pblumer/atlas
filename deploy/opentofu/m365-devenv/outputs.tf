# ---------------------------------------------------------------------------
# Worker configuration for a worker run by hand OUTSIDE the Atlas server built here
# (the server's own workers are configured in its Console by the bootstrap):
# the ATLAS_* variables each Worker Type reads at start-up
# (worker/*connector.go), written as out/worker.env (bash: set -a; . out/worker.env)
# and out/worker.env.ps1 (PowerShell: . .\out\worker.env.ps1). Multi-line PEM texts
# are written with literal \n, which the Entra and Teams Phone workers read as line
# breaks; the Exchange and SharePoint bundles are JSON, where \n is the JSON escape.
# ---------------------------------------------------------------------------

locals {
  # connector/envname.Key: upper case, every run of other characters one underscore.
  env_key = { for k, n in var.worker_names : k => upper(join("_", regexall("[A-Za-z0-9]+", n))) }

  pem1 = { # one-line PEM bundles
    entra      = var.workers.entra && var.entra_credential == "certificate" ? replace(module.entra[0].certificate_bundle_pem, "\n", "\\n") : null
    teamsphone = var.workers.teamsphone ? replace(module.teamsphone[0].certificate_bundle_pem, "\n", "\\n") : null
  }

  env_entra = var.workers.entra ? concat(
    [
      ["ATLAS_ENTRA_CONNECTORS", var.worker_names.entra],
      ["ATLAS_ENTRA_${local.env_key.entra}_TENANT_ID", var.tenant_id],
      ["ATLAS_ENTRA_${local.env_key.entra}_CLIENT_ID", module.entra[0].client_id],
    ],
    var.entra_credential == "certificate"
    ? [["ATLAS_ENTRA_${local.env_key.entra}_CLIENT_CERTIFICATE", local.pem1.entra]]
    : [["ATLAS_ENTRA_${local.env_key.entra}_CLIENT_SECRET", module.entra[0].client_secret]],
  ) : []

  worker_bundle = { for w in local.worker_defs : w.key => w.bundle }

  env_exchange = var.workers.exchange ? [
    ["ATLAS_EXCHANGE_CONNECTORS", var.worker_names.exchange],
    ["ATLAS_EXCHANGE_${local.env_key.exchange}_CREDENTIALS", local.worker_bundle["exchange"]],
  ] : []

  env_sharepoint = var.workers.sharepoint ? [
    ["ATLAS_SHAREPOINT_CONNECTORS", var.worker_names.sharepoint],
    ["ATLAS_SHAREPOINT_${local.env_key.sharepoint}_CREDENTIALS", local.worker_bundle["sharepoint"]],
  ] : []

  env_mail = var.workers.mail ? [
    ["ATLAS_MAIL_CONNECTORS", var.worker_names.mail],
    ["ATLAS_MAIL_${local.env_key.mail}_PROVIDER", "microsoft"],
    ["ATLAS_MAIL_${local.env_key.mail}_SENDER", local.mail_sender],
    ["ATLAS_MAIL_${local.env_key.mail}_SECRET", local.worker_bundle["mail"]],
  ] : []

  env_teamsphone = var.workers.teamsphone ? [
    ["ATLAS_TEAMSPHONE_CONNECTORS", var.worker_names.teamsphone],
    ["ATLAS_TEAMSPHONE_${local.env_key.teamsphone}_TENANT_ID", var.tenant_id],
    ["ATLAS_TEAMSPHONE_${local.env_key.teamsphone}_CLIENT_ID", module.teamsphone[0].client_id],
    ["ATLAS_TEAMSPHONE_${local.env_key.teamsphone}_CERTIFICATE", local.pem1.teamsphone],
  ] : []

  env_ad = var.enable_ad_dc ? [
    ["ATLAS_AD_CONNECTORS", var.worker_names.ad],
    ["ATLAS_AD_${local.env_key.ad}_URL", local.ad_url_public],
    ["ATLAS_AD_${local.env_key.ad}_BIND_DN", local.ad_bind_dn],
    ["ATLAS_AD_${local.env_key.ad}_PASSWORD", random_password.ad["service"].result],
  ] : [["ATLAS_AD_MOCK", "1"]]

  env_pairs = concat(local.env_entra, local.env_exchange, local.env_sharepoint, local.env_teamsphone, local.env_mail, local.env_ad)

  worker_kinds = compact([
    var.workers.entra ? "entra" : "",
    var.workers.exchange ? "exchange" : "",
    var.workers.sharepoint ? "sharepoint" : "",
    var.workers.teamsphone ? "teamsphone" : "",
    var.workers.mail ? "mail" : "",
    "ad",
  ])

  env_header = <<-EOT
    Atlas M365 development environment ${local.env_id} (tenant ${local.initial_domain})
    Generated by OpenTofu - contains credentials. Do not commit, delete after tofu destroy.
    Credentials expire ${time_offset.credential_expiry.rfc3339}.
    Start: atlas worker --server <https://atlas...> --connector ${join(",", local.worker_kinds)}
    (ATLAS_TOKEN must hold an API token with the worker scope.)
  EOT

  ad_trust_note = var.enable_ad_dc ? join("\n", [
    "The AD worker verifies LDAPS against the host trust store. Trust ${local.output_dir}/ad-ldaps.pem,",
    "and allow this host in ad_allowed_cidrs (the domain controller's public LDAPS port):",
    "  Linux: SSL_CERT_DIR below (Go reads it in addition to the default bundle file).",
    "  Windows: Import-Certificate -FilePath out\\ad-ldaps.pem -CertStoreLocation Cert:\\LocalMachine\\Root",
  ]) : "No domain controller (enable_ad_dc = false): the AD worker serves a mock directory in memory (ADR-0181)."
}

resource "local_sensitive_file" "worker_env" {
  filename        = "${local.output_dir}/worker.env"
  file_permission = "0600"
  content = join("\n", concat(
    [for l in split("\n", trimspace(local.env_header)) : "# ${l}"],
    [for l in split("\n", local.ad_trust_note) : "# ${l}"],
    [""],
    [for p in local.env_pairs : "${p[0]}='${p[1]}'"],
    var.enable_ad_dc ? ["SSL_CERT_DIR='/etc/ssl/certs:${local.output_dir}/trust'"] : [],
    [""],
  ))
}

resource "local_sensitive_file" "worker_env_ps1" {
  filename        = "${local.output_dir}/worker.env.ps1"
  file_permission = "0600"
  content = join("\n", concat(
    [for l in split("\n", trimspace(local.env_header)) : "# ${l}"],
    [for l in split("\n", local.ad_trust_note) : "# ${l}"],
    [""],
    [for p in local.env_pairs : "$env:${p[0]} = '${p[1]}'"],
    [""],
  ))
}

# The same certificate bundles as files, for a Console bundle, Connect-MicrosoftTeams
# or Connect-ExchangeOnline by hand.
resource "local_sensitive_file" "certificate_bundle" {
  # The keys come from switches only: a key derived from the (sensitive) PEM itself is
  # refused by for_each.
  for_each = toset(compact([
    var.workers.entra && var.entra_credential == "certificate" ? "entra" : "",
    var.workers.exchange ? "exchange" : "",
    var.workers.sharepoint && var.sharepoint_credential == "certificate" ? "sharepoint" : "",
    var.workers.teamsphone ? "teamsphone" : "",
  ]))

  filename        = "${local.output_dir}/certs/${each.key}.pem"
  file_permission = "0600"
  content = {
    entra      = one(module.entra[*].certificate_bundle_pem)
    exchange   = one(module.exchange[*].certificate_bundle_pem)
    sharepoint = one(module.sharepoint[*].certificate_bundle_pem)
    teamsphone = one(module.teamsphone[*].certificate_bundle_pem)
  }[each.key]
}

# A directory holding only the LDAPS certificate, for SSL_CERT_DIR.
resource "local_file" "ad_trust_dir" {
  count           = local.ad_count
  filename        = "${local.output_dir}/trust/atlas-ad-ldaps.pem"
  file_permission = "0644"
  content         = local_file.ad_ldaps_cert[0].content
}

# ---------------------------------------------------------------------------
# Plain outputs
# ---------------------------------------------------------------------------

output "environment_id" {
  description = "Prefix and suffix every object of this environment carries."
  value       = local.env_id
}

output "tenant" {
  description = "Tenant id and initial domain."
  value = {
    id             = var.tenant_id
    initial_domain = local.initial_domain
  }
}

output "worker_env_file" {
  description = "Bash environment file for atlas worker (mode 0600)."
  value       = local_sensitive_file.worker_env.filename
}

output "worker_env_ps1_file" {
  description = "PowerShell environment file for atlas worker (mode 0600)."
  value       = local_sensitive_file.worker_env_ps1.filename
}

output "worker_command" {
  description = "How to start one worker for all built kinds."
  value       = "set -a; . ${local_sensitive_file.worker_env.filename}; set +a; atlas worker --server \"$ATLAS_SERVER\" --connector ${join(",", local.worker_kinds)}"
}

output "apps" {
  description = "Client ids of the worker app registrations."
  value = {
    entra      = var.workers.entra ? module.entra[0].client_id : null
    exchange   = var.workers.exchange ? module.exchange[0].client_id : null
    sharepoint = var.workers.sharepoint ? module.sharepoint[0].client_id : null
    teamsphone = var.workers.teamsphone ? module.teamsphone[0].client_id : null
  }
}

output "test_users" {
  description = "Test users (UPN and object id). Passwords: tofu output -json test_user_passwords."
  value = merge(
    { manager = { upn = azuread_user.manager.user_principal_name, id = azuread_user.manager.object_id } },
    { for k, u in azuread_user.test : k => { upn = u.user_principal_name, id = u.object_id } },
  )
}

output "test_user_passwords" {
  description = "Initial passwords of the test users."
  value = merge(
    { manager = random_password.user["manager"].result },
    { for k in keys(var.test_users) : k => random_password.user[k].result },
  )
  sensitive = true
}

output "groups" {
  description = "Test groups. The Microsoft 365 group carries the SharePoint test site and becomes the test team through the Entra worker's create-team."
  value = {
    security = { id = azuread_group.security.object_id, name = azuread_group.security.display_name }
    scratch  = { id = azuread_group.scratch.object_id, name = azuread_group.scratch.display_name }
    m365 = {
      id                  = azuread_group.m365.object_id
      name                = azuread_group.m365.display_name
      mail                = azuread_group.m365.mail
      sharepoint_site_url = "https://${local.tenant_name}.sharepoint.com/sites/${azuread_group.m365.mail_nickname}"
      graph_site_lookup   = "GET https://graph.microsoft.com/v1.0/groups/${azuread_group.m365.object_id}/sites/root"
    }
  }
}

output "ad_public_fqdn" {
  description = "Public DNS name of the domain controller (LDAPS on 636)."
  value       = local.ad_public_fqdn
}

output "ad_ldaps_certificate_file" {
  description = "The domain controller's LDAPS certificate, to trust on the worker host."
  value       = var.enable_ad_dc ? local_file.ad_ldaps_cert[0].filename : null
}

output "ad_bind_dn" {
  description = "Bind DN of the AD worker's service account."
  value       = var.enable_ad_dc ? local.ad_bind_dn : null
}

output "ad_bind_password" {
  description = "Password of the AD worker's service account."
  value       = var.enable_ad_dc ? random_password.ad["service"].result : null
  sensitive   = true
}

output "ad_test_ou" {
  description = "OU the bind account controls and the test users live in."
  value       = var.enable_ad_dc ? local.ad_test_ou_dn : null
}

output "ad_admin" {
  description = "Local/domain administrator of the domain controller (for RDP)."
  value       = var.enable_ad_dc ? { username = "atlasadmin", password = random_password.ad["admin"].result } : null
  sensitive   = true
}

# --- Atlas server -------------------------------------------------------------

output "atlas_url" {
  description = "The Atlas server. Ready some 10-20 minutes after apply (scripts/wait-atlas.sh)."
  value       = local.atlas_url
}

output "atlas_admin" {
  description = "Local administrator of the Atlas server."
  value       = var.enable_atlas_server ? { username = "admin", password = random_password.atlas_admin[0].result } : null
  sensitive   = true
}

output "atlas_ssh" {
  description = "SSH to the Atlas server (setup log: /var/log/atlas-setup.log)."
  value       = var.enable_atlas_server ? "ssh -i ${local_sensitive_file.atlas_ssh_key[0].filename} atlasadmin@${local.atlas_fqdn}" : null
}

output "atlas_workers" {
  description = "Workers the bootstrap creates in the Atlas Console (name => kind)."
  value       = { for w in local.worker_defs : w.name => w.kind }
}

output "exchange_onprem" {
  description = "The on-premises Exchange server, for an Exchange worker with target onprem: its Remote PowerShell endpoint (Kerberos, inside the virtual network) and the worker's service account in Organization Management."
  value = local.exchange_count == 1 ? {
    vm              = azurerm_windows_virtual_machine.exchange[0].name
    resource_group  = azurerm_resource_group.env[0].name
    fqdn            = local.exchange_fqdn
    private_ip      = local.exchange_private_ip
    connection_uri  = "http://${local.exchange_fqdn}/PowerShell/"
    service_account = "${local.exchange_service_account}@${var.ad_domain_name}"
  } : null
}

output "exchange_service_password" {
  description = "Password of the Exchange worker's service account."
  value       = local.exchange_count == 1 ? random_password.exchange_service[0].result : null
  sensitive   = true
}

output "sharepoint_server" {
  description = "The SharePoint server, for the SharePoint Server worker: whether it is built, its VM, its web application (inside the virtual network) and the runbook service account. No password."
  value = {
    enabled             = local.sharepoint_count == 1
    vm                  = local.sharepoint_count == 1 ? azurerm_windows_virtual_machine.sharepoint[0].name : null
    resource_group      = local.sharepoint_count == 1 ? azurerm_resource_group.env[0].name : null
    fqdn                = local.sharepoint_count == 1 ? local.sharepoint_fqdn : null
    private_ip          = local.sharepoint_count == 1 ? local.sharepoint_private_ip : null
    web_application_url = local.sharepoint_count == 1 ? local.sharepoint_url : null
    runbook_account     = local.sharepoint_count == 1 ? "${local.sharepoint_runbook_account}@${var.ad_domain_name}" : null
  }
}
