<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_produkt_lebenszyklus" targetNamespace="http://atlas/katalog-demo">
  <message id="m_provision" name="produkt.provision"/>
  <message id="m_change" name="produkt.change"><extensionElements><zeebe:subscription correlationKey="=orderId + &#34;/&#34; + (if positionId = null then itemId else positionId)"/></extensionElements></message>
  <message id="m_deprovision" name="produkt.deprovision"><extensionElements><zeebe:subscription correlationKey="=orderId + &#34;/&#34; + (if positionId = null then itemId else positionId)"/></extensionElements></message>
  <process id="proc_produkt_lebenszyklus_vorlage" name="Produkt: Lebenszyklus (ein Strang)" isExecutable="true">
    <documentation>Vorlage: ein Strang pro Position (ADR-0428, Form per-position).
Ablauf: Neu bestellt -> Provisionierung -> Ausgegeben -> Warten auf Auftrag -> (Change)* -> Deprovisionierung -> Recht beendet.
Stopps gegen Endlosschleifen:
1. Jede Runde der Change-Schleife beginnt am ereignisbasierten Gateway und braucht ein externes Ereignis; eine Schleife ohne Wartezustand stoppt ohnehin das Execution Budget der Engine (ADR-0272).
2. Change-Limit: ab maxChanges (Standard 20) wird jeder weitere Change abgewiesen statt ausgeführt.
3. Rückgabe während eines Changes bricht den Change ab (unterbrechendes Randereignis); sie geht nicht verloren.
4. Rückgabe ohne laufende Instanz (übernommene, alte oder abgebrochene Rechte) tritt über das Startereignis mit derselben Nachricht direkt in die Deprovisionierung ein.
Bewusst nicht im Modell: Ablauf der Laufzeit (ADR-0344 gibt die Zeile zurück) und Stornierung vor der Ausgabe (die Bestellung bricht die Instanz ab, ADR-0416).
Korrelation: orderId + "/" + positionId (Positionsschlüssel, ADR-0384).</documentation>
    <startEvent id="start" name="Neu bestellt"><outgoing>f1</outgoing><messageEventDefinition messageRef="m_provision"/></startEvent>
    <userTask id="prov" name="Provisionierung"><incoming>f1</incoming><outgoing>f2</outgoing></userTask>
    <serviceTask id="prov_melden" name="Position als provisioniert melden"><incoming>f2</incoming><outgoing>f3</outgoing><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then &#34;http://127.0.0.1:8080&#34; else atlasApiBase) + &#34;/api/v1/orders/&#34; + orderId + &#34;/lines/&#34; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&#34;done&#34;" target="status"/></zeebe:ioMapping></extensionElements></serviceTask>
    <intermediateThrowEvent id="ausgegeben" name="Ausgegeben"><incoming>f3</incoming><outgoing>f4</outgoing></intermediateThrowEvent>
    <exclusiveGateway id="gw_warten"><incoming>f4</incoming><incoming>f16</incoming><outgoing>f5</outgoing></exclusiveGateway>
    <eventBasedGateway id="gw_ereignis" name="Warten auf Auftrag"><incoming>f5</incoming><outgoing>f6</outgoing><outgoing>f7</outgoing></eventBasedGateway>
    <intermediateCatchEvent id="msg_change" name="Change angefordert"><incoming>f6</incoming><outgoing>f9</outgoing><messageEventDefinition messageRef="m_change"/></intermediateCatchEvent>
    <intermediateCatchEvent id="msg_rueckgabe" name="Rückgabe angefordert"><incoming>f7</incoming><outgoing>f17</outgoing><messageEventDefinition messageRef="m_deprovision"/></intermediateCatchEvent>
    <exclusiveGateway id="gw_limit" name="Change-Limit erreicht?" default="f10"><incoming>f9</incoming><outgoing>f10</outgoing><outgoing>f11</outgoing></exclusiveGateway>
    <scriptTask id="zaehlen" name="Change zählen"><incoming>f10</incoming><outgoing>f12</outgoing><extensionElements><zeebe:script expression="=if changeCount = null then 1 else changeCount + 1" resultVariable="changeCount"/></extensionElements></scriptTask>
    <userTask id="change" name="Change"><incoming>f12</incoming><outgoing>f13</outgoing></userTask>
    <boundaryEvent id="b_rueckgabe" name="Rückgabe angefordert" attachedToRef="change" cancelActivity="true"><outgoing>f18</outgoing><messageEventDefinition messageRef="m_deprovision"/></boundaryEvent>
    <scriptTask id="abweisen" name="Change abweisen"><incoming>f11</incoming><outgoing>f14</outgoing><extensionElements><zeebe:script expression="=&#34;abgewiesen: Change-Limit erreicht&#34;" resultVariable="changeResult"/></extensionElements></scriptTask>
    <exclusiveGateway id="gw_ergebnis"><incoming>f13</incoming><incoming>f14</incoming><outgoing>f15</outgoing></exclusiveGateway>
    <scriptTask id="ergebnis" name="Change-Ergebnis festhalten"><incoming>f15</incoming><outgoing>f16</outgoing><extensionElements><zeebe:script expression="=if changeResult = null then &#34;ausgeführt&#34; else changeResult" resultVariable="lastChangeResult"/></extensionElements></scriptTask>
    <exclusiveGateway id="gw_rueckgabe"><incoming>f20</incoming><incoming>f17</incoming><incoming>f18</incoming><outgoing>f22</outgoing></exclusiveGateway>
    <startEvent id="start_ohne_instanz" name="Rückgabe ohne laufende Instanz"><outgoing>f20</outgoing><messageEventDefinition messageRef="m_deprovision"/></startEvent>
    <userTask id="deprov" name="Deprovisionierung"><incoming>f22</incoming><outgoing>f23</outgoing></userTask>
    <serviceTask id="deprov_melden" name="Rückgabe als erfolgt melden"><incoming>f23</incoming><outgoing>f24</outgoing><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then &#34;http://127.0.0.1:8080&#34; else atlasApiBase) + &#34;/api/v1/orders/&#34; + orderId + &#34;/lines/&#34; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&#34;returned&#34;" target="status"/></zeebe:ioMapping></extensionElements></serviceTask>
    <endEvent id="ende" name="Recht beendet"><incoming>f24</incoming></endEvent>
    <sequenceFlow id="f1" sourceRef="start" targetRef="prov"/>
    <sequenceFlow id="f2" sourceRef="prov" targetRef="prov_melden"/>
    <sequenceFlow id="f3" sourceRef="prov_melden" targetRef="ausgegeben"/>
    <sequenceFlow id="f4" sourceRef="ausgegeben" targetRef="gw_warten"/>
    <sequenceFlow id="f5" sourceRef="gw_warten" targetRef="gw_ereignis"/>
    <sequenceFlow id="f6" sourceRef="gw_ereignis" targetRef="msg_change"/>
    <sequenceFlow id="f7" sourceRef="gw_ereignis" targetRef="msg_rueckgabe"/>
    <sequenceFlow id="f9" sourceRef="msg_change" targetRef="gw_limit"/>
    <sequenceFlow id="f10" sourceRef="gw_limit" targetRef="zaehlen" name="unter Limit"/>
    <sequenceFlow id="f11" sourceRef="gw_limit" targetRef="abweisen" name="Limit erreicht"><conditionExpression>=(if changeCount = null then 0 else changeCount) &gt;= (if maxChanges = null then 20 else maxChanges)</conditionExpression></sequenceFlow>
    <sequenceFlow id="f12" sourceRef="zaehlen" targetRef="change"/>
    <sequenceFlow id="f13" sourceRef="change" targetRef="gw_ergebnis"/>
    <sequenceFlow id="f14" sourceRef="abweisen" targetRef="gw_ergebnis"/>
    <sequenceFlow id="f15" sourceRef="gw_ergebnis" targetRef="ergebnis"/>
    <sequenceFlow id="f16" sourceRef="ergebnis" targetRef="gw_warten" name="zurück in Wartezustand"/>
    <sequenceFlow id="f20" sourceRef="start_ohne_instanz" targetRef="gw_rueckgabe"/>
    <sequenceFlow id="f17" sourceRef="msg_rueckgabe" targetRef="gw_rueckgabe"/>
    <sequenceFlow id="f18" sourceRef="b_rueckgabe" targetRef="gw_rueckgabe"/>
    <sequenceFlow id="f22" sourceRef="gw_rueckgabe" targetRef="deprov"/>
    <sequenceFlow id="f23" sourceRef="deprov" targetRef="deprov_melden"/>
    <sequenceFlow id="f24" sourceRef="deprov_melden" targetRef="ende"/>
  </process>
  <bpmndi:BPMNDiagram id="d"><bpmndi:BPMNPlane id="p" bpmnElement="proc_produkt_lebenszyklus_vorlage">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><omgdc:Bounds x="100" y="382" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="68" y="422" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prov_di" bpmnElement="prov"><omgdc:Bounds x="180" y="360" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prov_melden_di" bpmnElement="prov_melden"><omgdc:Bounds x="330" y="360" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ausgegeben_di" bpmnElement="ausgegeben"><omgdc:Bounds x="480" y="382" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="448" y="422" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_warten_di" bpmnElement="gw_warten" isMarkerVisible="true"><omgdc:Bounds x="570" y="375" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ereignis_di" bpmnElement="gw_ereignis"><omgdc:Bounds x="670" y="375" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="596" y="430" width="95" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_change_di" bpmnElement="msg_change"><omgdc:Bounds x="780" y="232" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="748" y="272" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_limit_di" bpmnElement="gw_limit" isMarkerVisible="true"><omgdc:Bounds x="870" y="225" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="845" y="280" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zaehlen_di" bpmnElement="zaehlen"><omgdc:Bounds x="970" y="210" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="change_di" bpmnElement="change"><omgdc:Bounds x="1180" y="210" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="abweisen_di" bpmnElement="abweisen"><omgdc:Bounds x="1180" y="110" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ergebnis_di" bpmnElement="gw_ergebnis" isMarkerVisible="true"><omgdc:Bounds x="1330" y="225" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ergebnis_di" bpmnElement="ergebnis"><omgdc:Bounds x="1430" y="210" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="msg_rueckgabe_di" bpmnElement="msg_rueckgabe"><omgdc:Bounds x="780" y="382" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="748" y="422" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_rueckgabe_di" bpmnElement="gw_rueckgabe" isMarkerVisible="true"><omgdc:Bounds x="1205" y="375" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_ohne_instanz_di" bpmnElement="start_ohne_instanz"><omgdc:Bounds x="1112" y="502" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1080" y="542" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deprov_di" bpmnElement="deprov"><omgdc:Bounds x="1330" y="360" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deprov_melden_di" bpmnElement="deprov_melden"><omgdc:Bounds x="1480" y="360" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ende_di" bpmnElement="ende"><omgdc:Bounds x="1630" y="382" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1598" y="422" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_rueckgabe_di" bpmnElement="b_rueckgabe"><omgdc:Bounds x="1212" y="272" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1242" y="306" width="90" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><omgdi:waypoint x="136" y="400"/><omgdi:waypoint x="180" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><omgdi:waypoint x="280" y="400"/><omgdi:waypoint x="330" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><omgdi:waypoint x="430" y="400"/><omgdi:waypoint x="480" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><omgdi:waypoint x="516" y="400"/><omgdi:waypoint x="570" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><omgdi:waypoint x="620" y="400"/><omgdi:waypoint x="670" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><omgdi:waypoint x="695" y="375"/><omgdi:waypoint x="695" y="250"/><omgdi:waypoint x="780" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><omgdi:waypoint x="720" y="400"/><omgdi:waypoint x="780" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><omgdi:waypoint x="816" y="250"/><omgdi:waypoint x="870" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><omgdi:waypoint x="920" y="250"/><omgdi:waypoint x="970" y="250"/><bpmndi:BPMNLabel><omgdc:Bounds x="924" y="256" width="46" height="26"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><omgdi:waypoint x="895" y="225"/><omgdi:waypoint x="895" y="150"/><omgdi:waypoint x="1180" y="150"/><bpmndi:BPMNLabel><omgdc:Bounds x="905" y="128" width="140" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><omgdi:waypoint x="1070" y="250"/><omgdi:waypoint x="1180" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><omgdi:waypoint x="1280" y="250"/><omgdi:waypoint x="1330" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14"><omgdi:waypoint x="1280" y="150"/><omgdi:waypoint x="1355" y="150"/><omgdi:waypoint x="1355" y="225"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15"><omgdi:waypoint x="1380" y="250"/><omgdi:waypoint x="1430" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f16_di" bpmnElement="f16"><omgdi:waypoint x="1530" y="250"/><omgdi:waypoint x="1570" y="250"/><omgdi:waypoint x="1570" y="60"/><omgdi:waypoint x="595" y="60"/><omgdi:waypoint x="595" y="375"/><bpmndi:BPMNLabel><omgdc:Bounds x="960" y="38" width="140" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f20_di" bpmnElement="f20"><omgdi:waypoint x="1148" y="520"/><omgdi:waypoint x="1230" y="520"/><omgdi:waypoint x="1230" y="425"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f17_di" bpmnElement="f17"><omgdi:waypoint x="816" y="400"/><omgdi:waypoint x="1205" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f18_di" bpmnElement="f18"><omgdi:waypoint x="1230" y="308"/><omgdi:waypoint x="1230" y="375"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f22_di" bpmnElement="f22"><omgdi:waypoint x="1255" y="400"/><omgdi:waypoint x="1330" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f23_di" bpmnElement="f23"><omgdi:waypoint x="1430" y="400"/><omgdi:waypoint x="1480" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f24_di" bpmnElement="f24"><omgdi:waypoint x="1580" y="400"/><omgdi:waypoint x="1630" y="400"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</definitions>
