<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_exclusive_gateway" targetNamespace="http://atlas/playground">
  <process id="exclusive-gateway" name="Exclusive gateway" isExecutable="true">
    <documentation>Playground fixture: one decision, two branches. A heat map is only worth drawing on a model that has a branch to leave cold.</documentation>
    <startEvent id="start" name="Start"/>
    <exclusiveGateway id="decide" name="Large?" default="f_small"/>
    <userTask id="review" name="Review"/>
    <userTask id="autopay" name="Pay out"/>
    <endEvent id="reviewed" name="Reviewed"/>
    <endEvent id="paid" name="Paid"/>
    <sequenceFlow id="f_in" sourceRef="start" targetRef="decide"/>
    <sequenceFlow id="f_large" sourceRef="decide" targetRef="review">
      <conditionExpression>= amount &gt; 1000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_small" sourceRef="decide" targetRef="autopay"/>
    <sequenceFlow id="f_reviewed" sourceRef="review" targetRef="reviewed"/>
    <sequenceFlow id="f_paid" sourceRef="autopay" targetRef="paid"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="exclusive-gateway">
      <bpmndi:BPMNShape id="di_start" bpmnElement="start"><dc:Bounds x="160" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_decide" bpmnElement="decide"><dc:Bounds x="250" y="175" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_review" bpmnElement="review"><dc:Bounds x="360" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_autopay" bpmnElement="autopay"><dc:Bounds x="360" y="240" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_reviewed" bpmnElement="reviewed"><dc:Bounds x="520" y="102" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_paid" bpmnElement="paid"><dc:Bounds x="520" y="262" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_f_in" bpmnElement="f_in"><di:waypoint x="196" y="200"/><di:waypoint x="250" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_large" bpmnElement="f_large"><di:waypoint x="275" y="175"/><di:waypoint x="275" y="120"/><di:waypoint x="360" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_small" bpmnElement="f_small"><di:waypoint x="275" y="225"/><di:waypoint x="275" y="280"/><di:waypoint x="360" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_reviewed" bpmnElement="f_reviewed"><di:waypoint x="460" y="120"/><di:waypoint x="520" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_paid" bpmnElement="f_paid"><di:waypoint x="460" y="280"/><di:waypoint x="520" y="280"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
