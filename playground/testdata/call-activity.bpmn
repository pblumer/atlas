<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             id="defs_call_activity" targetNamespace="http://atlas/playground">
  <process id="parent" name="Parent" isExecutable="true">
    <documentation>Playground fixture: a process that calls another. The heat map is drawn onto the diagram on screen, which is this one — the child runs on its own compiled graph, whose element indices mean nothing here.</documentation>
    <startEvent id="p_start" name="Start"/>
    <callActivity id="p_call" name="Delegate">
      <extensionElements>
        <zeebe:calledElement processId="child" propagateAllChildVariables="true"/>
      </extensionElements>
    </callActivity>
    <endEvent id="p_end" name="Done"/>
    <sequenceFlow id="pf1" sourceRef="p_start" targetRef="p_call"/>
    <sequenceFlow id="pf2" sourceRef="p_call" targetRef="p_end"/>
  </process>
  <process id="child" name="Child" isExecutable="true">
    <startEvent id="c_start" name="Start"/>
    <userTask id="c_work" name="Do the work"/>
    <endEvent id="c_end" name="Done"/>
    <sequenceFlow id="cf1" sourceRef="c_start" targetRef="c_work"/>
    <sequenceFlow id="cf2" sourceRef="c_work" targetRef="c_end"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="parent">
      <bpmndi:BPMNShape id="di_p_start" bpmnElement="p_start"><dc:Bounds x="160" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_p_call" bpmnElement="p_call"><dc:Bounds x="270" y="160" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_p_end" bpmnElement="p_end"><dc:Bounds x="440" y="182" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_pf1" bpmnElement="pf1"><di:waypoint x="196" y="200"/><di:waypoint x="270" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_pf2" bpmnElement="pf2"><di:waypoint x="370" y="200"/><di:waypoint x="440" y="200"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
