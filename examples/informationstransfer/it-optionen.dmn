      <input id="in_18" label="postfachSystem"><inputExpression id="ie_18" typeRef="string"><text>postfachSystem</text></inputExpression></input>
      <output id="out_0" label="art" name="art" typeRef="string"/>
      <output id="out_1" label="text" name="text" typeRef="string"/>
      <rule id="r1">
        <description>Szenario unbekannt</description>
        <inputEntry id="r1_i0"><text>not("internalisierung","externalisierung","amtswechsel","abteilungswechsel")</text></inputEntry>
        <inputEntry id="r1_i1"><text>-</text></inputEntry>
        <inputEntry id="r1_i2"><text>-</text></inputEntry>
        <inputEntry id="r1_i3"><text>-</text></inputEntry>
