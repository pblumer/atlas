      <input id="in_11" label="quelleTransferiert"><inputExpression id="ie_11" typeRef="boolean"><text>quelleTransferiert</text></inputExpression></input>
      <input id="in_12" label="gleicheDomain"><inputExpression id="ie_12" typeRef="boolean"><text>gleicheDomain</text></inputExpression></input>
      <input id="in_13" label="domainBestaetigt"><inputExpression id="ie_13" typeRef="boolean"><text>domainBestaetigt</text></inputExpression></input>
      <input id="in_14" label="pfQuelleDa"><inputExpression id="ie_14" typeRef="boolean"><text>pfQuelleDa</text></inputExpression></input>
      <input id="in_15" label="pfZielDa"><inputExpression id="ie_15" typeRef="boolean"><text>pfZielDa</text></inputExpression></input>
      <input id="in_16" label="entraTransferAktiv"><inputExpression id="ie_16" typeRef="boolean"><text>entraTransferAktiv</text></inputExpression></input>
