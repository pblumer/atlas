             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_it_kontingent" targetNamespace="http://atlas/beispiel/informationstransfer">
  <itemDefinition id="item_Postfach" structureRef="Postfach"/>
  <dataStore id="ds_exchange_server_empfaenger" name="Exchange Server: Empfaenger"/>
  <dataStore id="ds_exchange_online_empfaenger" name="Exchange Online: Empfaenger"/>
  <process id="proc_it_kontingent" name="Informationstransfer: Kontingent" isExecutable="true" atlas:personal="quelle,ziel,begruendung,quelleKonto,zielKonto,pfQuelle,pfZiel" atlas:dataSubject="recipient">
    <documentation>Das Postfachkontingent geht nur dann von der Quelle auf das Ziel über, wenn die Quelle mehr Platz hat. Verglichen wird ProhibitSendReceiveQuota in KB (Exchange gibt ein Kontingent als «2 GB (2,147,483,648 bytes)» oder «Unlimited» an; die Bytes in der Klammer sind die Grundlage, Unlimited ist grösser als jede Zahl). Hat ein Postfach UseDatabaseQuotaDefaults, gilt das Kontingent seiner Datenbank (dbQuelle, dbZiel, Exchange Server).

Der Vergleich steht in den Parametern von set-mailbox-quota, die der Exchange-Worker auswertet, weil die Postfächer versiegelt sind: Ist die Quelle grösser, erhält das Ziel ihre drei Grenzen (in Bytes) und auf dem Exchange Server UseDatabaseQuotaDefaults = false; sonst erhält es seine eigenen Werte zurück, und es ändert sich nichts. Liest der Prozess keine Postfächer (ein Postfach fehlt), hat die Regel die Option schon abgelehnt.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="POSTFACH_SYSTEM" type="string" source="application" value="exchange-server"/></atlas:constants></extensionElements>
    <dataObject id="do_postfach" name="Zielpostfach" itemSubjectRef="item_Postfach"/>
    <startEvent id="s" name="Aufgerufen"><outgoing>f_s__gw_an</outgoing></startEvent>
    <exclusiveGateway id="gw_an" name="Kontingent?" default="f_gw_an__e_nein"><incoming>f_s__gw_an</incoming><outgoing>f_gw_an__gw_sys</outgoing><outgoing>f_gw_an__e_nein</outgoing></exclusiveGateway>
    <endEvent id="e_nein" name="Nicht gewählt"><incoming>f_gw_an__e_nein</incoming></endEvent>
    <exclusiveGateway id="gw_sys" name="Exchange Server?" default="f_gw_sys__st_set_o"><incoming>f_gw_an__gw_sys</incoming><outgoing>f_gw_sys__st_set</outgoing><outgoing>f_gw_sys__st_set_o</outgoing></exclusiveGateway>
    <serviceTask id="st_set" name="Kontingent setzen"><documentation>set-mailbox-quota auf dem Exchange Server am Zielpostfach (Anmeldename), mit den Grenzen der Quelle, wenn sie grösser ist.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange_onprem" operation="set-mailbox-quota" parameters="{&quot;Identity&quot;: &quot;=ziel&quot;, &quot;IssueWarningQuota&quot;: &quot;={qs: (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), gross: qs != null and zs != null and qs / 1024 &gt; zs / 1024, v: if gross then (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].IssueWarningQuota else pfQuelle.IssueWarningQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].IssueWarningQuota else pfQuelle.IssueWarningQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].IssueWarningQuota else pfQuelle.IssueWarningQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))) else (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].IssueWarningQuota else pfZiel.IssueWarningQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].IssueWarningQuota else pfZiel.IssueWarningQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].IssueWarningQuota else pfZiel.IssueWarningQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), r: if v = null then (if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].IssueWarningQuota else pfZiel.IssueWarningQuota) else if v &gt;= 1000000000000000000 then \&quot;Unlimited\&quot; else string(v) + \&quot;B\&quot;}.r&quot;, &quot;ProhibitSendQuota&quot;: &quot;={qs: (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), gross: qs != null and zs != null and qs / 1024 &gt; zs / 1024, v: if gross then (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendQuota else pfQuelle.ProhibitSendQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendQuota else pfQuelle.ProhibitSendQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendQuota else pfQuelle.ProhibitSendQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))) else (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendQuota else pfZiel.ProhibitSendQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendQuota else pfZiel.ProhibitSendQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendQuota else pfZiel.ProhibitSendQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), r: if v = null then (if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendQuota else pfZiel.ProhibitSendQuota) else if v &gt;= 1000000000000000000 then \&quot;Unlimited\&quot; else string(v) + \&quot;B\&quot;}.r&quot;, &quot;ProhibitSendReceiveQuota&quot;: &quot;={qs: (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), gross: qs != null and zs != null and qs / 1024 &gt; zs / 1024, v: if gross then (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))) else (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), r: if v = null then (if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota) else if v &gt;= 1000000000000000000 then \&quot;Unlimited\&quot; else string(v) + \&quot;B\&quot;}.r&quot;, &quot;UseDatabaseQuotaDefaults&quot;: &quot;={qs: (if ((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfQuelle.UseDatabaseQuotaDefaults = true then dbQuelle[1].ProhibitSendReceiveQuota else pfQuelle.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if ((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)) = null then null else if contains(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string((if pfZiel.UseDatabaseQuotaDefaults = true then dbZiel[1].ProhibitSendReceiveQuota else pfZiel.ProhibitSendReceiveQuota)), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&qu