    <serviceTask id="st_set_o" name="Kontingent setzen (Online)"><documentation>set-mailbox-quota in Exchange Online am Zielpostfach (Guid). Exchange Online kennt keine Datenbankvorgaben; ein Wert über der Grenze der Lizenz wird abgewiesen und zum Incident.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="set-mailbox-quota" parameters="{&quot;Identity&quot;: &quot;=string(pfZiel.Guid)&quot;, &quot;IssueWarningQuota&quot;: &quot;={qs: (if (pfQuelle.ProhibitSendReceiveQuota) = null then null else if contains(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if (pfZiel.ProhibitSendReceiveQuota) = null then null else if contains(string(pfZiel.ProhibitSendReceiveQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfZiel.ProhibitSendReceiveQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), gross: qs != null and zs != null and qs / 1024 &gt; zs / 1024, v: if gross then (if (pfQuelle.IssueWarningQuota) = null then null else if contains(string(pfQuelle.IssueWarningQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfQuelle.IssueWarningQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))) else (if (pfZiel.IssueWarningQuota) = null then null else if contains(string(pfZiel.IssueWarningQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfZiel.IssueWarningQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), r: if v = null then pfZiel.IssueWarningQuota else if v &gt;= 1000000000000000000 then \&quot;Unlimited\&quot; else string(v) + \&quot;B\&quot;}.r&quot;, &quot;ProhibitSendQuota&quot;: &quot;={qs: (if (pfQuelle.ProhibitSendReceiveQuota) = null then null else if contains(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), zs: (if (pfZiel.ProhibitSendReceiveQuota) = null then null else if contains(string(pfZiel.ProhibitSendReceiveQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfZiel.ProhibitSendReceiveQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), gross: qs != null and zs != null and qs / 1024 &gt; zs / 1024, v: if gross then (if (pfQuelle.ProhibitSendQuota) = null then null else if contains(string(pfQuelle.ProhibitSendQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfQuelle.ProhibitSendQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))) else (if (pfZiel.ProhibitSendQuota) = null then null else if contains(string(pfZiel.ProhibitSendQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfZiel.ProhibitSendQuota), \&quot;^.*\\\\(([0-9.,' ]+) bytes\\\\).*$\&quot;, \&quot;$1\&quot;), \&quot;[^0-9]\&quot;, \&quot;\&quot;))), r: if v = null then pfZiel.ProhibitSendQuota else if v &gt;= 1000000000000000000 then \&quot;Unlimited\&quot; else string(v) + \&quot;B\&quot;}.r&quot;, &quot;ProhibitSendReceiveQuota&quot;: &quot;={qs: (if (pfQuelle.ProhibitSendReceiveQuota) = null then null else if contains(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;Unlimited\&quot;) then 1000000000000000000 else number(replace(replace(string(pfQuelle.ProhibitSendReceiveQuota), \&quot;^.*\\\\(([0-9.,' ]+)