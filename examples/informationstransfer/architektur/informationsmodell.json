{
  "name": "Informationstransfer",
  "documentation": "Informationsmodell des Beispiels informationstransfer: ein Transferauftrag zwischen zwei Konten des Active Directory und was dabei übergeht – Postfach (Adresse, Inhalt, Kontingent), Cloud-Konto (Hard Match), Gruppenmitgliedschaften, Rufnummer und Kürzel. Konten und Postfächer sind personenbezogen und im Prozess versiegelt; die Engine kennt nur Wahrheitswerte über sie und Objekt-IDs.",
  "classes": [
    {
      "id": "cls-szenario",
      "name": "Szenario",
      "stereotype": "enumeration",
      "attributes": [],
      "documentation": "Wofür übertragen wird: die Variante des Produkts.",
      "literals": [
        "internalisierung",
        "externalisierung",
        "amtswechsel",
        "abteilungswechsel"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "cls-transferauftrag",
      "name": "Transferauftrag",
      "stereotype": "businessObject",
      "documentation": "Eine Position des Produkts it-informationstransfer: Szenario, die gewählten Optionen und die beiden Konten (als Anmeldenamen, versiegelt). Gehalten von der Instanz von proc_it_transfer; ihr Protokoll nennt das Ergebnis je Ressource.",
      "attributes": [
        {
          "name": "auftrag",
          "type": "string",
          "multiplicity": "1",
          "documentation": "orderId/positionId."
        },
        {
          "name": "szenario",
          "type": "Szenario",
          "multiplicity": "1"
        },
        {
          "name": "optionen",
          "type": "string",
          "multiplicity": "1",
          "documentation": "Die Ja/Nein-Antworten des Bestellformulars."
        },
        {
          "name": "protokoll",
          "type": "string",
          "multiplicity": "0..1"
        }
      ],
      "identity": [
        "auftrag"
      ],
      "x": 300,
      "y": 40,
      "lifecycle": {
        "states": [
          {
            "name": "Bestellt",
            "x": 40,
            "y": 40,
            "initial": true
          },
          {
            "name": "Geprüft",
            "x": 200,
            "y": 40
          },
          {
            "name": "Entschieden",
            "x": 360,
            "y": 40
          },
          {
            "name": "Ausgeführt",
            "x": 520,
            "y": 40,
            "final": true
          },
          {
            "name": "Abgelehnt",
            "x": 680,
            "y": 40,
            "final": true
          }
        ],
        "transitions": [
          {
            "id": "t-transferauftrag-1",
            "from": "Bestellt",
            "to": "Geprüft"
          },
          {
            "id": "t-transferauftrag-2",
            "from": "Geprüft",
            "to": "Entschieden"
          },
          {
            "id": "t-transferauftrag-3",
            "from": "Geprüft",
            "to": "Abgelehnt"
          },
          {
            "id": "t-transferauftrag-4",
            "from": "Entschieden",
            "to": "Abgelehnt"
          },
          {
            "id": "t-transferauftrag-5",
            "from": "Entschieden",
            "to": "Ausgeführt"
          }
        ]
      }
    },
