        <bpmndi:BPMNLabel><dc:Bounds x="1245" y="180" width="30" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f8" bpmnElement="f8">
        <di:waypoint x="1400" y="200"/>
        <di:waypoint x="1475" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f9" bpmnElement="f9">
        <di:waypoint x="1525" y="200"/>
        <di:waypoint x="1600" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f10" bpmnElement="f10">
        <di:waypoint x="1700" y="200"/>
        <di:waypoint x="1750" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f11" bpmnElement="f11">
        <di:waypoint x="1850" y="200"/>
