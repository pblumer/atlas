<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopQuotaRichtlinie" name="SpopQuotaRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_siteGefunden" name="siteGefunden"><variable id="v_siteGefunden" name="siteGefunden" typeRef="boolean"/></inputData>
<inputData id="id_siteTyp" name="siteTyp"><variable id="v_siteTyp" name="siteTyp" typeRef="string"/></inputData>
<inputData id="id_neueQuotaMb" name="neueQuotaMb"><variable id="v_neueQuotaMb" name="neueQuotaMb" typeRef="number"/></inputData>
<inputData id="id_erhoehungMb" name="erhoehungMb"><variable id="v_erhoehungMb" name="erhoehungMb" typeRef="number"/></inputData>
<inputData id="id_begruendungVorhanden" name="begruendungVorhanden"><variable id="v_begruendungVorhanden" name="begruendungVorhanden" typeRef="boolean"/></inputData>
<decision id="SpopQuotaRichtlinie" name="Quota-Richtlinie (GF-002)"><description>Ersetzt quota_limits.rego und approval.rego. Annahmen: Maximum je Site-Typ wie in der Site-Richtlinie (51200 MB für Hermes, Communication, Publishing; 10240 MB sonst); darüber hinaus gilt das Zusatzprodukt Speicherplatzerweiterung; Vier-Augen-Prinzip, wenn die Erhöhung mehr als 5120 MB beträgt.</description><variable id="v_SpopQuotaRichtlinie" name="SpopQuotaRichtlinie"/>
<informationRequirement id="ir_siteGefunden"><requiredInput href="#id_siteGefunden"/></informationRequirement><informationRequirement id="ir_siteTyp"><requiredInput href="#id_siteTyp"/></informationRequirement><informationRequirement id="ir_neueQuotaMb"><requiredInput href="#id_neueQuotaMb"/></informationRequirement><informationRequirement id="ir_erhoehungMb"><requiredInput href="#id_erhoehungMb"/></informationRequirement><informationRequirement id="ir_begruendungVorhanden"><requiredInput href="#id_begruendungVorhanden"/></informationRequirement>
<decisionTable id="dt_SpopQuotaRichtlinie" hitPolicy="FIRST">
<input id="i0" label="siteGefunden"><inputExpression id="ie0" typeRef="boolean"><text>siteGefunden</text></inputExpression></input>
<input id="i1" label="siteTyp"><inputExpression id="ie1" typeRef="string"><text>siteTyp</text></inputExpression></input>
<input id="i2" label="neueQuotaMb"><inputExpression id="ie2" typeRef="number"><text>neueQuotaMb</text></inputExpression></input>
<input id="i3" label="erhoehungMb"><inputExpression id="ie3" typeRef="number"><text>erhoehungMb</text></inputExpression></input>
<input id="i4" label="begruendungVorhanden"><inputExpression id="ie4" typeRef="boolean"><text>begruendungVorhanden</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><inputEntry id="r1i4"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>"Die Site wurde nicht gefunden."</text></outputEntry></rule>
<rule id="r2"><inputEntry id="r2i0"><text>-</text></inputEntry><inputEntry id="r2i1"><text>-</text></inputEntry><inputEntry id="r2i2"><text>-</text></inputEntry><inputEntry id="r2i3"><text>-</text></inputEntry><inputEntry id="r2i4"><text>false</text></inputEntry><outputEntry id="r2o0"><text>false</text></outputEntry><outputEntry id="r2o1"><text>false</text></outputEntry><outputEntry id="r2o2"><text>"Die Begründung fehlt (mindestens 10 Zeichen)."</text></outputEntry></rule>
<rule id="r3"><inputEntry id="r3i0"><text>-</text></inputEntry><inputEntry id="r3i1"><text>-</text></inputEntry><inputEntry id="r3i2"><text>-</text></inputEntry><inputEntry id="r3i3"><text>&lt;= 0</text></inputEntry><inputEntry id="r3i4"><text>-</text></inputEntry><outputEntry id="r3o0"><text>false</text></outputEntry><outputEntry id="r3o1"><text>false</text></outputEntry><outputEntry id="r3o2"><text>"Die neue Quota muss grösser als die aktuelle sein."</text></outputEntry></rule>
<rule id="r4"><inputEntry id="r4i0"><text>-</text></inputEntry><inputEntry id="r4i1"><text>"hermes","communication","publishing"</text></inputEntry><inputEntry id="r4i2"><text>&gt; 51200</text></inputEntry><inputEntry id="r4i3"><text>-</text></inputEntry><inputEntry id="r4i4"><text>-</text></inputEntry><outputEntry id="r4o0"><text>false</text></outputEntry><outputEntry id="r4o1"><text>false</text></outputEntry><outputEntry id="r4o2"><text>"Über dem Maximum des Site-Typs (51200 MB); mehr Speicher über die Speicherplatzerweiterung."</text></outputEntry></rule>
<rule id="r5"><inputEntry id="r5i0"><text>-</text></inputEntry><inputEntry id="r5i1"><text>"teamsite-classic","teamsite-modern","wiki"</text></inputEntry><inputEntry id="r5i2"><text>&gt; 10240</text></inputEntry><inputEntry id="r5i3"><text>-</text></inputEntry><inputEntry id="r5i4"><text>-</text></inputEntry><outputEntry id="r5o0"><text>false</text></outputEntry><outputEntry id="r5o1"><text>false</text></outputEntry><outputEntry id="r5o2"><text>"Über dem Maximum des Site-Typs (10240 MB); mehr Speicher über die Speicherplatzerweiterung."</text></outputEntry></rule>
<rule id="r6"><inputEntry id="r6i0"><text>-</text></inputEntry><inputEntry id="r6i1"><text>-</text></inputEntry><inputEntry id="r6i2"><text>-</text></inputEntry><inputEntry id="r6i3"><text>&gt; 5120</text></inputEntry><inputEntry id="r6i4"><text>-</text></inputEntry><outputEntry id="r6o0"><text>true</text></outputEntry><outputEntry id="r6o1"><text>true</text></outputEntry><outputEntry id="r6o2"><text>"Erhöhung um mehr als 5120 MB: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r7"><inputEntry id="r7i0"><text>-</text></inputEntry><inputEntry id="r7i1"><text>-</text></inputEntry><inputEntry id="r7i2"><text>-</text></inputEntry><inputEntry id="r7i3"><text>-</text></inputEntry><inputEntry id="r7i4"><text>-</text></inputEntry><outputEntry id="r7o0"><text>true</text></outputEntry><outputEntry id="r7o1"><text>false</text></outputEntry><outputEntry id="r7o2"><text>"Erhöhung bis 5120 MB: ohne Freigabe."</text></outputEntry></rule>
</decisionTable></decision></definitions>
