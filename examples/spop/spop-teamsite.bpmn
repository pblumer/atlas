<sequenceFlow id="a_f_4e_nein" name="Nein" sourceRef="a_gw_4e" targetRef="a_join"/>
<sequenceFlow id="a_f_prep" sourceRef="a_prep" targetRef="a_ut"/>
<sequenceFlow id="a_f_ut" sourceRef="a_ut" targetRef="a_gw_fr"/>
<sequenceFlow id="a_f_fr_ja" name="Ja" sourceRef="a_gw_fr" targetRef="a_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="a_f_fr_nein" name="Nein" sourceRef="a_gw_fr" targetRef="a_rej2"/>
<sequenceFlow id="a_f_rej2" sourceRef="a_rej2" targetRef="a_end_rej2"/>
<sequenceFlow id="a_f1" sourceRef="s_neu" targetRef="a_regel"/>
<sequenceFlow id="a_f3" sourceRef="a_join" targetRef="a_owner"/>
<sequenceFlow id="a_f4" sourceRef="a_owner" targetRef="a_site"/>
<sequenceFlow id="a_f5" sourceRef="a_site" targetRef="a_par"/>
<sequenceFlow id="a_f6" sourceRef="a_par" targetRef="a_grp"/>
<sequenceFlow id="a_f7" sourceRef="a_grp" targetRef="a_rechte"/>
<sequenceFlow id="a_f8" sourceRef="a_rechte" targetRef="a_parj"/>
<sequenceFlow id="a_f9" sourceRef="a_par" targetRef="a_quota"/>
<sequenceFlow id="a_f10" sourceRef="a_quota" targetRef="a_parj"/>
<sequenceFlow id="a_f11" sourceRef="a_par" targetRef="a_feat"/>
<sequenceFlow id="a_f12" sourceRef="a_feat" targetRef="a_parj"/>
<sequenceFlow id="a_f13" sourceRef="a_parj" targetRef="a_reg"/>
