<sequenceFlow id="t_f_ok_ja" name="Ja" sourceRef="t_gw_ok" targetRef="t_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="t_f_ok_nein" name="Nein" sourceRef="t_gw_ok" targetRef="t_rej1"/>
<sequenceFlow id="t_f_rej1" sourceRef="t_rej1" targetRef="t_end_rej1"/>
<sequenceFlow id="t_f_4e_ja" name="Ja" sourceRef="t_gw_4e" targetRef="t_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="t_f_4e_nein" name="Nein" sourceRef="t_gw_4e" targetRef="t_join"/>
<sequenceFlow id="t_f_prep" sourceRef="t_prep" targetRef="t_ut"/>
<sequenceFlow id="t_f_ut" sourceRef="t_ut" targetRef="t_gw_fr"/>
