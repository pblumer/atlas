<sequenceFlow id="u_f_fr_nein" name="Nein" sourceRef="u_gw_fr" targetRef="u_rej2"/>
<sequenceFlow id="u_f_rej2" sourceRef="u_rej2" targetRef="u_end_rej2"/>
<sequenceFlow id="u_fx0" sourceRef="u_apply" targetRef="u_bill"/>
<sequenceFlow id="u_f10" sourceRef="u_join" targetRef="u_apply"/>
<sequenceFlow id="u_f11" sourceRef="u_bill" targetRef="u_info"/>
<sequenceFlow id="u_f12" sourceRef="u_info" targetRef="u_end"/>
</subProcess>
<intermediateCatchEvent id="c_rechte" name="Berechtigungsänderung angefragt"><documentation>Aktion berechtigungen-aendern (Formular spop-berechtigungen-aendern: neuerOwnerUpn, neueMemberUpns, begruendung).</documentation><incoming>w_c5</incoming><outgoing>w_s5</outgoing><messageEventDefinition messageRef="m_rechte"/></intermediateCatchEvent>
<subProcess id="sp_rechte" name="Berechtigungen ändern"><documentation>Aktion berechtigungen-aendern: setzt Owner und Members der Site neu; anzugeben ist der vollständige neue Stand. Richtlinie SpopAenderungRichtlinie mit aenderung berechtigungen: Owner-Wechsel bei Hermes, Communication und Publishing mit Vier-Augen-Freigabe. Die Ausführung schreibt nur die geänderten Felder in die lokale Variable neu (Ergebnisse innerer Aufgaben bleiben im Subprozess, ADR-0074); das Output-Mapping setzt sie beim Abschluss mit context merge in den Stand des Strangs ein. Endet der Subprozess mit einer Ablehnung, ist neu leer und der Stand bleibt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=if neu = null then gruppen else context merge([gruppen, neu])" target="gruppen"/></zeebe:ioMapping></extensionElements><incoming>w_s5</incoming><outgoing>w_z5</outgoing><startEvent id="b_s"><outgoing>b_f0</outgoing></startEvent>
<serviceTask id="b_read" name="Gruppen und neuen Owner lesen (S2)"><documentation>Simuliert apsbw_sharepoint_group read und apsbw_ad_user read für den neuen Owner (ownerExistiert). Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ gefunden: site != null, owner: if gruppen = null then null else gruppen.owner, mitglieder: if gruppen = null then "" else (if gruppen.mitglieder = null then "" else gruppen.mitglieder), ownerExistiert: true }' resultVariable="aktuell"/></extensionElements><incoming>b_f0</incoming><outgoing>b_f1</outgoing></serviceTask>
<businessRuleTask id="b_regel" name="Änderungs-Richtlinie prüfen"><documentation>DMN SpopAenderungRichtlinie mit aenderung berechtigungen.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopAenderungRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="berechtigungen"' target="aenderung"/><zeebe:input source='=neuerOwnerUpn != null and matches(neuerOwnerUpn, "^[^@ ]+@[^@ ]+[.][^@ ]+$") and aktuell.ownerExistiert = true' target="gueltig"/><zeebe:input source='=aktuell.owner != null and neuerOwnerUpn != null and lower case(neuerOwnerUpn) = lower case(aktuell.owner) and (if neueMemberUpns = null then "" else neueMemberUpns) = aktuell.mitglieder' target="unveraendert"/><zeebe:input source='=if site = null then "" else site.typ' target="siteTyp"/><zeebe:input source="=aktuell.owner = null or neuerOwnerUpn = null or lower case(neuerOwnerUpn) != lower case(aktuell.owner)" target="ownerWechsel"/></zeebe:ioMapping></extensionElements><incoming>b_f1</incoming><outgoing>b_f2</outgoing></businessRuleTask>
<exclusiveGateway id="b_gw_ok" name="Zulässig?" default="b_f_ok_nein"><incoming>b_f2</incoming><outgoing>b_f_ok_ja</outgoing><outgoing>b_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="b_gw_4e" name="Vier-Augen nötig?" default="b_f_4e_nein"><incoming>b_f_ok_ja</incoming><outgoing>b_f_4e_ja</outgoing><outgoing>b_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="b_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="rejected"/></extensionElements><incoming>b_f_ok_nein</incoming><outgoing>b_f_rej1</outgoing></sendTask>
<endEvent id="b_end_rej1" name="Abgelehnt: Richtlinie"><incoming>b_f_rej1</incoming></endEvent>
<scriptTask id="b_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Berechtigungen ändern\nSite: " + site.url + "\nOwner bisher: " + aktuell.owner + "\nNeu: " + neuerOwnerUpn + "\nMembers neu: " + (if neueMemberUpns = null then "" else neueMemberUpns) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>b_f_4e_ja</incoming><outgoing>b_f_prep</outgoing></scriptTask>
<userTask id="b_ut" name="Owner-Wechsel freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>b_f_prep</incoming><outgoing>b_f_ut</outgoing></userTask>
<exclusiveGateway id="b_gw_fr" name="Freigegeben?" default="b_f_fr_nein"><incoming>b_f_ut</incoming><outgoing>b_f_fr_ja</outgoing><outgoing>b_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="b_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="rejected"/></extensionElements><incoming>b_f_fr_nein</incoming><outgoing>b_f_rej2</outgoing></sendTask>
<endEvent id="b_end_rej2" name="Abgelehnt: Freigabe"><incoming>b_f_rej2</incoming></endEvent>
<exclusiveGateway id="b_join"><incoming>b_f_4e_nein</incoming><incoming>b_f_fr_ja</incoming><outgoing>b_f10</outgoing></exclusiveGateway>
<serviceTask id="b_apply" name="Gruppen aktualisieren (S2–S5)"><documentation>Simuliert apsbw_sharepoint_group add_member und remove_member für die Owner- und die Member-Gruppe. Schreibt neu mit Owner und Members sowie ownerVorher und mitgliederVorher für einen Rollback.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ owner: neuerOwnerUpn, mitglieder: if neueMemberUpns = null then "" else neueMemberUpns, ownerVorher: gruppen.owner, mitgliederVorher: gruppen.mitglieder }' resultVariable="neu"/></extensionElements><incoming>b_f10</incoming><outgoing>b_f11</outgoing></serviceTask>
<sendTask id="b_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="completed"/></extensionElements><incoming>b_f11</incoming><outgoing>b_f12</outgoing></sendTask>
<endEvent id="b_end" name="Berechtigungen geändert"><incoming>b_f12</incoming></endEvent>
<sequenceFlow id="b_f0" sourceRef="b_s" targetRef="b_read"/>
<sequenceFlow id="b_f1" sourceRef="b_read" targetRef="b_regel"/>
<sequenceFlow id="b_f2" sourceRef="b_regel" targetRef="b_gw_ok"/>
<sequenceFlow id="b_f_ok_ja" name="Ja" sourceRef="b_gw_ok" targetRef="b_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_ok_nein" name="Nein" sourceRef="b_gw_ok" targetRef="b_rej1"/>
<sequenceFlow id="b_f_rej1" sourceRef="b_rej1" targetRef="b_end_rej1"/>
<sequenceFlow id="b_f_4e_ja" name="Ja" sourceRef="b_gw_4e" targetRef="b_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_4e_nein" name="Nein" sourceRef="b_gw_4e" targetRef="b_join"/>
<sequenceFlow id="b_f_prep" sourceRef="b_prep" targetRef="b_ut"/>
<sequenceFlow id="b_f_ut" sourceRef="b_ut" targetRef="b_gw_fr"/>
<sequenceFlow id="b_f_fr_ja" name="Ja" sourceRef="b_gw_fr" targetRef="b_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_fr_nein" name="Nein" sourceRef="b_gw_fr" targetRef="b_rej2"/>
<sequenceFlow id="b_f_rej2" sourceRef="b_rej2" targetRef="b_end_rej2"/>
<sequenceFlow id="b_f10" sourceRef="b_join" targetRef="b_apply"/>
<sequenceFlow id="b_f11" sourceRef="b_apply" targetRef="b_info"/>
<sequenceFlow id="b_f12" sourceRef="b_info" targetRef="b_end"/>
</subProcess>
<exclusiveGateway id="j_zurueck"><documentation>Gemeinsamer Rückweg: Jeder Änderungs-Subprozess unterhalb mündet hier; von hier geht der Strang zurück zum Warten.</documentation><incoming>w_z0</incoming><incoming>w_z1</incoming><incoming>w_z2</incoming><incoming>w_z3</incoming><incoming>w_z4</incoming><incoming>w_z5</incoming><outgoing>w_back</outgoing></exclusiveGateway>
<subProcess id="sp_rueckgabe" name="Rückgabe" triggeredByEvent="true"><documentation>Unterbrechender Ereignis-Subprozess (ADR-0082) auf der Nachricht spop.teamsite.rueckgabe (Operation deprovision, Formular spop-teamsite-rueckgabe: grund). Er unterbricht den Strang, wo immer er steht: beim Warten, in einer Änderung oder in einer wartenden Freigabe. Entfernt die externen Zugriffe, löscht die Site und beendet die Verrechnung der Site und ihrer Zusatzleistungen.</documentation><startEvent id="rv_s" name="Rückgabe angefordert"><outgoing>rv_f1</outgoing><messageEventDefinition messageRef="m_rueckgabe"/></startEvent>
<serviceTask id="rv_extern" name="Externe Zugriffe entfernen"><documentation>Simuliert apsbw_sharepoint_externaluser remove für jeden Eintrag in externe, der Liste der angenommenen Einladungen.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ siteUrl: site.url, entfernt: if externe = null then [] else externe }" resultVariable="externEntfernt"/></extensionElements><incoming>rv_f1</incoming><outgoing>rv_f2</outgoing></serviceTask>
<serviceTask id="rv_delete" name="Site löschen"><documentation>Simuliert apsbw_sharepoint_site delete (Worker sharepointserver: delete-site, Papierkorb).</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ siteUrl: site.url, status: "im Papierkorb" }' resultVariable="rueckbau"/></extensionElements><incoming>rv_f2</incoming><outgoing>rv_f3</outgoing></serviceTask>
<serviceTask id="rv_bill" name="Verrechnung beenden"><documentation>Simuliert das Beenden der wiederkehrenden Verrechnung: Site-Material, Speicherplatzerweiterung und Zusatzleistungen.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ material: site.material, siteUrl: site.url, zusatz: zusatz, quota: quota, status: "beendet" }' resultVariable="verrechnung"/></extensionElements><incoming>rv_f3</incoming><outgoing>rv_f4</outgoing></serviceTask>
<serviceTask id="rv_info" name="Rückgabe melden"><documentation>Meldet die Rückgabe über die Positionsroute (status returned); damit endet das Recht im Bestand. Braucht das Secret "atlas" mit einem API-Token der Rolle operator; die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE. Eine Position mit Variante heisst itemId#variantId; das # wird als %23 kodiert, sonst schneidet es die URL ab.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>rv_f4</incoming><outgoing>rv_f5</outgoing></serviceTask>
<endEvent id="rv_end" name="Site zurückgegeben"><incoming>rv_f5</incoming></endEvent>
<sequenceFlow id="rv_f1" sourceRef="rv_s" targetRef="rv_extern"/>
<sequenceFlow id="rv_f2" sourceRef="rv_extern" targetRef="rv_delete"/>
<sequenceFlow id="rv_f3" sourceRef="rv_delete" targetRef="rv_bill"/>
<sequenceFlow id="rv_f4" sourceRef="rv_bill" targetRef="rv_info"/>
<sequenceFlow id="rv_f5" sourceRef="rv_info" targetRef="rv_end"/>
</subProcess>
<startEvent id="r_start" name="Rückgabe ohne laufenden Strang"><documentation>Rückfallebene wie im Referenzmodell: Eine Rückgabe für eine Position ohne laufenden Strang startet hier. Der Katalog verlangt für per-position diesen Nachrichtenstart.</documentation><outgoing>r_f1</outgoing><messageEventDefinition messageRef="m_rueckgabe"/></startEvent>
<scriptTask id="r_site" name="Site ermitteln"><documentation>Bildet die Site-URL aus der Konfiguration der Position nach demselben Schema wie die Bereitstellung (Annahme: der Katalog liefert amtKuerzel und kurzname der Position mit). Eine spätere URL-Änderung kennt diese Ebene nicht.</documentation><extensionElements><zeebe:script expression='={ url: "/sites/" + lower case(amtKuerzel) + "-" + kurzname }' resultVariable="site"/></extensionElements><incoming>r_f1</incoming><outgoing>r_f2</outgoing></scriptTask>
<serviceTask id="r_delete" name="Site löschen"><documentation>Simuliert apsbw_sharepoint_site delete (Worker sharepointserver: delete-site, Papierkorb).</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ siteUrl: site.url, status: "im Papierkorb" }' resultVariable="rueckbau"/></extensionElements><incoming>r_f2</incoming><outgoing>r_f3</outgoing></serviceTask>
<serviceTask id="r_bill" name="Verrechnung beenden"><documentation>Simuliert das Beenden der wiederkehrenden Verrechnung der Site und ihrer Zusatzleistungen.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ siteUrl: site.url, status: "beendet" }' resultVariable="verrechnung"/></extensionElements><incoming>r_f3</incoming><outgoing>r_f4</outgoing></serviceTask>
<serviceTask id="r_info" name="Rückgabe melden"><documentation>Meldet die Rückgabe über die Positionsroute (status returned). Braucht das Secret "atlas" mit einem API-Token der Rolle operator; die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE. Eine Position mit Variante heisst itemId#variantId; das # wird als %23 kodiert, sonst schneidet es die URL ab.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>r_f4</incoming><outgoing>r_f5</outgoing></serviceTask>
<endEvent id="r_end" name="Site zurückgegeben"><incoming>r_f5</incoming></endEvent>
