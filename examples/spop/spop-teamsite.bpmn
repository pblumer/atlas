<sequenceFlow id="x_f17" sourceRef="x_ablauf" targetRef="x_widerruf"/>
<sequenceFlow id="x_f18" sourceRef="x_widerruf" targetRef="x_info2"/>
<sequenceFlow id="x_f19" sourceRef="x_info2" targetRef="x_end2"/>
</subProcess>
<intermediateCatchEvent id="c_quota" name="Speichererweiterung angefragt"><documentation>GF-002: Aktion quota-erhoehen, im Shop «Speicherplatz erweitern» (Formular spop-quota-erhoehung: menge = Zusatzspeicher in GB, begruendung).</documentation><incoming>w_c0</incoming><outgoing>w_s0</outgoing><messageEventDefinition messageRef="m_quota"/></intermediateCatchEvent>
<subProcess id="sp_quota" name="Speicherplatz erweitern (GF-002)"><documentation>GF-002 SP OnPrem Quota-Erhöhung als Speicherplatzerweiterung (Material 540007510, Verrechnung pro GB und Monat): Die Aktion nennt die neue Gesamtmenge Zusatzspeicher in GB. Die Site behält ihre inbegriffene Quota (quota.basisMb); die gesetzte Quota ist basisMb + zusatzGb × 1024. Richtlinie SpopZusatzRichtlinie mit dem Produktschlüssel spop-speicher: 1 bis 500 GB, Vier-Augen-Prinzip über 100 GB. Die Ausführung schreibt nur die geänderten Felder in die lokale Variable neu (Ergebnisse innerer Aufgaben bleiben im Subprozess, ADR-0074); das Output-Mapping setzt sie beim Abschluss mit context merge in den Stand des Strangs ein. Endet der Subprozess mit einer Ablehnung, ist neu leer und der Stand bleibt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=if neu = null then quota else context merge([quota, neu])" target="quota"/></zeebe:ioMapping></extensionElements><incoming>w_s0</incoming><outgoing>w_z0</outgoing><startEvent id="q_s"><outgoing>q_f0</outgoing></startEvent>
<serviceTask id="q_read" name="Site und Speicher lesen (S1)"><documentation>Simuliert apsbw_sharepoint_site read und apsbw_sharepoint_quota read aus dem Stand des Strangs (site, quota). Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ gefunden: site != null, basisMb: if quota.basisMb = null then quota.storageMb else quota.basisMb, gb: if quota.zusatzGb = null then 0 else quota.zusatzGb }" resultVariable="aktuell"/></extensionElements><incoming>q_f0</incoming><outgoing>q_f1</outgoing></serviceTask>
<businessRuleTask id="q_regel" name="Speicher-Richtlinie prüfen (S3)"><documentation>DMN SpopZusatzRichtlinie mit dem Produktschlüssel spop-speicher: zulässige Menge, Material 540007510, Vier-Augen-Prinzip über 100 GB.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopZusatzRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="spop-speicher"' target="produkt"/><zeebe:input source="=if menge = null then 0 else number(string(menge))" target="menge"/><zeebe:input source="=(if menge = null then 0 else number(string(menge))) = aktuell.gb" target="unveraendert"/></zeebe:ioMapping></extensionElements><incoming>q_f1</incoming><outgoing>q_f2</outgoing></businessRuleTask>
<exclusiveGateway id="q_gw_ok" name="Zulässig?" default="q_f_ok_nein"><incoming>q_f2</incoming><outgoing>q_f_ok_ja</outgoing><outgoing>q_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="q_gw_4e" name="Vier-Augen nötig?" default="q_f_4e_nein"><incoming>q_f_ok_ja</incoming><outgoing>q_f_4e_ja</outgoing><outgoing>q_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="q_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion quota-erhoehen mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="quota-erhoehen" outcome="rejected"/></extensionElements><incoming>q_f_ok_nein</incoming><outgoing>q_f_rej1</outgoing></sendTask>
<endEvent id="q_end_rej1" name="Abgelehnt: Richtlinie"><incoming>q_f_rej1</incoming></endEvent>
<scriptTask id="q_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Speicherplatzerweiterung (GF-002, Material " + regel.material + ")\nSite: " + site.url + " (" + site.typ + ")\nZusatzspeicher bisher: " + string(aktuell.gb) + " GB\nNeu: " + string(menge) + " GB" + (if begruendung = null then "" else "\nBegründung: " + begruendung) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>q_f_4e_ja</incoming><outgoing>q_f_prep</outgoing></scriptTask>
<userTask id="q_ut" name="Speichererweiterung freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>q_f_prep</incoming><outgoing>q_f_ut</outgoing></userTask>
<exclusiveGateway id="q_gw_fr" name="Freigegeben?" default="q_f_fr_nein"><incoming>q_f_ut</incoming><outgoing>q_f_fr_ja</outgoing><outgoing>q_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="q_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion quota-erhoehen mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="quota-erhoehen" outcome="rejected"/></extensionElements><incoming>q_f_fr_nein</incoming><outgoing>q_f_rej2</outgoing></sendTask>
<endEvent id="q_end_rej2" name="Abgelehnt: Freigabe"><incoming>q_f_rej2</incoming></endEvent>
<exclusiveGateway id="q_join"><incoming>q_f_4e_nein</incoming><incoming>q_f_fr_ja</incoming><outgoing>q_f10</outgoing></exclusiveGateway>
<serviceTask id="q_apply" name="Speicher setzen (S2)"><documentation>Simuliert apsbw_sharepoint_quota apply (Worker sharepointserver: set-site-quota) mit basisMb + zusatzGb × 1024 und die Umstellung der Verrechnung auf zusatzGb × Material 540007510; zusatzGbVorher bleibt für einen Rollback erhalten.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ zusatzGb: number(string(menge)), zusatzGbVorher: aktuell.gb, storageMb: aktuell.basisMb + number(string(menge)) * 1024, material: regel.material }" resultVariable="neu"/></extensionElements><incoming>q_f10</incoming><outgoing>q_f11</outgoing></serviceTask>
<sendTask id="q_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion quota-erhoehen mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="quota-erhoehen" outcome="completed"/></extensionElements><incoming>q_f11</incoming><outgoing>q_f12</outgoing></sendTask>
<endEvent id="q_end" name="Speicher erweitert"><incoming>q_f12</incoming></endEvent>
<sequenceFlow id="q_f0" sourceRef="q_s" targetRef="q_read"/>
<sequenceFlow id="q_f1" sourceRef="q_read" targetRef="q_regel"/>
<sequenceFlow id="q_f2" sourceRef="q_regel" targetRef="q_gw_ok"/>
<sequenceFlow id="q_f_ok_ja" name="Ja" sourceRef="q_gw_ok" targetRef="q_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="q_f_ok_nein" name="Nein" sourceRef="q_gw_ok" targetRef="q_rej1"/>
<sequenceFlow id="q_f_rej1" sourceRef="q_rej1" targetRef="q_end_rej1"/>
<sequenceFlow id="q_f_4e_ja" name="Ja" sourceRef="q_gw_4e" targetRef="q_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="q_f_4e_nein" name="Nein" sourceRef="q_gw_4e" targetRef="q_join"/>
<sequenceFlow id="q_f_prep" sourceRef="q_prep" targetRef="q_ut"/>
<sequenceFlow id="q_f_ut" sourceRef="q_ut" targetRef="q_gw_fr"/>
<sequenceFlow id="q_f_fr_ja" name="Ja" sourceRef="q_gw_fr" targetRef="q_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="q_f_fr_nein" name="Nein" sourceRef="q_gw_fr" targetRef="q_rej2"/>
<sequenceFlow id="q_f_rej2" sourceRef="q_rej2" targetRef="q_end_rej2"/>
<sequenceFlow id="q_f10" sourceRef="q_join" targetRef="q_apply"/>
<sequenceFlow id="q_f11" sourceRef="q_apply" targetRef="q_info"/>
<sequenceFlow id="q_f12" sourceRef="q_info" targetRef="q_end"/>
</subProcess>
<intermediateCatchEvent id="c_reporting" name="Reporting angefragt"><documentation>Aktion reporting-aendern (Formular spop-reporting: menge = neue Gesamtmenge, begruendung).</documentation><incoming>w_c1</incoming><outgoing>w_s1</outgoing><messageEventDefinition messageRef="m_reporting"/></intermediateCatchEvent>
<subProcess id="sp_reporting" name="Erweitertes Reporting"><documentation>Erweitertes Reporting der Site: Report-Pakete 0 bis 20, CHF 25.– pro Paket; 0 beendet die Leistung. Die Anzahl bestimmt das Verrechnungsband: 1–5 (540007511), 6–10 (540007703), 11–15 (540007702), 16–20 (540007704). Die Leistung gehört zur Site und endet mit ihrer Rückgabe. Die Ausführung schreibt nur die geänderten Felder in die lokale Variable neu (Ergebnisse innerer Aufgaben bleiben im Subprozess, ADR-0074); das Output-Mapping setzt sie beim Abschluss mit context merge in den Stand des Strangs ein. Endet der Subprozess mit einer Ablehnung, ist neu leer und der Stand bleibt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=if neu = null then zusatz else context merge([(if zusatz = null then {} else zusatz), neu])" target="zusatz"/></zeebe:ioMapping></extensionElements><incoming>w_s1</incoming><outgoing>w_z1</outgoing><startEvent id="rp_s"><outgoing>rp_f0</outgoing></startEvent>
<serviceTask id="rp_read" name="Site und Zusatzleistung lesen (S1)"><documentation>Simuliert apsbw_sharepoint_site read und liest den Stand der Zusatzleistung aus zusatz.reporting. Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ gefunden: site != null, menge: if zusatz = null then 0 else (if zusatz.reporting = null then 0 else zusatz.reporting.menge) }" resultVariable="aktuell"/></extensionElements><incoming>rp_f0</incoming><outgoing>rp_f1</outgoing></serviceTask>
<businessRuleTask id="rp_regel" name="Erweitertes Reporting-Richtlinie prüfen"><documentation>DMN SpopZusatzRichtlinie mit dem Produktschlüssel spop-reporting: zulässige Menge, Verrechnungsband und Materialnummer.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopZusatzRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="spop-reporting"' target="produkt"/><zeebe:input source="=if menge = null then 0 else number(string(menge))" target="menge"/><zeebe:input source="=(if menge = null then 0 else number(string(menge))) = aktuell.menge" target="unveraendert"/></zeebe:ioMapping></extensionElements><incoming>rp_f1</incoming><outgoing>rp_f2</outgoing></businessRuleTask>
<exclusiveGateway id="rp_gw_ok" name="Zulässig?" default="rp_f_ok_nein"><incoming>rp_f2</incoming><outgoing>rp_f_ok_ja</outgoing><outgoing>rp_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="rp_gw_4e" name="Vier-Augen nötig?" default="rp_f_4e_nein"><incoming>rp_f_ok_ja</incoming><outgoing>rp_f_4e_ja</outgoing><outgoing>rp_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="rp_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion reporting-aendern mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="reporting-aendern" outcome="rejected"/></extensionElements><incoming>rp_f_ok_nein</incoming><outgoing>rp_f_rej1</outgoing></sendTask>
<endEvent id="rp_end_rej1" name="Abgelehnt: Richtlinie"><incoming>rp_f_rej1</incoming></endEvent>
<scriptTask id="rp_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Erweitertes Reporting\nSite: " + site.url + "\nBisher: " + string(aktuell.menge) + " Pakete\nNeu: " + string(menge) + " Pakete" + (if begruendung = null then "" else "\nBegründung: " + begruendung) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>rp_f_4e_ja</incoming><outgoing>rp_f_prep</outgoing></scriptTask>
<userTask id="rp_ut" name="Reporting freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>rp_f_prep</incoming><outgoing>rp_f_ut</outgoing></userTask>
<exclusiveGateway id="rp_gw_fr" name="Freigegeben?" default="rp_f_fr_nein"><incoming>rp_f_ut</incoming><outgoing>rp_f_fr_ja</outgoing><outgoing>rp_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="rp_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion reporting-aendern mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="reporting-aendern" outcome="rejected"/></extensionElements><incoming>rp_f_fr_nein</incoming><outgoing>rp_f_rej2</outgoing></sendTask>
<endEvent id="rp_end_rej2" name="Abgelehnt: Freigabe"><incoming>rp_f_rej2</incoming></endEvent>
<exclusiveGateway id="rp_join"><incoming>rp_f_4e_nein</incoming><incoming>rp_f_fr_ja</incoming><outgoing>rp_f10</outgoing></exclusiveGateway>
<serviceTask id="rp_apply" name="Zusatzleistung setzen (S2)"><documentation>Simuliert die Ausführung in SharePoint und die Umstellung der Verrechnung auf das Band der neuen Menge (Material aus der Richtlinie, leer, wenn die Leistung endet). Schreibt neu.reporting; mengeVorher bleibt für einen Rollback.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ reporting: { menge: number(string(menge)), mengeVorher: aktuell.menge, material: regel.material, einheit: regel.einheit } }" resultVariable="neu"/></extensionElements><incoming>rp_f10</incoming><outgoing>rp_f11</outgoing></serviceTask>
<sendTask id="rp_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion reporting-aendern mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="reporting-aendern" outcome="completed"/></extensionElements><incoming>rp_f11</incoming><outgoing>rp_f12</outgoing></sendTask>
<endEvent id="rp_end" name="Reporting gesetzt"><incoming>rp_f12</incoming></endEvent>
<sequenceFlow id="rp_f0" sourceRef="rp_s" targetRef="rp_read"/>
<sequenceFlow id="rp_f1" sourceRef="rp_read" targetRef="rp_regel"/>
<sequenceFlow id="rp_f2" sourceRef="rp_regel" targetRef="rp_gw_ok"/>
<sequenceFlow id="rp_f_ok_ja" name="Ja" sourceRef="rp_gw_ok" targetRef="rp_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="rp_f_ok_nein" name="Nein" sourceRef="rp_gw_ok" targetRef="rp_rej1"/>
<sequenceFlow id="rp_f_rej1" sourceRef="rp_rej1" targetRef="rp_end_rej1"/>
<sequenceFlow id="rp_f_4e_ja" name="Ja" sourceRef="rp_gw_4e" targetRef="rp_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="rp_f_4e_nein" name="Nein" sourceRef="rp_gw_4e" targetRef="rp_join"/>
<sequenceFlow id="rp_f_prep" sourceRef="rp_prep" targetRef="rp_ut"/>
<sequenceFlow id="rp_f_ut" sourceRef="rp_ut" targetRef="rp_gw_fr"/>
<sequenceFlow id="rp_f_fr_ja" name="Ja" sourceRef="rp_gw_fr" targetRef="rp_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="rp_f_fr_nein" name="Nein" sourceRef="rp_gw_fr" targetRef="rp_rej2"/>
<sequenceFlow id="rp_f_rej2" sourceRef="rp_rej2" targetRef="rp_end_rej2"/>
<sequenceFlow id="rp_f10" sourceRef="rp_join" targetRef="rp_apply"/>
<sequenceFlow id="rp_f11" sourceRef="rp_apply" targetRef="rp_info"/>
<sequenceFlow id="rp_f12" sourceRef="rp_info" targetRef="rp_end"/>
</subProcess>
<intermediateCatchEvent id="c_subsites" name="SubSite Quota angefragt"><documentation>Aktion subsites-aendern (Formular spop-subsites: menge = neue Gesamtmenge, begruendung).</documentation><incoming>w_c2</incoming><outgoing>w_s2</outgoing><messageEventDefinition messageRef="m_subsites"/></intermediateCatchEvent>
<subProcess id="sp_subsites" name="SubSite Quota"><documentation>SubSite Quota der Site: erlaubte Subsites 10 bis 500; bis 10 sind in der Basis enthalten, 10 beendet die Leistung. Bänder 11–20 (540007513), 21–50 (540007705), 51–100 (540007706), 101–200 (540007707), 201–500 (540007708); ab 101 Vier-Augen-Prinzip. Die Leistung gehört zur Site und endet mit ihrer Rückgabe. Die Ausführung schreibt nur die geänderten Felder in die lokale Variable neu (Ergebnisse innerer Aufgaben bleiben im Subprozess, ADR-0074); das Output-Mapping setzt sie beim Abschluss mit context merge in den Stand des Strangs ein. Endet der Subprozess mit einer Ablehnung, ist neu leer und der Stand bleibt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=if neu = null then zusatz else context merge([(if zusatz = null then {} else zusatz), neu])" target="zusatz"/></zeebe:ioMapping></extensionElements><incoming>w_s2</incoming><outgoing>w_z2</outgoing><startEvent id="ss_s"><outgoing>ss_f0</outgoing></startEvent>
<serviceTask id="ss_read" name="Site und Zusatzleistung lesen (S1)"><documentation>Simuliert apsbw_sharepoint_site read und liest den Stand der Zusatzleistung aus zusatz.subsites. Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ gefunden: site != null, menge: if zusatz = null then 10 else (if zusatz.subsites = null then 10 else zusatz.subsites.menge) }" resultVariable="aktuell"/></extensionElements><incoming>ss_f0</incoming><outgoing>ss_f1</outgoing></serviceTask>
<businessRuleTask id="ss_regel" name="SubSite Quota-Richtlinie prüfen"><documentation>DMN SpopZusatzRichtlinie mit dem Produktschlüssel spop-subsite-quota: zulässige Menge, Verrechnungsband und Materialnummer.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopZusatzRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="spop-subsite-quota"' target="produkt"/><zeebe:input source="=if menge = null then 0 else number(string(menge))" target="menge"/><zeebe:input source="=(if menge = null then 0 else number(string(menge))) = aktuell.menge" target="unveraendert"/></zeebe:ioMapping></extensionElements><incoming>ss_f1</incoming><outgoing>ss_f2</outgoing></businessRuleTask>
<exclusiveGateway id="ss_gw_ok" name="Zulässig?" default="ss_f_ok_nein"><incoming>ss_f2</incoming><outgoing>ss_f_ok_ja</outgoing><outgoing>ss_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="ss_gw_4e" name="Vier-Augen nötig?" default="ss_f_4e_nein"><incoming>ss_f_ok_ja</incoming><outgoing>ss_f_4e_ja</outgoing><outgoing>ss_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="ss_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion subsites-aendern mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="subsites-aendern" outcome="rejected"/></extensionElements><incoming>ss_f_ok_nein</incoming><outgoing>ss_f_rej1</outgoing></sendTask>
<endEvent id="ss_end_rej1" name="Abgelehnt: Richtlinie"><incoming>ss_f_rej1</incoming></endEvent>
<scriptTask id="ss_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="SubSite Quota\nSite: " + site.url + "\nBisher: " + string(aktuell.menge) + " Subsites\nNeu: " + string(menge) + " Subsites" + (if begruendung = null then "" else "\nBegründung: " + begruendung) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>ss_f_4e_ja</incoming><outgoing>ss_f_prep</outgoing></scriptTask>
<userTask id="ss_ut" name="SubSite Quota freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>ss_f_prep</incoming><outgoing>ss_f_ut</outgoing></userTask>
<exclusiveGateway id="ss_gw_fr" name="Freigegeben?" default="ss_f_fr_nein"><incoming>ss_f_ut</incoming><outgoing>ss_f_fr_ja</outgoing><outgoing>ss_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="ss_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion subsites-aendern mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="subsites-aendern" outcome="rejected"/></extensionElements><incoming>ss_f_fr_nein</incoming><outgoing>ss_f_rej2</outgoing></sendTask>
<endEvent id="ss_end_rej2" name="Abgelehnt: Freigabe"><incoming>ss_f_rej2</incoming></endEvent>
<exclusiveGateway id="ss_join"><incoming>ss_f_4e_nein</incoming><incoming>ss_f_fr_ja</incoming><outgoing>ss_f10</outgoing></exclusiveGateway>
<serviceTask id="ss_apply" name="Zusatzleistung setzen (S2)"><documentation>Simuliert die Ausführung in SharePoint und die Umstellung der Verrechnung auf das Band der neuen Menge (Material aus der Richtlinie, leer, wenn die Leistung endet). Schreibt neu.subsites; mengeVorher bleibt für einen Rollback.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ subsites: { menge: number(string(menge)), mengeVorher: aktuell.menge, material: regel.material, einheit: regel.einheit } }" resultVariable="neu"/></extensionElements><incoming>ss_f10</incoming><outgoing>ss_f11</outgoing></serviceTask>
<sendTask id="ss_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion subsites-aendern mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="subsites-aendern" outcome="completed"/></extensionElements><incoming>ss_f11</incoming><outgoing>ss_f12</outgoing></sendTask>
<endEvent id="ss_end" name="SubSite Quota gesetzt"><incoming>ss_f12</incoming></endEvent>
<sequenceFlow id="ss_f0" sourceRef="ss_s" targetRef="ss_read"/>
<sequenceFlow id="ss_f1" sourceRef="ss_read" targetRef="ss_regel"/>
<sequenceFlow id="ss_f2" sourceRef="ss_regel" targetRef="ss_gw_ok"/>
<sequenceFlow id="ss_f_ok_ja" name="Ja" sourceRef="ss_gw_ok" targetRef="ss_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="ss_f_ok_nein" name="Nein" sourceRef="ss_gw_ok" targetRef="ss_rej1"/>
<sequenceFlow id="ss_f_rej1" sourceRef="ss_rej1" targetRef="ss_end_rej1"/>
<sequenceFlow id="ss_f_4e_ja" name="Ja" sourceRef="ss_gw_4e" targetRef="ss_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="ss_f_4e_nein" name="Nein" sourceRef="ss_gw_4e" targetRef="ss_join"/>
<sequenceFlow id="ss_f_prep" sourceRef="ss_prep" targetRef="ss_ut"/>
<sequenceFlow id="ss_f_ut" sourceRef="ss_ut" targetRef="ss_gw_fr"/>
<sequenceFlow id="ss_f_fr_ja" name="Ja" sourceRef="ss_gw_fr" targetRef="ss_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="ss_f_fr_nein" name="Nein" sourceRef="ss_gw_fr" targetRef="ss_rej2"/>
<sequenceFlow id="ss_f_rej2" sourceRef="ss_rej2" targetRef="ss_end_rej2"/>
<sequenceFlow id="ss_f10" sourceRef="ss_join" targetRef="ss_apply"/>
<sequenceFlow id="ss_f11" sourceRef="ss_apply" targetRef="ss_info"/>
<sequenceFlow id="ss_f12" sourceRef="ss_info" targetRef="ss_end"/>
</subProcess>
<intermediateCatchEvent id="c_titel" name="Umbenennung angefragt"><documentation>Aktion site-umbenennen (Formular spop-site-umbenennen: neuerTitel, begruendung).</documentation><incoming>w_c3</incoming><outgoing>w_s3</outgoing><messageEventDefinition messageRef="m_titel"/></intermediateCatchEvent>
<subProcess id="sp_titel" name="Site umbenennen"><documentation>Aktion site-umbenennen: ändert den Titel der Site; die URL bleibt. Richtlinie SpopAenderungRichtlinie mit aenderung titel: 1 bis 80 Zeichen, ohne Freigabe. Die Ausführung schreibt nur die geänderten Felder in die lokale Variable neu (Ergebnisse innerer Aufgaben bleiben im Subprozess, ADR-0074); das Output-Mapping setzt sie beim Abschluss mit context merge in den Stand des Strangs ein. Endet der Subprozess mit einer Ablehnung, ist neu leer und der Stand bleibt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=if neu = null then site else context merge([site, neu])" target="site"/></zeebe:ioMapping></extensionElements><incoming>w_s3</incoming><outgoing>w_z3</outgoing><startEvent id="t_s"><outgoing>t_f0</outgoing></startEvent>
<serviceTask id="t_read" name="Site lesen (S1)"><documentation>Simuliert apsbw_sharepoint_site read aus dem Stand des Strangs (site). Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ gefunden: site != null, titel: if site = null then null else site.titel }" resultVariable="aktuell"/></extensionElements><incoming>t_f0</incoming><outgoing>t_f1</outgoing></serviceTask>
<businessRuleTask id="t_regel" name="Änderungs-Richtlinie prüfen"><documentation>DMN SpopAenderungRichtlinie mit aenderung titel.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopAenderungRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="titel"' target="aenderung"/><zeebe:input source="=neuerTitel != null and string length(neuerTitel) &gt;= 1 and string length(neuerTitel) &lt;= 80" target="gueltig"/><zeebe:input source="=neuerTitel = aktuell.titel" target="unveraendert"/><zeebe:input source='=if site = null then "" else site.typ' target="siteTyp"/><zeebe:input source="=false" target="ownerWechsel"/></zeebe:ioMapping></extensionElements><incoming>t_f1</incoming><outgoing>t_f2</outgoing></businessRuleTask>
<exclusiveGateway id="t_gw_ok" name="Zulässig?" default="t_f_ok_nein"><incoming>t_f2</incoming><outgoing>t_f_ok_ja</outgoing><outgoing>t_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="t_gw_4e" name="Vier-Augen nötig?" default="t_f_4e_nein"><incoming>t_f_ok_ja</incoming><outgoing>t_f_4e_ja</outgoing><outgoing>t_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="t_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-umbenennen mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-umbenennen" outcome="rejected"/></extensionElements><incoming>t_f_ok_nein</incoming><outgoing>t_f_rej1</outgoing></sendTask>
<endEvent id="t_end_rej1" name="Abgelehnt: Richtlinie"><incoming>t_f_rej1</incoming></endEvent>
<scriptTask id="t_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Site umbenennen\nSite: " + site.url + "\nTitel bisher: " + aktuell.titel + "\nNeu: " + neuerTitel + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>t_f_4e_ja</incoming><outgoing>t_f_prep</outgoing></scriptTask>
<userTask id="t_ut" name="Umbenennung freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>t_f_prep</incoming><outgoing>t_f_ut</outgoing></userTask>
<exclusiveGateway id="t_gw_fr" name="Freigegeben?" default="t_f_fr_nein"><incoming>t_f_ut</incoming><outgoing>t_f_fr_ja</outgoing><outgoing>t_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="t_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-umbenennen mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-umbenennen" outcome="rejected"/></extensionElements><incoming>t_f_fr_nein</incoming><outgoing>t_f_rej2</outgoing></sendTask>
<endEvent id="t_end_rej2" name="Abgelehnt: Freigabe"><incoming>t_f_rej2</incoming></endEvent>
<exclusiveGateway id="t_join"><incoming>t_f_4e_nein</incoming><incoming>t_f_fr_ja</incoming><outgoing>t_f10</outgoing></exclusiveGateway>
<serviceTask id="t_apply" name="Titel setzen (S1)"><documentation>Simuliert apsbw_sharepoint_site update (Titel). Schreibt neu mit dem neuen Titel und titelVorher für einen Rollback.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ titel: neuerTitel, titelVorher: site.titel }" resultVariable="neu"/></extensionElements><incoming>t_f10</incoming><outgoing>t_f11</outgoing></serviceTask>
<sendTask id="t_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-umbenennen mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-umbenennen" outcome="completed"/></extensionElements><incoming>t_f11</incoming><outgoing>t_f12</outgoing></sendTask>
<endEvent id="t_end" name="Site umbenannt"><incoming>t_f12</incoming></endEvent>
<sequenceFlow id="t_f0" sourceRef="t_s" targetRef="t_read"/>
<sequenceFlow id="t_f1" sourceRef="t_read" targetRef="t_regel"/>
