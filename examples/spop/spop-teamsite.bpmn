<sequenceFlow id="t_f10" sourceRef="t_join" targetRef="t_apply"/>
<sequenceFlow id="t_f11" sourceRef="t_apply" targetRef="t_info"/>
<sequenceFlow id="t_f12" sourceRef="t_info" targetRef="t_end"/>
</subProcess>
<subProcess id="sp_url" name="Site-URL ändern" triggeredByEvent="true"><documentation>Aktion site-url-aendern (Formular spop-site-url-aendern: neuesAmtKuerzel, neuerKurzname, begruendung): gibt der Site die URL /sites/&lt;amt&gt;-&lt;kurzname&gt;. Bestehende Links werden ungültig; darum immer Vier-Augen-Freigabe (SpopAenderungRichtlinie, aenderung url). Führt die Verrechnung und siteZugriff nach, damit die Eigentumsprüfung der Zusatzleistungen die Site unter der neuen URL findet. Annahme: SharePoint OnPrem erlaubt das Umbenennen der Site-Collection-URL; technisch nicht geklärt. Nicht unterbrechender Ereignis-Subprozess (ADR-0082): startet bei jeder Nachricht der Position, läuft neben dem Strang und ändert dessen Stand über das Output-Mapping; endet er mit einer Ablehnung, lösen die Ausdrücke den unveränderten Wert auf (ADR-0074). Vor der Bereitstellung lehnt die Regel ab, weil site noch fehlt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=site" target="site"/><zeebe:output source="=verrechnung" target="verrechnung"/><zeebe:output source='=site.url + "|" + (if orderer = null then "" else orderer) + "|" + (if recipient = null then "" else recipient)' target="siteZugriff"/></zeebe:ioMapping></extensionElements><startEvent id="u_s" name="URL-Änderung angefragt" isInterrupting="false"><outgoing>u_f0</outgoing><messageEventDefinition messageRef="m_url"/></startEvent>
<serviceTask id="u_read" name="Site und neue URL lesen (S1)"><documentation>Simuliert apsbw_sharepoint_site read für die heutige und die neue URL; urlFrei sagt, ob unter der neuen URL noch keine Site besteht. Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ gefunden: site != null, url: if site = null then null else site.url, neueUrl: "/sites/" + lower case(neuesAmtKuerzel) + "-" + neuerKurzname, urlFrei: true }' resultVariable="aktuell"/></extensionElements><incoming>u_f0</incoming><outgoing>u_f1</outgoing></serviceTask>
<businessRuleTask id="u_regel" name="Änderungs-Richtlinie prüfen"><documentation>DMN SpopAenderungRichtlinie mit aenderung url: immer Vier-Augen-Prinzip.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopAenderungRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="url"' target="aenderung"/><zeebe:input source='=neuesAmtKuerzel != null and matches(neuesAmtKuerzel, "^[A-Z]{2,6}$") and neuerKurzname != null and matches(neuerKurzname, "^[a-z0-9][a-z0-9-]{2,29}$") and aktuell.urlFrei = true' target="gueltig"/><zeebe:input source="=aktuell.neueUrl = aktuell.url" target="unveraendert"/><zeebe:input source='=if site = null then "" else site.typ' target="siteTyp"/><zeebe:input source="=false" target="ownerWechsel"/></zeebe:ioMapping></extensionElements><incoming>u_f1</incoming><outgoing>u_f2</outgoing></businessRuleTask>
<exclusiveGateway id="u_gw_ok" name="Zulässig?" default="u_f_ok_nein"><incoming>u_f2</incoming><outgoing>u_f_ok_ja</outgoing><outgoing>u_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="u_gw_4e" name="Vier-Augen nötig?" default="u_f_4e_nein"><incoming>u_f_ok_ja</incoming><outgoing>u_f_4e_ja</outgoing><outgoing>u_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="u_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-url-aendern mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-url-aendern" outcome="rejected"/></extensionElements><incoming>u_f_ok_nein</incoming><outgoing>u_f_rej1</outgoing></sendTask>
<endEvent id="u_end_rej1" name="Abgelehnt: Richtlinie"><incoming>u_f_rej1</incoming></endEvent>
<scriptTask id="u_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Site-URL ändern\nURL bisher: " + aktuell.url + "\nNeu: " + aktuell.neueUrl + (if begruendung = null then "" else "\nBegründung: " + begruendung) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>u_f_4e_ja</incoming><outgoing>u_f_prep</outgoing></scriptTask>
<userTask id="u_ut" name="URL-Änderung freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>u_f_prep</incoming><outgoing>u_f_ut</outgoing></userTask>
<exclusiveGateway id="u_gw_fr" name="Freigegeben?" default="u_f_fr_nein"><incoming>u_f_ut</incoming><outgoing>u_f_fr_ja</outgoing><outgoing>u_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="u_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-url-aendern mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-url-aendern" outcome="rejected"/></extensionElements><incoming>u_f_fr_nein</incoming><outgoing>u_f_rej2</outgoing></sendTask>
<endEvent id="u_end_rej2" name="Abgelehnt: Freigabe"><incoming>u_f_rej2</incoming></endEvent>
<exclusiveGateway id="u_join"><incoming>u_f_4e_nein</incoming><incoming>u_f_fr_ja</incoming><outgoing>u_f10</outgoing></exclusiveGateway>
<serviceTask id="u_apply" name="Site-URL ändern (S1)"><documentation>Simuliert das Umbenennen der Site-Collection-URL (apsbw_sharepoint_site rename). Schreibt site mit der neuen URL; urlVorher bleibt für einen Rollback erhalten.</documentation><extensionElements><atlas:mockupConnector minDuration="PT2S" maxDuration="PT4S" resultExpression="={ url: aktuell.neueUrl, titel: site.titel, typ: site.typ, template: site.template, material: site.material, sprache: site.sprache, urlVorher: site.url }" resultVariable="site"/></extensionElements><incoming>u_f10</incoming><outgoing>u_f11</outgoing></serviceTask>
<serviceTask id="u_bill" name="Verrechnung nachführen"><documentation>Simuliert die Anpassung der wiederkehrenden Verrechnung auf die neue URL.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ material: site.material, menge: 1, einheit: "Site", siteUrl: site.url, position: orderId + "/" + (if positionId = null then itemId else positionId) }' resultVariable="verrechnung"/></extensionElements><incoming>u_f11</incoming><outgoing>u_f12</outgoing></serviceTask>
<sendTask id="u_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion site-url-aendern mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="site-url-aendern" outcome="completed"/></extensionElements><incoming>u_f12</incoming><outgoing>u_f13</outgoing></sendTask>
<endEvent id="u_end" name="URL geändert"><incoming>u_f13</incoming></endEvent>
<sequenceFlow id="u_f0" sourceRef="u_s" targetRef="u_read"/>
<sequenceFlow id="u_f1" sourceRef="u_read" targetRef="u_regel"/>
<sequenceFlow id="u_f2" sourceRef="u_regel" targetRef="u_gw_ok"/>
<sequenceFlow id="u_f_ok_ja" name="Ja" sourceRef="u_gw_ok" targetRef="u_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="u_f_ok_nein" name="Nein" sourceRef="u_gw_ok" targetRef="u_rej1"/>
<sequenceFlow id="u_f_rej1" sourceRef="u_rej1" targetRef="u_end_rej1"/>
<sequenceFlow id="u_f_4e_ja" name="Ja" sourceRef="u_gw_4e" targetRef="u_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="u_f_4e_nein" name="Nein" sourceRef="u_gw_4e" targetRef="u_join"/>
<sequenceFlow id="u_f_prep" sourceRef="u_prep" targetRef="u_ut"/>
<sequenceFlow id="u_f_ut" sourceRef="u_ut" targetRef="u_gw_fr"/>
<sequenceFlow id="u_f_fr_ja" name="Ja" sourceRef="u_gw_fr" targetRef="u_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="u_f_fr_nein" name="Nein" sourceRef="u_gw_fr" targetRef="u_rej2"/>
<sequenceFlow id="u_f_rej2" sourceRef="u_rej2" targetRef="u_end_rej2"/>
<sequenceFlow id="u_f10" sourceRef="u_join" targetRef="u_apply"/>
<sequenceFlow id="u_f11" sourceRef="u_apply" targetRef="u_bill"/>
<sequenceFlow id="u_f12" sourceRef="u_bill" targetRef="u_info"/>
<sequenceFlow id="u_f13" sourceRef="u_info" targetRef="u_end"/>
</subProcess>
<subProcess id="sp_rechte" name="Berechtigungen ändern" triggeredByEvent="true"><documentation>Aktion berechtigungen-aendern (Formular spop-berechtigungen-aendern: neuerOwnerUpn, neueMemberUpns, begruendung): setzt Owner und Members der Site neu; anzugeben ist der vollständige neue Stand. Richtlinie SpopAenderungRichtlinie mit aenderung berechtigungen: Owner-Wechsel bei Hermes, Communication und Publishing mit Vier-Augen-Freigabe. Die Eigentumsprüfung der Zusatzleistungen hängt am Besteller und Empfänger der Position, nicht am Owner; sie ändert sich hier nicht. Nicht unterbrechender Ereignis-Subprozess (ADR-0082): startet bei jeder Nachricht der Position, läuft neben dem Strang und ändert dessen Stand über das Output-Mapping; endet er mit einer Ablehnung, lösen die Ausdrücke den unveränderten Wert auf (ADR-0074). Vor der Bereitstellung lehnt die Regel ab, weil site noch fehlt.</documentation><extensionElements><zeebe:ioMapping><zeebe:output source="=gruppen" target="gruppen"/></zeebe:ioMapping></extensionElements><startEvent id="b_s" name="Änderung angefragt" isInterrupting="false"><outgoing>b_f0</outgoing><messageEventDefinition messageRef="m_rechte"/></startEvent>
<serviceTask id="b_read" name="Gruppen und neuen Owner lesen (S2)"><documentation>Simuliert apsbw_sharepoint_group read und apsbw_ad_user read für den neuen Owner (ownerExistiert). Schreibt aktuell.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ gefunden: site != null, owner: if gruppen = null then null else gruppen.owner, mitglieder: if gruppen = null then "" else (if gruppen.mitglieder = null then "" else gruppen.mitglieder), ownerExistiert: true }' resultVariable="aktuell"/></extensionElements><incoming>b_f0</incoming><outgoing>b_f1</outgoing></serviceTask>
<businessRuleTask id="b_regel" name="Änderungs-Richtlinie prüfen"><documentation>DMN SpopAenderungRichtlinie mit aenderung berechtigungen.</documentation><extensionElements><zeebe:calledDecision decisionId="SpopAenderungRichtlinie" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=aktuell.gefunden" target="siteGefunden"/><zeebe:input source='="berechtigungen"' target="aenderung"/><zeebe:input source='=neuerOwnerUpn != null and matches(neuerOwnerUpn, "^[^@ ]+@[^@ ]+[.][^@ ]+$") and aktuell.ownerExistiert = true' target="gueltig"/><zeebe:input source='=aktuell.owner != null and neuerOwnerUpn != null and lower case(neuerOwnerUpn) = lower case(aktuell.owner) and (if neueMemberUpns = null then "" else neueMemberUpns) = aktuell.mitglieder' target="unveraendert"/><zeebe:input source='=if site = null then "" else site.typ' target="siteTyp"/><zeebe:input source="=aktuell.owner = null or neuerOwnerUpn = null or lower case(neuerOwnerUpn) != lower case(aktuell.owner)" target="ownerWechsel"/></zeebe:ioMapping></extensionElements><incoming>b_f1</incoming><outgoing>b_f2</outgoing></businessRuleTask>
<exclusiveGateway id="b_gw_ok" name="Zulässig?" default="b_f_ok_nein"><incoming>b_f2</incoming><outgoing>b_f_ok_ja</outgoing><outgoing>b_f_ok_nein</outgoing></exclusiveGateway>
<exclusiveGateway id="b_gw_4e" name="Vier-Augen nötig?" default="b_f_4e_nein"><incoming>b_f_ok_ja</incoming><outgoing>b_f_4e_ja</outgoing><outgoing>b_f_4e_nein</outgoing></exclusiveGateway>
<sendTask id="b_rej1" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit rejected, weil die Richtlinie sie nicht zulässt.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="rejected"/></extensionElements><incoming>b_f_ok_nein</incoming><outgoing>b_f_rej1</outgoing></sendTask>
<endEvent id="b_end_rej1" name="Abgelehnt: Richtlinie"><incoming>b_f_rej1</incoming></endEvent>
<scriptTask id="b_prep" name="Freigabe vorbereiten"><documentation>Schreibt die Zusammenfassung für das Freigabeformular spop-freigabe.</documentation><extensionElements><zeebe:script expression='="Berechtigungen ändern\nSite: " + site.url + "\nOwner bisher: " + aktuell.owner + "\nNeu: " + neuerOwnerUpn + "\nMembers neu: " + (if neueMemberUpns = null then "" else neueMemberUpns) + "\nRegel: " + regel.grund' resultVariable="zusammenfassung"/></extensionElements><incoming>b_f_4e_ja</incoming><outgoing>b_f_prep</outgoing></scriptTask>
<userTask id="b_ut" name="Owner-Wechsel freigeben"><documentation>Vier-Augen-Freigabe durch die Gruppe SPoP-Freigabe.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="SPoP-Freigabe"/><zeebe:formDefinition formId="spop-freigabe"/></extensionElements><incoming>b_f_prep</incoming><outgoing>b_f_ut</outgoing></userTask>
<exclusiveGateway id="b_gw_fr" name="Freigegeben?" default="b_f_fr_nein"><incoming>b_f_ut</incoming><outgoing>b_f_fr_ja</outgoing><outgoing>b_f_fr_nein</outgoing></exclusiveGateway>
<sendTask id="b_rej2" name="Ablehnung melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit rejected, weil die Vier-Augen-Freigabe verweigert wurde.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="rejected"/></extensionElements><incoming>b_f_fr_nein</incoming><outgoing>b_f_rej2</outgoing></sendTask>
<endEvent id="b_end_rej2" name="Abgelehnt: Freigabe"><incoming>b_f_rej2</incoming></endEvent>
<exclusiveGateway id="b_join"><incoming>b_f_4e_nein</incoming><incoming>b_f_fr_ja</incoming><outgoing>b_f10</outgoing></exclusiveGateway>
<serviceTask id="b_apply" name="Gruppen aktualisieren (S2–S5)"><documentation>Simuliert apsbw_sharepoint_group add_member und remove_member für die Owner- und die Member-Gruppe. Schreibt gruppen mit dem neuen Stand; ownerVorher und mitgliederVorher bleiben für einen Rollback erhalten.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ owners: gruppen.owners, members: gruppen.members, visitors: gruppen.visitors, owner: neuerOwnerUpn, mitglieder: if neueMemberUpns = null then "" else neueMemberUpns, ownerVorher: gruppen.owner, mitgliederVorher: gruppen.mitglieder }' resultVariable="gruppen"/></extensionElements><incoming>b_f10</incoming><outgoing>b_f11</outgoing></serviceTask>
<sendTask id="b_info" name="Aktion als erledigt melden"><documentation>Shop-Aufgabe (Modus outcome): beantwortet die Aktion berechtigungen-aendern mit completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="berechtigungen-aendern" outcome="completed"/></extensionElements><incoming>b_f11</incoming><outgoing>b_f12</outgoing></sendTask>
<endEvent id="b_end" name="Berechtigungen geändert"><incoming>b_f12</incoming></endEvent>
<sequenceFlow id="b_f0" sourceRef="b_s" targetRef="b_read"/>
<sequenceFlow id="b_f1" sourceRef="b_read" targetRef="b_regel"/>
<sequenceFlow id="b_f2" sourceRef="b_regel" targetRef="b_gw_ok"/>
<sequenceFlow id="b_f_ok_ja" name="Ja" sourceRef="b_gw_ok" targetRef="b_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_ok_nein" name="Nein" sourceRef="b_gw_ok" targetRef="b_rej1"/>
<sequenceFlow id="b_f_rej1" sourceRef="b_rej1" targetRef="b_end_rej1"/>
<sequenceFlow id="b_f_4e_ja" name="Ja" sourceRef="b_gw_4e" targetRef="b_prep"><conditionExpression>=regel.vierAugen = true</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_4e_nein" name="Nein" sourceRef="b_gw_4e" targetRef="b_join"/>
<sequenceFlow id="b_f_prep" sourceRef="b_prep" targetRef="b_ut"/>
<sequenceFlow id="b_f_ut" sourceRef="b_ut" targetRef="b_gw_fr"/>
<sequenceFlow id="b_f_fr_ja" name="Ja" sourceRef="b_gw_fr" targetRef="b_join"><conditionExpression>=freigabeEntscheid = "freigegeben"</conditionExpression></sequenceFlow>
<sequenceFlow id="b_f_fr_nein" name="Nein" sourceRef="b_gw_fr" targetRef="b_rej2"/>
<sequenceFlow id="b_f_rej2" sourceRef="b_rej2" targetRef="b_end_rej2"/>
<sequenceFlow id="b_f10" sourceRef="b_join" targetRef="b_apply"/>
<sequenceFlow id="b_f11" sourceRef="b_apply" targetRef="b_info"/>
<sequenceFlow id="b_f12" sourceRef="b_info" targetRef="b_end"/>
</subProcess>
<boundaryEvent id="b_rueck_q" name="Rückgabe" attachedToRef="sp_quota" cancelActivity="true"><documentation>Eine Rückgabe bricht eine laufende Quota-Erhöhung ab.</documentation><outgoing>r_f2</outgoing><messageEventDefinition messageRef="m_rueckgabe"/></boundaryEvent>
<boundaryEvent id="b_rueck_x" name="Rückgabe" attachedToRef="sp_extern" cancelActivity="true"><documentation>Eine Rückgabe bricht eine laufende Einladung ab, auch während auf die Annahme gewartet wird.</documentation><outgoing>r_f4</outgoing><messageEventDefinition messageRef="m_rueckgabe"/></boundaryEvent>
<exclusiveGateway id="j_rueck1"><incoming>r_f1</incoming><incoming>r_f2</incoming><outgoing>r_f3</outgoing></exclusiveGateway>
<exclusiveGateway id="j_rueck2"><incoming>r_f3</incoming><incoming>r_f4</incoming><incoming>r_f6</incoming><outgoing>r_f7</outgoing></exclusiveGateway>
<startEvent id="r_start" name="Rückgabe ohne laufenden Strang"><documentation>Rückfallebene wie im Referenzmodell: Eine Rückgabe für eine Position ohne laufenden Strang startet hier. Der Katalog verlangt für per-position diesen Nachrichtenstart.</documentation><outgoing>r_f5</outgoing><messageEventDefinition messageRef="m_rueckgabe"/></startEvent>
<scriptTask id="r_site" name="Site ermitteln"><documentation>Bildet die Site-URL aus der Konfiguration der Position nach demselben Schema wie die Bereitstellung (Annahme: der Katalog liefert amtKuerzel und kurzname der Position mit).</documentation><extensionElements><zeebe:script expression='={ url: "/sites/" + lower case(amtKuerzel) + "-" + kurzname }' resultVariable="site"/></extensionElements><incoming>r_f5</incoming><outgoing>r_f6</outgoing></scriptTask>
<serviceTask id="r_extern" name="Externe Zugriffe entfernen"><documentation>Simuliert apsbw_sharepoint_externaluser remove für jeden Eintrag in externe, der Liste der angenommenen Einladungen des Strangs.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression="={ siteUrl: site.url, entfernt: if externe = null then [] else externe }" resultVariable="externEntfernt"/></extensionElements><incoming>r_f7</incoming><outgoing>r_f8</outgoing></serviceTask>
<serviceTask id="r_delete" name="Site löschen"><documentation>Simuliert apsbw_sharepoint_site delete (Worker sharepointserver: delete-site, Papierkorb).</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ siteUrl: site.url, status: "im Papierkorb" }' resultVariable="rueckbau"/></extensionElements><incoming>r_f8</incoming><outgoing>r_f9</outgoing></serviceTask>
<serviceTask id="r_bill" name="Verrechnung beenden"><documentation>Simuliert das Beenden der wiederkehrenden Verrechnung des Site-Materials.</documentation><extensionElements><atlas:mockupConnector minDuration="PT1S" maxDuration="PT2S" resultExpression='={ material: site.material, siteUrl: site.url, status: "beendet" }' resultVariable="verrechnung"/></extensionElements><incoming>r_f9</incoming><outgoing>r_f9b</outgoing></serviceTask>
<serviceTask id="r_info" name="Rückgabe melden"><documentation>Meldet die Rückgabe über die Positionsroute (status returned); damit endet das Recht im Bestand. Braucht das Secret "atlas" mit einem API-Token der Rolle operator; die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE. Eine Position mit Variante heisst itemId#variantId; das # wird als %23 kodiert, sonst schneidet es die URL ab.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>r_f9b</incoming><outgoing>r_f10</outgoing></serviceTask>
<endEvent id="r_end" name="Site zurückgegeben"><documentation>Terminierendes Ende: beendet den Strang der Position vollständig, auch laufende Ereignis-Subprozesse.</documentation><incoming>r_f10</incoming><terminateEventDefinition/></endEvent>
<sequenceFlow id="a_f2" sourceRef="a_regel" targetRef="a_gw_ok"/>
<sequenceFlow id="a_f_ok_ja" name="Ja" sourceRef="a_gw_ok" targetRef="a_gw_4e"><conditionExpression>=regel.zulaessig = true</conditionExpression></sequenceFlow>
<sequenceFlow id="a_f_ok_nein" name="Nein" sourceRef="a_gw_ok" targetRef="a_rej1"/>
<sequenceFlow id="a_f_rej1" sourceRef="a_rej1" targetRef="a_end_rej1"/>
