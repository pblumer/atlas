<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopExternRichtlinie" name="SpopExternRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_siteGefunden" name="siteGefunden"><variable id="v_siteGefunden" name="siteGefunden" typeRef="boolean"/></inputData>
<inputData id="id_emailDomain" name="emailDomain"><variable id="v_emailDomain" name="emailDomain" typeRef="string"/></inputData>
<inputData id="id_rolle" name="rolle"><variable id="v_rolle" name="rolle" typeRef="string"/></inputData>
<inputData id="id_ablaufTage" name="ablaufTage"><variable id="v_ablaufTage" name="ablaufTage" typeRef="number"/></inputData>
<decision id="SpopExternRichtlinie" name="Externe-Benutzer-Richtlinie (GF-003)"><description>Ersetzt external_user.rego, mfa_required.rego und approval.rego. Annahmen: Liste privater Mail-Domains; Gültigkeit 1 bis 90 Tage; MFA ist für alle externen Benutzer Pflicht; Vier-Augen-Prinzip ab Contribute.</description><variable id="v_SpopExternRichtlinie" name="SpopExternRichtlinie"/>
<informationRequirement id="ir_siteGefunden"><requiredInput href="#id_siteGefunden"/></informationRequirement><informationRequirement id="ir_emailDomain"><requiredInput href="#id_emailDomain"/></informationRequirement><informationRequirement id="ir_rolle"><requiredInput href="#id_rolle"/></informationRequirement><informationRequirement id="ir_ablaufTage"><requiredInput href="#id_ablaufTage"/></informationRequirement>
<decisionTable id="dt_SpopExternRichtlinie" hitPolicy="FIRST">
<input id="i0" label="siteGefunden"><inputExpression id="ie0" typeRef="boolean"><text>siteGefunden</text></inputExpression></input>
<input id="i1" label="emailDomain"><inputExpression id="ie1" typeRef="string"><text>emailDomain</text></inputExpression></input>
<input id="i2" label="rolle"><inputExpression id="ie2" typeRef="string"><text>rolle</text></inputExpression></input>
<input id="i3" label="ablaufTage"><inputExpression id="ie3" typeRef="number"><text>ablaufTage</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="mfaPflicht" name="mfaPflicht" typeRef="boolean"/>
<output id="o3" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>true</text></outputEntry><outputEntry id="r1o3"><text>"Die Site wurde nicht gefunden."</text></outputEntry></rule>
<rule id="r2"><inputEntry id="r2i0"><text>-</text></inputEntry><inputEntry id="r2i1"><text>""</text></inputEntry><inputEntry id="r2i2"><text>-</text></inputEntry><inputEntry id="r2i3"><text>-</text></inputEntry><outputEntry id="r2o0"><text>false</text></outputEntry><outputEntry id="r2o1"><text>false</text></outputEntry><outputEntry id="r2o2"><text>true</text></outputEntry><outputEntry id="r2o3"><text>"Die E-Mail-Adresse ist ungültig."</text></outputEntry></rule>
<rule id="r3"><inputEntry id="r3i0"><text>-</text></inputEntry><inputEntry id="r3i1"><text>"gmail.com","googlemail.com","hotmail.com","outlook.com","live.com","yahoo.com","icloud.com","gmx.ch","gmx.net","gmx.de","bluewin.ch"</text></inputEntry><inputEntry id="r3i2"><text>-</text></inputEntry><inputEntry id="r3i3"><text>-</text></inputEntry><outputEntry id="r3o0"><text>false</text></outputEntry><outputEntry id="r3o1"><text>false</text></outputEntry><outputEntry id="r3o2"><text>true</text></outputEntry><outputEntry id="r3o3"><text>"Private E-Mail-Domains sind für externe Benutzer nicht zugelassen."</text></outputEntry></rule>
<rule id="r4"><inputEntry id="r4i0"><text>-</text></inputEntry><inputEntry id="r4i1"><text>-</text></inputEntry><inputEntry id="r4i2"><text>-</text></inputEntry><inputEntry id="r4i3"><text>&lt; 1</text></inputEntry><outputEntry id="r4o0"><text>false</text></outputEntry><outputEntry id="r4o1"><text>false</text></outputEntry><outputEntry id="r4o2"><text>true</text></outputEntry><outputEntry id="r4o3"><text>"Die Gültigkeit muss zwischen 1 und 90 Tagen liegen."</text></outputEntry></rule>
<rule id="r5"><inputEntry id="r5i0"><text>-</text></inputEntry><inputEntry id="r5i1"><text>-</text></inputEntry><inputEntry id="r5i2"><text>-</text></inputEntry><inputEntry id="r5i3"><text>&gt; 90</text></inputEntry><outputEntry id="r5o0"><text>false</text></outputEntry><outputEntry id="r5o1"><text>false</text></outputEntry><outputEntry id="r5o2"><text>true</text></outputEntry><outputEntry id="r5o3"><text>"Die Gültigkeit muss zwischen 1 und 90 Tagen liegen."</text></outputEntry></rule>
<rule id="r6"><inputEntry id="r6i0"><text>-</text></inputEntry><inputEntry id="r6i1"><text>-</text></inputEntry><inputEntry id="r6i2"><text>"Read"</text></inputEntry><inputEntry id="r6i3"><text>-</text></inputEntry><outputEntry id="r6o0"><text>true</text></outputEntry><outputEntry id="r6o1"><text>false</text></outputEntry><outputEntry id="r6o2"><text>true</text></outputEntry><outputEntry id="r6o3"><text>"Leserecht: ohne Freigabe, MFA-Pflicht."</text></outputEntry></rule>
<rule id="r7"><inputEntry id="r7i0"><text>-</text></inputEntry><inputEntry id="r7i1"><text>-</text></inputEntry><inputEntry id="r7i2"><text>"Contribute","Full Control"</text></inputEntry><inputEntry id="r7i3"><text>-</text></inputEntry><outputEntry id="r7o0"><text>true</text></outputEntry><outputEntry id="r7o1"><text>true</text></outputEntry><outputEntry id="r7o2"><text>true</text></outputEntry><outputEntry id="r7o3"><text>"Contribute oder Full Control: Vier-Augen-Prinzip, MFA-Pflicht."</text></outputEntry></rule>
<rule id="r8"><inputEntry id="r8i0"><text>-</text></inputEntry><inputEntry id="r8i1"><text>-</text></inputEntry><inputEntry id="r8i2"><text>-</text></inputEntry><inputEntry id="r8i3"><text>-</text></inputEntry><outputEntry id="r8o0"><text>false</text></outputEntry><outputEntry id="r8o1"><text>false</text></outputEntry><outputEntry id="r8o2"><text>true</text></outputEntry><outputEntry id="r8o3"><text>"Unbekannte Rolle."</text></outputEntry></rule>
</decisionTable></decision></definitions>
