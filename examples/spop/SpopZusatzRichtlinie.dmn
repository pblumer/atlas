<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopZusatzRichtlinie" name="SpopZusatzRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_siteGefunden" name="siteGefunden"><variable id="v_siteGefunden" name="siteGefunden" typeRef="boolean"/></inputData>
<inputData id="id_siteGehoert" name="siteGehoert"><variable id="v_siteGehoert" name="siteGehoert" typeRef="boolean"/></inputData>
<inputData id="id_produkt" name="produkt"><variable id="v_produkt" name="produkt" typeRef="string"/></inputData>
<inputData id="id_menge" name="menge"><variable id="v_menge" name="menge" typeRef="number"/></inputData>
<inputData id="id_unveraendert" name="unveraendert"><variable id="v_unveraendert" name="unveraendert" typeRef="boolean"/></inputData>
<decision id="SpopZusatzRichtlinie" name="Zusatzleistung-Richtlinie"><description>Zulässige Menge, Verrechnungsband und Materialnummer der Zusatzleistungen: Speicherplatzerweiterung 540007510 (GB, Aktion quota-erhoehen der Site, Produkt spop-speicher), Erweitertes Reporting 540007511/540007703/540007702/540007704 (1–5/6–10/11–15/16–20 Pakete), SubSite Quota 540007513/540007705/540007706/540007707/540007708 (11–20/21–50/51–100/101–200/201–500). Annahmen: Speicher 1 bis 500 GB, Freigabe über 100 GB; SubSite Quota bis 10 in der Basis enthalten, Freigabe ab 101. Abgelehnt wird auch, wenn die Site nicht aktiv ist oder nicht der bestellenden Person gehört (siteGefunden, siteGehoert).</description><variable id="v_SpopZusatzRichtlinie" name="SpopZusatzRichtlinie"/>
<informationRequirement id="ir_siteGefunden"><requiredInput href="#id_siteGefunden"/></informationRequirement><informationRequirement id="ir_siteGehoert"><requiredInput href="#id_siteGehoert"/></informationRequirement><informationRequirement id="ir_produkt"><requiredInput href="#id_produkt"/></informationRequirement><informationRequirement id="ir_menge"><requiredInput href="#id_menge"/></informationRequirement><informationRequirement id="ir_unveraendert"><requiredInput href="#id_unveraendert"/></informationRequirement>
<decisionTable id="dt_SpopZusatzRichtlinie" hitPolicy="FIRST">
<input id="i0" label="siteGefunden"><inputExpression id="ie0" typeRef="boolean"><text>siteGefunden</text></inputExpression></input>
<input id="i1" label="siteGehoert"><inputExpression id="ie1" typeRef="boolean"><text>siteGehoert</text></inputExpression></input>
<input id="i2" label="produkt"><inputExpression id="ie2" typeRef="string"><text>produkt</text></inputExpression></input>
<input id="i3" label="menge"><inputExpression id="ie3" typeRef="number"><text>menge</text></inputExpression></input>
<input id="i4" label="unveraendert"><inputExpression id="ie4" typeRef="boolean"><text>unveraendert</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="material" name="material" typeRef="string"/>
<output id="o3" label="einheit" name="einheit" typeRef="string"/>
<output id="o4" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><inputEntry id="r1i4"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>""</text></outputEntry><outputEntry id="r1o3"><text>""</text></outputEntry><outputEntry id="r1o4"><text>"Die Site wurde nicht gefunden: kein aktiver Site-Strang mit dieser URL (/sites/&lt;amt&gt;-&lt;kurzname&gt;)."</text></outputEntry></rule>
<rule id="r2"><inputEntry id="r2i0"><text>-</text></inputEntry><inputEntry id="r2i1"><text>false</text></inputEntry><inputEntry id="r2i2"><text>-</text></inputEntry><inputEntry id="r2i3"><text>-</text></inputEntry><inputEntry id="r2i4"><text>-</text></inputEntry><outputEntry id="r2o0"><text>false</text></outputEntry><outputEntry id="r2o1"><text>false</text></outputEntry><outputEntry id="r2o2"><text>""</text></outputEntry><outputEntry id="r2o3"><text>""</text></outputEntry><outputEntry id="r2o4"><text>"Die Site gehört nicht der bestellenden Person: sie ist weder Besteller noch Empfänger der Site-Position."</text></outputEntry></rule>
<rule id="r3"><inputEntry id="r3i0"><text>-</text></inputEntry><inputEntry id="r3i1"><text>-</text></inputEntry><inputEntry id="r3i2"><text>-</text></inputEntry><inputEntry id="r3i3"><text>-</text></inputEntry><inputEntry id="r3i4"><text>true</text></inputEntry><outputEntry id="r3o0"><text>false</text></outputEntry><outputEntry id="r3o1"><text>false</text></outputEntry><outputEntry id="r3o2"><text>""</text></outputEntry><outputEntry id="r3o3"><text>""</text></outputEntry><outputEntry id="r3o4"><text>"Die Menge ist unverändert."</text></outputEntry></rule>
<rule id="r4"><inputEntry id="r4i0"><text>-</text></inputEntry><inputEntry id="r4i1"><text>-</text></inputEntry><inputEntry id="r4i2"><text>"spop-speicher"</text></inputEntry><inputEntry id="r4i3"><text>[1..100]</text></inputEntry><inputEntry id="r4i4"><text>-</text></inputEntry><outputEntry id="r4o0"><text>true</text></outputEntry><outputEntry id="r4o1"><text>false</text></outputEntry><outputEntry id="r4o2"><text>"540007510"</text></outputEntry><outputEntry id="r4o3"><text>"GB"</text></outputEntry><outputEntry id="r4o4"><text>"Speicherplatzerweiterung bis 100 GB: ohne Freigabe."</text></outputEntry></rule>
<rule id="r5"><inputEntry id="r5i0"><text>-</text></inputEntry><inputEntry id="r5i1"><text>-</text></inputEntry><inputEntry id="r5i2"><text>"spop-speicher"</text></inputEntry><inputEntry id="r5i3"><text>(100..500]</text></inputEntry><inputEntry id="r5i4"><text>-</text></inputEntry><outputEntry id="r5o0"><text>true</text></outputEntry><outputEntry id="r5o1"><text>true</text></outputEntry><outputEntry id="r5o2"><text>"540007510"</text></outputEntry><outputEntry id="r5o3"><text>"GB"</text></outputEntry><outputEntry id="r5o4"><text>"Speicherplatzerweiterung über 100 GB: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r6"><inputEntry id="r6i0"><text>-</text></inputEntry><inputEntry id="r6i1"><text>-</text></inputEntry><inputEntry id="r6i2"><text>"spop-speicher"</text></inputEntry><inputEntry id="r6i3"><text>-</text></inputEntry><inputEntry id="r6i4"><text>-</text></inputEntry><outputEntry id="r6o0"><text>false</text></outputEntry><outputEntry id="r6o1"><text>false</text></outputEntry><outputEntry id="r6o2"><text>""</text></outputEntry><outputEntry id="r6o3"><text>""</text></outputEntry><outputEntry id="r6o4"><text>"Speicherplatzerweiterung: 1 bis 500 GB."</text></outputEntry></rule>
<rule id="r7"><inputEntry id="r7i0"><text>-</text></inputEntry><inputEntry id="r7i1"><text>-</text></inputEntry><inputEntry id="r7i2"><text>"spop-reporting"</text></inputEntry><inputEntry id="r7i3"><text>[1..5]</text></inputEntry><inputEntry id="r7i4"><text>-</text></inputEntry><outputEntry id="r7o0"><text>true</text></outputEntry><outputEntry id="r7o1"><text>false</text></outputEntry><outputEntry id="r7o2"><text>"540007511"</text></outputEntry><outputEntry id="r7o3"><text>"Pakete"</text></outputEntry><outputEntry id="r7o4"><text>"Erweitertes Reporting 1–5 Pakete."</text></outputEntry></rule>
<rule id="r8"><inputEntry id="r8i0"><text>-</text></inputEntry><inputEntry id="r8i1"><text>-</text></inputEntry><inputEntry id="r8i2"><text>"spop-reporting"</text></inputEntry><inputEntry id="r8i3"><text>[6..10]</text></inputEntry><inputEntry id="r8i4"><text>-</text></inputEntry><outputEntry id="r8o0"><text>true</text></outputEntry><outputEntry id="r8o1"><text>false</text></outputEntry><outputEntry id="r8o2"><text>"540007703"</text></outputEntry><outputEntry id="r8o3"><text>"Pakete"</text></outputEntry><outputEntry id="r8o4"><text>"Erweitertes Reporting 6–10 Pakete."</text></outputEntry></rule>
<rule id="r9"><inputEntry id="r9i0"><text>-</text></inputEntry><inputEntry id="r9i1"><text>-</text></inputEntry><inputEntry id="r9i2"><text>"spop-reporting"</text></inputEntry><inputEntry id="r9i3"><text>[11..15]</text></inputEntry><inputEntry id="r9i4"><text>-</text></inputEntry><outputEntry id="r9o0"><text>true</text></outputEntry><outputEntry id="r9o1"><text>false</text></outputEntry><outputEntry id="r9o2"><text>"540007702"</text></outputEntry><outputEntry id="r9o3"><text>"Pakete"</text></outputEntry><outputEntry id="r9o4"><text>"Erweitertes Reporting 11–15 Pakete."</text></outputEntry></rule>
<rule id="r10"><inputEntry id="r10i0"><text>-</text></inputEntry><inputEntry id="r10i1"><text>-</text></inputEntry><inputEntry id="r10i2"><text>"spop-reporting"</text></inputEntry><inputEntry id="r10i3"><text>[16..20]</text></inputEntry><inputEntry id="r10i4"><text>-</text></inputEntry><outputEntry id="r10o0"><text>true</text></outputEntry><outputEntry id="r10o1"><text>false</text></outputEntry><outputEntry id="r10o2"><text>"540007704"</text></outputEntry><outputEntry id="r10o3"><text>"Pakete"</text></outputEntry><outputEntry id="r10o4"><text>"Erweitertes Reporting 16–20 Pakete."</text></outputEntry></rule>
<rule id="r11"><inputEntry id="r11i0"><text>-</text></inputEntry><inputEntry id="r11i1"><text>-</text></inputEntry><inputEntry id="r11i2"><text>"spop-reporting"</text></inputEntry><inputEntry id="r11i3"><text>-</text></inputEntry><inputEntry id="r11i4"><text>-</text></inputEntry><outputEntry id="r11o0"><text>false</text></outputEntry><outputEntry id="r11o1"><text>false</text></outputEntry><outputEntry id="r11o2"><text>""</text></outputEntry><outputEntry id="r11o3"><text>""</text></outputEntry><outputEntry id="r11o4"><text>"Erweitertes Reporting: 1 bis 20 Pakete."</text></outputEntry></rule>
<rule id="r12"><inputEntry id="r12i0"><text>-</text></inputEntry><inputEntry id="r12i1"><text>-</text></inputEntry><inputEntry id="r12i2"><text>"spop-subsite-quota"</text></inputEntry><inputEntry id="r12i3"><text>[11..20]</text></inputEntry><inputEntry id="r12i4"><text>-</text></inputEntry><outputEntry id="r12o0"><text>true</text></outputEntry><outputEntry id="r12o1"><text>false</text></outputEntry><outputEntry id="r12o2"><text>"540007513"</text></outputEntry><outputEntry id="r12o3"><text>"Subsites"</text></outputEntry><outputEntry id="r12o4"><text>"SubSite Quota 11–20."</text></outputEntry></rule>
