<rule id="r18"><inputEntry id="r18i0"><text>-</text></inputEntry><inputEntry id="r18i1"><text>-</text></inputEntry><inputEntry id="r18i2"><text>-</text></inputEntry><inputEntry id="r18i3"><text>-</text></inputEntry><inputEntry id="r18i4"><text>-</text></inputEntry><outputEntry id="r18o0"><text>false</text></outputEntry><outputEntry id="r18o1"><text>false</text></outputEntry><outputEntry id="r18o2"><text>""</text></outputEntry><outputEntry id="r18o3"><text>""</text></outputEntry><outputEntry id="r18o4"><text>"Unbekanntes Produkt: keine SPoP-Zusatzleistung."</text></outputEntry></rule>
</decisionTable></decision></definitions>
