<rule id="r15"><inputEntry id="r15i0"><text>-</text></inputEntry><inputEntry id="r15i1"><text>-</text></inputEntry><inputEntry id="r15i2"><text>"spop-subsite-quota"</text></inputEntry><inputEntry id="r15i3"><text>[101..200]</text></inputEntry><inputEntry id="r15i4"><text>-</text></inputEntry><outputEntry id="r15o0"><text>true</text></outputEntry><outputEntry id="r15o1"><text>true</text></outputEntry><outputEntry id="r15o2"><text>"540007707"</text></outputEntry><outputEntry id="r15o3"><text>"Subsites"</text></outputEntry><outputEntry id="r15o4"><text>"SubSite Quota 101–200: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r16"><inputEntry id="r16i0"><text>-</text></inputEntry><inputEntry id="r16i1"><text>-</text></inputEntry><inputEntry id="r16i2"><text>"spop-subsite-quota"</text></inputEntry><inputEntry id="r16i3"><text>[201..500]</text></inputEntry><inputEntry id="r16i4"><text>-</text></inputEntry><outputEntry id="r16o0"><text>true</text></outputEntry><outputEntry id="r16o1"><text>true</text></outputEntry><outputEntry id="r16o2"><text>"540007708"</text></outputEntry><outputEntry id="r16o3"><text>"Subsites"</text></outputEntry><outputEntry id="r16o4"><text>"SubSite Quota 201–500: Vier-Augen-Prinzip."</text></outputEntry></rule>
