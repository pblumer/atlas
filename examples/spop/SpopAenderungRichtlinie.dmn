<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopAenderungRichtlinie" name="SpopAenderungRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_siteGefunden" name="siteGefunden"><variable id="v_siteGefunden" name="siteGefunden" typeRef="boolean"/></inputData>
<inputData id="id_aenderung" name="aenderung"><variable id="v_aenderung" name="aenderung" typeRef="string"/></inputData>
<inputData id="id_gueltig" name="gueltig"><variable id="v_gueltig" name="gueltig" typeRef="boolean"/></inputData>
<inputData id="id_unveraendert" name="unveraendert"><variable id="v_unveraendert" name="unveraendert" typeRef="boolean"/></inputData>
<inputData id="id_siteTyp" name="siteTyp"><variable id="v_siteTyp" name="siteTyp" typeRef="string"/></inputData>
<inputData id="id_ownerWechsel" name="ownerWechsel"><variable id="v_ownerWechsel" name="ownerWechsel" typeRef="boolean"/></inputData>
<decision id="SpopAenderungRichtlinie" name="Site-Änderung-Richtlinie"><description>Prüft die Aktionen, die die Angaben einer bereitgestellten Site ändern: site-umbenennen (aenderung titel), site-url-aendern (url) und berechtigungen-aendern (berechtigungen). Ob die neuen Angaben gültig sind, berechnet der Prozess (gueltig), ebenso ob sie dem heutigen Stand entsprechen (unveraendert) und ob der Owner wechselt (ownerWechsel). Annahmen: Titeländerung ohne Freigabe; eine neue URL macht bestehende Links ungültig und braucht immer die Vier-Augen-Freigabe; ein Owner-Wechsel braucht sie bei Hermes, Communication und Publishing, wie die Owner-Zuweisung bei der Bestellung.</description><variable id="v_SpopAenderungRichtlinie" name="SpopAenderungRichtlinie"/>
<informationRequirement id="ir_siteGefunden"><requiredInput href="#id_siteGefunden"/></informationRequirement><informationRequirement id="ir_aenderung"><requiredInput href="#id_aenderung"/></informationRequirement><informationRequirement id="ir_gueltig"><requiredInput href="#id_gueltig"/></informationRequirement><informationRequirement id="ir_unveraendert"><requiredInput href="#id_unveraendert"/></informationRequirement><informationRequirement id="ir_siteTyp"><requiredInput href="#id_siteTyp"/></informationRequirement><informationRequirement id="ir_ownerWechsel"><requiredInput href="#id_ownerWechsel"/></informationRequirement>
<decisionTable id="dt_SpopAenderungRichtlinie" hitPolicy="FIRST">
<input id="i0" label="siteGefunden"><inputExpression id="ie0" typeRef="boolean"><text>siteGefunden</text></inputExpression></input>
<input id="i1" label="aenderung"><inputExpression id="ie1" typeRef="string"><text>aenderung</text></inputExpression></input>
<input id="i2" label="gueltig"><inputExpression id="ie2" typeRef="boolean"><text>gueltig</text></inputExpression></input>
<input id="i3" label="unveraendert"><inputExpression id="ie3" typeRef="boolean"><text>unveraendert</text></inputExpression></input>
<input id="i4" label="siteTyp"><inputExpression id="ie4" typeRef="string"><text>siteTyp</text></inputExpression></input>
<input id="i5" label="ownerWechsel"><inputExpression id="ie5" typeRef="boolean"><text>ownerWechsel</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><inputEntry id="r1i4"><text>-</text></inputEntry><inputEntry id="r1i5"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>"Die Site ist noch nicht bereitgestellt."</text></outputEntry></rule>
<rule id="r2"><inputEntry id="r2i0"><text>-</text></inputEntry><inputEntry id="r2i1"><text>"titel"</text></inputEntry><inputEntry id="r2i2"><text>false</text></inputEntry><inputEntry id="r2i3"><text>-</text></inputEntry><inputEntry id="r2i4"><text>-</text></inputEntry><inputEntry id="r2i5"><text>-</text></inputEntry><outputEntry id="r2o0"><text>false</text></outputEntry><outputEntry id="r2o1"><text>false</text></outputEntry><outputEntry id="r2o2"><text>"Der Titel muss 1 bis 80 Zeichen haben."</text></outputEntry></rule>
<rule id="r3"><inputEntry id="r3i0"><text>-</text></inputEntry><inputEntry id="r3i1"><text>"url"</text></inputEntry><inputEntry id="r3i2"><text>false</text></inputEntry><inputEntry id="r3i3"><text>-</text></inputEntry><inputEntry id="r3i4"><text>-</text></inputEntry><inputEntry id="r3i5"><text>-</text></inputEntry><outputEntry id="r3o0"><text>false</text></outputEntry><outputEntry id="r3o1"><text>false</text></outputEntry><outputEntry id="r3o2"><text>"Die neue URL ist ungültig oder vergeben: Amtskürzel 2 bis 6 Grossbuchstaben, Kurzname 3 bis 30 Zeichen aus Kleinbuchstaben, Ziffern und Bindestrichen."</text></outputEntry></rule>
<rule id="r4"><inputEntry id="r4i0"><text>-</text></inputEntry><inputEntry id="r4i1"><text>"berechtigungen"</text></inputEntry><inputEntry id="r4i2"><text>false</text></inputEntry><inputEntry id="r4i3"><text>-</text></inputEntry><inputEntry id="r4i4"><text>-</text></inputEntry><inputEntry id="r4i5"><text>-</text></inputEntry><outputEntry id="r4o0"><text>false</text></outputEntry><outputEntry id="r4o1"><text>false</text></outputEntry><outputEntry id="r4o2"><text>"Der Owner muss als UPN (name@domain) angegeben sein und im AD existieren."</text></outputEntry></rule>
<rule id="r5"><inputEntry id="r5i0"><text>-</text></inputEntry><inputEntry id="r5i1"><text>-</text></inputEntry><inputEntry id="r5i2"><text>-</text></inputEntry><inputEntry id="r5i3"><text>true</text></inputEntry><inputEntry id="r5i4"><text>-</text></inputEntry><inputEntry id="r5i5"><text>-</text></inputEntry><outputEntry id="r5o0"><text>false</text></outputEntry><outputEntry id="r5o1"><text>false</text></outputEntry><outputEntry id="r5o2"><text>"Die Angaben entsprechen dem heutigen Stand der Site; es gibt nichts zu ändern."</text></outputEntry></rule>
<rule id="r6"><inputEntry id="r6i0"><text>-</text></inputEntry><inputEntry id="r6i1"><text>"titel"</text></inputEntry><inputEntry id="r6i2"><text>-</text></inputEntry><inputEntry id="r6i3"><text>-</text></inputEntry><inputEntry id="r6i4"><text>-</text></inputEntry><inputEntry id="r6i5"><text>-</text></inputEntry><outputEntry id="r6o0"><text>true</text></outputEntry><outputEntry id="r6o1"><text>false</text></outputEntry><outputEntry id="r6o2"><text>"Titeländerung im Self-Service: ohne Freigabe."</text></outputEntry></rule>
<rule id="r7"><inputEntry id="r7i0"><text>-</text></inputEntry><inputEntry id="r7i1"><text>"url"</text></inputEntry><inputEntry id="r7i2"><text>-</text></inputEntry><inputEntry id="r7i3"><text>-</text></inputEntry><inputEntry id="r7i4"><text>-</text></inputEntry><inputEntry id="r7i5"><text>-</text></inputEntry><outputEntry id="r7o0"><text>true</text></outputEntry><outputEntry id="r7o1"><text>true</text></outputEntry><outputEntry id="r7o2"><text>"Eine neue Site-URL macht bestehende Links ungültig: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r8"><inputEntry id="r8i0"><text>-</text></inputEntry><inputEntry id="r8i1"><text>"berechtigungen"</text></inputEntry><inputEntry id="r8i2"><text>-</text></inputEntry><inputEntry id="r8i3"><text>-</text></inputEntry><inputEntry id="r8i4"><text>"hermes","communication","publishing"</text></inputEntry><inputEntry id="r8i5"><text>true</text></inputEntry><outputEntry id="r8o0"><text>true</text></outputEntry><outputEntry id="r8o1"><text>true</text></outputEntry><outputEntry id="r8o2"><text>"Owner-Wechsel bei Hermes, Communication oder Publishing: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r9"><inputEntry id="r9i0"><text>-</text></inputEntry><inputEntry id="r9i1"><text>"berechtigungen"</text></inputEntry><inputEntry id="r9i2"><text>-</text></inputEntry><inputEntry id="r9i3"><text>-</text></inputEntry><inputEntry id="r9i4"><text>-</text></inputEntry><inputEntry id="r9i5"><text>-</text></inputEntry><outputEntry id="r9o0"><text>true</text></outputEntry><outputEntry id="r9o1"><text>false</text></outputEntry><outputEntry id="r9o2"><text>"Berechtigungsänderung im Self-Service: ohne Freigabe."</text></outputEntry></rule>
<rule id="r10"><inputEntry id="r10i0"><text>-</text></inputEntry><inputEntry id="r10i1"><text>-</text></inputEntry><inputEntry id="r10i2"><text>-</text></inputEntry><inputEntry id="r10i3"><text>-</text></inputEntry><inputEntry id="r10i4"><text>-</text></inputEntry><inputEntry id="r10i5"><text>-</text></inputEntry><outputEntry id="r10o0"><text>false</text></outputEntry><outputEntry id="r10o1"><text>false</text></outputEntry><outputEntry id="r10o2"><text>"Unbekannte Änderung."</text></outputEntry></rule>
</decisionTable></decision></definitions>
