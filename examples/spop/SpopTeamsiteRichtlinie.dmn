<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopTeamsiteRichtlinie" name="SpopTeamsiteRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_amtGueltig" name="amtGueltig"><variable id="v_amtGueltig" name="amtGueltig" typeRef="boolean"/></inputData>
<inputData id="id_kurznameGueltig" name="kurznameGueltig"><variable id="v_kurznameGueltig" name="kurznameGueltig" typeRef="boolean"/></inputData>
<inputData id="id_produkt" name="produkt"><variable id="v_produkt" name="produkt" typeRef="string"/></inputData>
<inputData id="id_quotaWahl" name="quotaWahl"><variable id="v_quotaWahl" name="quotaWahl" typeRef="string"/></inputData>
<inputData id="id_quotaMb" name="quotaMb"><variable id="v_quotaMb" name="quotaMb" typeRef="number"/></inputData>
<inputData id="id_begruendungVorhanden" name="begruendungVorhanden"><variable id="v_begruendungVorhanden" name="begruendungVorhanden" typeRef="boolean"/></inputData>
<decision id="SpopTeamsiteRichtlinie" name="Site-Richtlinie (GF-001)"><description>Ersetzt amt_naming.rego, quota_limits.rego und approval.rego und bildet das Katalogprodukt auf den Site-Typ ab: Vorlage, Features, Standard- und Maximalquota, Freigabepflicht und Materialnummer. Annahmen: Amtskürzel 2 bis 6 Grossbuchstaben; Kurzname 3 bis 30 Zeichen; Vorlagen, Features, Grenzwerte und Freigabepflicht je Typ wie in der Tabelle; Hermes, Communication und Publishing immer mit Vier-Augen-Prinzip; individuelle Quota immer mit Freigabe.</description><variable id="v_SpopTeamsiteRichtlinie" name="SpopTeamsiteRichtlinie"/>
<informationRequirement id="ir_amtGueltig"><requiredInput href="#id_amtGueltig"/></informationRequirement><informationRequirement id="ir_kurznameGueltig"><requiredInput href="#id_kurznameGueltig"/></informationRequirement><informationRequirement id="ir_produkt"><requiredInput href="#id_produkt"/></informationRequirement><informationRequirement id="ir_quotaWahl"><requiredInput href="#id_quotaWahl"/></informationRequirement><informationRequirement id="ir_quotaMb"><requiredInput href="#id_quotaMb"/></informationRequirement><informationRequirement id="ir_begruendungVorhanden"><requiredInput href="#id_begruendungVorhanden"/></informationRequirement>
<decisionTable id="dt_SpopTeamsiteRichtlinie" hitPolicy="FIRST">
<input id="i0" label="amtGueltig"><inputExpression id="ie0" typeRef="boolean"><text>amtGueltig</text></inputExpression></input>
<input id="i1" label="kurznameGueltig"><inputExpression id="ie1" typeRef="boolean"><text>kurznameGueltig</text></inputExpression></input>
<input id="i2" label="produkt"><inputExpression id="ie2" typeRef="string"><text>produkt</text></inputExpression></input>
<input id="i3" label="quotaWahl"><inputExpression id="ie3" typeRef="string"><text>quotaWahl</text></inputExpression></input>
<input id="i4" label="quotaMb"><inputExpression id="ie4" typeRef="number"><text>quotaMb</text></inputExpression></input>
<input id="i5" label="begruendungVorhanden"><inputExpression id="ie5" typeRef="boolean"><text>begruendungVorhanden</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="quotaEffektivMb" name="quotaEffektivMb" typeRef="number"/>
<output id="o3" label="siteTyp" name="siteTyp" typeRef="string"/>
<output id="o4" label="template" name="template" typeRef="string"/>
<output id="o5" label="features" name="features" typeRef="string"/>
<output id="o6" label="material" name="material" typeRef="string"/>
<output id="o7" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><inputEntry id="r1i4"><text>-</text></inputEntry><inputEntry id="r1i5"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>0</text></outputEntry><outputEntry id="r1o3"><text>""</text></outputEntry><outputEntry id="r1o4"><text>""</text></outputEntry><outputEntry id="r1o5"><text>""</text></outputEntry><outputEntry id="r1o6"><text>""</text></outputEntry><outputEntry id="r1o7"><text>"Das Amtskürzel entspricht nicht der Namensregel (2 bis 6 Grossbuchstaben)."</text></outputEntry></rule>
