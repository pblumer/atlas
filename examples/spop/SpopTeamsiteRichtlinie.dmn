<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="defs_SpopTeamsiteRichtlinie" name="SpopTeamsiteRichtlinie" namespace="http://atlas/dmn">
<inputData id="id_amtGueltig" name="amtGueltig"><variable id="v_amtGueltig" name="amtGueltig" typeRef="boolean"/></inputData>
<inputData id="id_siteTyp" name="siteTyp"><variable id="v_siteTyp" name="siteTyp" typeRef="string"/></inputData>
<inputData id="id_quotaWahl" name="quotaWahl"><variable id="v_quotaWahl" name="quotaWahl" typeRef="string"/></inputData>
<inputData id="id_quotaMb" name="quotaMb"><variable id="v_quotaMb" name="quotaMb" typeRef="number"/></inputData>
<inputData id="id_begruendungVorhanden" name="begruendungVorhanden"><variable id="v_begruendungVorhanden" name="begruendungVorhanden" typeRef="boolean"/></inputData>
<decision id="SpopTeamsiteRichtlinie" name="TeamSite-Richtlinie (GF-001)"><description>Ersetzt amt_naming.rego, quota_limits.rego und approval.rego. Annahmen: Amtskürzel 2 bis 6 Grossbuchstaben; Standardquota Standard 5120 MB, Project 10240 MB, Department 20480 MB; Maximum 10240, 51200 und 102400 MB; Minimum 1024 MB; Vier-Augen-Prinzip ausser beim Self-Service Standard (Standard-Site mit Standardquota).</description><variable id="v_SpopTeamsiteRichtlinie" name="SpopTeamsiteRichtlinie"/>
<informationRequirement id="ir_amtGueltig"><requiredInput href="#id_amtGueltig"/></informationRequirement><informationRequirement id="ir_siteTyp"><requiredInput href="#id_siteTyp"/></informationRequirement><informationRequirement id="ir_quotaWahl"><requiredInput href="#id_quotaWahl"/></informationRequirement><informationRequirement id="ir_quotaMb"><requiredInput href="#id_quotaMb"/></informationRequirement><informationRequirement id="ir_begruendungVorhanden"><requiredInput href="#id_begruendungVorhanden"/></informationRequirement>
<decisionTable id="dt_SpopTeamsiteRichtlinie" hitPolicy="FIRST">
<input id="i0" label="amtGueltig"><inputExpression id="ie0" typeRef="boolean"><text>amtGueltig</text></inputExpression></input>
<input id="i1" label="siteTyp"><inputExpression id="ie1" typeRef="string"><text>siteTyp</text></inputExpression></input>
<input id="i2" label="quotaWahl"><inputExpression id="ie2" typeRef="string"><text>quotaWahl</text></inputExpression></input>
<input id="i3" label="quotaMb"><inputExpression id="ie3" typeRef="number"><text>quotaMb</text></inputExpression></input>
<input id="i4" label="begruendungVorhanden"><inputExpression id="ie4" typeRef="boolean"><text>begruendungVorhanden</text></inputExpression></input>
<output id="o0" label="zulaessig" name="zulaessig" typeRef="boolean"/>
<output id="o1" label="vierAugen" name="vierAugen" typeRef="boolean"/>
<output id="o2" label="quotaEffektivMb" name="quotaEffektivMb" typeRef="number"/>
<output id="o3" label="grund" name="grund" typeRef="string"/>
<rule id="r1"><inputEntry id="r1i0"><text>false</text></inputEntry><inputEntry id="r1i1"><text>-</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><inputEntry id="r1i3"><text>-</text></inputEntry><inputEntry id="r1i4"><text>-</text></inputEntry><outputEntry id="r1o0"><text>false</text></outputEntry><outputEntry id="r1o1"><text>false</text></outputEntry><outputEntry id="r1o2"><text>0</text></outputEntry><outputEntry id="r1o3"><text>"Das Amtskürzel entspricht nicht der Namensregel (2 bis 6 Grossbuchstaben)."</text></outputEntry></rule>
<rule id="r2"><inputEntry id="r2i0"><text>-</text></inputEntry><inputEntry id="r2i1"><text>not("Standard","Project","Department")</text></inputEntry><inputEntry id="r2i2"><text>-</text></inputEntry><inputEntry id="r2i3"><text>-</text></inputEntry><inputEntry id="r2i4"><text>-</text></inputEntry><outputEntry id="r2o0"><text>false</text></outputEntry><outputEntry id="r2o1"><text>false</text></outputEntry><outputEntry id="r2o2"><text>0</text></outputEntry><outputEntry id="r2o3"><text>"Unbekannter Site-Typ."</text></outputEntry></rule>
<rule id="r3"><inputEntry id="r3i0"><text>-</text></inputEntry><inputEntry id="r3i1"><text>-</text></inputEntry><inputEntry id="r3i2"><text>not("Standard","Custom")</text></inputEntry><inputEntry id="r3i3"><text>-</text></inputEntry><inputEntry id="r3i4"><text>-</text></inputEntry><outputEntry id="r3o0"><text>false</text></outputEntry><outputEntry id="r3o1"><text>false</text></outputEntry><outputEntry id="r3o2"><text>0</text></outputEntry><outputEntry id="r3o3"><text>"Unbekannte Quota-Wahl."</text></outputEntry></rule>
<rule id="r4"><inputEntry id="r4i0"><text>-</text></inputEntry><inputEntry id="r4i1"><text>-</text></inputEntry><inputEntry id="r4i2"><text>"Custom"</text></inputEntry><inputEntry id="r4i3"><text>-</text></inputEntry><inputEntry id="r4i4"><text>false</text></inputEntry><outputEntry id="r4o0"><text>false</text></outputEntry><outputEntry id="r4o1"><text>false</text></outputEntry><outputEntry id="r4o2"><text>0</text></outputEntry><outputEntry id="r4o3"><text>"Eine individuelle Quota braucht eine Begründung (mindestens 10 Zeichen)."</text></outputEntry></rule>
<rule id="r5"><inputEntry id="r5i0"><text>-</text></inputEntry><inputEntry id="r5i1"><text>-</text></inputEntry><inputEntry id="r5i2"><text>"Custom"</text></inputEntry><inputEntry id="r5i3"><text>&lt; 1024</text></inputEntry><inputEntry id="r5i4"><text>-</text></inputEntry><outputEntry id="r5o0"><text>false</text></outputEntry><outputEntry id="r5o1"><text>false</text></outputEntry><outputEntry id="r5o2"><text>0</text></outputEntry><outputEntry id="r5o3"><text>"Die Quota muss mindestens 1024 MB betragen."</text></outputEntry></rule>
<rule id="r6"><inputEntry id="r6i0"><text>-</text></inputEntry><inputEntry id="r6i1"><text>"Standard"</text></inputEntry><inputEntry id="r6i2"><text>"Custom"</text></inputEntry><inputEntry id="r6i3"><text>&gt; 10240</text></inputEntry><inputEntry id="r6i4"><text>-</text></inputEntry><outputEntry id="r6o0"><text>false</text></outputEntry><outputEntry id="r6o1"><text>false</text></outputEntry><outputEntry id="r6o2"><text>0</text></outputEntry><outputEntry id="r6o3"><text>"Über dem Maximum für Standard (10240 MB)."</text></outputEntry></rule>
<rule id="r7"><inputEntry id="r7i0"><text>-</text></inputEntry><inputEntry id="r7i1"><text>"Project"</text></inputEntry><inputEntry id="r7i2"><text>"Custom"</text></inputEntry><inputEntry id="r7i3"><text>&gt; 51200</text></inputEntry><inputEntry id="r7i4"><text>-</text></inputEntry><outputEntry id="r7o0"><text>false</text></outputEntry><outputEntry id="r7o1"><text>false</text></outputEntry><outputEntry id="r7o2"><text>0</text></outputEntry><outputEntry id="r7o3"><text>"Über dem Maximum für Project (51200 MB)."</text></outputEntry></rule>
<rule id="r8"><inputEntry id="r8i0"><text>-</text></inputEntry><inputEntry id="r8i1"><text>"Department"</text></inputEntry><inputEntry id="r8i2"><text>"Custom"</text></inputEntry><inputEntry id="r8i3"><text>&gt; 102400</text></inputEntry><inputEntry id="r8i4"><text>-</text></inputEntry><outputEntry id="r8o0"><text>false</text></outputEntry><outputEntry id="r8o1"><text>false</text></outputEntry><outputEntry id="r8o2"><text>0</text></outputEntry><outputEntry id="r8o3"><text>"Über dem Maximum für Department (102400 MB)."</text></outputEntry></rule>
<rule id="r9"><inputEntry id="r9i0"><text>-</text></inputEntry><inputEntry id="r9i1"><text>"Standard"</text></inputEntry><inputEntry id="r9i2"><text>"Standard"</text></inputEntry><inputEntry id="r9i3"><text>-</text></inputEntry><inputEntry id="r9i4"><text>-</text></inputEntry><outputEntry id="r9o0"><text>true</text></outputEntry><outputEntry id="r9o1"><text>false</text></outputEntry><outputEntry id="r9o2"><text>5120</text></outputEntry><outputEntry id="r9o3"><text>"Self-Service Standard: ohne Freigabe."</text></outputEntry></rule>
<rule id="r10"><inputEntry id="r10i0"><text>-</text></inputEntry><inputEntry id="r10i1"><text>"Standard"</text></inputEntry><inputEntry id="r10i2"><text>"Custom"</text></inputEntry><inputEntry id="r10i3"><text>-</text></inputEntry><inputEntry id="r10i4"><text>-</text></inputEntry><outputEntry id="r10o0"><text>true</text></outputEntry><outputEntry id="r10o1"><text>true</text></outputEntry><outputEntry id="r10o2"><text>quotaMb</text></outputEntry><outputEntry id="r10o3"><text>"Individuelle Quota: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r11"><inputEntry id="r11i0"><text>-</text></inputEntry><inputEntry id="r11i1"><text>"Project"</text></inputEntry><inputEntry id="r11i2"><text>"Standard"</text></inputEntry><inputEntry id="r11i3"><text>-</text></inputEntry><inputEntry id="r11i4"><text>-</text></inputEntry><outputEntry id="r11o0"><text>true</text></outputEntry><outputEntry id="r11o1"><text>true</text></outputEntry><outputEntry id="r11o2"><text>10240</text></outputEntry><outputEntry id="r11o3"><text>"Owner-Zuweisung ausserhalb Self-Service Standard: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r12"><inputEntry id="r12i0"><text>-</text></inputEntry><inputEntry id="r12i1"><text>"Project"</text></inputEntry><inputEntry id="r12i2"><text>"Custom"</text></inputEntry><inputEntry id="r12i3"><text>-</text></inputEntry><inputEntry id="r12i4"><text>-</text></inputEntry><outputEntry id="r12o0"><text>true</text></outputEntry><outputEntry id="r12o1"><text>true</text></outputEntry><outputEntry id="r12o2"><text>quotaMb</text></outputEntry><outputEntry id="r12o3"><text>"Owner-Zuweisung ausserhalb Self-Service Standard: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r13"><inputEntry id="r13i0"><text>-</text></inputEntry><inputEntry id="r13i1"><text>"Department"</text></inputEntry><inputEntry id="r13i2"><text>"Standard"</text></inputEntry><inputEntry id="r13i3"><text>-</text></inputEntry><inputEntry id="r13i4"><text>-</text></inputEntry><outputEntry id="r13o0"><text>true</text></outputEntry><outputEntry id="r13o1"><text>true</text></outputEntry><outputEntry id="r13o2"><text>20480</text></outputEntry><outputEntry id="r13o3"><text>"Owner-Zuweisung ausserhalb Self-Service Standard: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r14"><inputEntry id="r14i0"><text>-</text></inputEntry><inputEntry id="r14i1"><text>"Department"</text></inputEntry><inputEntry id="r14i2"><text>"Custom"</text></inputEntry><inputEntry id="r14i3"><text>-</text></inputEntry><inputEntry id="r14i4"><text>-</text></inputEntry><outputEntry id="r14o0"><text>true</text></outputEntry><outputEntry id="r14o1"><text>true</text></outputEntry><outputEntry id="r14o2"><text>quotaMb</text></outputEntry><outputEntry id="r14o3"><text>"Owner-Zuweisung ausserhalb Self-Service Standard: Vier-Augen-Prinzip."</text></outputEntry></rule>
<rule id="r15"><inputEntry id="r15i0"><text>-</text></inputEntry><inputEntry id="r15i1"><text>-</text></inputEntry><inputEntry id="r15i2"><text>-</text></inputEntry><inputEntry id="r15i3"><text>-</text></inputEntry><inputEntry id="r15i4"><text>-</text></inputEntry><outputEntry id="r15o0"><text>false</text></outputEntry><outputEntry id="r15o1"><text>false</text></outputEntry><outputEntry id="r15o2"><text>0</text></outputEntry><outputEntry id="r15o3"><text>"Die Bestellung ist unvollständig."</text></outputEntry></rule>
</decisionTable></decision></definitions>
