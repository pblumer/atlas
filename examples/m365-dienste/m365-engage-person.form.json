{
  "type": "default",
  "id": "m365-engage-person",
  "components": [
    {
      "type": "text",
      "text": "**Person aufnehmen · Add a person**"
    },
    {
      "key": "communityPerson",
      "type": "textfield",
      "label": "Person (UPN)",
      "validate": {
        "required": true,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
      }
    },
    {
      "key": "communityRolle",
      "type": "radio",
      "label": "Rolle · Role",
      "values": [
        {
          "label": "Mitglied · Member",
          "value": "mitglied"
        },
        {
          "label": "Admin",
          "value": "admin"
        }
      ],
      "defaultValue": "mitglied",
      "validate": {
        "required": true
      },
      "properties": {
        "personal": "false"
      }
    }
  ]
}
