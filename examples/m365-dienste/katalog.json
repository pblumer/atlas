    {
      "id": "m365-lizenz",
      "homeCatalog": "cat-m365-mitarbeitende",
      "state": "active",
      "texts": {
        "de": "Microsoft 365: Lizenz mit Postfach",
        "en": "Microsoft 365: licence with mailbox"
      },
      "descriptions": {
        "de": "Die Microsoft-365-Lizenz einer Person mit Office, Teams und dem Postfach in Exchange Online. Die Variante bestimmt die Lizenzstufe. Danach: Lizenz wechseln (E3, E5, F3), Abwesenheitsnotiz, Postfachkontingent, Weiterleitung in die eigene Domain, zusätzliche Mailadressen und Kalenderstellvertretung.",
        "en": "A person's Microsoft 365 licence with Office, Teams and the mailbox in Exchange Online. The variant sets the licence tier. Afterwards: change the licence (E3, E5, F3), automatic reply, mailbox quota, forwarding within the own domain, additional e-mail addresses and calendar delegates."
      },
      "variants": [
        {
          "id": "standard",
          "texts": {
            "de": "Standard (E3)",
            "en": "Standard (E3)"
          }
        },
        {
          "id": "erweitert",
          "texts": {
            "de": "Erweitert (E5)",
            "en": "Extended (E5)"
          }
        },
        {
          "id": "frontline",
          "texts": {
            "de": "Frontline (F3)",
            "en": "Frontline (F3)"
          }
        }
      ],
      "approval": {
        "kind": "proc_m365_genehmigung_vorgesetzter"
      },
      "lifecycleProcess": "proc_m365_lizenz",
      "configForm": "m365-lizenz-bestellung",
      "actions": [
        {
          "key": "provision",
          "message": "m365.lizenz.zuweisen",
          "effect": "provision"
        },
        {
          "key": "deprovision",
          "message": "m365.lizenz.entziehen",
          "effect": "deprovision",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Lizenz zurückgeben",
            "en": "Return the licence"
          }
        },
        {
          "key": "wechseln",
          "message": "m365.lizenz.wechseln",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Lizenz wechseln",
            "en": "Change the licence"
          },
          "form": "m365-lizenz-wechsel"
        },
        {
          "key": "abwesenheit",
          "message": "m365.postfach.abwesenheit",
          "effect": "service",
          "triggers": [
            "customer"
          ],
          "labels": {
            "de": "Abwesenheitsnotiz setzen",
            "en": "Set an automatic reply"
          },
          "form": "m365-abwesenheit"
        },
        {
          "key": "abwesenheit-beenden",
          "message": "m365.postfach.anwesend",
          "effect": "service",
          "triggers": [
            "customer"
          ],
          "labels": {
            "de": "Abwesenheitsnotiz beenden",
            "en": "End the automatic reply"
          }
        },
        {
          "key": "kontingent",
          "message": "m365.postfach.kontingent",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Postfachkontingent erhöhen",
            "en": "Increase the mailbox quota"
          },
          "form": "m365-postfach-kontingent"
        },
        {
          "key": "weiterleitung",
          "message": "m365.postfach.weiterleitung",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Weiterleitung setzen",
            "en": "Set mail forwarding"
          },
          "form": "m365-postfach-weiterleitung"
        },
        {
          "key": "weiterleitung-aus",
          "message": "m365.postfach.weiterleitung-aus",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Weiterleitung aufheben",
            "en": "Stop mail forwarding"
          }
        },
        {
          "key": "alias",
          "message": "m365.postfach.adresse",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Zusätzliche Mailadresse",
            "en": "Add an e-mail address"
          },
          "form": "m365-postfach-adresse"
        },
        {
          "key": "alias-weg",
          "message": "m365.postfach.adresse-weg",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Mailadresse entfernen",
            "en": "Remove an e-mail address"
          },
          "form": "m365-postfach-adresse"
        },
        {
          "key": "stellvertretung",
          "message": "m365.postfach.stellvertretung",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Kalenderstellvertretung erteilen",
            "en": "Grant a calendar delegate"
          },
          "form": "m365-postfach-stellvertretung"
        },
        {
          "key": "stellvertretung-weg",
          "message": "m365.postfach.stellvertretung-weg",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Kalenderstellvertretung entziehen",
            "en": "Remove a calendar delegate"
          },
          "form": "m365-postfach-stellvertretung"
        }
