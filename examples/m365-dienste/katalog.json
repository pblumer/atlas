    {
      "id": "m365-lizenz",
      "homeCatalog": "cat-m365-mitarbeitende",
      "state": "active",
      "texts": {
        "de": "Microsoft 365: Lizenz mit Postfach",
        "en": "Microsoft 365: licence with mailbox"
      },
      "descriptions": {
        "de": "Die Microsoft-365-Lizenz einer Person mit Office, Teams und dem Postfach in Exchange Online. Die Variante bestimmt die Lizenzstufe.",
        "en": "A person's Microsoft 365 licence with Office, Teams and the mailbox in Exchange Online. The variant sets the licence tier."
      },
      "variants": [
        {
          "id": "standard",
          "texts": {
            "de": "Standard (E3)",
            "en": "Standard (E3)"
          }
        },
        {
          "id": "erweitert",
          "texts": {
            "de": "Erweitert (E5)",
            "en": "Extended (E5)"
          }
        },
        {
          "id": "frontline",
          "texts": {
            "de": "Frontline (F3)",
            "en": "Frontline (F3)"
          }
        }
      ],
      "approval": {
        "kind": "proc_m365_genehmigung_vorgesetzter"
      },
      "lifecycleProcess": "proc_m365_lizenz",
      "configForm": "m365-person",
      "actions": [
        {
          "key": "provision",
          "message": "m365.lizenz.zuweisen",
          "effect": "provision"
        },
        {
          "key": "deprovision",
          "message": "m365.lizenz.entziehen",
          "effect": "deprovision",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Lizenz zurückgeben",
            "en": "Return the licence"
          }
        },
        {
          "key": "abwesenheit",
          "message": "m365.postfach.abwesenheit",
          "effect": "service",
          "triggers": [
            "customer"
          ],
          "labels": {
            "de": "Abwesenheitsnotiz setzen",
            "en": "Set an automatic reply"
          },
          "form": "m365-abwesenheit"
        },
        {
          "key": "abwesenheit-beenden",
          "message": "m365.postfach.anwesend",
          "effect": "service",
          "triggers": [
            "customer"
          ],
          "labels": {
            "de": "Abwesenheitsnotiz beenden",
            "en": "End the automatic reply"
          }
        }
      ],
      "keywords": [
