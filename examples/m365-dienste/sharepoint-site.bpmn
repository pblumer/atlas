<?xml version="1.0" encoding="UTF-8"?>
<!--
SharePoint: Team Site. Lebenszyklus-Prozess (anlegen, Gast, Besitzer, Kontingent, Sichtbarkeit, löschen, wiederherstellen, zurückgeben).
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_m365_sharepoint_site" targetNamespace="http://atlas/beispiel/m365-dienste">
  <message id="m_m365_site_erstellen" name="m365.site.erstellen"/>
  <message id="m_m365_site_rueckgabe" name="m365.site.rueckgabe"/>
  <message id="m_m365_site_gast" name="m365.site.gast"/>
  <message id="m_m365_site_besitzer" name="m365.site.besitzer"/>
  <message id="m_m365_site_kontingent" name="m365.site.kontingent"/>
  <error id="err_sp_admin" name="SharePoint-Verwaltung nicht erlaubt" errorCode="SHAREPOINT_ADMIN_NOT_PERMITTED"/>
  <error id="err_sp_quota" name="Kontingent abgelehnt" errorCode="SHAREPOINT_QUOTA_REFUSED"/>
  <message id="m_m365_site_loeschen" name="m365.site.loeschen"/>
  <message id="m_m365_site_wiederherstellen" name="m365.site.wiederherstellen"/>
  <message id="m_m365_site_sichtbarkeit" name="m365.site.sichtbarkeit"/>
  <itemDefinition id="item_Katalogposition" structureRef="Katalogposition"/>
  <itemDefinition id="item_M365Gruppe" structureRef="M365Gruppe"/>
  <itemDefinition id="item_SharePointSite" structureRef="SharePointSite"/>
  <itemDefinition id="item_SiteInventarEintrag" structureRef="SiteInventarEintrag"/>
  <dataStore id="ds_entra_id_konten" name="Entra ID: Konten"/>
  <dataStore id="ds_entra_id_gruppen" name="Entra ID: Gruppen"/>
  <dataStore id="ds_exchange_online_empfaenger" name="Exchange Online: Empfaenger"/>
  <dataStore id="ds_sharepoint_online_sites" name="SharePoint Online: Sites"/>
  <dataStore id="ds_sharepoint_online_site_inventar" name="SharePoint Online: Site-Inventar"/>
  <process id="proc_m365_sharepoint_site" name="SharePoint: Team Site" isExecutable="true" atlas:personal="besitzer,stellvertretung,besitzerKonto,stellvertretungKonto,email,anzeigename,einladung,neuerBesitzer,bisherigerBesitzer,neuerBesitzerKonto,bisherigerBesitzerKonto,kontingentBegruendung,sichtbarkeitBegruendung" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus einer SharePoint-Teamwebsite mit Microsoft-365-Gruppe: anlegen, Gäste einladen, Besitzer ändern, Speicher erhöhen, die Sichtbarkeit ändern (privat oder öffentlich), löschen, wiederherstellen und endgültig zurückgeben.

Eine gruppenverbundene moderne Teamwebsite ist eine Microsoft-365-Gruppe (groupTypes Unified, ohne Team), deren Alias (mailNickname) die URL der Site ist: /sites/&lt;alias&gt;. Der Prozess legt deshalb die Gruppe an und wartet, bis Microsoft die Site dazu bereitgestellt hat.

Governance:
- URL: Die bestellende Person wählt die URL; das Formular prüft live, ob sie frei ist (ADR-0519). Diese Prüfung ist eine Gefälligkeit. Verbindlich prüft die Bereitstellung noch einmal: bestehende Gruppen, gelöschte Gruppen im Papierkorb, eine Site unter derselben Adresse und Exchange-Empfänger (Funktionspostfächer, Verteiler, Kontakte), deren Alias oder Adresse die URL schon trägt.
- Namensregel: M365Namensregel mit dem Objekttyp site prüft die Form der URL und die reservierten Namen.
- Besitz: Jede Site hat zwei Besitzer (Besitzer und Stellvertretung).
- Inventar: Die Liste «Site-Inventar» auf der Site der Konstante SITE_INVENTAR führt jede Site mit Alias, Adresse, Gruppe, Sprache, Kontingent, Status und Katalog-Position, ohne Personendaten.
- Speicher: Microsoft Graph hat keine Schnittstelle für das Speicherkontingent einer Site. Der SharePoint-Worker setzt es deshalb mit set-site-quota über die SharePoint-Verwaltung (Admin-Host des Tenants); das braucht ein Zertifikat und die SharePoint-Anwendungsberechtigung Sites.FullControl.All. Fehlt beides oder lehnt der Tenant ab (etwa bei automatischer Speicherverwaltung), setzt es die Gruppe M365-SharePoint im SharePoint Admin Center; die Aufgaben sagen es.

Personendaten: besitzer, stellvertretung, die Adressen der Aktionen (email, anzeigename, neuerBesitzer, bisherigerBesitzer), die gelesenen Konten, die Einladung und die Begründungen (kontingentBegruendung, sichtbarkeitBegruendung) sind als Personendaten der empfangenden Person deklariert; sie stehen nur in Worker-Ausdrücken und Formularen, nie in einer Bedingung.</documentation>
    <extensionElements>
      <atlas:constants>
        <atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/>
        <atlas:constant name="NAME_PREFIX" type="json" source="application" value='""'/>
        <atlas:constant name="SHAREPOINT_HOST" type="string" source="application" value="contoso.sharepoint.com"/>
        <atlas:constant name="SITE_INVENTAR" type="string" source="application" value="contoso.sharepoint.com:/sites/m365-governance"/>
      </atlas:constants>
    </extensionElements>
    <startEvent id="s_neu" name="Site bestellt"><documentation>Start der Operation provision (Nachricht m365.site.erstellen). Die Bestellung bringt titel, url, sprache, kontingent, zweck, sichtbarkeit, besitzer und stellvertretung aus dem Formular m365-sharepoint-site-bestellung mit.</documentation><outgoing>f_s_neu__br_name</outgoing><messageEventDefinition messageRef="m_m365_site_erstellen"/></startEvent>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel mit dem Objekttyp site an (Governance). Anders als bei Teams wählt die bestellende Person die URL selbst; die Regel prüft sie. Das Input-Mapping übergibt die URL kleingeschrieben als slug, aber nur, wenn sie die Form ^[a-z0-9][a-z0-9_-]{2,63}$ hat (dieselbe wie das Muster im Formular); sonst ist slug leer, und die Regel lehnt mit einer Begründung ab. Reservierte Bezeichnungen (admin, postmaster, security …) gelten auch für Sites. bereich bleibt leer, weil eine Site kein Bereichskürzel trägt. Das Ergebnis steht danach in regel (erlaubt, grund, anzeigename = titel, alias = URL); Output-Mappings wertet Atlas auf einer Business-Rule-Task nicht aus.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source='="site"' target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source='=""' target="bereich"/><zeebe:input source="=titel" target="bezeichnung"/><zeebe:input source='=if url != null and matches(lower case(url), "^[a-z0-9][a-z0-9_-]{2,63}$") then lower case(url) else ""' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_neu__br_name</incoming><outgoing>f_br_name__gw_name</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_name" name="Namensregel erfüllt?" default="f_gw_name__st_ablehnen"><documentation>Nur ein ausdrücklich erlaubter Name führt weiter (fail-closed): Der Default-Fluss ist die Ablehnung.</documentation><incoming>f_br_name__gw_name</incoming><outgoing>f_gw_name__st_ablehnen</outgoing><outgoing>f_gw_name__sc_alias</outgoing></exclusiveGateway>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Meldet die Ablehnung über POST /api/v1/orders/{orderId}/lines/{itemId}/decision mit der Begründung der Namensregel. Eine verletzte Namensregel ist eine Entscheidung und keine Störung: kein Incident, die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + itemId + "/decision"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="Namensregel"' target="by"/><zeebe:input source='=regel.grund' target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_name__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing><dataOutputAssociation id="doa_st_ablehnen"><targetRef>dor_st_ablehnen</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt: Namensregel"><documentation>Die Position steht auf rejected; es ist nichts angelegt worden.</documentation><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <scriptTask id="sc_alias" name="Alias übernehmen"><documentation>Übernimmt regel.alias als eigene Variable alias, weil die folgenden Schritte und die Formulare der Aufgaben sie lesen.</documentation><extensionElements><zeebe:script expression='=regel.alias' resultVariable="alias"/></extensionElements><incoming>f_gw_name__sc_alias</incoming><outgoing>f_sc_alias__st_besitzer</outgoing></scriptTask>
    <serviceTask id="st_besitzer" name="Besitzer prüfen"><documentation>get-user liest das Konto aus besitzer, bevor irgendetwas angelegt wird: Eine falsche Adresse scheitert hier, ohne dass eine halbe Gruppe zurückbleibt. Die id braucht add-group-owner.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=besitzer" select="id,displayName,accountEnabled" resultVariable="besitzerKonto"/></extensionElements><incoming>f_sc_alias__st_besitzer</incoming><outgoing>f_st_besitzer__st_stv</outgoing></serviceTask>
    <serviceTask id="st_stv" name="Stellvertretung prüfen"><documentation>get-user liest das Konto der Stellvertretung (Secondary Owner). Zwei Besitzer verhindern eine verwaiste Site, wenn eine Person geht.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=stellvertretung" select="id,displayName,accountEnabled" resultVariable="stellvertretungKonto"/></extensionElements><incoming>f_st_besitzer__st_stv</incoming><outgoing>f_st_stv__st_gr_pruefen</outgoing></serviceTask>
    <serviceTask id="st_gr_pruefen" name="Gruppen prüfen"><documentation>Verbindliche Prüfung, ob die URL frei ist: list-groups mit mailNickname eq '&lt;alias&gt;'. Die Live-Prüfung im Bestellformular ist nur eine Gefälligkeit; zwischen Bestellung und Bereitstellung kann jemand anderes den Namen belegt haben.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,mailNickname" maxUsers="5" resultVariable="gruppenTreffer"/></extensionElements><incoming>f_st_stv__st_gr_pruefen</incoming><outgoing>f_st_gr_pruefen__st_del_pruefen</outgoing></serviceTask>
    <serviceTask id="st_del_pruefen" name="Gelöschte Gruppen prüfen"><documentation>list-deleted-groups mit demselben Filter: Eine gelöschte Microsoft-365-Gruppe behält ihren Alias 30 Tage lang im Papierkorb des Verzeichnisses, und eine neue Gruppe mit diesem Alias scheitert in dieser Zeit. Ob Graph den Filter auf deletedItems so annimmt, ist an keinem Tenant geprüft.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-deleted-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,mailNickname" maxUsers="5" resultVariable="geloeschtTreffer"/></extensionElements><incoming>f_st_gr_pruefen__st_del_pruefen</incoming><outgoing>f_st_del_pruefen__st_site_pruefen</outgoing></serviceTask>
    <serviceTask id="st_site_pruefen" name="Site-Adresse prüfen"><documentation>get-site auf &lt;SHAREPOINT_HOST&gt;:/sites/&lt;alias&gt;. Eine Site ohne Gruppe (eine klassische Site oder eine Kommunikationssite) belegt die Adresse ebenfalls. exists=false ist eine Antwort und kein Fehler.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="get-site" site="=application.SHAREPOINT_HOST + &quot;:/sites/&quot; + alias" resultVariable="siteAlt"/></extensionElements><incoming>f_st_del_pruefen__st_site_pruefen</incoming><outgoing>f_st_site_pruefen__st_ex_pruefen</outgoing></serviceTask>
    <serviceTask id="st_ex_pruefen" name="Exchange-Adressen prüfen"><documentation>run-get-cmdlet mit Get-Recipient und dem Filter (Alias -eq '&lt;alias&gt;') -or (EmailAddresses -like 'smtp:&lt;alias&gt;@*'): Die Gruppe erhält die Adresse &lt;alias&gt;@&lt;Domain&gt;, und ein Funktionspostfach, ein Verteiler oder ein Kontakt kann genau diese Adresse schon tragen, ohne dass Entra ID eine Gruppe dieses Namens kennt. Dasselbe fragt die Live-Prüfung im Formular (Quelle recipients des Exchange-Workers). ResultSize 1 und maxResults 1: Ein Treffer genügt für «vergeben». Das Ergebnis ist nicht als Personendatum deklariert, weil das Gateway es zählen muss. Damit es nie die Daten einer Person enthält, schliesst der Filter Empfänger aus, die für Personen stehen (UserMailbox, MailUser, GuestMailUser, MailContact): Gefunden werden nur Funktionspostfächer, Räume, Geräte, Verteiler und Gruppen. Hält das Postfach oder der Kontakt einer Person den Alias, merkt das erst create-group: Graph lehnt die doppelte Adresse ab, der Job wiederholt sich und endet als Incident, den M365-Administration sieht (README, Bekannte Grenzen). Die Live-Prüfung im Formular fragt dagegen alle Empfänger und erkennt diesen Fall schon bei der Eingabe; sie speichert nichts. Ob Exchange Online -like auf EmailAddresses mit einem Platzhalter am Ende in jedem Tenant auswertet, ist Microsofts Dokumentation und nicht an einem Tenant geprüft.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="run-get-cmdlet" cmdlet="Get-Recipient" parameters="{&quot;Filter&quot;: &quot;=\&quot;((Alias -eq '\&quot; + alias + \&quot;') -or (EmailAddresses -like 'smtp:\&quot; + alias + \&quot;@*')) -and (RecipientTypeDetails -ne 'UserMailbox') -and (RecipientTypeDetails -ne 'MailUser') -and (RecipientTypeDetails -ne 'GuestMailUser') -and (RecipientTypeDetails -ne 'MailContact')\&quot;&quot;, &quot;ResultSize&quot;: 1}" maxResults="1" resultVariable="exchangeTreffer"/></extensionElements><incoming>f_st_site_pruefen__st_ex_pruefen</incoming><outgoing>f_st_ex_pruefen__gw_frei</outgoing></serviceTask>
    <exclusiveGateway id="gw_frei" name="URL frei?" default="f_gw_frei__st_vergeben"><documentation>Weiter nur, wenn keine der vier Quellen die URL kennt (Gruppen, gelöschte Gruppen, Sites, Exchange-Empfänger). Der Default-Fluss ist die Ablehnung (fail-closed). Die Ergebnisse benennen niemanden und sind nicht als Personendaten deklariert; deshalb darf das Gateway sie lesen.</documentation><incoming>f_st_ex_pruefen__gw_frei</incoming><outgoing>f_gw_frei__st_vergeben</outgoing><outgoing>f_gw_frei__st_gruppe</outgoing></exclusiveGateway>
    <serviceTask id="st_vergeben" name="Ablehnung melden"><documentation>Meldet über die Entscheidungsroute die Ablehnung mit dem Grund «Die URL ist bereits vergeben». Auch das ist eine Entscheidung und keine Störung.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + itemId + "/decision"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="Verfügbarkeitsprüfung"' target="by"/><zeebe:input source='="Die URL ist bereits vergeben: /sites/" + alias' target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_frei__st_vergeben</incoming><outgoing>f_st_vergeben__e_vergeben</outgoing><dataOutputAssociation id="doa_st_vergeben"><targetRef>dor_st_vergeben</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_vergeben" name="Abgelehnt: URL vergeben"><documentation>Die Position steht auf rejected; es ist nichts angelegt worden.</documentation><incoming>f_st_vergeben__e_vergeben</incoming></endEvent>
    <serviceTask id="st_gruppe" name="Gruppe anlegen"><documentation>create-group: eine Microsoft-365-Gruppe (groupTypes Unified, mailEnabled true, securityEnabled false) ohne Team. mailNickname ist der Alias, deshalb liegt die Site unter /sites/&lt;alias&gt;; displayName ist der Titel. Microsoft legt die Teamwebsite zur Gruppe selbst an. Die Beschreibung nennt Zweck und Katalog-Position. preferredLanguage fehlt mit Absicht: Microsoft Graph lehnt es beim Anlegen einer Gruppe ab (HTTP 400 «Property preferredLanguage should not be set»). Die bestellte Sprache steht deshalb nur im Inventar.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="create-group" attributes='{"displayName": "=regel.anzeigename", "mailNickname": "=alias", "description": "=zweck + \" | SharePoint-Site | Katalog-Position \" + orderId + \"/\" + (if positionId = null then itemId else positionId)", "mailEnabled": true, "securityEnabled": false, "groupTypes": ["Unified"], "visibility": "=sichtbarkeit"}' resultVariable="gruppe"/></extensionElements><incoming>f_gw_frei__st_gruppe</incoming><outgoing>f_st_gruppe__st_owner1</outgoing><dataOutputAssociation id="doa_st_gruppe"><targetRef>dor_st_gruppe</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_owner1" name="Besitzer eintragen"><documentation>add-group-owner für die Person aus besitzer. Besitzer der Gruppe sind Besitzer der Site.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-owner" userId="=besitzerKonto.id" groupId="=gruppe.id"/></extensionElements><incoming>f_st_gruppe__st_owner1</incoming><outgoing>f_st_owner1__st_owner2</outgoing></serviceTask>
    <serviceTask id="st_owner2" name="Stellvertretung eintragen"><documentation>add-group-owner für die Stellvertretung.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-owner" userId="=stellvertretungKonto.id" groupId="=gruppe.id"/></extensionElements><incoming>f_st_owner1__st_owner2</incoming><outgoing>f_st_owner2__sc_zaehler</outgoing></serviceTask>
    <scriptTask id="sc_zaehler" name="Zähler setzen"><documentation>Setzt versuch auf 0. Die Site zu einer Gruppe entsteht asynchron und erfahrungsgemäss innert Minuten; der Prozess fragt deshalb höchstens zehnmal im Abstand von zwei Minuten nach.</documentation><extensionElements><zeebe:script expression='=0' resultVariable="versuch"/></extensionElements><incoming>f_st_owner2__sc_zaehler</incoming><outgoing>f_sc_zaehler__gw_wjoin</outgoing></scriptTask>
    <exclusiveGateway id="gw_wjoin"><documentation>Sammelt den ersten Durchgang und jede Wiederholung des Wartens.</documentation><incoming>f_sc_zaehler__gw_wjoin</incoming><incoming>f_gw_nochmal__gw_wjoin</incoming><outgoing>f_gw_wjoin__t_warten</outgoing></exclusiveGateway>
    <intermediateCatchEvent id="t_warten" name="Zwei Minuten warten"><documentation>Wartet zwei Minuten, bevor get-site nach der Site fragt.</documentation><incoming>f_gw_wjoin__t_warten</incoming><outgoing>f_t_warten__sc_versuch</outgoing><timerEventDefinition><timeDuration>PT2M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <scriptTask id="sc_versuch" name="Versuch zählen"><documentation>Erhöht versuch um eins.</documentation><extensionElements><zeebe:script expression='=versuch + 1' resultVariable="versuch"/></extensionElements><incoming>f_t_warten__sc_versuch</incoming><outgoing>f_sc_versuch__st_site_lesen</outgoing></scriptTask>
    <serviceTask id="st_site_lesen" name="Site lesen"><documentation>get-site auf &lt;SHAREPOINT_HOST&gt;:/sites/&lt;alias&gt;. Solange die Site noch nicht besteht, antwortet der Worker mit exists=false.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="get-site" site="=application.SHAREPOINT_HOST + &quot;:/sites/&quot; + alias" resultVariable="siteNeu"/></extensionElements><incoming>f_sc_versuch__st_site_lesen</incoming><outgoing>f_st_site_lesen__gw_site</outgoing><dataOutputAssociation id="doa_st_site_lesen"><targetRef>dor_st_site_lesen</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_site" name="Site bereit?" default="f_gw_site__gw_nochmal"><documentation>Weiter zum Inventar, sobald get-site die Site findet; sonst entscheidet der Zähler.</documentation><incoming>f_st_site_lesen__gw_site</incoming><outgoing>f_gw_site__gw_sjoin</outgoing><outgoing>f_gw_site__gw_nochmal</outgoing></exclusiveGateway>
    <exclusiveGateway id="gw_nochmal" name="Weiter warten?" default="f_gw_nochmal__ut_site"><documentation>Unter zehn Versuchen wird erneut gewartet. Danach (nach rund 20 Minuten) geht die Sache an M365-SharePoint, statt endlos weiterzufragen.</documentation><incoming>f_gw_site__gw_nochmal</incoming><outgoing>f_gw_nochmal__gw_wjoin</outgoing><outgoing>f_gw_nochmal__ut_site</outgoing></exclusiveGateway>
    <userTask id="ut_site" name="Site-Erstellung prüfen"><documentation>Aufgabe für M365-SharePoint: Die Gruppe besteht, aber ihre Site war nach zehn Versuchen noch nicht da. Im SharePoint Admin Center nachsehen und die Aufgabe abschliessen, sobald die Site besteht. Das Inventar erhält danach die Adresse, die die Gruppe im Formular nennt (siteUrlTatsaechlich), sonst die, die sich aus Host und Alias ergibt. Die Aktionen des Produkts erwarten die Site unter /sites/&lt;alias&gt;; eine abweichende Adresse ist von Hand zu bereinigen.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="M365-SharePoint"/><zeebe:formDefinition formId="m365-sharepoint-site-pruefen"/></extensionElements><incoming>f_gw_nochmal__ut_site</incoming><outgoing>f_ut_site__gw_sjoin</outgoing></userTask>
    <exclusiveGateway id="gw_sjoin"><documentation>Sammelt den automatischen und den manuellen Weg zur fertigen Site.</documentation><incoming>f_gw_site__gw_sjoin</incoming><incoming>f_ut_site__gw_sjoin</incoming><outgoing>f_gw_sjoin__st_inventar</outgoing></exclusiveGateway>
    <serviceTask id="st_inventar" name="Inventar-Eintrag anlegen"><documentation>create-item in der Liste «Site-Inventar» auf der Site der Applikationskonstante SITE_INVENTAR: Titel, Alias, Adresse, Gruppen-ID, Sprache, bestelltes Kontingent in GB, Status Active und die Katalog-Position. Keine Personendaten: Wer Besitzer ist, steht in Entra ID, nicht in einer Liste, die niemand nachführt.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="create-item" site="=application.SITE_INVENTAR" list="Site-Inventar"><atlas:itemField name="Title" value="=regel.anzeigename"/><atlas:itemField name="Alias" value="=alias"/><atlas:itemField name="SiteUrl" value="=if siteNeu.exists = true then siteNeu.webUrl else if siteUrlTatsaechlich != null and siteUrlTatsaechlich != &quot;&quot; then siteUrlTatsaechlich else &quot;https://&quot; + application.SHAREPOINT_HOST + &quot;/sites/&quot; + alias"/><atlas:itemField name="GroupId" value="=gruppe.id"/><atlas:itemField name="Sprache" value="=sprache"/><atlas:itemField name="KontingentGB" value="=number(kontingent)"/><atlas:itemField name="Status" value="Active"/><atlas:itemField name="Position" value="=orderId + &quot;/&quot; + (if positionId = null then itemId else positionId)"/></atlas:sharepointConnector></extensionElements><incoming>f_gw_sjoin__st_inventar</incoming><outgoing>f_st_inventar__st_done</outgoing><dataOutputAssociation id="doa_st_inventar"><targetRef>dor_st_inventar</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit erhält die empfangende Person das Recht im Bestand. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="done"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_inventar__st_done</incoming><outgoing>f_st_done__st_kontingent</outgoing><dataOutputAssociation id="doa_st_done"><targetRef>dor_st_done</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_kontingent" name="Speicherkontingent setzen"><documentation>set-site-quota setzt das bestellte Kontingent (kontingent, in GB) über die SharePoint-Verwaltung; SharePoint warnt bei 90 Prozent. Microsoft Graph kennt dafür keine Schnittstelle, deshalb geht dieser Schritt an den Admin-Host des Tenants und braucht ein Zertifikat und die SharePoint-Anwendungsberechtigung Sites.FullControl.All. Kann der Worker das nicht oder lehnt der Tenant ab, führen die beiden Fehlerränder zur Aufgabe «Speicherkontingent setzen von Hand».</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="set-site-quota" site="=if siteNeu.exists = true then siteNeu.webUrl else if siteUrlTatsaechlich != null and siteUrlTatsaechlich != &quot;&quot; then siteUrlTatsaechlich else &quot;https://&quot; + application.SHAREPOINT_HOST + &quot;/sites/&quot; + alias" quotaGB="=number(kontingent)" resultVariable="kontingentGesetztAuto"/></extensionElements><incoming>f_st_done__st_kontingent</incoming><outgoing>f_st_kontingent__e_bereit</outgoing></serviceTask>
    <boundaryEvent id="b_kont_admin" name="Verwaltung nicht erlaubt" attachedToRef="st_kontingent" cancelActivity="true"><documentation>SHAREPOINT_ADMIN_NOT_PERMITTED: Der Worker meldet sich mit einem Client-Secret an, oder der App fehlt Sites.FullControl.All. Das ändert kein zweiter Versuch; eine Person setzt das Kontingent.</documentation><outgoing>f_b_kont_admin__ut_kontingent</outgoing><errorEventDefinition errorRef="err_sp_admin"/></boundaryEvent>
    <boundaryEvent id="b_kont_quota" name="Kontingent abgelehnt" attachedToRef="st_kontingent" cancelActivity="true"><documentation>SHAREPOINT_QUOTA_REFUSED: SharePoint hat das Kontingent abgelehnt, meist weil der Tenant den Speicher automatisch verwaltet. Eine Person entscheidet im Admin Center.</documentation><outgoing>f_b_kont_quota__ut_kontingent</outgoing><errorEventDefinition errorRef="err_sp_quota"/></boundaryEvent>
    <userTask id="ut_kontingent" name="Speicherkontingent von Hand setzen"><documentation>Rückfall für M365-SharePoint, wenn set-site-quota das Kontingent nicht setzen konnte (Fehlerrand SHAREPOINT_ADMIN_NOT_PERMITTED oder SHAREPOINT_QUOTA_REFUSED): das bestellte Kontingent im SharePoint Admin Center (oder mit Set-SPOSite -StorageQuota) setzen. Die Site ist bereits nutzbar und hat bis dahin das Standardkontingent des Tenants.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="M365-SharePoint"/><zeebe:formDefinition formId="m365-sharepoint-kontingent-setzen"/></extensionElements><incoming>f_b_kont_admin__ut_kontingent</incoming><incoming>f_b_kont_quota__ut_kontingent</incoming><outgoing>f_ut_kontingent__e_bereit</outgoing></userTask>
    <endEvent id="e_bereit" name="Site bereit"><documentation>Gruppe, Site, Besitzer und Inventar-Eintrag bestehen; das Kontingent ist gesetzt.</documentation><incoming>f_st_kontingent__e_bereit</incoming><incoming>f_ut_kontingent__e_bereit</incoming></endEvent>
    <startEvent id="s_rueck" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (Nachricht m365.site.rueckgabe): Die Site wird endgültig zurückgegeben, das Recht endet.</documentation><outgoing>f_s_rueck__sc_alias2</outgoing><messageEventDefinition messageRef="m_m365_site_rueckgabe"/></startEvent>
    <scriptTask id="sc_alias2" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_rueck__sc_alias2</incoming><outgoing>f_sc_alias2__st_suchen2</outgoing></scriptTask>
    <serviceTask id="st_suchen2" name="Gruppe suchen"><documentation>list-groups mit dem Filter mailNickname eq '&lt;alias&gt;'. Ein Ergebnis ist die Gruppe der Site; keines heisst, dass sie nicht mehr besteht.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_sc_alias2__st_suchen2</incoming><outgoing>f_st_suchen2__gw_gef2</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef2" name="Gruppe vorhanden?" default="f_gw_gef2__st_loeschen2"><documentation>Eine Gruppe, die schon gelöscht ist (etwa über die Aktion «Site löschen»), ist zurückgegeben: Die Position wird trotzdem als zurückgegeben gemeldet, damit der Bestand kein Recht ohne Objekt führt.</documentation><incoming>f_st_suchen2__gw_gef2</incoming><outgoing>f_gw_gef2__st_loeschen2</outgoing><outgoing>f_gw_gef2__gw_join2</outgoing></exclusiveGateway>
    <serviceTask id="st_loeschen2" name="Gruppe löschen"><documentation>delete-group: Microsoft löscht mit der Gruppe auch ihre Site. Beides liegt danach 30 Tage im Papierkorb und lässt sich in dieser Zeit von einer Administratorin oder einem Administrator wiederherstellen; über den Shop nicht mehr, weil das Recht mit der Rückgabe endet.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="delete-group" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_gef2__st_loeschen2</incoming><outgoing>f_st_loeschen2__gw_join2</outgoing><dataOutputAssociation id="doa_st_loeschen2"><targetRef>dor_st_loeschen2</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_join2"><documentation>Sammelt beide Wege.</documentation><incoming>f_gw_gef2__gw_join2</incoming><incoming>f_st_loeschen2__gw_join2</incoming><outgoing>f_gw_join2__st_inv_suchen2</outgoing></exclusiveGateway>
    <serviceTask id="st_inv_suchen2" name="Inventar-Eintrag suchen"><documentation>list-items in der Liste «Site-Inventar» auf der Site der Applikationskonstante SITE_INVENTAR, gefiltert mit fields/Alias eq '&lt;alias&gt;'. Der Eintrag ist bei der Bereitstellung entstanden; fehlt er, scheitert der nächste Schritt als Incident, weil ein Bestand ohne Inventar-Eintrag von Hand zu klären ist.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="list-items" site="=application.SITE_INVENTAR" list="Site-Inventar" filter="=&quot;fields/Alias eq '&quot; + alias + &quot;'&quot;" select="Alias,Status,KontingentGB" maxResults="5" resultVariable="inventar"/></extensionElements><incoming>f_gw_join2__st_inv_suchen2</incoming><outgoing>f_st_inv_suchen2__st_inv_status2</outgoing></serviceTask>
    <serviceTask id="st_inv_status2" name="Inventar nachführen"><documentation>update-item setzt Status auf Returned.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="update-item" site="=application.SITE_INVENTAR" list="Site-Inventar" itemId="=inventar.items[1].id"><atlas:itemField name="Status" value="Returned"/></atlas:sharepointConnector></extensionElements><incoming>f_st_inv_suchen2__st_inv_status2</incoming><outgoing>f_st_inv_status2__st_returned</outgoing><dataOutputAssociation id="doa_st_inv_status2"><targetRef>dor_st_inv_status2</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Eine Rückgabe erhält atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_inv_status2__st_returned</incoming><outgoing>f_st_returned__e_rueck</outgoing><dataOutputAssociation id="doa_st_returned"><targetRef>dor_st_returned</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_rueck" name="Site zurückgegeben"><documentation>Gruppe und Site sind gelöscht, das Inventar sagt Returned.</documentation><incoming>f_st_returned__e_rueck</incoming></endEvent>
    <startEvent id="s_gast" name="Einladung angefragt"><documentation>Start der Aktion gast (Änderung, Nachricht m365.site.gast). Das Formular m365-sharepoint-gast liefert email und anzeigename; beide sind Personendaten.</documentation><outgoing>f_s_gast__sc_alias3</outgoing><messageEventDefinition messageRef="m_m365_site_gast"/></startEvent>
    <scriptTask id="sc_alias3" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_gast__sc_alias3</incoming><outgoing>f_sc_alias3__st_suchen3</outgoing></scriptTask>
    <serviceTask id="st_suchen3" name="Gruppe suchen"><documentation>list-groups mit dem Alias, wie bei der Rückgabe.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_sc_alias3__st_suchen3</incoming><outgoing>f_st_suchen3__st_site3</outgoing></serviceTask>
    <serviceTask id="st_site3" name="Site lesen"><documentation>get-site liefert webUrl, die Adresse, auf die die Einladung führt.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="get-site" site="=application.SHAREPOINT_HOST + &quot;:/sites/&quot; + alias" resultVariable="siteG"/></extensionElements><incoming>f_st_suchen3__st_site3</incoming><outgoing>f_st_site3__st_einladen</outgoing></serviceTask>
    <serviceTask id="st_einladen" name="Gast einladen"><documentation>invite-guest: POST /invitations mit Adresse und Anzeigename aus dem Formular; die Einladung führt auf die Site (inviteRedirectUrl) und Microsoft verschickt sie selbst (sendInvitationMessage). Das Ergebnis trägt in invitedUser.id das Gastkonto. Die Einstellungen des Tenants für externe Zusammenarbeit und für das Teilen in SharePoint müssen Gäste zulassen; sonst lehnt Graph ab, und es entsteht ein Incident.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="invite-guest" attributes='{"invitedUserEmailAddress": "=email", "invitedUserDisplayName": "=anzeigename", "inviteRedirectUrl": "=siteG.webUrl", "sendInvitationMessage": true}' resultVariable="einladung"/></extensionElements><incoming>f_st_site3__st_einladen</incoming><outgoing>f_st_einladen__st_gast_mitglied</outgoing></serviceTask>
    <serviceTask id="st_gast_mitglied" name="Gast aufnehmen"><documentation>add-group-member nimmt das Gastkonto in die Gruppe auf; Mitglieder der Gruppe sind Mitglieder der Site.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-member" userId="=einladung.invitedUser.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_st_einladen__st_gast_mitglied</incoming><outgoing>f_st_gast_mitglied__sd_gast</outgoing></serviceTask>
    <sendTask id="sd_gast" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «gast» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="gast" outcome="completed"/></extensionElements><incoming>f_st_gast_mitglied__sd_gast</incoming><outgoing>f_sd_gast__e_gast</outgoing></sendTask>
    <endEvent id="e_gast" name="Gast eingeladen"><documentation>Die externe Person ist eingeladen und Mitglied der Site.</documentation><incoming>f_sd_gast__e_gast</incoming></endEvent>
    <startEvent id="s_besitzer" name="Besitzerwechsel angefragt"><documentation>Start der Aktion besitzer (Änderung, Nachricht m365.site.besitzer). Das Formular m365-sharepoint-besitzer liefert neuerBesitzer, bisherigenEntfernen und gegebenenfalls bisherigerBesitzer.</documentation><outgoing>f_s_besitzer__sc_alias4</outgoing><messageEventDefinition messageRef="m_m365_site_besitzer"/></startEvent>
    <scriptTask id="sc_alias4" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_besitzer__sc_alias4</incoming><outgoing>f_sc_alias4__st_suchen4</outgoing></scriptTask>
    <serviceTask id="st_suchen4" name="Gruppe suchen"><documentation>list-groups mit dem Alias.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_sc_alias4__st_suchen4</incoming><outgoing>f_st_suchen4__st_neu_konto</outgoing></serviceTask>
    <serviceTask id="st_neu_konto" name="Neuen Besitzer prüfen"><documentation>get-user liest das Konto aus neuerBesitzer.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=neuerBesitzer" select="id,displayName,accountEnabled" resultVariable="neuerBesitzerKonto"/></extensionElements><incoming>f_st_suchen4__st_neu_konto</incoming><outgoing>f_st_neu_konto__st_owner_neu</outgoing></serviceTask>
    <serviceTask id="st_owner_neu" name="Besitzer eintragen"><documentation>add-group-owner. Zuerst kommt der neue Besitzer hinzu, erst danach geht der bisherige: So hat die Site in keinem Augenblick weniger Besitzer als vorher.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-owner" userId="=neuerBesitzerKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_st_neu_konto__st_owner_neu</incoming><outgoing>f_st_owner_neu__gw_bisher</outgoing></serviceTask>
    <exclusiveGateway id="gw_bisher" name="Bisherigen entfernen?" default="f_gw_bisher__gw_bjoin"><documentation>Liest bisherigenEntfernen, ein Feld, das niemanden benennt und deshalb als nicht personenbezogen markiert ist. Die Adresse selbst (bisherigerBesitzer) ist ein Personendatum und darf in keiner Bedingung stehen. Der Default-Fluss entfernt niemanden.</documentation><incoming>f_st_owner_neu__gw_bisher</incoming><outgoing>f_gw_bisher__gw_bjoin</outgoing><outgoing>f_gw_bisher__st_alt_konto</outgoing></exclusiveGateway>
    <serviceTask id="st_alt_konto" name="Bisherigen Besitzer prüfen"><documentation>get-user liest das Konto aus bisherigerBesitzer.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=bisherigerBesitzer" select="id,displayName" resultVariable="bisherigerBesitzerKonto"/></extensionElements><incoming>f_gw_bisher__st_alt_konto</incoming><outgoing>f_st_alt_konto__st_owner_alt</outgoing></serviceTask>
    <serviceTask id="st_owner_alt" name="Besitzer austragen"><documentation>remove-group-owner. Graph lehnt ab, wenn damit der letzte Besitzer ginge; das kann hier nicht eintreten, weil der neue schon eingetragen ist.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="remove-group-owner" userId="=bisherigerBesitzerKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_st_alt_konto__st_owner_alt</incoming><outgoing>f_st_owner_alt__gw_bjoin</outgoing></serviceTask>
    <exclusiveGateway id="gw_bjoin"><documentation>Sammelt beide Wege.</documentation><incoming>f_gw_bisher__gw_bjoin</incoming><incoming>f_st_owner_alt__gw_bjoin</incoming><outgoing>f_gw_bjoin__sd_besitzer</outgoing></exclusiveGateway>
    <sendTask id="sd_besitzer" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «besitzer» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="besitzer" outcome="completed"/></extensionElements><incoming>f_gw_bjoin__sd_besitzer</incoming><outgoing>f_sd_besitzer__e_besitzer</outgoing></sendTask>
    <endEvent id="e_besitzer" name="Besitzer geändert"><documentation>Die Besitzer der Site sind nachgeführt.</documentation><incoming>f_sd_besitzer__e_besitzer</incoming></endEvent>
    <startEvent id="s_kont" name="Mehr Speicher angefragt"><documentation>Start der Aktion kontingent (Änderung, Nachricht m365.site.kontingent). Das Formular m365-sharepoint-kontingent liefert neuesKontingent (Text, in GB) und kontingentBegruendung.</documentation><outgoing>f_s_kont__sc_alias5</outgoing><messageEventDefinition messageRef="m_m365_site_kontingent"/></startEvent>
    <scriptTask id="sc_alias5" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_kont__sc_alias5</incoming><outgoing>f_sc_alias5__st_site5</outgoing></scriptTask>
    <serviceTask id="st_site5" name="Site lesen"><documentation>get-site liefert die belegte und die verfügbare Menge (quota.used, quota.total, in Bytes), damit die Regel und die prüfende Person sehen, wie voll die Site ist.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="get-site" site="=application.SHAREPOINT_HOST + &quot;:/sites/&quot; + alias" resultVariable="siteJetzt"/></extensionElements><incoming>f_sc_alias5__st_site5</incoming><outgoing>f_st_site5__sc_belegt</outgoing></serviceTask>
    <scriptTask id="sc_belegt" name="Belegung umrechnen"><documentation>Rechnet quota.used in GB um, auf eine Stelle gerundet. Kennt get-site keine Belegung, bleibt belegtGB leer, und die Regel prüft nur die gewünschte Stufe.</documentation><extensionElements><zeebe:script expression='=if siteJetzt.exists = true and siteJetzt.quota != null and siteJetzt.quota.used != null then decimal(siteJetzt.quota.used / 1073741824, 1) else null' resultVariable="belegtGB"/></extensionElements><incoming>f_st_site5__sc_belegt</incoming><outgoing>f_sc_belegt__br_kont</outgoing></scriptTask>
    <businessRuleTask id="br_kont" name="Kontingentstufe prüfen"><documentation>Wendet M365SiteKontingent an: bis 25 GB ohne Prüfung, darüber bis 250 GB mit Prüfung durch M365-SharePoint, mehr oder weniger als belegt wird abgelehnt, alles andere fail-closed abgelehnt. Das Ergebnis steht in stufe (stufeErlaubt, pruefpflicht, grund).</documentation><extensionElements><zeebe:calledDecision decisionId="M365SiteKontingent" resultVariable="stufe"/><zeebe:ioMapping><zeebe:input source="=number(neuesKontingent)" target="gewuenschtGB"/><zeebe:input source="=belegtGB" target="belegtGB"/></zeebe:ioMapping></extensionElements><incoming>f_sc_belegt__br_kont</incoming><outgoing>f_br_kont__gw_stufe</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_stufe" name="Stufe erlaubt?" default="f_gw_stufe__gw_kabl"><documentation>Nur eine ausdrücklich erlaubte Stufe führt zur Aufgabe; der Default-Fluss ist die Ablehnung (fail-closed).</documentation><incoming>f_br_kont__gw_stufe</incoming><outgoing>f_gw_stufe__st_kont5</outgoing><outgoing>f_gw_stufe__sc_hinweis</outgoing><outgoing>f_gw_stufe__gw_kabl</outgoing></exclusiveGateway>
    <serviceTask id="st_kont5" name="Kontingent setzen"><documentation>Eine erlaubte Stufe ohne Prüfpflicht (bis 25 GB) setzt der SharePoint-Worker selbst: set-site-quota mit neuesKontingent über die SharePoint-Verwaltung. Kann er das nicht oder lehnt der Tenant ab, geht der Antrag an die Aufgabe «Kontingent prüfen und setzen».</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="set-site-quota" site="=if siteJetzt.exists = true then siteJetzt.webUrl else application.SHAREPOINT_HOST + &quot;:/sites/&quot; + alias" quotaGB="=number(neuesKontingent)" resultVariable="kontingentGesetztAuto"/></extensionElements><incoming>f_gw_stufe__st_kont5</incoming><outgoing>f_st_kont5__st_inv_suchen5</outgoing></serviceTask>
    <boundaryEvent id="b_kont5_admin" name="Verwaltung nicht erlaubt" attachedToRef="st_kont5" cancelActivity="true"><documentation>SHAREPOINT_ADMIN_NOT_PERMITTED: weiter zur Aufgabe.</documentation><outgoing>f_b_kont5_admin__sc_hinweis</outgoing><errorEventDefinition errorRef="err_sp_admin"/></boundaryEvent>
    <boundaryEvent id="b_kont5_quota" name="Kontingent abgelehnt" attachedToRef="st_kont5" cancelActivity="true"><documentation>SHAREPOINT_QUOTA_REFUSED: weiter zur Aufgabe.</documentation><outgoing>f_b_kont5_quota__sc_hinweis</outgoing><errorEventDefinition errorRef="err_sp_quota"/></boundaryEvent>
    <scriptTask id="sc_hinweis" name="Hinweis bilden"><documentation>Übernimmt stufe.grund als pruefhinweis, damit das Formular der Aufgabe ihn zeigt.</documentation><extensionElements><zeebe:script expression='=stufe.grund' resultVariable="pruefhinweis"/></extensionElements><incoming>f_gw_stufe__sc_hinweis</incoming><incoming>f_b_kont5_admin__sc_hinweis</incoming><incoming>f_b_kont5_quota__sc_hinweis</incoming><outgoing>f_sc_hinweis__ut_kont</outgoing></scriptTask>
    <userTask id="ut_kont" name="Kontingent prüfen und setzen"><documentation>Aufgabe für M365-SharePoint: Verlangt die Regel eine Prüfung, entscheidet die Gruppe über den Antrag; sonst setzt sie das Kontingent nur. Gesetzt wird es im SharePoint Admin Center, weil Microsoft Graph keine Schnittstelle dafür hat.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="M365-SharePoint"/><zeebe:formDefinition formId="m365-sharepoint-kontingent-pruefung"/></extensionElements><incoming>f_sc_hinweis__ut_kont</incoming><outgoing>f_ut_kont__gw_entscheid</outgoing></userTask>
    <exclusiveGateway id="gw_entscheid" name="Kontingent gesetzt?" default="f_gw_entscheid__gw_kabl"><documentation>kontingentEntscheid kommt aus dem Formular der Aufgabe und benennt niemanden. Nur «gesetzt» führt das Inventar nach.</documentation><incoming>f_ut_kont__gw_entscheid</incoming><outgoing>f_gw_entscheid__st_inv_suchen5</outgoing><outgoing>f_gw_entscheid__gw_kabl</outgoing></exclusiveGateway>
    <serviceTask id="st_inv_suchen5" name="Inventar-Eintrag suchen"><documentation>list-items in der Liste «Site-Inventar» auf der Site der Applikationskonstante SITE_INVENTAR, gefiltert mit fields/Alias eq '&lt;alias&gt;'. Der Eintrag ist bei der Bereitstellung entstanden; fehlt er, scheitert der nächste Schritt als Incident, weil ein Bestand ohne Inventar-Eintrag von Hand zu klären ist.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="list-items" site="=application.SITE_INVENTAR" list="Site-Inventar" filter="=&quot;fields/Alias eq '&quot; + alias + &quot;'&quot;" select="Alias,Status,KontingentGB" maxResults="5" resultVariable="inventar"/></extensionElements><incoming>f_gw_entscheid__st_inv_suchen5</incoming><incoming>f_st_kont5__st_inv_suchen5</incoming><outgoing>f_st_inv_suchen5__st_inv_k</outgoing></serviceTask>
    <serviceTask id="st_inv_k" name="Inventar nachführen"><documentation>update-item setzt KontingentGB auf das neue Kontingent.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="update-item" site="=application.SITE_INVENTAR" list="Site-Inventar" itemId="=inventar.items[1].id"><atlas:itemField name="KontingentGB" value="=number(neuesKontingent)"/></atlas:sharepointConnector></extensionElements><incoming>f_st_inv_suchen5__st_inv_k</incoming><outgoing>f_st_inv_k__sd_kont</outgoing><dataOutputAssociation id="doa_st_inv_k"><targetRef>dor_st_inv_k</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_kont" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «kontingent» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="kontingent" outcome="completed"/></extensionElements><incoming>f_st_inv_k__sd_kont</incoming><outgoing>f_sd_kont__e_kont</outgoing></sendTask>
    <endEvent id="e_kont" name="Kontingent erhöht"><documentation>Das neue Kontingent ist gesetzt und im Inventar vermerkt.</documentation><incoming>f_sd_kont__e_kont</incoming></endEvent>
    <exclusiveGateway id="gw_kabl"><documentation>Sammelt die Ablehnung durch die Regel und durch M365-SharePoint.</documentation><incoming>f_gw_stufe__gw_kabl</incoming><incoming>f_gw_entscheid__gw_kabl</incoming><outgoing>f_gw_kabl__sd_kont_abl</outgoing></exclusiveGateway>
    <sendTask id="sd_kont_abl" name="Ablehnung melden"><documentation>Eine Shop-Aufgabe meldet die Aktion «kontingent» als rejected (ADR-0429: die Ablehnung einer Kundenaktion ist das Ergebnis rejected). Der Grund steht in stufe.grund bzw. im Kommentar der Aufgabe, nicht im Ergebnis: Eine Shop-Aufgabe trägt keinen Text.</documentation><extensionElements><atlas:shopTask mode="outcome" action="kontingent" outcome="rejected"/></extensionElements><incoming>f_gw_kabl__sd_kont_abl</incoming><outgoing>f_sd_kont_abl__e_kont_abl</outgoing></sendTask>
    <endEvent id="e_kont_abl" name="Kontingent abgelehnt"><documentation>Das Kontingent bleibt, wie es war.</documentation><incoming>f_sd_kont_abl__e_kont_abl</incoming></endEvent>
    <startEvent id="s_loesch" name="Löschen angefragt"><documentation>Start der Aktion loeschen (Änderung, Nachricht m365.site.loeschen). Anders als die Rückgabe lässt sie das Recht bestehen: Die Site ist gelöscht, kann aber 30 Tage lang mit der Aktion «Gelöschte Site wiederherstellen» zurückgeholt werden.</documentation><outgoing>f_s_loesch__sc_alias6</outgoing><messageEventDefinition messageRef="m_m365_site_loeschen"/></startEvent>
    <scriptTask id="sc_alias6" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_loesch__sc_alias6</incoming><outgoing>f_sc_alias6__st_suchen6</outgoing></scriptTask>
    <serviceTask id="st_suchen6" name="Gruppe suchen"><documentation>list-groups mit dem Filter mailNickname eq '&lt;alias&gt;'. Ein Ergebnis ist die Gruppe der Site; keines heisst, dass sie nicht mehr besteht.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_sc_alias6__st_suchen6</incoming><outgoing>f_st_suchen6__gw_gef6</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef6" name="Gruppe vorhanden?" default="f_gw_gef6__st_loeschen6"><documentation>Ist die Gruppe schon weg, gibt es nichts zu löschen; das Inventar wird trotzdem nachgeführt.</documentation><incoming>f_st_suchen6__gw_gef6</incoming><outgoing>f_gw_gef6__st_loeschen6</outgoing><outgoing>f_gw_gef6__gw_join6</outgoing></exclusiveGateway>
    <serviceTask id="st_loeschen6" name="Gruppe löschen"><documentation>delete-group: Gruppe und Site landen im Papierkorb und bleiben 30 Tage wiederherstellbar; danach löscht Microsoft sie endgültig.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="delete-group" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_gef6__st_loeschen6</incoming><outgoing>f_st_loeschen6__gw_join6</outgoing><dataOutputAssociation id="doa_st_loeschen6"><targetRef>dor_st_loeschen6</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_join6"><documentation>Sammelt beide Wege.</documentation><incoming>f_gw_gef6__gw_join6</incoming><incoming>f_st_loeschen6__gw_join6</incoming><outgoing>f_gw_join6__st_inv_suchen6</outgoing></exclusiveGateway>
    <serviceTask id="st_inv_suchen6" name="Inventar-Eintrag suchen"><documentation>list-items in der Liste «Site-Inventar» auf der Site der Applikationskonstante SITE_INVENTAR, gefiltert mit fields/Alias eq '&lt;alias&gt;'. Der Eintrag ist bei der Bereitstellung entstanden; fehlt er, scheitert der nächste Schritt als Incident, weil ein Bestand ohne Inventar-Eintrag von Hand zu klären ist.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="list-items" site="=application.SITE_INVENTAR" list="Site-Inventar" filter="=&quot;fields/Alias eq '&quot; + alias + &quot;'&quot;" select="Alias,Status,KontingentGB" maxResults="5" resultVariable="inventar"/></extensionElements><incoming>f_gw_join6__st_inv_suchen6</incoming><outgoing>f_st_inv_suchen6__st_inv_status6</outgoing></serviceTask>
    <serviceTask id="st_inv_status6" name="Inventar nachführen"><documentation>update-item setzt Status auf Removed.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="update-item" site="=application.SITE_INVENTAR" list="Site-Inventar" itemId="=inventar.items[1].id"><atlas:itemField name="Status" value="Removed"/></atlas:sharepointConnector></extensionElements><incoming>f_st_inv_suchen6__st_inv_status6</incoming><outgoing>f_st_inv_status6__sd_loesch</outgoing><dataOutputAssociation id="doa_st_inv_status6"><targetRef>dor_st_inv_status6</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_loesch" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «loeschen» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="loeschen" outcome="completed"/></extensionElements><incoming>f_st_inv_status6__sd_loesch</incoming><outgoing>f_sd_loesch__e_loesch</outgoing></sendTask>
    <endEvent id="e_loesch" name="Site gelöscht"><documentation>Gruppe und Site liegen im Papierkorb; das Inventar sagt Removed.</documentation><incoming>f_sd_loesch__e_loesch</incoming></endEvent>
    <startEvent id="s_wieder" name="Wiederherstellung angefragt"><documentation>Start der Aktion wiederherstellen (Änderung, Nachricht m365.site.wiederherstellen).</documentation><outgoing>f_s_wieder__sc_alias7</outgoing><messageEventDefinition messageRef="m_m365_site_wiederherstellen"/></startEvent>
    <scriptTask id="sc_alias7" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_wieder__sc_alias7</incoming><outgoing>f_sc_alias7__st_geloescht7</outgoing></scriptTask>
    <serviceTask id="st_geloescht7" name="Gelöschte Gruppe suchen"><documentation>list-deleted-groups mit mailNickname eq '&lt;alias&gt;'. Ein Ergebnis ist die gelöschte Gruppe; keines heisst, dass die 30 Tage vorbei sind oder die Gruppe nie gelöscht wurde.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-deleted-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname,deletedDateTime" maxUsers="5" resultVariable="geloescht"/></extensionElements><incoming>f_sc_alias7__st_geloescht7</incoming><outgoing>f_st_geloescht7__gw_wieder</outgoing></serviceTask>
    <exclusiveGateway id="gw_wieder" name="Noch wiederherstellbar?" default="f_gw_wieder__sd_wieder_abl"><documentation>Weiter nur mit einem Treffer; der Default-Fluss meldet die Ablehnung (fail-closed).</documentation><incoming>f_st_geloescht7__gw_wieder</incoming><outgoing>f_gw_wieder__st_restore</outgoing><outgoing>f_gw_wieder__sd_wieder_abl</outgoing></exclusiveGateway>
    <serviceTask id="st_restore" name="Gruppe wiederherstellen"><documentation>restore-group holt die Gruppe aus dem Papierkorb des Verzeichnisses; Microsoft stellt laut seiner Dokumentation die Site mit ihr wieder her. An einem Tenant ist das nicht geprüft.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="restore-group" groupId="=geloescht[1].id"/></extensionElements><incoming>f_gw_wieder__st_restore</incoming><outgoing>f_st_restore__st_inv_suchen7</outgoing><dataOutputAssociation id="doa_st_restore"><targetRef>dor_st_restore</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_inv_suchen7" name="Inventar-Eintrag suchen"><documentation>list-items in der Liste «Site-Inventar» auf der Site der Applikationskonstante SITE_INVENTAR, gefiltert mit fields/Alias eq '&lt;alias&gt;'. Der Eintrag ist bei der Bereitstellung entstanden; fehlt er, scheitert der nächste Schritt als Incident, weil ein Bestand ohne Inventar-Eintrag von Hand zu klären ist.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="list-items" site="=application.SITE_INVENTAR" list="Site-Inventar" filter="=&quot;fields/Alias eq '&quot; + alias + &quot;'&quot;" select="Alias,Status,KontingentGB" maxResults="5" resultVariable="inventar"/></extensionElements><incoming>f_st_restore__st_inv_suchen7</incoming><outgoing>f_st_inv_suchen7__st_inv_status7</outgoing></serviceTask>
    <serviceTask id="st_inv_status7" name="Inventar nachführen"><documentation>update-item setzt Status wieder auf Active.</documentation><extensionElements><atlas:sharepointConnector connector="ucc_sharepoint" operation="update-item" site="=application.SITE_INVENTAR" list="Site-Inventar" itemId="=inventar.items[1].id"><atlas:itemField name="Status" value="Active"/></atlas:sharepointConnector></extensionElements><incoming>f_st_inv_suchen7__st_inv_status7</incoming><outgoing>f_st_inv_status7__sd_wieder</outgoing><dataOutputAssociation id="doa_st_inv_status7"><targetRef>dor_st_inv_status7</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_wieder" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «wiederherstellen» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="wiederherstellen" outcome="completed"/></extensionElements><incoming>f_st_inv_status7__sd_wieder</incoming><outgoing>f_sd_wieder__e_wieder</outgoing></sendTask>
    <endEvent id="e_wieder" name="Site wiederhergestellt"><documentation>Gruppe und Site bestehen wieder; das Inventar sagt Active.</documentation><incoming>f_sd_wieder__e_wieder</incoming></endEvent>
    <sendTask id="sd_wieder_abl" name="Ablehnung melden"><documentation>Eine Shop-Aufgabe meldet die Aktion «wiederherstellen» als rejected: Die Site ist nicht mehr wiederherstellbar.</documentation><extensionElements><atlas:shopTask mode="outcome" action="wiederherstellen" outcome="rejected"/></extensionElements><incoming>f_gw_wieder__sd_wieder_abl</incoming><outgoing>f_sd_wieder_abl__e_wieder_abl</outgoing></sendTask>
    <endEvent id="e_wieder_abl" name="Nicht wiederherstellbar"><documentation>Im Papierkorb liegt keine Gruppe mit diesem Alias.</documentation><incoming>f_sd_wieder_abl__e_wieder_abl</incoming></endEvent>
    <startEvent id="s_sicht" name="Sichtbarkeit angefragt"><documentation>Start der Aktion sichtbarkeit (Änderung, Nachricht m365.site.sichtbarkeit). Das Formular m365-sichtbarkeit liefert neueSichtbarkeit (Private oder Public) und sichtbarkeitBegruendung. Wie «Externe Person einladen» und «Site-Besitzer ändern» ohne eigene Genehmigung: Die Aktion fragt die verantwortliche Person der Site, und ein Besitzer kann die Datenschutzeinstellung der Site auch selbst umstellen; die Genehmigung der Bestellung hat entschieden, wem die Site gehört, nicht wie sichtbar sie ist. Die Begründung bleibt in den Variablen der Instanz.</documentation><outgoing>f_s_sicht__sc_alias8</outgoing><messageEventDefinition messageRef="m_m365_site_sichtbarkeit"/></startEvent>
    <scriptTask id="sc_alias8" name="Alias bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel bei der Bereitstellung übernommen hat: kleingeschrieben und mit dem Präfix NAME_PREFIX davor. Für eine Site ist der Alias die URL selbst (/sites/&lt;alias&gt;) und der mailNickname der Gruppe; die Namensregel muss deshalb nicht noch einmal laufen. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression='=(if application.NAME_PREFIX = null then "" else application.NAME_PREFIX) + lower case(url)' resultVariable="alias"/></extensionElements><incoming>f_s_sicht__sc_alias8</incoming><outgoing>f_sc_alias8__st_suchen8</outgoing></scriptTask>
    <serviceTask id="st_suchen8" name="Gruppe suchen"><documentation>list-groups mit dem Filter mailNickname eq '&lt;alias&gt;'; visibility zeigt, wie die Site heute steht.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;mailNickname eq '&quot; + alias + &quot;'&quot;" select="id,displayName,mailNickname,visibility" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_sc_alias8__st_suchen8</incoming><outgoing>f_st_suchen8__gw_sicht</outgoing></serviceTask>
    <exclusiveGateway id="gw_sicht" name="Gruppe gefunden?" default="f_gw_sicht__sd_sicht_abl"><documentation>Weiter nur mit genau einem Treffer und einer Sichtbarkeit, die Graph kennt (Private oder Public); der Default-Fluss meldet die Ablehnung (fail-closed), etwa für eine Site, die mit «Site löschen» im Papierkorb liegt. neueSichtbarkeit benennt niemanden und ist deshalb nicht als Personendatum deklariert; nur so darf das Gateway sie lesen.</documentation><incoming>f_st_suchen8__gw_sicht</incoming><outgoing>f_gw_sicht__st_sicht</outgoing><outgoing>f_gw_sicht__sd_sicht_abl</outgoing></exclusiveGateway>
    <serviceTask id="st_sicht" name="Sichtbarkeit setzen"><documentation>update-group: PATCH /groups/{id} mit visibility. Die Datenschutzeinstellung einer gruppenverbundenen Teamwebsite ist die Sichtbarkeit ihrer Microsoft-365-Gruppe; SharePoint übernimmt sie. Ein PATCH mit der Sichtbarkeit, die die Gruppe schon hat, ändert nichts, deshalb lässt sich die Aktion wiederholen. Das Site-Inventar führt keine Sichtbarkeit und bleibt unverändert.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="update-group" groupId="=treffer[1].id" attributes='{"visibility": "=neueSichtbarkeit"}'/></extensionElements><incoming>f_gw_sicht__st_sicht</incoming><outgoing>f_st_sicht__sd_sicht</outgoing><dataOutputAssociation id="doa_st_sicht"><targetRef>dor_st_sicht</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_sicht" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «sichtbarkeit» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="sichtbarkeit" outcome="completed"/></extensionElements><incoming>f_st_sicht__sd_sicht</incoming><outgoing>f_sd_sicht__e_sicht</outgoing></sendTask>
    <endEvent id="e_sicht" name="Sichtbarkeit geändert"><documentation>Die Gruppe und mit ihr die Site haben die neue Sichtbarkeit.</documentation><incoming>f_sd_sicht__e_sicht</incoming></endEvent>
    <sendTask id="sd_sicht_abl" name="Ablehnung melden"><documentation>Eine Shop-Aufgabe meldet die Aktion «sichtbarkeit» als rejected: Unter dem Alias steht keine Gruppe (oder mehr als eine), oder die verlangte Sichtbarkeit ist weder Private noch Public.</documentation><extensionElements><atlas:shopTask mode="outcome" action="sichtbarkeit" outcome="rejected"/></extensionElements><incoming>f_gw_sicht__sd_sicht_abl</incoming><outgoing>f_sd_sicht_abl__e_sicht_abl</outgoing></sendTask>
    <endEvent id="e_sicht_abl" name="Nicht geändert"><documentation>Die Sichtbarkeit bleibt, wie sie war.</documentation><incoming>f_sd_sicht_abl__e_sicht_abl</incoming></endEvent>
    <sequenceFlow id="f_s_neu__br_name" sourceRef="s_neu" targetRef="br_name"/>
    <sequenceFlow id="f_br_name__gw_name" sourceRef="br_name" targetRef="gw_name"/>
    <sequenceFlow id="f_gw_name__st_ablehnen" sourceRef="gw_name" targetRef="st_ablehnen" name="nein"/>
    <sequenceFlow id="f_gw_name__sc_alias" sourceRef="gw_name" targetRef="sc_alias" name="ja"><conditionExpression>=regel.erlaubt = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_st_ablehnen__e_abgelehnt" sourceRef="st_ablehnen" targetRef="e_abgelehnt"/>
    <sequenceFlow id="f_sc_alias__st_besitzer" sourceRef="sc_alias" targetRef="st_besitzer"/>
    <sequenceFlow id="f_st_besitzer__st_stv" sourceRef="st_besitzer" targetRef="st_stv"/>
    <sequenceFlow id="f_st_stv__st_gr_pruefen" sourceRef="st_stv" targetRef="st_gr_pruefen"/>
    <sequenceFlow id="f_st_gr_pruefen__st_del_pruefen" sourceRef="st_gr_pruefen" targetRef="st_del_pruefen"/>
    <sequenceFlow id="f_st_del_pruefen__st_site_pruefen" sourceRef="st_del_pruefen" targetRef="st_site_pruefen"/>
    <sequenceFlow id="f_st_site_pruefen__st_ex_pruefen" sourceRef="st_site_pruefen" targetRef="st_ex_pruefen"/>
    <sequenceFlow id="f_st_ex_pruefen__gw_frei" sourceRef="st_ex_pruefen" targetRef="gw_frei"/>
    <sequenceFlow id="f_gw_frei__st_vergeben" sourceRef="gw_frei" targetRef="st_vergeben" name="nein"/>
    <sequenceFlow id="f_gw_frei__st_gruppe" sourceRef="gw_frei" targetRef="st_gruppe" name="ja"><conditionExpression>=count(gruppenTreffer) = 0 and count(geloeschtTreffer) = 0 and siteAlt.exists = false and count(exchangeTreffer) = 0</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_st_vergeben__e_vergeben" sourceRef="st_vergeben" targetRef="e_vergeben"/>
    <sequenceFlow id="f_st_gruppe__st_owner1" sourceRef="st_gruppe" targetRef="st_owner1"/>
    <sequenceFlow id="f_st_owner1__st_owner2" sourceRef="st_owner1" targetRef="st_owner2"/>
    <sequenceFlow id="f_st_owner2__sc_zaehler" sourceRef="st_owner2" targetRef="sc_zaehler"/>
    <sequenceFlow id="f_sc_zaehler__gw_wjoin" sourceRef="sc_zaehler" targetRef="gw_wjoin"/>
    <sequenceFlow id="f_gw_wjoin__t_warten" sourceRef="gw_wjoin" targetRef="t_warten"/>
    <sequenceFlow id="f_t_warten__sc_versuch" sourceRef="t_warten" targetRef="sc_versuch"/>
    <sequenceFlow id="f_sc_versuch__st_site_lesen" sourceRef="sc_versuch" targetRef="st_site_lesen"/>
    <sequenceFlow id="f_st_site_lesen__gw_site" sourceRef="st_site_lesen" targetRef="gw_site"/>
    <sequenceFlow id="f_gw_site__gw_sjoin" sourceRef="gw_site" targetRef="gw_sjoin" name="ja"><conditionExpression>=siteNeu.exists = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_site__gw_nochmal" sourceRef="gw_site" targetRef="gw_nochmal" name="nein"/>
