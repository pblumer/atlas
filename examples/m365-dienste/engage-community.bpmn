<?xml version="1.0" encoding="UTF-8"?>
<!--
Viva Engage: Community. Lebenszyklus-Prozess mit vier Nachrichtenstarts (anlegen, löschen, Person aufnehmen, Person entfernen).
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_m365_engage_community" targetNamespace="http://atlas/beispiel/m365-dienste">
  <message id="m_m365_community_erstellen" name="m365.community.erstellen"/>
  <message id="m_m365_community_loeschen" name="m365.community.loeschen"/>
  <message id="m_m365_community_mitglied" name="m365.community.mitglied"/>
  <message id="m_m365_community_mitglied_weg" name="m365.community.mitglied-weg"/>
  <itemDefinition id="item_EngageCommunity" structureRef="EngageCommunity"/>
  <itemDefinition id="item_Katalogposition" structureRef="Katalogposition"/>
  <dataStore id="ds_entra_id_konten" name="Entra ID: Konten"/>
  <dataStore id="ds_entra_id_gruppen" name="Entra ID: Gruppen"/>
  <process id="proc_m365_engage_community" name="Viva Engage: Community" isExecutable="true" atlas:personal="besitzer,besitzerKonto,communityPerson,communityPersonKonto" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus einer Community in Viva Engage: anlegen, Personen aufnehmen und entfernen, löschen. Produkt m365-engage, ein Prozess, Form pro Operation (ADR-0425/0429).

Eine Community steht auf einer Microsoft-365-Gruppe, die Viva Engage zu ihr anlegt. Angelegt wird die Community über Microsoft Graph (create-community); Mitglieder und Admins führt der Prozess auf dieser Gruppe (add-group-member, add-group-owner, remove-group-member, remove-group-owner), und die Rückgabe löscht die Gruppe.

Governance:
- Namensregel: M365Namensregel mit dem Objekttyp community bildet den Anzeigenamen «EC-&lt;BEREICH&gt; &lt;Bezeichnung&gt;» und lehnt reservierte und zu lange Namen ab. Den Alias der Gruppe wählt Viva Engage; Rückgabe und Aktionen finden die Gruppe deshalb über ihren Anzeigenamen, den dieselbe Namensregel aus denselben Antworten bildet.
- Besitz: Die Community entsteht mit der Person aus besitzer als erstem Admin.
- Herkunft: Die Beschreibung nennt die Katalog-Position.
- Nicht fertig ist keine Störung: Schliesst Viva Engage den Vorgang nicht innert der Grenze des Workers ab, prüft M365-Administration, statt dass eine Wiederholung eine zweite Community anlegt.

Voraussetzungen (Microsofts Dokumentation, an keinem Tenant geprüft): Der Tenant läuft in Viva Engage im nativen Modus (Native Mode), und der Worker ucc_entra hat Community.ReadWrite.All.

Personendaten: besitzer, communityPerson und die gelesenen Konten sind als Personendaten der empfangenden Person deklariert; sie stehen nur in Worker-Ausdrücken und Formularen, nie in einer Bedingung.

Worker: ucc_entra.</documentation>
    <extensionElements>
      <atlas:constants>
        <atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/>
        <atlas:constant name="NAME_PREFIX" type="json" source="application" value='""'/>
      </atlas:constants>
    </extensionElements>
    <startEvent id="s_neu" name="Community bestellt"><documentation>Start der Operation provision (Nachricht m365.community.erstellen), nach der Genehmigung durch die vorgesetzte Person der Besitzerin oder des Besitzers. Die Bestellung bringt bereich, bezeichnung, beschreibung, sichtbarkeit und besitzer.</documentation><outgoing>f_s_neu__br_name</outgoing><messageEventDefinition messageRef="m_m365_community_erstellen"/></startEvent>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel mit dem Objekttyp community an (Präfix EC): Anzeigename «EC-&lt;BEREICH&gt; &lt;Bezeichnung&gt;», reservierte und zu lange Namen werden mit Begründung abgelehnt. Die Eingabe slug normalisiert die Bezeichnung im Input-Mapping. bereich und bezeichnung benennen niemanden; nur so darf die Engine sie auswerten. Das Ergebnis steht in regel (erlaubt, grund, anzeigename, alias).</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source='="community"' target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source="=bereich" target="bereich"/><zeebe:input source="=bezeichnung" target="bezeichnung"/><zeebe:input source='=replace(replace(replace(replace(replace(replace(replace(lower case(bezeichnung), "ä", "ae"), "ö", "oe"), "ü", "ue"), "[éèê]", "e"), "[àâ]", "a"), "[^a-z0-9]+", "-"), "^-+|-+$", "")' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_neu__br_name</incoming><outgoing>f_br_name__gw_name</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_name" name="Namensregel erfüllt?" default="f_gw_name__st_ablehnen"><documentation>Nur ein ausdrücklich erlaubter Name führt weiter (fail-closed): Der Default-Fluss ist die Ablehnung.</documentation><incoming>f_br_name__gw_name</incoming><outgoing>f_gw_name__st_ablehnen</outgoing><outgoing>f_gw_name__st_besitzer</outgoing></exclusiveGateway>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Meldet die Ablehnung über POST /api/v1/orders/{orderId}/lines/{itemId}/decision mit der Begründung der Namensregel. Eine Entscheidung und keine Störung.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + itemId + "/decision"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="Namensregel"' target="by"/><zeebe:input source="=regel.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_name__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing><dataOutputAssociation id="doa_st_ablehnen"><targetRef>dor_st_ablehnen</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt: Namensregel"><documentation>Die Position steht auf rejected; nichts ist angelegt.</documentation><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <serviceTask id="st_besitzer" name="Besitzer prüfen"><documentation>get-user liest das Konto aus besitzer, bevor etwas angelegt wird: Eine falsche Adresse scheitert hier. create-community braucht die id des Kontos, denn eine Community, die eine Anwendung anlegt, muss nach Microsofts Dokumentation eine Besitzerin oder einen Besitzer nennen.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=besitzer" select="id,displayName,accountEnabled" resultVariable="besitzerKonto"/></extensionElements><incoming>f_gw_name__st_besitzer</incoming><outgoing>f_st_besitzer__st_pruefen</outgoing></serviceTask>
    <serviceTask id="st_pruefen" name="Name prüfen"><documentation>Verbindliche Prüfung, ob der Name frei ist: list-groups mit displayName eq '&lt;Anzeigename&gt;' (ein Apostroph im Namen wird verdoppelt, wie OData es verlangt). Annahme: Die Microsoft-365-Gruppe einer Community trägt den Anzeigenamen der Community; so beschreibt Microsoft die Gruppe einer Community, an einem Tenant ist es nicht geprüft. Ein Treffer lehnt die Position ab. Den Alias (mailNickname) der Gruppe wählt Viva Engage selbst; geprüft wird deshalb der Anzeigename. Das Ergebnis benennt niemanden (id und displayName einer Gruppe).</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;displayName eq '&quot; + replace(regel.anzeigename, &quot;'&quot;, &quot;''&quot;) + &quot;'&quot;" select="id,displayName" maxUsers="5" resultVariable="namensTreffer"/></extensionElements><incoming>f_st_besitzer__st_pruefen</incoming><outgoing>f_st_pruefen__gw_frei</outgoing></serviceTask>
    <exclusiveGateway id="gw_frei" name="Name frei?" default="f_gw_frei__st_vergeben"><documentation>Weiter nur ohne Treffer; der Default-Fluss ist die Ablehnung (fail-closed).</documentation><incoming>f_st_pruefen__gw_frei</incoming><outgoing>f_gw_frei__st_community</outgoing><outgoing>f_gw_frei__st_vergeben</outgoing></exclusiveGateway>
    <serviceTask id="st_vergeben" name="Ablehnung melden"><documentation>Meldet über die Entscheidungsroute die Ablehnung mit dem Grund «Der Name ist bereits vergeben».</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + itemId + "/decision"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="Verfügbarkeitsprüfung"' target="by"/><zeebe:input source="=&quot;Der Name ist bereits vergeben: &quot; + regel.anzeigename" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_frei__st_vergeben</incoming><outgoing>f_st_vergeben__e_vergeben</outgoing><dataOutputAssociation id="doa_st_vergeben"><targetRef>dor_st_vergeben</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_vergeben" name="Abgelehnt: Name vergeben"><documentation>Die Position steht auf rejected; nichts ist angelegt.</documentation><incoming>f_st_vergeben__e_vergeben</incoming></endEvent>
    <serviceTask id="st_community" name="Community anlegen"><documentation>create-community (POST /employeeExperience/communities) mit Anzeigename, Beschreibung samt Katalog-Position und Sichtbarkeit; die Besitzerin oder der Besitzer wird als owners@odata.bind gebunden. Graph antwortet mit einem Vorgang, dem der Worker bis zu seiner Grenze folgt. Fertig: community trägt id, displayName, privacy und groupId. Nicht fertig: community.id ist null, mit status und operation; der Worker schliesst den Job trotzdem ab, damit eine Wiederholung keine zweite Community anlegt.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="create-community" userId="=besitzerKonto.id" attributes="{&quot;displayName&quot;: &quot;=regel.anzeigename&quot;, &quot;description&quot;: &quot;=beschreibung + \&quot; | Katalog-Position \&quot; + orderId + \&quot;/\&quot; + (if positionId = null then itemId else positionId)&quot;, &quot;privacy&quot;: &quot;=sichtbarkeit&quot;}" resultVariable="community"/></extensionElements><incoming>f_gw_frei__st_community</incoming><outgoing>f_st_community__gw_id</outgoing><dataOutputAssociation id="doa_st_community"><targetRef>dor_st_community</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_id" name="Community fertig?" default="f_gw_id__sc_hinweis"><documentation>community.id ist null, wenn Viva Engage den Vorgang innert der Grenze des Workers nicht abgeschlossen hat. Der Default-Fluss geht an einen Menschen: Ohne id ist nichts bestätigt.</documentation><incoming>f_st_community__gw_id</incoming><outgoing>f_gw_id__gw_cjoin</outgoing><outgoing>f_gw_id__sc_hinweis</outgoing></exclusiveGateway>
    <scriptTask id="sc_hinweis" name="Hinweis bilden"><documentation>Bildet communityHinweis aus Name, Status und Vorgang, damit das Formular der Aufgabe ihn zeigt. Nichts davon benennt eine Person.</documentation><extensionElements><zeebe:script expression='="Community «" + regel.anzeigename + "», Status " + (if community.status = null then "unbekannt" else community.status) + ", Vorgang " + (if community.operation = null then "unbekannt" else community.operation)' resultVariable="communityHinweis"/></extensionElements><incoming>f_gw_id__sc_hinweis</incoming><outgoing>f_sc_hinweis__ut_pruefen</outgoing></scriptTask>
    <userTask id="ut_pruefen" name="Community in Viva Engage prüfen"><documentation>Aufgabe für M365-Administration: Im Viva Engage Admin Center (oder mit GET auf den Vorgang aus communityHinweis) nachsehen, ob die Community entstanden ist, und die id ihrer Microsoft-365-Gruppe eintragen (communityGruppeId). Ist sie nicht entstanden, die Aufgabe nicht abschliessen, sondern die Community von Hand anlegen oder die Bestellung zurückweisen lassen.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="M365-Administration"/><zeebe:formDefinition formId="m365-engage-pruefen"/></extensionElements><incoming>f_sc_hinweis__ut_pruefen</incoming><outgoing>f_ut_pruefen__st_gruppe</outgoing></userTask>
    <serviceTask id="st_gruppe" name="Gruppe lesen"><documentation>get-group mit der eingetragenen id: Eine falsch abgeschriebene id scheitert hier als Incident, statt als bereitgestellt gemeldet zu werden.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-group" groupId="=communityGruppeId" select="id,displayName" resultVariable="communityGruppe"/></extensionElements><incoming>f_ut_pruefen__st_gruppe</incoming><outgoing>f_st_gruppe__gw_cjoin</outgoing></serviceTask>
    <exclusiveGateway id="gw_cjoin"><documentation>Sammelt den automatischen und den manuellen Weg.</documentation><incoming>f_gw_id__gw_cjoin</incoming><incoming>f_st_gruppe__gw_cjoin</incoming><outgoing>f_gw_cjoin__st_done</outgoing></exclusiveGateway>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit erhält die empfangende Person das Recht im Bestand. Braucht das Secret "atlas" mit einem API-Token der Rolle operator.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="done"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_cjoin__st_done</incoming><outgoing>f_st_done__e_bereit</outgoing><dataOutputAssociation id="doa_st_done"><targetRef>dor_st_done</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_bereit" name="Community bereit"><documentation>Die Community besteht, mit ihrer Besitzerin oder ihrem Besitzer.</documentation><incoming>f_st_done__e_bereit</incoming></endEvent>
    <startEvent id="s_rueck" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (Nachricht m365.community.loeschen): Die Community wird gelöscht.</documentation><outgoing>f_s_rueck__br_name2</outgoing><messageEventDefinition messageRef="m_m365_community_loeschen"/></startEvent>
    <businessRuleTask id="br_name2" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel mit dem Objekttyp community an (Präfix EC): Anzeigename «EC-&lt;BEREICH&gt; &lt;Bezeichnung&gt;», reservierte und zu lange Namen werden mit Begründung abgelehnt. Die Eingabe slug normalisiert die Bezeichnung im Input-Mapping. bereich und bezeichnung benennen niemanden; nur so darf die Engine sie auswerten. Das Ergebnis steht in regel (erlaubt, grund, anzeigename, alias). Hier bildet sie den Anzeigenamen aus denselben Antworten der Bestellung neu: Über ihn findet der Prozess die Microsoft-365-Gruppe der Community wieder.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source='="community"' target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source="=bereich" target="bereich"/><zeebe:input source="=bezeichnung" target="bezeichnung"/><zeebe:input source='=replace(replace(replace(replace(replace(replace(replace(lower case(bezeichnung), "ä", "ae"), "ö", "oe"), "ü", "ue"), "[éèê]", "e"), "[àâ]", "a"), "[^a-z0-9]+", "-"), "^-+|-+$", "")' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_rueck__br_name2</incoming><outgoing>f_br_name2__st_suchen2</outgoing></businessRuleTask>
    <serviceTask id="st_suchen2" name="Gruppe suchen"><documentation>list-groups mit displayName eq '&lt;Anzeigename&gt;' (ein Apostroph im Namen wird verdoppelt, wie OData es verlangt). Annahme: Die Microsoft-365-Gruppe einer Community trägt den Anzeigenamen der Community; so beschreibt Microsoft die Gruppe einer Community, an einem Tenant ist es nicht geprüft.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;displayName eq '&quot; + replace(regel.anzeigename, &quot;'&quot;, &quot;''&quot;) + &quot;'&quot;" select="id,displayName" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_br_name2__st_suchen2</incoming><outgoing>f_st_suchen2__gw_gef2</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef2" name="Gruppe vorhanden?" default="f_gw_gef2__st_loeschen"><documentation>Ist die Gruppe schon weg, ist die Community zurückgegeben; die Position wird trotzdem gemeldet, damit der Bestand kein Recht ohne Objekt führt.</documentation><incoming>f_st_suchen2__gw_gef2</incoming><outgoing>f_gw_gef2__st_loeschen</outgoing><outgoing>f_gw_gef2__gw_join2</outgoing></exclusiveGateway>
    <serviceTask id="st_loeschen" name="Gruppe löschen"><documentation>delete-group auf die Gruppe der Community. Annahme: Mit der Gruppe löscht Microsoft auch die Community, so wie es das Löschen einer Microsoft-365-Gruppe für die mit ihr verbundenen Dienste beschreibt; an einem Tenant ist das nicht geprüft. Die Gruppe liegt danach 30 Tage im Papierkorb.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="delete-group" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_gef2__st_loeschen</incoming><outgoing>f_st_loeschen__gw_join2</outgoing><dataOutputAssociation id="doa_st_loeschen"><targetRef>dor_st_loeschen</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_join2"><documentation>Sammelt beide Wege.</documentation><incoming>f_gw_gef2__gw_join2</incoming><incoming>f_st_loeschen__gw_join2</incoming><outgoing>f_gw_join2__st_returned</outgoing></exclusiveGateway>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Eine Rückgabe erhält atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_join2__st_returned</incoming><outgoing>f_st_returned__e_rueck</outgoing><dataOutputAssociation id="doa_st_returned"><targetRef>dor_st_returned</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_rueck" name="Community gelöscht"><incoming>f_st_returned__e_rueck</incoming></endEvent>
    <startEvent id="s_mitglied" name="Aufnahme angefragt"><documentation>Start der Aktion mitglied (Änderung, Nachricht m365.community.mitglied). Das Formular m365-engage-person liefert communityPerson (UPN, Personendatum) und communityRolle (mitglied oder admin, nicht personenbezogen).</documentation><outgoing>f_s_mitglied__br_name3</outgoing><messageEventDefinition messageRef="m_m365_community_mitglied"/></startEvent>
    <businessRuleTask id="br_name3" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel mit dem Objekttyp community an (Präfix EC): Anzeigename «EC-&lt;BEREICH&gt; &lt;Bezeichnung&gt;», reservierte und zu lange Namen werden mit Begründung abgelehnt. Die Eingabe slug normalisiert die Bezeichnung im Input-Mapping. bereich und bezeichnung benennen niemanden; nur so darf die Engine sie auswerten. Das Ergebnis steht in regel (erlaubt, grund, anzeigename, alias). Hier bildet sie den Anzeigenamen aus denselben Antworten der Bestellung neu: Über ihn findet der Prozess die Microsoft-365-Gruppe der Community wieder.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source='="community"' target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source="=bereich" target="bereich"/><zeebe:input source="=bezeichnung" target="bezeichnung"/><zeebe:input source='=replace(replace(replace(replace(replace(replace(replace(lower case(bezeichnung), "ä", "ae"), "ö", "oe"), "ü", "ue"), "[éèê]", "e"), "[àâ]", "a"), "[^a-z0-9]+", "-"), "^-+|-+$", "")' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_mitglied__br_name3</incoming><outgoing>f_br_name3__st_suchen3</outgoing></businessRuleTask>
    <serviceTask id="st_suchen3" name="Gruppe suchen"><documentation>list-groups mit displayName eq '&lt;Anzeigename&gt;' (ein Apostroph im Namen wird verdoppelt, wie OData es verlangt). Annahme: Die Microsoft-365-Gruppe einer Community trägt den Anzeigenamen der Community; so beschreibt Microsoft die Gruppe einer Community, an einem Tenant ist es nicht geprüft.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;displayName eq '&quot; + replace(regel.anzeigename, &quot;'&quot;, &quot;''&quot;) + &quot;'&quot;" select="id,displayName" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_br_name3__st_suchen3</incoming><outgoing>f_st_suchen3__st_person3</outgoing></serviceTask>
    <serviceTask id="st_person3" name="Person prüfen"><documentation>get-user liest das Konto der aufzunehmenden Person.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=communityPerson" select="id,displayName,accountEnabled" resultVariable="communityPersonKonto"/></extensionElements><incoming>f_st_suchen3__st_person3</incoming><outgoing>f_st_person3__gw_rolle</outgoing></serviceTask>
    <exclusiveGateway id="gw_rolle" name="Welche Rolle?" default="f_gw_rolle__st_member"><documentation>communityRolle kommt aus dem Aktionsformular und benennt niemanden; deshalb darf das Gateway sie lesen. Der Default-Fluss macht die Person zum Mitglied, nicht zum Admin.</documentation><incoming>f_st_person3__gw_rolle</incoming><outgoing>f_gw_rolle__st_member</outgoing><outgoing>f_gw_rolle__st_admin</outgoing></exclusiveGateway>
    <serviceTask id="st_member" name="Als Mitglied aufnehmen"><documentation>add-group-member auf die Gruppe der Community: Mitglieder der Gruppe sind Mitglieder der Community.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-member" userId="=communityPersonKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_rolle__st_member</incoming><outgoing>f_st_member__gw_rjoin</outgoing></serviceTask>
    <serviceTask id="st_admin" name="Als Admin aufnehmen"><documentation>add-group-owner: Besitzer der Gruppe sind nach Microsofts Beschreibung Admins der Community (nicht an einem Tenant geprüft). Ein Admin muss nicht zusätzlich Mitglied sein, damit er die Community verwaltet.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="add-group-owner" userId="=communityPersonKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_rolle__st_admin</incoming><outgoing>f_st_admin__gw_rjoin</outgoing></serviceTask>
    <exclusiveGateway id="gw_rjoin"><documentation>Sammelt beide Rollen.</documentation><incoming>f_st_member__gw_rjoin</incoming><incoming>f_st_admin__gw_rjoin</incoming><outgoing>f_gw_rjoin__sd_mitglied</outgoing></exclusiveGateway>
    <sendTask id="sd_mitglied" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «mitglied» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglied" outcome="completed"/></extensionElements><incoming>f_gw_rjoin__sd_mitglied</incoming><outgoing>f_sd_mitglied__e_mitglied</outgoing></sendTask>
    <endEvent id="e_mitglied" name="Person aufgenommen"><incoming>f_sd_mitglied__e_mitglied</incoming></endEvent>
    <startEvent id="s_weg" name="Entfernen angefragt"><documentation>Start der Aktion mitglied-weg (Änderung, Nachricht m365.community.mitglied-weg). Das Formular m365-engage-person-weg liefert communityPerson und adminAuch (ja oder nein, nicht personenbezogen).</documentation><outgoing>f_s_weg__br_name4</outgoing><messageEventDefinition messageRef="m_m365_community_mitglied_weg"/></startEvent>
    <businessRuleTask id="br_name4" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel mit dem Objekttyp community an (Präfix EC): Anzeigename «EC-&lt;BEREICH&gt; &lt;Bezeichnung&gt;», reservierte und zu lange Namen werden mit Begründung abgelehnt. Die Eingabe slug normalisiert die Bezeichnung im Input-Mapping. bereich und bezeichnung benennen niemanden; nur so darf die Engine sie auswerten. Das Ergebnis steht in regel (erlaubt, grund, anzeigename, alias). Hier bildet sie den Anzeigenamen aus denselben Antworten der Bestellung neu: Über ihn findet der Prozess die Microsoft-365-Gruppe der Community wieder.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source='="community"' target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source="=bereich" target="bereich"/><zeebe:input source="=bezeichnung" target="bezeichnung"/><zeebe:input source='=replace(replace(replace(replace(replace(replace(replace(lower case(bezeichnung), "ä", "ae"), "ö", "oe"), "ü", "ue"), "[éèê]", "e"), "[àâ]", "a"), "[^a-z0-9]+", "-"), "^-+|-+$", "")' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_weg__br_name4</incoming><outgoing>f_br_name4__st_suchen4</outgoing></businessRuleTask>
    <serviceTask id="st_suchen4" name="Gruppe suchen"><documentation>list-groups mit displayName eq '&lt;Anzeigename&gt;' (ein Apostroph im Namen wird verdoppelt, wie OData es verlangt). Annahme: Die Microsoft-365-Gruppe einer Community trägt den Anzeigenamen der Community; so beschreibt Microsoft die Gruppe einer Community, an einem Tenant ist es nicht geprüft.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="list-groups" filter="=&quot;displayName eq '&quot; + replace(regel.anzeigename, &quot;'&quot;, &quot;''&quot;) + &quot;'&quot;" select="id,displayName" maxUsers="5" resultVariable="treffer"/></extensionElements><incoming>f_br_name4__st_suchen4</incoming><outgoing>f_st_suchen4__st_person4</outgoing></serviceTask>
    <serviceTask id="st_person4" name="Person prüfen"><documentation>get-user liest das Konto der Person, die gehen soll.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=communityPerson" select="id,displayName" resultVariable="communityPersonKonto"/></extensionElements><incoming>f_st_suchen4__st_person4</incoming><outgoing>f_st_person4__gw_admin</outgoing></serviceTask>
    <exclusiveGateway id="gw_admin" name="Auch als Admin?" default="f_gw_admin__gw_ajoin"><documentation>adminAuch kommt aus dem Formular und benennt niemanden. Der Default-Fluss trägt nur die Mitgliedschaft aus.</documentation><incoming>f_st_person4__gw_admin</incoming><outgoing>f_gw_admin__gw_ajoin</outgoing><outgoing>f_gw_admin__st_owner_weg</outgoing></exclusiveGateway>
    <serviceTask id="st_owner_weg" name="Admin austragen"><documentation>remove-group-owner. Graph lehnt ab, wenn damit der letzte Besitzer ginge; das wird zum Incident, weil eine Community ohne Admin niemand mehr verwaltet.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="remove-group-owner" userId="=communityPersonKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_admin__st_owner_weg</incoming><outgoing>f_st_owner_weg__gw_ajoin</outgoing></serviceTask>
    <exclusiveGateway id="gw_ajoin"><documentation>Sammelt beide Wege.</documentation><incoming>f_gw_admin__gw_ajoin</incoming><incoming>f_st_owner_weg__gw_ajoin</incoming><outgoing>f_gw_ajoin__st_member_weg</outgoing></exclusiveGateway>
    <serviceTask id="st_member_weg" name="Mitglied austragen"><documentation>remove-group-member. Ist die Person nur Admin und nicht Mitglied, antwortet Graph mit einem Fehler, und die Aufgabe wird zum Incident.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="remove-group-member" userId="=communityPersonKonto.id" groupId="=treffer[1].id"/></extensionElements><incoming>f_gw_ajoin__st_member_weg</incoming><outgoing>f_st_member_weg__sd_weg</outgoing></serviceTask>
    <sendTask id="sd_weg" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «mitglied-weg» erledigt ist.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglied-weg" outcome="completed"/></extensionElements><incoming>f_st_member_weg__sd_weg</incoming><outgoing>f_sd_weg__e_weg</outgoing></sendTask>
    <endEvent id="e_weg" name="Person entfernt"><incoming>f_sd_weg__e_weg</incoming></endEvent>
