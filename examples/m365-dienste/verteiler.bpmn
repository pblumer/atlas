<?xml version="1.0" encoding="UTF-8"?>
<!--
Exchange: Verteilerliste. Lebenszyklus-Prozess mit Namensregel und Herkunftskennzeichnung.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_m365_verteiler" targetNamespace="http://atlas/beispiel/m365-dienste">
  <message id="m_m365_verteiler_erstellen" name="m365.verteiler.erstellen"/>
  <message id="m_m365_verteiler_entfernen" name="m365.verteiler.entfernen"/>
  <message id="m_m365_verteiler_mitglied_aufnehmen" name="m365.verteiler.mitglied-aufnehmen"/>
  <message id="m_m365_verteiler_mitglied_entfernen" name="m365.verteiler.mitglied-entfernen"/>
  <itemDefinition id="item_Katalogposition" structureRef="Katalogposition"/>
  <itemDefinition id="item_Verteiler" structureRef="Verteiler"/>
  <itemDefinition id="item_Verteilermitgliedschaft" structureRef="Verteilermitgliedschaft"/>
  <dataStore id="ds_exchange_online_empfaenger" name="Exchange Online: Empfaenger"/>
  <process id="proc_m365_verteiler" name="Exchange: Verteilerliste" isExecutable="true" atlas:personal="besitzer,person" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus einer Verteilerliste: anlegen, entfernen, Mitglieder aufnehmen und entfernen.

Governance wie beim Funktionspostfach: Namensregel mit Präfix VL, Herkunftskennzeichnung in CustomAttribute1 bis 4, Rückgabe und Aktionen über die Kennzeichnung. Die Liste ist geschlossen (MemberJoinRestriction Closed): Wer Mitglied wird, entscheidet die verantwortliche Person über die Aktionen im Shop, nicht jede Person selbst. Auf Wunsch nimmt sie nur Mail aus der eigenen Organisation an.

Personendaten: besitzer und person sind als Personendaten der empfangenden Person deklariert. Konstante MAIL_DOMAIN. Worker: ucc_exchange.</documentation>
    <extensionElements>
      <atlas:constants><atlas:constant name="NAME_PREFIX" type="json" source="application" value='""'/>
        <atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/>
        <atlas:constant name="MAIL_DOMAIN" type="string" source="application" value="contoso.ch"/>
      </atlas:constants>
    </extensionElements>
    <startEvent id="s_neu" name="Verteiler bestellt"><documentation>Start der Operation provision.</documentation><outgoing>f_s_neu__br_name</outgoing><messageEventDefinition messageRef="m_m365_verteiler_erstellen"/></startEvent>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>Wendet die Namensregel M365Namensregel an (Governance). Die bestellende Person gibt nur das Bereichskürzel und eine Bezeichnung an; die Entscheidungstabelle bildet daraus Anzeigename und Alias mit dem Präfix des Objekttyps (verteiler), weist reservierte Bezeichnungen (admin, postmaster, security …) und zu lange Namen ab und begründet jede Abweichung. Die Eingabe slug normalisiert die Bezeichnung im Input-Mapping (Kleinbuchstaben, Umlaute ausgeschrieben, alles andere zu Bindestrichen). bereich und bezeichnung benennen niemanden und sind deshalb nicht als Personendaten deklariert; nur so darf die Engine sie auswerten. Das Ergebnis steht danach in regel (erlaubt, grund, anzeigename, alias). Die Felder werden als regel.alias usw. gelesen: Output-Mappings wertet Atlas auf einer Business-Rule-Task nicht aus.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source='="verteiler"' target="objekttyp"/><zeebe:input source="=bereich" target="bereich"/><zeebe:input source="=bezeichnung" target="bezeichnung"/><zeebe:input source='=replace(replace(replace(replace(replace(replace(replace(lower case(bezeichnung), "ä", "ae"), "ö", "oe"), "ü", "ue"), "[éèê]", "e"), "[àâ]", "a"), "[^a-z0-9]+", "-"), "^-+|-+$", "")' target="slug"/></zeebe:ioMapping></extensionElements><incoming>f_s_neu__br_name</incoming><outgoing>f_br_name__gw_name</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_name" name="Namensregel erfüllt?" default="f_gw_name__st_ablehnen"><documentation>Nur ein ausdrücklich erlaubter Name führt weiter (fail-closed): Der Default-Fluss ist die Ablehnung, damit eine Regel, die nicht greift, nie ein Objekt mit beliebigem Namen anlegt.</documentation><incoming>f_br_name__gw_name</incoming><outgoing>f_gw_name__st_ablehnen</outgoing><outgoing>f_gw_name__st_anlegen</outgoing></exclusiveGateway>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Meldet die Ablehnung über POST /api/v1/orders/{orderId}/lines/{itemId}/decision, mit der Begründung, die die Namensregel geliefert hat. Eine verletzte Namensregel ist eine Entscheidung und keine Störung: Sie erzeugt keinen Incident, und die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + itemId + "/decision"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="Namensregel"' target="by"/><zeebe:input source="=regel.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_name__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing><dataOutputAssociation id="doa_st_ablehnen"><targetRef>dor_st_ablehnen</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt: Namensregel"><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <serviceTask id="st_anlegen" name="Verteiler anlegen"><documentation>create-distribution-group. RequireSenderAuthenticationEnabled ist ein Wahrheitswert und wird deshalb per FEEL aus der Formularantwort gebildet: PowerShell weist die Zeichenkette "true" für einen Schalter ab.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="create-distribution-group" parameters='{"Name": "=regel.anzeigename", "DisplayName": "=regel.anzeigename", "Alias": "=regel.alias", "PrimarySmtpAddress": "=regel.alias + \"@\" + application.MAIL_DOMAIN", "ManagedBy": "=besitzer", "MemberJoinRestriction": "Closed", "MemberDepartRestriction": "Open", "RequireSenderAuthenticationEnabled": "=nurIntern = \"true\""}'/></extensionElements><incoming>f_gw_name__st_anlegen</incoming><outgoing>f_st_anlegen__st_tag</outgoing><dataOutputAssociation id="doa_st_anlegen"><targetRef>dor_st_anlegen</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_tag" name="Herkunft kennzeichnen"><documentation>Kennzeichnet die Herkunft (Governance): CustomAttribute1 = atlas-katalog, CustomAttribute2 = Produkt, CustomAttribute3 = Auftrag/Position, CustomAttribute4 = verantwortliche Person. Die Kennzeichnung ist zweierlei: Rückgabe und Änderungen finden das Objekt darüber wieder, und die wöchentliche Governance-Prüfung erkennt jedes Objekt ohne sie als nicht über den Katalog entstanden.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="update-distribution-group" parameters='{"Identity": "=regel.alias + \"@\" + application.MAIL_DOMAIN", "CustomAttribute1": "atlas-katalog", "CustomAttribute2": "=itemId", "CustomAttribute3": "=orderId + \"/\" + (if positionId = null then itemId else positionId)", "CustomAttribute4": "=besitzer"}'/></extensionElements><incoming>f_st_anlegen__st_tag</incoming><outgoing>f_st_tag__st_done</outgoing></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit erhält die empfangende Person das Recht im Bestand. Eine Serviceaufgabe und keine Shop-Aufgabe, weil Bereitstellen und Rückgabe das Recht ändern. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="done"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_tag__st_done</incoming><outgoing>f_st_done__e_bereit</outgoing><dataOutputAssociation id="doa_st_done"><targetRef>dor_st_done</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_bereit" name="Verteiler bereit"><incoming>f_st_done__e_bereit</incoming></endEvent>
    <startEvent id="s_weg" name="Rückgabe angefordert"><documentation>Start der Operation deprovision.</documentation><outgoing>f_s_weg__st_finden</outgoing><messageEventDefinition messageRef="m_m365_verteiler_entfernen"/></startEvent>
    <serviceTask id="st_finden" name="Verteiler finden"><documentation>Findet die Verteilerliste über die Herkunftskennzeichnung: CustomAttribute3 trägt seit der Bereitstellung «&lt;orderId&gt;/&lt;positionId&gt;». Die Suche hängt damit nicht am Namen, der sich nach einer Änderung der Namensregel anders bilden würde, sondern an der Position, die das Recht im Bestand begründet. maxResults 5: Mehr Treffer wären ein Fehler der Kennzeichnung, und Exchange-Listen scheitern über der Grenze, statt abgeschnitten zu werden.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="list-distribution-groups" parameters="{&quot;Filter&quot;: &quot;=\&quot;CustomAttribute3 -eq '\&quot; + orderId + \&quot;/\&quot; + (if positionId = null then itemId else positionId) + \&quot;'\&quot;&quot;}" maxResults="5" resultVariable="treffer"/></extensionElements><incoming>f_s_weg__st_finden</incoming><outgoing>f_st_finden__gw_gef</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef" name="Verteiler vorhanden?" default="f_gw_gef__st_entfernen"><documentation>Ein schon entfernter Verteiler ist zurückgegeben; die Rückgabe wird trotzdem gemeldet.</documentation><incoming>f_st_finden__gw_gef</incoming><outgoing>f_gw_gef__st_entfernen</outgoing><outgoing>f_gw_gef__gw_join</outgoing></exclusiveGateway>
    <serviceTask id="st_entfernen" name="Verteiler entfernen"><documentation>remove-distribution-group; BypassSecurityGroupManagerCheck, weil der Worker nicht selbst als Verwalter der Liste eingetragen ist.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="remove-distribution-group" parameters='{"Identity": "=treffer[1].PrimarySmtpAddress", "BypassSecurityGroupManagerCheck": true}'/></extensionElements><incoming>f_gw_gef__st_entfernen</incoming><outgoing>f_st_entfernen__gw_join</outgoing><dataOutputAssociation id="doa_st_entfernen"><targetRef>dor_st_entfernen</targetRef></dataOutputAssociation></serviceTask>
    <exclusiveGateway id="gw_join"><incoming>f_gw_gef__gw_join</incoming><incoming>f_st_entfernen__gw_join</incoming><outgoing>f_gw_join__st_returned</outgoing></exclusiveGateway>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Eine Rückgabe erhält die Variable atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE (Fallback http://127.0.0.1:8080), die auf jeder Installation einmal zu setzen ist, deren Server nicht dort lauscht.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + replace((if positionId = null then itemId else positionId), "#", "%23")' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_join__st_returned</incoming><outgoing>f_st_returned__e_weg</outgoing><dataOutputAssociation id="doa_st_returned"><targetRef>dor_st_returned</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_weg" name="Verteiler entfernt"><incoming>f_st_returned__e_weg</incoming></endEvent>
    <startEvent id="s_plus" name="Aufnahme angefragt"><documentation>Start der Aktion mitglied-aufnehmen (Änderung).</documentation><outgoing>f_s_plus__st_finden2</outgoing><messageEventDefinition messageRef="m_m365_verteiler_mitglied_aufnehmen"/></startEvent>
    <serviceTask id="st_finden2" name="Verteiler finden"><documentation>Findet die Verteilerliste über die Herkunftskennzeichnung: CustomAttribute3 trägt seit der Bereitstellung «&lt;orderId&gt;/&lt;positionId&gt;». Die Suche hängt damit nicht am Namen, der sich nach einer Änderung der Namensregel anders bilden würde, sondern an der Position, die das Recht im Bestand begründet. maxResults 5: Mehr Treffer wären ein Fehler der Kennzeichnung, und Exchange-Listen scheitern über der Grenze, statt abgeschnitten zu werden.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="list-distribution-groups" parameters="{&quot;Filter&quot;: &quot;=\&quot;CustomAttribute3 -eq '\&quot; + orderId + \&quot;/\&quot; + (if positionId = null then itemId else positionId) + \&quot;'\&quot;&quot;}" maxResults="5" resultVariable="treffer"/></extensionElements><incoming>f_s_plus__st_finden2</incoming><outgoing>f_st_finden2__st_add</outgoing></serviceTask>
    <serviceTask id="st_add" name="Mitglied aufnehmen"><documentation>add-distribution-group-member.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="add-distribution-group-member" parameters='{"Identity": "=treffer[1].PrimarySmtpAddress", "Member": "=person", "BypassSecurityGroupManagerCheck": true}'/></extensionElements><incoming>f_st_finden2__st_add</incoming><outgoing>f_st_add__sd_plus</outgoing><dataOutputAssociation id="doa_st_add"><targetRef>dor_st_add</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_plus" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «mitglied-aufnehmen» erledigt ist. Der Katalog verlangt beim Veröffentlichen, dass jede Änderung und jeder Service so beantwortet wird; das Recht selbst bleibt bestehen.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglied-aufnehmen" outcome="completed"/></extensionElements><incoming>f_st_add__sd_plus</incoming><outgoing>f_sd_plus__e_plus</outgoing></sendTask>
    <endEvent id="e_plus" name="Mitglied aufgenommen"><incoming>f_sd_plus__e_plus</incoming></endEvent>
    <startEvent id="s_minus" name="Austritt angefragt"><documentation>Start der Aktion mitglied-entfernen (Änderung).</documentation><outgoing>f_s_minus__st_finden3</outgoing><messageEventDefinition messageRef="m_m365_verteiler_mitglied_entfernen"/></startEvent>
    <serviceTask id="st_finden3" name="Verteiler finden"><documentation>Findet die Verteilerliste über die Herkunftskennzeichnung: CustomAttribute3 trägt seit der Bereitstellung «&lt;orderId&gt;/&lt;positionId&gt;». Die Suche hängt damit nicht am Namen, der sich nach einer Änderung der Namensregel anders bilden würde, sondern an der Position, die das Recht im Bestand begründet. maxResults 5: Mehr Treffer wären ein Fehler der Kennzeichnung, und Exchange-Listen scheitern über der Grenze, statt abgeschnitten zu werden.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="list-distribution-groups" parameters="{&quot;Filter&quot;: &quot;=\&quot;CustomAttribute3 -eq '\&quot; + orderId + \&quot;/\&quot; + (if positionId = null then itemId else positionId) + \&quot;'\&quot;&quot;}" maxResults="5" resultVariable="treffer"/></extensionElements><incoming>f_s_minus__st_finden3</incoming><outgoing>f_st_finden3__st_remove</outgoing></serviceTask>
    <serviceTask id="st_remove" name="Mitglied entfernen"><documentation>remove-distribution-group-member.</documentation><extensionElements><atlas:exchangeConnector connector="ucc_exchange" operation="remove-distribution-group-member" parameters='{"Identity": "=treffer[1].PrimarySmtpAddress", "Member": "=person", "BypassSecurityGroupManagerCheck": true}'/></extensionElements><incoming>f_st_finden3__st_remove</incoming><outgoing>f_st_remove__sd_minus</outgoing><dataOutputAssociation id="doa_st_remove"><targetRef>dor_st_remove</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_minus" name="Änderung als erledigt melden"><documentation>Eine Shop-Aufgabe (Modus outcome) meldet, dass die Aktion «mitglied-entfernen» erledigt ist. Der Katalog verlangt beim Veröffentlichen, dass jede Änderung und jeder Service so beantwortet wird; das Recht selbst bleibt bestehen.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglied-entfernen" outcome="completed"/></extensionElements><incoming>f_st_remove__sd_minus</incoming><outgoing>f_sd_minus__e_minus</outgoing></sendTask>
    <endEvent id="e_minus" name="Mitglied entfernt"><incoming>f_sd_minus__e_minus</incoming></endEvent>
    <sequenceFlow id="f_gw_name__st_ablehnen" sourceRef="gw_name" targetRef="st_ablehnen" name="nein"/>
    <sequenceFlow id="f_st_ablehnen__e_abgelehnt" sourceRef="st_ablehnen" targetRef="e_abgelehnt"/>
    <sequenceFlow id="f_s_neu__br_name" sourceRef="s_neu" targetRef="br_name"/>
    <sequenceFlow id="f_br_name__gw_name" sourceRef="br_name" targetRef="gw_name"/>
    <sequenceFlow id="f_gw_name__st_anlegen" sourceRef="gw_name" targetRef="st_anlegen" name="ja"><conditionExpression>=regel.erlaubt = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_st_anlegen__st_tag" sourceRef="st_anlegen" targetRef="st_tag"/>
    <sequenceFlow id="f_st_tag__st_done" sourceRef="st_tag" targetRef="st_done"/>
    <sequenceFlow id="f_st_done__e_bereit" sourceRef="st_done" targetRef="e_bereit"/>
    <sequenceFlow id="f_s_weg__st_finden" sourceRef="s_weg" targetRef="st_finden"/>
    <sequenceFlow id="f_st_finden__gw_gef" sourceRef="st_finden" targetRef="gw_gef"/>
    <sequenceFlow id="f_gw_gef__st_entfernen" sourceRef="gw_gef" targetRef="st_entfernen" name="ja"/>
    <sequenceFlow id="f_gw_gef__gw_join" sourceRef="gw_gef" targetRef="gw_join" name="nein"><conditionExpression>=count(treffer) = 0</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_st_entfernen__gw_join" sourceRef="st_entfernen" targetRef="gw_join"/>
    <sequenceFlow id="f_gw_join__st_returned" sourceRef="gw_join" targetRef="st_returned"/>
    <sequenceFlow id="f_st_returned__e_weg" sourceRef="st_returned" targetRef="e_weg"/>
    <sequenceFlow id="f_s_plus__st_finden2" sourceRef="s_plus" targetRef="st_finden2"/>
    <sequenceFlow id="f_st_finden2__st_add" sourceRef="st_finden2" targetRef="st_add"/>
    <sequenceFlow id="f_st_add__sd_plus" sourceRef="st_add" targetRef="sd_plus"/>
    <sequenceFlow id="f_sd_plus__e_plus" sourceRef="sd_plus" targetRef="e_plus"/>
    <sequenceFlow id="f_s_minus__st_finden3" sourceRef="s_minus" targetRef="st_finden3"/>
    <sequenceFlow id="f_st_finden3__st_remove" sourceRef="st_finden3" targetRef="st_remove"/>
    <sequenceFlow id="f_st_remove__sd_minus" sourceRef="st_remove" targetRef="sd_minus"/>
    <sequenceFlow id="f_sd_minus__e_minus" sourceRef="sd_minus" targetRef="e_minus"/>
    <!-- Architektur: Datenobjekte und Datenspeicher (architektur/README) -->
    <dataObject id="do_katalogposition" name="Katalogposition" itemSubjectRef="item_Katalogposition"/>
    <dataObject id="do_verteiler" name="Verteiler" itemSubjectRef="item_Verteiler"/>
    <dataObject id="do_verteilermitgliedschaft" name="Verteilermitgliedschaft" itemSubjectRef="item_Verteilermitgliedschaft"/>
    <dataObjectReference id="dor_st_done" name="Katalogposition" dataObjectRef="do_katalogposition"><dataState name="Erledigt"/></dataObjectReference>
    <dataObjectReference id="dor_st_returned" name="Katalogposition" dataObjectRef="do_katalogposition"><dataState name="Zurueckgegeben"/></dataObjectReference>
    <dataObjectReference id="dor_st_ablehnen" name="Katalogposition" dataObjectRef="do_katalogposition"><dataState name="Abgelehnt"/></dataObjectReference>
    <dataObjectReference id="dor_st_anlegen" name="Verteiler" dataObjectRef="do_verteiler"><dataState name="Angelegt"/></dataObjectReference>
    <dataObjectReference id="dor_st_entfernen" name="Verteiler" dataObjectRef="do_verteiler"><dataState name="Entfernt"/></dataObjectReference>
    <dataObjectReference id="dor_st_add" name="Verteilermitgliedschaft" dataObjectRef="do_verteilermitgliedschaft"><dataState name="Aufgenommen"/></dataObjectReference>
    <dataObjectReference id="dor_st_remove" name="Verteilermitgliedschaft" dataObjectRef="do_verteilermitgliedschaft"><dataState name="Entfernt"/></dataObjectReference>
    <dataStoreReference id="dsr_exchange_online_empfaenger" name="Exchange Online: Empfaenger" dataStoreRef="ds_exchange_online_empfaenger"/>
  </process>
  <bpmndi:BPMNDiagram id="proc_m365_verteiler_diagram">
    <bpmndi:BPMNPlane id="proc_m365_verteiler_plane" bpmnElement="proc_m365_verteiler">
      <bpmndi:BPMNShape id="s_neu_di" bpmnElement="s_neu"><omgdc:Bounds x="162" y="112" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="130" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="br_name_di" bpmnElement="br_name"><omgdc:Bounds x="280" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_name_di" bpmnElement="gw_name" isMarkerVisible="true"><omgdc:Bounds x="455" y="105" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="383" y="74" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_ablehnen_di" bpmnElement="st_ablehnen"><omgdc:Bounds x="580" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_abgelehnt_di" bpmnElement="e_abgelehnt"><omgdc:Bounds x="762" y="252" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="730" y="292" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_anlegen_di" bpmnElement="st_anlegen"><omgdc:Bounds x="580" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_tag_di" bpmnElement="st_tag"><omgdc:Bounds x="730" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_done_di" bpmnElement="st_done"><omgdc:Bounds x="880" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_bereit_di" bpmnElement="e_bereit"><omgdc:Bounds x="1062" y="112" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1030" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
