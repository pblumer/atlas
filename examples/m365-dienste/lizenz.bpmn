      <bpmndi:BPMNShape id="st_ort_di" bpmnElement="st_ort"><omgdc:Bounds x="580" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_lizenz_di" bpmnElement="st_lizenz"><omgdc:Bounds x="730" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_done_di" bpmnElement="st_done"><omgdc:Bounds x="880" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_zugewiesen_di" bpmnElement="e_zugewiesen"><omgdc:Bounds x="1062" y="112" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1030" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_entziehen_di" bpmnElement="s_entziehen"><omgdc:Bounds x="162" y="252" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="130" y="292" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
