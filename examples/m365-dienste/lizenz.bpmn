  <bpmndi:BPMNDiagram id="proc_m365_lizenz_diagram">
    <bpmndi:BPMNPlane id="proc_m365_lizenz_plane" bpmnElement="proc_m365_lizenz">
      <bpmndi:BPMNShape id="s_zuweisen_di" bpmnElement="s_zuweisen"><omgdc:Bounds x="162" y="112" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="130" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="br_profil_di" bpmnElement="br_profil"><omgdc:Bounds x="280" y="90" width="100" height="80"/></bpmndi:BPMNShape>
