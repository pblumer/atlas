    <sequenceFlow id="f_st_suchen4__st_kanal" sourceRef="st_suchen4" targetRef="st_kanal"/>
    <sequenceFlow id="f_st_kanal__sd_kanal" sourceRef="st_kanal" targetRef="sd_kanal"/>
    <sequenceFlow id="f_sd_kanal__e_kanal" sourceRef="sd_kanal" targetRef="e_kanal"/>
