    <sequenceFlow id="f_ut_adkonto__gw_ajoin" sourceRef="ut_adkonto" targetRef="gw_ajoin"/>
    <sequenceFlow id="f_gw_ajoin__gw_rende" sourceRef="gw_ajoin" targetRef="gw_rende"/>
    <sequenceFlow id="f_gw_rende__e_ausgetreten" sourceRef="gw_rende" targetRef="e_ausgetreten"/>
    <!-- Architektur: Datenobjekte und Datenspeicher (architektur/README) -->
    <dataObject id="do_konto" name="Konto" itemSubjectRef="item_Konto"/>
