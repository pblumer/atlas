    <sequenceFlow id="f_gw_split__st_sync_start" sourceRef="gw_split" targetRef="st_sync_start"/>
    <sequenceFlow id="f_st_sync_start__gw_wjoin" sourceRef="st_sync_start" targetRef="gw_wjoin"/>
    <sequenceFlow id="f_gw_wjoin__t_warten" sourceRef="gw_wjoin" targetRef="t_warten"/>
    <sequenceFlow id="f_t_warten__st_sync" sourceRef="t_warten" targetRef="st_sync"/>
    <sequenceFlow id="f_st_sync__gw_sync" sourceRef="st_sync" targetRef="gw_sync"/>
    <sequenceFlow id="f_gw_sync__gw_kjoin" sourceRef="gw_sync" targetRef="gw_kjoin" name="gespiegelt"><conditionExpression>=syncJetzt &gt;= syncStart + 2</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_sync__gw_wjoin" sourceRef="gw_sync" targetRef="gw_wjoin" name="weiter warten"><conditionExpression>=syncJetzt &lt; syncStart + 2 and versuche &lt; 16</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_sync__ut_konto" sourceRef="gw_sync" targetRef="ut_konto" name="Zeit abgelaufen"/>
    <sequenceFlow id="f_ut_konto__gw_kjoin" sourceRef="ut_konto" targetRef="gw_kjoin"/>
    <sequenceFlow id="f_gw_kjoin__st_atlaskonto" sourceRef="gw_kjoin" targetRef="st_atlaskonto"/>
    <sequenceFlow id="f_st_atlaskonto__gw_bjoin" sourceRef="st_atlaskonto" targetRef="gw_bjoin"/>
    <sequenceFlow id="f_gw_bjoin__sd_bestellen" sourceRef="gw_bjoin" targetRef="sd_bestellen"/>
    <sequenceFlow id="f_sd_bestellen__rc_austritt" sourceRef="sd_bestellen" targetRef="rc_austritt"/>
    <sequenceFlow id="f_b_abgelehnt__ut_abgelehnt" sourceRef="b_abgelehnt" targetRef="ut_abgelehnt"/>
    <sequenceFlow id="f_ut_abgelehnt__gw_abgelehnt" sourceRef="ut_abgelehnt" targetRef="gw_abgelehnt"/>
    <sequenceFlow id="f_gw_abgelehnt__gw_bjoin" sourceRef="gw_abgelehnt" targetRef="gw_bjoin" name="erneut"><conditionExpression>=entscheid = "erneut"</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_abgelehnt__e_abgebrochen" sourceRef="gw_abgelehnt" targetRef="e_abgebrochen" name="beenden"/>
    <sequenceFlow id="f_rc_austritt__st_sperren" sourceRef="rc_austritt" targetRef="st_sperren"/>
    <sequenceFlow id="f_st_sperren__gw_rsplit" sourceRef="st_sperren" targetRef="gw_rsplit"/>
    <sequenceFlow id="f_gw_rsplit__sd_rueckgabe" sourceRef="gw_rsplit" targetRef="sd_rueckgabe"/>
    <sequenceFlow id="f_sd_rueckgabe__gw_rjoin" sourceRef="sd_rueckgabe" targetRef="gw_rjoin"/>
    <sequenceFlow id="f_b_rueckgabe__ut_rueckgabe" sourceRef="b_rueckgabe" targetRef="ut_rueckgabe"/>
    <sequenceFlow id="f_ut_rueckgabe__gw_rjoin" sourceRef="ut_rueckgabe" targetRef="gw_rjoin"/>
    <sequenceFlow id="f_gw_rjoin__gw_rende" sourceRef="gw_rjoin" targetRef="gw_rende"/>
    <sequenceFlow id="f_gw_rsplit__sd_adkonto" sourceRef="gw_rsplit" targetRef="sd_adkonto"/>
    <sequenceFlow id="f_sd_adkonto__gw_ajoin" sourceRef="sd_adkonto" targetRef="gw_ajoin"/>
