<?xml version="1.0" encoding="UTF-8"?>
<!--
SharePoint Server: Teamwebsite. Lebenszyklus-Prozess der On-Premises-Variante (anlegen, Besitzer, Mitglieder, Kontingent, löschen, wiederherstellen, zurückgeben).
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:atlas="http://atlas/schema/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" id="defs_proc_m365_spserver_site" targetNamespace="http://atlas/beispiel/m365-dienste">
  <message id="m_sp_s_neu" name="m365onprem.spsite.erstellen"/>
  <message id="m_sp_s_rueck" name="m365onprem.spsite.rueckgabe"/>
  <message id="m_sp_s_besitzer" name="m365onprem.spsite.besitzer"/>
  <message id="m_sp_s_mitglieder" name="m365onprem.spsite.mitglieder"/>
  <message id="m_sp_s_kontingent" name="m365onprem.spsite.kontingent"/>
  <message id="m_sp_s_loeschen" name="m365onprem.spsite.loeschen"/>
  <message id="m_sp_s_wieder" name="m365onprem.spsite.wiederherstellen"/>
  <error id="err_exists" name="Adresse vergeben" errorCode="SHAREPOINT_SERVER_SITE_EXISTS"/>
  <error id="err_missing" name="Website fehlt" errorCode="SHAREPOINT_SERVER_SITE_NOT_FOUND"/>
  <error id="err_deleted" name="Nicht im Papierkorb" errorCode="SHAREPOINT_SERVER_DELETED_SITE_NOT_FOUND"/>
  <error id="err_account" name="Konto unbekannt" errorCode="SHAREPOINT_SERVER_ACCOUNT_NOT_FOUND"/>
  <error id="err_quota" name="Kontingent abgelehnt" errorCode="SHAREPOINT_SERVER_QUOTA_REFUSED"/>
  <itemDefinition id="item_Katalogposition" structureRef="Katalogposition"/>
  <itemDefinition id="item_SharePointServerSite" structureRef="SharePointServerSite"/>
  <dataStore id="ds_sites" name="SharePoint Server: Sites"/>
  <process id="proc_m365_spserver_site" name="SharePoint Server: Teamwebsite" isExecutable="true" atlas:personal="besitzer,stellvertretung,neuerBesitzer,neueStellvertretung,konto" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus einer Teamwebsite auf SharePoint Server (Subscription Edition, on-premises): Die Websitesammlung ist die Einheit, eine Microsoft-365-Gruppe gibt es nicht. Worker ist ucc_sharepoint_onprem auf einem Server der Farm. Die Variablen kommen aus dem Bestellformular; die Adresse bildet die Namensregel, und vor dem Anlegen prüft get-site, ob sie frei ist. Inventar: Eigenschaften atlas.* in der Website selbst, gelesen mit list-sites. Das Produkt gehört nur zur On-Premises-Variante (Katalog cat-m365-onprem).</documentation>
    <dataObject id="do_position" name="Katalogposition" itemSubjectRef="item_Katalogposition"/>
    <dataObject id="do_site" name="SharePoint-Server-Site" itemSubjectRef="item_SharePointServerSite"/>
    <dataObjectReference id="dor_anlegen" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Bereit"/></dataObjectReference>
    <dataStoreReference id="dsr_sites" name="SharePoint Server: Sites" dataStoreRef="ds_sites"/>
    <dataObjectReference id="dor_done" name="Katalogposition" dataObjectRef="do_position"><dataState name="Erledigt"/></dataObjectReference>
    <dataObjectReference id="dor_abl" name="Katalogposition" dataObjectRef="do_position"><dataState name="Abgelehnt"/></dataObjectReference>
    <dataObjectReference id="dor_verg" name="Katalogposition" dataObjectRef="do_position"><dataState name="Abgelehnt"/></dataObjectReference>
    <dataObjectReference id="dor_ret" name="Katalogposition" dataObjectRef="do_position"><dataState name="Zurueckgegeben"/></dataObjectReference>
    <dataObjectReference id="dor_besitzer" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Bereit"/></dataObjectReference>
    <dataObjectReference id="dor_mitglieder" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Bereit"/></dataObjectReference>
    <dataObjectReference id="dor_kontingent" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Bereit"/></dataObjectReference>
    <dataObjectReference id="dor_loeschen" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Geloescht"/></dataObjectReference>
    <dataObjectReference id="dor_wieder" name="SharePoint-Server-Site" dataObjectRef="do_site"><dataState name="Bereit"/></dataObjectReference>
    <startEvent id="s_neu" name="Teamwebsite bestellt"><documentation>Start der Operation provision (Nachricht m365onprem.spsite.erstellen). Aus dem Formular m365-spserver-site-bestellung kommen titel, url, sprache, kontingent, besitzer und stellvertretung.</documentation><outgoing>s_neu_next</outgoing><messageEventDefinition messageRef="m_sp_s_neu"/></startEvent>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>Wendet M365Namensregel mit dem Objekttyp site an, wie die Online-Teamwebsite. Das Ergebnis steht in regel (erlaubt, grund, anzeigename = titel, alias = URL mit NAME_PREFIX davor); der Alias ist der letzte Teil der Adresse unter /sites/ der Webanwendung.</documentation><extensionElements><zeebe:calledDecision decisionId="M365Namensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=&quot;site&quot;" target="objekttyp"/><zeebe:input source="=application.NAME_PREFIX" target="praefix"/><zeebe:input source="=&quot;&quot;" target="bereich"/><zeebe:input source="=titel" target="bezeichnung"/><zeebe:input source="=if url != null and matches(lower case(url), &quot;^[a-z0-9][a-z0-9_-]{2,63}$&quot;) then lower case(url) else &quot;&quot;" target="slug"/></zeebe:ioMapping></extensionElements><incoming>s_neu_next</incoming><outgoing>br_next</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_name" name="Name erlaubt?" default="f_gw_nein"><documentation>Die Namensregel entscheidet; eine verletzte Regel ist eine Entscheidung und keine Störung.</documentation><incoming>br_next</incoming><outgoing>f_gw_ja</outgoing><outgoing>f_gw_nein</outgoing></exclusiveGateway>
    <serviceTask id="st_site_pruefen" name="Adresse prüfen"><documentation>get-site auf die Adresse, die die Namensregel gebildet hat (regel.alias unter /sites/ der Webanwendung), wie die Online-Teamwebsite vor dem Anlegen fragt. Keine Website ist eine Antwort und kein Fehler: siteAlt ist dann null. Sonst steht in siteAlt die Website, wie create-site sie zurückgibt, mit ihren Eigenschaften atlas.*. Das Ergebnis ist nicht als Personendatum deklariert, weil das Gateway es lesen muss; es hat dieselbe Form wie site nach dem Anlegen.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="get-site" parameters="{&quot;Site&quot;: &quot;=regel.alias&quot;}" resultVariable="siteAlt"/></extensionElements><incoming>f_gw_ja</incoming><outgoing>f_site_frei</outgoing></serviceTask>
    <exclusiveGateway id="gw_frei" name="Adresse frei?" default="f_frei_nein"><documentation>Weiter zu create-site, wenn unter der Adresse keine Website liegt oder wenn die Website dort die Eigenschaft atlas.position dieser Position trägt: Dann hat ein früherer Lauf derselben Position sie angelegt, und create-site ist der Schritt, der diese zweite Zustellung beantwortet; meldet es dennoch SHAREPOINT_SERVER_SITE_EXISTS, fängt das der Fehlerrand. Jede andere Website, auch eine ohne atlas.position, belegt die Adresse; der Default-Fluss ist die Ablehnung (fail-closed). get value liest die Eigenschaft, weil ihr Name einen Punkt enthält. Zwischen dieser Prüfung und dem Anlegen kann jemand die Adresse belegen; dafür bleibt der Fehlerrand an create-site.</documentation><incoming>f_site_frei</incoming><outgoing>f_frei_ja</outgoing><outgoing>f_frei_nein</outgoing></exclusiveGateway>
    <serviceTask id="st_anlegen" name="Website anlegen"><documentation>create-site legt die Websitesammlung unter /sites/ mit der Team-Vorlage an und erstellt die drei Standardgruppen. Die Eigenschaften atlas.* halten Position und Produkt in der Site selbst fest: Das ist das Inventar; list-sites liest sie zurück, ohne SharePoint Online.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="create-site" parameters="{&quot;Site&quot;: &quot;=regel.alias&quot;, &quot;Name&quot;: &quot;=regel.anzeigename&quot;, &quot;OwnerAlias&quot;: &quot;=besitzer&quot;, &quot;SecondaryOwnerAlias&quot;: &quot;=stellvertretung&quot;, &quot;Language&quot;: &quot;=sprache&quot;, &quot;Properties&quot;: {&quot;atlas.position&quot;: &quot;=string(orderId) + \&quot;:\&quot; + string(if positionId = null then itemId else positionId)&quot;, &quot;atlas.produkt&quot;: &quot;m365-spserver-site&quot;}}" resultVariable="site"/></extensionElements><incoming>f_frei_ja</incoming><outgoing>f_anlegen_kont</outgoing><dataOutputAssociation id="doa_dor_anlegen"><targetRef>dor_anlegen</targetRef></dataOutputAssociation></serviceTask>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Meldet die Ablehnung der Namensregel an die Position; die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + itemId + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;Namensregel&quot;" target="by"/><zeebe:input source="=regel.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_nein</incoming><outgoing>f_abl_end</outgoing><dataOutputAssociation id="doa_dor_abl"><targetRef>dor_abl</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt: Namensregel"><documentation>Die Position steht auf rejected; es ist nichts angelegt worden.</documentation><incoming>f_abl_end</incoming></endEvent>
    <boundaryEvent id="b_anl_a" name="Adresse vergeben" attachedToRef="st_anlegen" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_EXISTS: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_anl_a_out</outgoing><errorEventDefinition errorRef="err_exists"/></boundaryEvent>
    <boundaryEvent id="b_anl_b" name="Konto unbekannt" attachedToRef="st_anlegen" cancelActivity="true"><documentation>SHAREPOINT_SERVER_ACCOUNT_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_anl_b_out</outgoing><errorEventDefinition errorRef="err_account"/></boundaryEvent>
    <serviceTask id="st_vergeben" name="Ablehnung melden"><documentation>Meldet die Ablehnung, wenn die Adresse vergeben oder ein Besitzerkonto im Verzeichnis unbekannt ist; beides ändert kein zweiter Versuch. Kommt die Ablehnung von gw_frei, liegt unter der Adresse die Website einer anderen Position (oder eine, die Atlas nicht angelegt hat), und der Grund sagt genau das. Von den Fehlerrändern an create-site kommt der allgemeinere Grund, weil dort nicht feststeht, welche der beiden Prüfungen fehlschlug.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + itemId + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;Verzeichnispruefung&quot;" target="by"/><zeebe:input source="=if siteAlt != null and get value(siteAlt.Properties, &quot;atlas.position&quot;) != string(orderId) + &quot;:&quot; + string(if positionId = null then itemId else positionId) then &quot;Die Adresse ist bereits vergeben.&quot; else &quot;Die Adresse ist bereits vergeben, oder ein Konto ist im Verzeichnis unbekannt.&quot;" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_frei_nein</incoming><incoming>b_anl_a_out</incoming><incoming>b_anl_b_out</incoming><outgoing>f_verg_end</outgoing><dataOutputAssociation id="doa_dor_verg"><targetRef>dor_verg</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_vergeben" name="Abgelehnt: Verzeichnis"><documentation>Es ist keine Website entstanden.</documentation><incoming>f_verg_end</incoming></endEvent>
    <serviceTask id="st_kont" name="Speicherkontingent setzen"><documentation>set-site-quota setzt das bestellte Kontingent (GB); SharePoint warnt bei 90 Prozent. Die Website hat keine Kontingentvorlage, darum greift hier kein Fehlerrand.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="set-site-quota" parameters="{&quot;Site&quot;: &quot;=regel.alias&quot;, &quot;QuotaGB&quot;: &quot;=number(kontingent)&quot;}"/></extensionElements><incoming>f_anlegen_kont</incoming><outgoing>f_kont_done</outgoing></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position als erledigt; erst damit entsteht das Recht im Bestand.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;done&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_kont_done</incoming><outgoing>f_done_end</outgoing><dataOutputAssociation id="doa_dor_done"><targetRef>dor_done</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_bereit" name="Website bereit"><documentation>Die Teamwebsite ist bereit.</documentation><incoming>f_done_end</incoming></endEvent>
    <startEvent id="s_rueck" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (Nachricht m365onprem.spsite.rueckgabe): endgültig zurückgeben.</documentation><outgoing>s_rueck_next</outgoing><messageEventDefinition messageRef="m_sp_s_rueck"/></startEvent>
    <scriptTask id="sc_rueck" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_rueck_next</incoming><outgoing>f_rueck_del</outgoing></scriptTask>
    <serviceTask id="st_rueck_del" name="Website löschen"><documentation>delete-site legt die Website in den Papierkorb (Remove-SPSite -GradualDelete); ist sie schon dort oder weg, gilt die Rückgabe trotzdem als erledigt.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="delete-site" parameters="{&quot;Site&quot;: &quot;=alias&quot;}"/></extensionElements><incoming>f_rueck_del</incoming><outgoing>f_rueck_ret</outgoing></serviceTask>
    <boundaryEvent id="b_rueck_a" name="Website fehlt" attachedToRef="st_rueck_del" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_rueck_a_out</outgoing><errorEventDefinition errorRef="err_missing"/></boundaryEvent>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe; damit endet das Recht im Bestand.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;returned&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_rueck_ret</incoming><incoming>b_rueck_a_out</incoming><outgoing>f_ret_end</outgoing><dataOutputAssociation id="doa_dor_ret"><targetRef>dor_ret</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_rueck" name="Zurückgegeben"><documentation>Die Position ist zurückgegeben.</documentation><incoming>f_ret_end</incoming></endEvent>
    <startEvent id="s_besitzer" name="Besitzerwechsel angefragt"><documentation>Aktion besitzer: neuerBesitzer und neueStellvertretung aus dem Formular m365-spserver-site-besitzer.</documentation><outgoing>s_besitzer_next</outgoing><messageEventDefinition messageRef="m_sp_s_besitzer"/></startEvent>
    <scriptTask id="sc_besitzer" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_besitzer_next</incoming><outgoing>f_besitzer_op</outgoing></scriptTask>
    <serviceTask id="st_besitzer" name="Besitzer setzen"><documentation>set-site-owners setzt primären und sekundären Besitzer der Websitesammlung (Set-SPSite). Beides sind Personen; eine AD-Gruppe kann nicht Besitzerin sein.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="set-site-owners" parameters="{&quot;Site&quot;: &quot;=alias&quot;, &quot;OwnerAlias&quot;: &quot;=neuerBesitzer&quot;, &quot;SecondaryOwnerAlias&quot;: &quot;=neueStellvertretung&quot;}"/></extensionElements><incoming>f_besitzer_op</incoming><outgoing>f_besitzer_ok</outgoing><dataOutputAssociation id="doa_dor_besitzer"><targetRef>dor_besitzer</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_besitzer" name="Änderung als erledigt melden"><documentation>Meldet die Aktion «besitzer» dem Shop als completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="besitzer" outcome="completed"/></extensionElements><incoming>f_besitzer_ok</incoming><outgoing>f_besitzer_done</outgoing></sendTask>
    <endEvent id="e_besitzer" name="Erledigt"><documentation>Die Aktion ist erledigt.</documentation><incoming>f_besitzer_done</incoming></endEvent>
    <boundaryEvent id="b_besitzer_a" name="Website fehlt" attachedToRef="st_besitzer" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_besitzer_a_out</outgoing><errorEventDefinition errorRef="err_missing"/></boundaryEvent>
    <boundaryEvent id="b_besitzer_b" name="Konto unbekannt" attachedToRef="st_besitzer" cancelActivity="true"><documentation>SHAREPOINT_SERVER_ACCOUNT_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_besitzer_b_out</outgoing><errorEventDefinition errorRef="err_account"/></boundaryEvent>
    <sendTask id="sd_besitzer_abl" name="Ablehnung melden"><documentation>Meldet die Aktion «besitzer» dem Shop als rejected.</documentation><extensionElements><atlas:shopTask mode="outcome" action="besitzer" outcome="rejected"/></extensionElements><incoming>b_besitzer_a_out</incoming><incoming>b_besitzer_b_out</incoming><outgoing>f_besitzer_abl_end</outgoing></sendTask>
    <endEvent id="e_besitzer_abl" name="Abgelehnt"><documentation>Die Aktion wurde abgelehnt; die Person liest den Grund im Shop.</documentation><incoming>f_besitzer_abl_end</incoming></endEvent>
    <startEvent id="s_mitglieder" name="Mitgliederänderung angefragt"><documentation>Aktion mitglieder: gruppe (owners, members oder visitors), aenderung (hinzufuegen oder entfernen) und konto (AD-Konto oder AD-Gruppe).</documentation><outgoing>s_mitglieder_next</outgoing><messageEventDefinition messageRef="m_sp_s_mitglieder"/></startEvent>
    <scriptTask id="sc_mitglieder" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_mitglieder_next</incoming><outgoing>f_mitglieder_op</outgoing></scriptTask>
    <serviceTask id="st_mitglieder" name="Mitglieder ändern"><documentation>update-group-members ändert eine Standardgruppe der Website. Hinzufügen und Entfernen sind wiederholbar: Ein Konto, das schon so steht, ändert nichts.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="update-group-members" parameters="{&quot;Site&quot;: &quot;=alias&quot;, &quot;Group&quot;: &quot;=gruppe&quot;, &quot;Add&quot;: &quot;=if aenderung = \&quot;hinzufuegen\&quot; then [konto] else []&quot;, &quot;Remove&quot;: &quot;=if aenderung = \&quot;entfernen\&quot; then [konto] else []&quot;}"/></extensionElements><incoming>f_mitglieder_op</incoming><outgoing>f_mitglieder_ok</outgoing><dataOutputAssociation id="doa_dor_mitglieder"><targetRef>dor_mitglieder</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_mitglieder" name="Änderung als erledigt melden"><documentation>Meldet die Aktion «mitglieder» dem Shop als completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglieder" outcome="completed"/></extensionElements><incoming>f_mitglieder_ok</incoming><outgoing>f_mitglieder_done</outgoing></sendTask>
    <endEvent id="e_mitglieder" name="Erledigt"><documentation>Die Aktion ist erledigt.</documentation><incoming>f_mitglieder_done</incoming></endEvent>
    <boundaryEvent id="b_mitglieder_a" name="Website fehlt" attachedToRef="st_mitglieder" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_mitglieder_a_out</outgoing><errorEventDefinition errorRef="err_missing"/></boundaryEvent>
    <boundaryEvent id="b_mitglieder_b" name="Konto unbekannt" attachedToRef="st_mitglieder" cancelActivity="true"><documentation>SHAREPOINT_SERVER_ACCOUNT_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_mitglieder_b_out</outgoing><errorEventDefinition errorRef="err_account"/></boundaryEvent>
    <sendTask id="sd_mitglieder_abl" name="Ablehnung melden"><documentation>Meldet die Aktion «mitglieder» dem Shop als rejected.</documentation><extensionElements><atlas:shopTask mode="outcome" action="mitglieder" outcome="rejected"/></extensionElements><incoming>b_mitglieder_a_out</incoming><incoming>b_mitglieder_b_out</incoming><outgoing>f_mitglieder_abl_end</outgoing></sendTask>
    <endEvent id="e_mitglieder_abl" name="Abgelehnt"><documentation>Die Aktion wurde abgelehnt; die Person liest den Grund im Shop.</documentation><incoming>f_mitglieder_abl_end</incoming></endEvent>
    <startEvent id="s_kontingent" name="Kontingentänderung angefragt"><documentation>Aktion kontingent: neuesKontingent in GB aus dem Formular m365-spserver-site-kontingent.</documentation><outgoing>s_kontingent_next</outgoing><messageEventDefinition messageRef="m_sp_s_kontingent"/></startEvent>
    <scriptTask id="sc_kontingent" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_kontingent_next</incoming><outgoing>f_kontingent_op</outgoing></scriptTask>
    <serviceTask id="st_kontingent" name="Kontingent setzen"><documentation>set-site-quota setzt das neue Kontingent (GB). Hat die Website eine Kontingentvorlage, lehnt der Worker ab und die Person liest den Grund.</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="set-site-quota" parameters="{&quot;Site&quot;: &quot;=alias&quot;, &quot;QuotaGB&quot;: &quot;=number(neuesKontingent)&quot;}"/></extensionElements><incoming>f_kontingent_op</incoming><outgoing>f_kontingent_ok</outgoing><dataOutputAssociation id="doa_dor_kontingent"><targetRef>dor_kontingent</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_kontingent" name="Änderung als erledigt melden"><documentation>Meldet die Aktion «kontingent» dem Shop als completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="kontingent" outcome="completed"/></extensionElements><incoming>f_kontingent_ok</incoming><outgoing>f_kontingent_done</outgoing></sendTask>
    <endEvent id="e_kontingent" name="Erledigt"><documentation>Die Aktion ist erledigt.</documentation><incoming>f_kontingent_done</incoming></endEvent>
    <boundaryEvent id="b_kontingent_a" name="Website fehlt" attachedToRef="st_kontingent" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_kontingent_a_out</outgoing><errorEventDefinition errorRef="err_missing"/></boundaryEvent>
    <boundaryEvent id="b_kontingent_b" name="Kontingent abgelehnt" attachedToRef="st_kontingent" cancelActivity="true"><documentation>SHAREPOINT_SERVER_QUOTA_REFUSED: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_kontingent_b_out</outgoing><errorEventDefinition errorRef="err_quota"/></boundaryEvent>
    <sendTask id="sd_kontingent_abl" name="Ablehnung melden"><documentation>Meldet die Aktion «kontingent» dem Shop als rejected.</documentation><extensionElements><atlas:shopTask mode="outcome" action="kontingent" outcome="rejected"/></extensionElements><incoming>b_kontingent_a_out</incoming><incoming>b_kontingent_b_out</incoming><outgoing>f_kontingent_abl_end</outgoing></sendTask>
    <endEvent id="e_kontingent_abl" name="Abgelehnt"><documentation>Die Aktion wurde abgelehnt; die Person liest den Grund im Shop.</documentation><incoming>f_kontingent_abl_end</incoming></endEvent>
    <startEvent id="s_loeschen" name="Löschen angefragt"><documentation>Aktion loeschen. Anders als die Rückgabe lässt sie das Recht bestehen: Die Website liegt im Papierkorb und kann wiederhergestellt werden.</documentation><outgoing>s_loeschen_next</outgoing><messageEventDefinition messageRef="m_sp_s_loeschen"/></startEvent>
    <scriptTask id="sc_loeschen" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_loeschen_next</incoming><outgoing>f_loeschen_op</outgoing></scriptTask>
    <serviceTask id="st_loeschen" name="Website löschen"><documentation>delete-site legt die Website in den Papierkorb (Remove-SPSite -GradualDelete).</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="delete-site" parameters="{&quot;Site&quot;: &quot;=alias&quot;}"/></extensionElements><incoming>f_loeschen_op</incoming><outgoing>f_loeschen_ok</outgoing><dataOutputAssociation id="doa_dor_loeschen"><targetRef>dor_loeschen</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_loeschen" name="Änderung als erledigt melden"><documentation>Meldet die Aktion «loeschen» dem Shop als completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="loeschen" outcome="completed"/></extensionElements><incoming>f_loeschen_ok</incoming><outgoing>f_loeschen_done</outgoing></sendTask>
    <endEvent id="e_loeschen" name="Erledigt"><documentation>Die Aktion ist erledigt.</documentation><incoming>f_loeschen_done</incoming></endEvent>
    <boundaryEvent id="b_loeschen_a" name="Website fehlt" attachedToRef="st_loeschen" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_loeschen_a_out</outgoing><errorEventDefinition errorRef="err_missing"/></boundaryEvent>
    <sendTask id="sd_loeschen_abl" name="Ablehnung melden"><documentation>Meldet die Aktion «loeschen» dem Shop als rejected.</documentation><extensionElements><atlas:shopTask mode="outcome" action="loeschen" outcome="rejected"/></extensionElements><incoming>b_loeschen_a_out</incoming><outgoing>f_loeschen_abl_end</outgoing></sendTask>
    <endEvent id="e_loeschen_abl" name="Abgelehnt"><documentation>Die Aktion wurde abgelehnt; die Person liest den Grund im Shop.</documentation><incoming>f_loeschen_abl_end</incoming></endEvent>
    <startEvent id="s_wieder" name="Wiederherstellung angefragt"><documentation>Aktion wiederherstellen: holt die Website aus dem Papierkorb zurück, solange die Aufbewahrung der Webanwendung läuft.</documentation><outgoing>s_wieder_next</outgoing><messageEventDefinition messageRef="m_sp_s_wieder"/></startEvent>
    <scriptTask id="sc_wieder" name="Adresse bilden"><documentation>Bildet den Alias aus der bestellten URL so, wie ihn die Namensregel übernommen hat: kleingeschrieben und mit NAME_PREFIX davor. url ist nicht als Personendatum deklariert, nur so darf die Engine sie auswerten.</documentation><extensionElements><zeebe:script expression="=(if application.NAME_PREFIX = null then &quot;&quot; else application.NAME_PREFIX) + lower case(url)" resultVariable="alias"/></extensionElements><incoming>s_wieder_next</incoming><outgoing>f_wieder_op</outgoing></scriptTask>
    <serviceTask id="st_wieder" name="Website wiederherstellen"><documentation>restore-site stellt die jüngste gelöschte Website dieser Adresse wieder her (Restore-SPDeletedSite).</documentation><extensionElements><atlas:sharepointServerConnector connector="ucc_sharepoint_onprem" operation="restore-site" parameters="{&quot;Site&quot;: &quot;=alias&quot;}"/></extensionElements><incoming>f_wieder_op</incoming><outgoing>f_wieder_ok</outgoing><dataOutputAssociation id="doa_dor_wieder"><targetRef>dor_wieder</targetRef></dataOutputAssociation></serviceTask>
    <sendTask id="sd_wieder" name="Änderung als erledigt melden"><documentation>Meldet die Aktion «wiederherstellen» dem Shop als completed.</documentation><extensionElements><atlas:shopTask mode="outcome" action="wiederherstellen" outcome="completed"/></extensionElements><incoming>f_wieder_ok</incoming><outgoing>f_wieder_done</outgoing></sendTask>
    <endEvent id="e_wieder" name="Erledigt"><documentation>Die Aktion ist erledigt.</documentation><incoming>f_wieder_done</incoming></endEvent>
    <boundaryEvent id="b_wieder_a" name="Nicht im Papierkorb" attachedToRef="st_wieder" cancelActivity="true"><documentation>SHAREPOINT_SERVER_DELETED_SITE_NOT_FOUND: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_wieder_a_out</outgoing><errorEventDefinition errorRef="err_deleted"/></boundaryEvent>
    <boundaryEvent id="b_wieder_b" name="Adresse vergeben" attachedToRef="st_wieder" cancelActivity="true"><documentation>SHAREPOINT_SERVER_SITE_EXISTS: Fehlerrand; die Aktion endet mit einer begründeten Meldung statt mit einem Incident.</documentation><outgoing>b_wieder_b_out</outgoing><errorEventDefinition errorRef="err_exists"/></boundaryEvent>
    <sendTask id="sd_wieder_abl" name="Ablehnung melden"><documentation>Meldet die Aktion «wiederherstellen» dem Shop als rejected.</documentation><extensionElements><atlas:shopTask mode="outcome" action="wiederherstellen" outcome="rejected"/></extensionElements><incoming>b_wieder_a_out</incoming><incoming>b_wieder_b_out</incoming><outgoing>f_wieder_abl_end</outgoing></sendTask>
    <endEvent id="e_wieder_abl" name="Abgelehnt"><documentation>Die Aktion wurde abgelehnt; die Person liest den Grund im Shop.</documentation><incoming>f_wieder_abl_end</incoming></endEvent>
