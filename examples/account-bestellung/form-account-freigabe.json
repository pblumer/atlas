{
  "type": "default",
  "id": "account-freigabe",
  "components": [
    {
      "type": "text",
      "text": "# 🔑 Bestellung freigeben\n\nPrüfe die Account-Bestellung. Kategorie und Aktivierung kommen aus der DMN-Regel `KontotypMapping`. UPN und Anzeigename bildet der Entra-Worker beim Anlegen selbst aus Vor- und Nachname: `jml-test-<kürzel>-<vorname>.<nachname>@contoso.com`. Bei **Freigabe** setzt du das Initialpasswort; der Entra-Worker legt das Konto in contoso.com an."
    },
    {
      "key": "kategorie",
      "type": "textfield",
      "label": "Kategorie (aus DMN)",
      "disabled": true
    },
    {
      "key": "vorname",
      "type": "textfield",
      "label": "Vorname",
      "disabled": true
    },
    {
      "key": "nachname",
      "type": "textfield",
      "label": "Nachname",
      "disabled": true
    },
    {
      "key": "begruendung",
      "type": "textarea",
      "label": "Begründung des Antragstellers",
      "disabled": true
    },
    {
      "key": "entscheidung",
      "type": "radio",
      "label": "Entscheidung",
      "values": [
        { "label": "Freigeben – Konto in contoso.com anlegen", "value": "anlegen" },
        { "label": "Bestellung ablehnen", "value": "ablehnen" }
      ],
      "validate": { "required": true }
    },
    {
      "key": "initialpasswort",
      "type": "textfield",
      "label": "Initiales Passwort",
      "description": "Mindestens 8 Zeichen. Wird beim ersten Login geändert.",
      "conditional": { "hide": "=entscheidung != \"anlegen\"" },
      "validate": { "required": true, "minLength": 8 }
    },
    {
      "key": "ablehnungsgrund",
      "type": "textarea",
      "label": "Ablehnungsgrund",
      "conditional": { "hide": "=entscheidung != \"ablehnen\"" }
    }
  ]
}
