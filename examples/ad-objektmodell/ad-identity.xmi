      <ownedComment xmi:type="uml:Comment" xmi:id="User-mSMQDigests-doc">
        <body>MSMQ-Digests - An array of digests of the corresponding certificates in attribute mSMQ-Sign-Certificates. They are used for mapping a digest into a certificate. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
