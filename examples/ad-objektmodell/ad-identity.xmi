      <ownedComment xmi:type="uml:Comment" xmi:id="User-msIIS-FTPRoot-doc">
        <body>ms-IIS-FTP-Root - This attribute determines the file server share. It is used in conjunction with ms-IIS-FTP-Dir to determine the FTP user home directory. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
