    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msDS-GeoCoordinatesAltitude" name="msDS-GeoCoordinatesAltitude" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msDS-GeoCoordinatesAltitude-doc">
        <body>ms-DS-GeoCoordinates-Altitude - Geo-coordinates for location services, specifically altitude (in millimeters) of the office or conference room. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msDS-GeoCoordinatesLatitude" name="msDS-GeoCoordinatesLatitude" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msDS-GeoCoordinatesLatitude-doc">
        <body>ms-DS-GeoCoordinates-Latitude - Geo-coordinates for location services, specifically, latitude (in microdegrees) of the office or conference room. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msDS-GeoCoordinatesLongitude" name="msDS-GeoCoordinatesLongitude" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msDS-GeoCoordinatesLongitude-doc">
        <body>ms-DS-GeoCoordinates-Longitude - Geo-coordinates for location services, specifically, longitude (in microdegrees) of the office or conference room. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msDS-PhoneticDisplayName" name="msDS-PhoneticDisplayName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msDS-PhoneticDisplayName-doc">
        <body>ms-DS-Phonetic-Display-Name - The phonetic display name of an object. In the absence of a phonetic display name, the existing display name is used. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msExchAssistantName" name="msExchAssistantName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msExchAssistantName-doc">
        <body>ms-Exch-Assistant-Name - Contains the name of the assistant for an account. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-msExchLabeledURI" name="msExchLabeledURI" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-msExchLabeledURI-doc">
        <body>ms-Exch-LabeledURI - An Exchange URI followed by a label. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-secretary" name="secretary" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-secretary-doc">
        <body>secretary - Contains the distinguished name of the secretary for an account. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-showInAddressBook" name="showInAddressBook" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-showInAddressBook-doc">
        <body>Show-In-Address-Book - This attribute is used to indicate in which MAPI address books an object will appear. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-telephoneNumber" name="telephoneNumber" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-telephoneNumber-doc">
        <body>Telephone-Number - The primary telephone number. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-textEncodedORAddress" name="textEncodedORAddress" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-textEncodedORAddress-doc">
        <body>Text-Encoded-OR-Address - This attribute is used to support X.400 addresses in a text format. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-userCert" name="userCert" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-userCert-doc">
        <body>User-Cert - Nortel v1 or DMS certificates. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-userSMIMECertificate" name="userSMIMECertificate" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-userSMIMECertificate-doc">
        <body>User-SMIME-Certificate - Certificate distribution object or tagged certificates. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-userCertificate" name="userCertificate" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-userCertificate-doc">
        <body>X509-Cert - Contains the DER-encoded X.509v3 certificates issued to the user. Note that this property contains the public key certificates issued to this user by Microsoft Certificate Service. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="Organizational-Person" name="Organizational-Person">
    <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-doc">
      <body>This class is used for objects that contain organizational information about a user, such as the employee number, department, manager, title, office address, and so on. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-Organizational-Person-Person" general="Person"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-streetAddress" name="streetAddress" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-streetAddress-doc">
        <body>Address - The user's address. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-homePostalAddress" name="homePostalAddress" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-homePostalAddress-doc">
        <body>Address-Home - A user's home address. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-assistant" name="assistant" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-assistant-doc">
        <body>Assistant - The distinguished name of a user's administrative assistant. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-company" name="company" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-company-doc">
        <body>Company - The user's company name. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-countryCode" name="countryCode" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-countryCode-doc">
        <body>Country-Code - Specifies the country/region code for the user's language of choice. This value is not used by Windows 2000. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-c" name="c" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-c-doc">
        <body>Country-Name - The country/region in the address of the user. The country/region is represented as a 2-character code based on ISO-3166. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-department" name="department" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-department-doc">
        <body>Department - Contains the name for the department in which the user works. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-destinationIndicator" name="destinationIndicator" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-destinationIndicator-doc">
        <body>Destination-Indicator - This is part of the X.500 specification and not used by NTDS. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-division" name="division" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-division-doc">
        <body>Division - The user's division. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-mail" name="mail" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-mail-doc">
        <body>E-mail-Addresses - The list of email addresses for a contact. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-employeeID" name="employeeID" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-employeeID-doc">
        <body>Employee-ID - The ID of an employee. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-facsimileTelephoneNumber" name="facsimileTelephoneNumber" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-facsimileTelephoneNumber-doc">
        <body>Facsimile-Telephone-Number - Contains telephone number of the user's business fax machine. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-generationQualifier" name="generationQualifier" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-generationQualifier-doc">
        <body>Generation-Qualifier - Indicates a person generation. For example, Jr. or II. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-givenName" name="givenName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-givenName-doc">
        <body>Given-Name - Contains the given name (first name) of the user. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-houseIdentifier" name="houseIdentifier" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-houseIdentifier-doc">
        <body>houseIdentifier - Specifies a linguistic construct used to identify a particular building, for example, a house number or house name relative to a street, avenue, town, city, and so on. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Organizational-Person-initials" name="initials" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-initials-doc">
