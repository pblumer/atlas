<?xml version="1.0" encoding="UTF-8"?>
<uml:Model xmi:version="20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101" xmi:id="model" name="Active Directory Objektmodell">
  <ownedComment xmi:type="uml:Comment" xmi:id="model-doc">
    <body>Active-Directory-Schemaklassen fuer Identitaets- und Berechtigungsprozesse, erzeugt aus Microsofts Schemadokumentation (MicrosoftDocs/win32, desktop-src/ADSchema). Je Klasse nur die selbst deklarierten Attribute; geerbte stehen an der Oberklasse. Hilfsklassen (auxiliary classes) sind als Generalisierung gefuehrt.</body>
  </ownedComment>
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="primitive-boolean" name="boolean"/>
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="primitive-dateTime" name="dateTime"/>
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="primitive-number" name="number"/>
  <packagedElement xmi:type="uml:PrimitiveType" xmi:id="primitive-string" name="string"/>
  <packagedElement xmi:type="uml:Class" xmi:id="Builtin-Domain" name="Builtin-Domain">
    <ownedComment xmi:type="uml:Comment" xmi:id="Builtin-Domain-doc">
      <body>The container that holds the default groups for a domain. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-Builtin-Domain-Top" general="Top"/>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="Computer" name="Computer">
    <ownedComment xmi:type="uml:Comment" xmi:id="Computer-doc">
      <body>This class represents a computer account in the domain. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-Computer-User" general="User"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-catalogs" name="catalogs" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-catalogs-doc">
        <body>Catalogs - The list of catalogs that index storage on a given computer. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-cn" name="cn" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-cn-doc">
        <body>Common-Name - The name that represents an object. Used to perform searches. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-defaultLocalPolicyObject" name="defaultLocalPolicyObject" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-defaultLocalPolicyObject-doc">
        <body>Default-Local-Policy-Object - A reference to a Policy object that defines the local policy for the host object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-dNSHostName" name="dNSHostName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-dNSHostName-doc">
        <body>DNS-Host-Name - Name of computer as registered in DNS. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-localPolicyFlags" name="localPolicyFlags" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-localPolicyFlags-doc">
        <body>Local-Policy-Flags - Flags that determine where a computer gets its policy. Local-Policy-Reference. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-location" name="location" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-location-doc">
        <body>Location - The user's location, such as office number. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-machineRole" name="machineRole" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-machineRole-doc">
        <body>Machine-Role - Role for a machine DC, Server, or Workstation. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-managedBy" name="managedBy" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-managedBy-doc">
        <body>Managed-By - The distinguished name of the user that is assigned to manage this object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-AdditionalDnsHostName" name="msDS-AdditionalDnsHostName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-AdditionalDnsHostName-doc">
        <body>ms-DS-Additional-Dns-Host-Name - The attribute is used to store the additional DNS host name of a computer object. This attribute is used at the time a DC is renamed. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-AdditionalSamAccountName" name="msDS-AdditionalSamAccountName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-AdditionalSamAccountName-doc">
        <body>ms-DS-Additional-Sam-Account-Name - This attribute is used to store the SAM account names that correspond to the DNS host names in ms-DS-Additional-Dns-Host-Name. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-AuthenticatedAtDC" name="msDS-AuthenticatedAtDC" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-AuthenticatedAtDC-doc">
        <body>ms-DS-AuthenticatedAt-DC - Forward link for ms-DS-AuthenticatedTo-Accountlist. Identifies which DC a user has authenticated to. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-ExecuteScriptPassword" name="msDS-ExecuteScriptPassword" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-ExecuteScriptPassword-doc">
        <body>ms-DS-ExecuteScriptPassword - Used during domain rename. This value cannot be written to or read from by using LDAP. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-GenerationId" name="msDS-GenerationId" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-GenerationId-doc">
        <body>ms-DS-Generation-Id - For virtual machine snapshot resuming detection. This attribute represents the VM Generation ID. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-HostServiceAccount" name="msDS-HostServiceAccount" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-HostServiceAccount-doc">
        <body>ms-DS-Host-Service-Account - Service Accounts configured to run on this computer. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-isGC" name="msDS-isGC" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-isGC-doc">
        <body>ms-DS-isGC - Identifies the state of the Global Catalog on the DC. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-isRODC" name="msDS-isRODC" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-isRODC-doc">
        <body>ms-DS-isRODC - Shows whether a DC is an RODC. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-IsUserCachableAtRodc" name="msDS-IsUserCachableAtRodc" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-IsUserCachableAtRodc-doc">
        <body>ms-DS-Is-User-Cachable-At-Rodc - For a Read-Only Domain Controller (RODC), identifies whether the specified user's secrets can be cached. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-KrbTgtLink" name="msDS-KrbTgtLink" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-KrbTgtLink-doc">
        <body>ms-DS-KrbTgt-Link - Used with RODCs to define which krbtgt\_XXXX account corresponds to each RODC. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-NeverRevealGroup" name="msDS-NeverRevealGroup" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-NeverRevealGroup-doc">
        <body>ms-DS-Never-Reveal-Group - Used with RODCs to define which users, computers, and groups are not allowed to have their passwords cached on an RODC. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-PromotionSettings" name="msDS-PromotionSettings" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-PromotionSettings-doc">
        <body>ms-DS-Promotion-Settings - For a computer, contains an XML string to be used for delegated DSA promotion. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-RevealedList" name="msDS-RevealedList" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-RevealedList-doc">
        <body>ms-DS-Revealed-List - Identifies security principals whose current computer account passwords have been replicated to the RODC. (LDAP-Syntax: Object(Access-Point))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-RevealedUsers" name="msDS-RevealedUsers" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-RevealedUsers-doc">
        <body>ms-DS-Revealed-Users - Used with RODCs to identify the user objects whose secrets have been disclosed to that RODC. (LDAP-Syntax: Object(DN-Binary))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-RevealOnDemandGroup" name="msDS-RevealOnDemandGroup" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-RevealOnDemandGroup-doc">
        <body>ms-DS-Reveal-OnDemand-Group - Used with RODCs to define which users, computers, and groups are allowed to have their passwords cached on an RODC. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msDS-SiteName" name="msDS-SiteName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msDS-SiteName-doc">
        <body>ms-DS-SiteName - Lists the site name that corresponds to the DC. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msImaging-HashAlgorithm" name="msImaging-HashAlgorithm" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msImaging-HashAlgorithm-doc">
        <body>ms-Imaging-Hash-Algorithm - Contains the name of the hash algorithm used to create the Thumbprint Hash for the Scan Repository/Secure Print Device. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msImaging-ThumbprintHash" name="msImaging-ThumbprintHash" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msImaging-ThumbprintHash-doc">
        <body>ms-Imaging-Thumbprint-Hash - Contains a hash of the security certificate for the Scan Repository/Secure Print Device. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msSFU30Aliases" name="msSFU30Aliases" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msSFU30Aliases-doc">
        <body>msSFU-30-Aliases - Contains part of the NIS mail map. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msSFU30Name" name="msSFU30Name" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msSFU30Name-doc">
        <body>msSFU-30-Name - Contains the name of a map. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msSFU30NisDomain" name="msSFU30NisDomain" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msSFU30NisDomain-doc">
        <body>msSFU-30-Nis-Domain - Contains the NIS domain. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTPM-OwnerInformation" name="msTPM-OwnerInformation" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTPM-OwnerInformation-doc">
        <body>ms-TPM-OwnerInformation - Contains the owner information of a particular TPM. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTPM-TpmInformationForComputer" name="msTPM-TpmInformationForComputer" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTPM-TpmInformationForComputer-doc">
        <body>ms-TPM-Tpm-Information-For-Computer - This attribute links a Computer object to a TPM object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSEndpointData" name="msTSEndpointData" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSEndpointData-doc">
        <body>ms-TS-Endpoint-Data - This attribute represents the VM Name for a computer in a TSV deployment. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSEndpointPlugin" name="msTSEndpointPlugin" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSEndpointPlugin-doc">
        <body>ms-TS-Endpoint-Plugin - This attribute represents the name of the plug-in that handles the orchestration. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSEndpointType" name="msTSEndpointType" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSEndpointType-doc">
        <body>ms-TS-Endpoint-Type - This attribute defines whether the computer is a physical computer or a virtual machine. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSPrimaryDesktopBL" name="msTSPrimaryDesktopBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSPrimaryDesktopBL-doc">
        <body>ms-TS-Primary-Desktop-BL - This attribute represents the backward link to a user. | ms-TS-Primary-Desktop-BL attribute (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSProperty01" name="msTSProperty01" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSProperty01-doc">
        <body>MS-TS-Property01 - Reserved for future use. | MS-TS-Property01 attribute (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSProperty02" name="msTSProperty02" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSProperty02-doc">
        <body>MS-TS-Property02 - Reserved for future use. | MS-TS-Property02 attribute (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-msTSSecondaryDesktopBL" name="msTSSecondaryDesktopBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-msTSSecondaryDesktopBL-doc">
        <body>ms-TS-Secondary-Desktop-BL - This attribute represents the backward link to a user. | ms-TS-Secondary-Desktop-BL attribute (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-netbootGUID" name="netbootGUID" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-netbootGUID-doc">
        <body>Netboot-GUID - Diskless boot A computer's on-board GUID. Corresponds to the computer's network card MAC address. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-netbootInitialization" name="netbootInitialization" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-netbootInitialization-doc">
        <body>Netboot-Initialization - Default boot path for diskless boot. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-netbootMachineFilePath" name="netbootMachineFilePath" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-netbootMachineFilePath-doc">
        <body>Netboot-Machine-File-Path - This attribute specifies the server that answers the client. Beginning with the Windows Server 2003 operating system, it can indicate the Startrom.com that the client gets. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Computer-netbootMirrorDataFile" name="netbootMirrorDataFile" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Computer-netbootMirrorDataFile-doc">
        <body>Netboot-Mirror-Data-File - The Netboot-Mirror-Data-File attribute is reserved for internal use. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
