      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-preferredDeliveryMethod-doc">
        <body>Preferred-Delivery-Method - The X.500-preferred way to deliver to addressee. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
