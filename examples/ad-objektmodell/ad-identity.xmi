  <packagedElement xmi:type="uml:Class" xmi:id="ms-DS-Group-Managed-Service-Account" name="ms-DS-Group-Managed-Service-Account">
    <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-doc">
      <body>The group managed service account class is used to create an account which can be shared by different computers to run Windows services. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-ms-DS-Group-Managed-Service-Account-Computer" general="Computer"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-GroupMSAMembership" name="msDS-GroupMSAMembership" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-GroupMSAMembership-doc">
        <body>ms-DS-GroupMSAMembership - This attribute is used for access checks to determine if a requestor has permission to retrieve the password for a group MSA. (LDAP-Syntax: String(NT-Sec-Desc))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPassword" name="msDS-ManagedPassword" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPassword-doc">
        <body>ms-DS-ManagedPassword - This constructed attribute returns a blob that contains the clear-text previous and current password, TimeUntilEpochExpires, and TimeUntilNextScheduledUpdate for a group MSA. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordId" name="msDS-ManagedPasswordId" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordId-doc">
        <body>ms-DS-ManagedPasswordId - This attribute contains the key identifier for the current managed password data for a group MSA. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordInterval" name="msDS-ManagedPasswordInterval" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordInterval-doc">
        <body>ms-DS-ManagedPasswordInterval - This attribute is used to retrieve the number of days before a managed password is automatically changed for a group MSA. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordPreviousId" name="msDS-ManagedPasswordPreviousId" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="ms-DS-Group-Managed-Service-Account-msDS-ManagedPasswordPreviousId-doc">
        <body>ms-DS-ManagedPasswordPreviousId - This constructed attribute contains the key identifier for the previous managed password data for a group MSA. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
