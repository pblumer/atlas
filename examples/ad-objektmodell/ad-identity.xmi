      <ownedComment xmi:type="uml:Comment" xmi:id="User-mSMQDigestsMig-doc">
        <body>MSMQ-Digests-Mig - In MSMQ mixed-mode, contains the previous value of mSMQDigests. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
