    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-netbootSCPBL" name="netbootSCPBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-netbootSCPBL-doc">
        <body>netboot-SCP-BL - A list of service connection points that reference this NetBoot server. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-nonSecurityMemberBL" name="nonSecurityMemberBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-nonSecurityMemberBL-doc">
        <body>Non-Security-Member-BL - List of nonsecurity-members for an Exchange distribution list. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-nTSecurityDescriptor" name="nTSecurityDescriptor" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-nTSecurityDescriptor-doc">
        <body>NT-Security-Descriptor - The Windows NT security descriptor for the schema object. A security descriptor is a data structure that contains security information about an object, such as the ownership and permissions of the object. (LDAP-Syntax: String(NT-Sec-Desc))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-distinguishedName" name="distinguishedName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-distinguishedName-doc">
        <body>Obj-Dist-Name - Same as the Distinguished Name for an object. Used by Exchange. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-objectCategory" name="objectCategory" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-objectCategory-doc">
        <body>Object-Category - An object class name used to group objects of this or derived classes. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-objectClass" name="objectClass" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-objectClass-doc">
        <body>Object-Class - The list of classes from which this class is derived. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-objectGUID" name="objectGUID" type="primitive-string" isID="true">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-objectGUID-doc">
        <body>Object-Guid - The unique identifier for an object. (LDAP-Syntax: Object(Replica-Link)) Als Geschaeftsschluessel gefuehrt: Microsoft fuehrt das Attribut als optional, weil das Verzeichnis es selbst setzt.</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-objectVersion" name="objectVersion" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-objectVersion-doc">
        <body>Object-Version - This can be used to store a version number for the object. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-otherWellKnownObjects" name="otherWellKnownObjects" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-otherWellKnownObjects-doc">
        <body>Other-Well-Known-Objects - Contains a list of containers by GUID and Distinguished Name. This permits retrieving an object after it has been moved by using just the GUID and the domain name. Whenever the object is moved, the system automatically updates the Distinguished Name. (LDAP-Syntax: Object(DN-Binary))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-partialAttributeDeletionList" name="partialAttributeDeletionList" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-partialAttributeDeletionList-doc">
        <body>Partial-Attribute-Deletion-List - Tracks the internal replication state of partial replicas (that is, on GCs). Attribute of the partial replica NC object. Used when the GC is in the process of removing attributes from the objects in its partial replica NCs. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-partialAttributeSet" name="partialAttributeSet" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-partialAttributeSet-doc">
        <body>Partial-Attribute-Set - Tracks the internal replication state of partial replicas (that is, on GCs). Attribute of the partial replica NC object. Defines the set of attributes present on a particular partial replica NC. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-possibleInferiors" name="possibleInferiors" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-possibleInferiors-doc">
        <body>Possible-Inferiors - The list of objects that this object can contain. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-proxiedObjectName" name="proxiedObjectName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-proxiedObjectName-doc">
        <body>Proxied-Object-Name - This attribute is used internally by Active Directory to help track interdomain moves. (LDAP-Syntax: Object(DN-Binary))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-proxyAddresses" name="proxyAddresses" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-proxyAddresses-doc">
        <body>Proxy-Addresses - A proxy address is the address by which a Microsoft Exchange Server recipient object is recognized in a foreign mail system. Proxy addresses are required for all recipient objects, such as custom recipients and distribution lists. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-queryPolicyBL" name="queryPolicyBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-queryPolicyBL-doc">
        <body>Query-Policy-BL - List of all objects holding references to a given Query-Policy. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-name" name="name" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-name-doc">
        <body>RDN - The Relative Distinguished Name (RDN) of an object. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-replPropertyMetaData" name="replPropertyMetaData" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-replPropertyMetaData-doc">
        <body>Repl-Property-Meta-Data - Tracks internal replication state information for DS objects. Information here can be extracted in public form through the public API DsReplicaGetInfo(). Present on all DS objects. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-replUpToDateVector" name="replUpToDateVector" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-replUpToDateVector-doc">
        <body>Repl-UpToDate-Vector - Tracks internal replication state information for an entire NC. Information here can be extracted in public form through the API DsReplicaGetInfo(). Present on all NC root objects. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-directReports" name="directReports" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-directReports-doc">
        <body>Reports - Contains the list of users that directly report to the user. The users listed as reports are those that have the property manager property set to this user. Each item in the list is a linked reference to the object that represents the user. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-repsFrom" name="repsFrom" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-repsFrom-doc">
        <body>Reps-From - Lists the servers from which the directory will accept changes for the defined naming context. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-repsTo" name="repsTo" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-repsTo-doc">
        <body>Reps-To - Lists the servers that the directory will notify of changes and servers to which the directory will send changes on Request for the defined naming context. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-revision" name="revision" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-revision-doc">
        <body>Revision - The revision level for a security descriptor or other change. Only used in the sam-server and ds-ui-settings objects. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-sDRightsEffective" name="sDRightsEffective" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-sDRightsEffective-doc">
        <body>SD-Rights-Effective - This constructed attribute returns a single DWORD value that can have up to three bits set OWNER\_SECURITY\_INFORMATIONDACL\_SECURITY\_INFORMATIONSACL\_SECURITY\_INFORMATION If a bit is set, then the user has write access to the corresponding part of the security descriptor. Owner means both owner and group. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-serverReferenceBL" name="serverReferenceBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-serverReferenceBL-doc">
        <body>Server-Reference-BL - Found in the domain naming context. The distinguished name of a computer under the sites folder. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-showInAdvancedViewOnly" name="showInAdvancedViewOnly" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-showInAdvancedViewOnly-doc">
        <body>Show-In-Advanced-View-Only - TRUE if this attribute is to be visible in the Advanced mode of the UI. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-siteObjectBL" name="siteObjectBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-siteObjectBL-doc">
        <body>Site-Object-BL - The list of distinguished names for subnets that belong to this site. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-structuralObjectClass" name="structuralObjectClass" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-structuralObjectClass-doc">
        <body>Structural-Object-Class - This constructed attribute stores a list of classes contained in a class hierarchy, including abstract classes. This list does contain dynamically linked auxiliary classes. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-subRefs" name="subRefs" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-subRefs-doc">
        <body>Sub-Refs - List of subordinate references of a Naming Context. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-subSchemaSubEntry" name="subSchemaSubEntry" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-subSchemaSubEntry-doc">
        <body>SubSchemaSubEntry - The distinguished name for the location of the subschema object where a class or attribute is defined. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-systemFlags" name="systemFlags" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-systemFlags-doc">
        <body>System-Flags - An integer value that contains flags that define additional properties of the class. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-uSNChanged" name="uSNChanged" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-uSNChanged-doc">
        <body>USN-Changed - The update sequence number (USN) assigned by the local directory for the latest change, including creation. See also , USN-Created. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-uSNCreated" name="uSNCreated" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-uSNCreated-doc">
        <body>USN-Created - The update sequence number (USN) assigned at object creation. See also, USN-Changed. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-uSNDSALastObjRemoved" name="uSNDSALastObjRemoved" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-uSNDSALastObjRemoved-doc">
        <body>USN-DSA-Last-Obj-Removed - Contains the update sequence number (USN) for the last system object that was removed from a server. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-USNIntersite" name="USNIntersite" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-USNIntersite-doc">
        <body>USN-Intersite - The update sequence number (USN) for inter-site replication. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-uSNLastObjRem" name="uSNLastObjRem" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-uSNLastObjRem-doc">
        <body>USN-Last-Obj-Rem - Contains the update sequence number (USN) for the last non-system object that was removed from a server. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-uSNSource" name="uSNSource" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-uSNSource-doc">
        <body>USN-Source - Value of the USN-Changed attribute of the object from the remote directory that replicated the change to the local server. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-wbemPath" name="wbemPath" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-wbemPath-doc">
        <body>Wbem-Path - References to objects in other ADSI namespaces. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-wellKnownObjects" name="wellKnownObjects" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-wellKnownObjects-doc">
        <body>Well-Known-Objects - This attribute contains a list of well-known object containers by GUID and distinguished name. (LDAP-Syntax: Object(DN-Binary))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-whenChanged" name="whenChanged" type="primitive-dateTime">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-whenChanged-doc">
        <body>When-Changed - The date when this object was last changed. This value is not replicated and exists in the global catalog. (LDAP-Syntax: String(Generalized-Time))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-whenCreated" name="whenCreated" type="primitive-dateTime">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-whenCreated-doc">
        <body>When-Created - The date when this object was created. This value is replicated and is in the global catalog. (LDAP-Syntax: String(Generalized-Time))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-wWWHomePage" name="wWWHomePage" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-wWWHomePage-doc">
        <body>WWW-Home-Page - A web page that is the primary landing page of a website. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-url" name="url" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-url-doc">
        <body>WWW-Page-Other - A list of alternate webpages. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="User" name="User">
    <ownedComment xmi:type="uml:Comment" xmi:id="User-doc">
      <body>This class is used to store information about an employee or contractor who works for an organization. It is also possible to apply this class to long term visitors. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-User-Mail-Recipient" general="Mail-Recipient"/>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-User-Organizational-Person" general="Organizational-Person"/>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-User-Security-Principal" general="Security-Principal"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-accountExpires" name="accountExpires" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-accountExpires-doc">
        <body>Account-Expires - The date when the account expires. (LDAP-Syntax: Interval)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-aCSPolicyName" name="aCSPolicyName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-aCSPolicyName-doc">
        <body>ACS-Policy-Name - String name of an ACS policy that applies to this user. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-homePostalAddress" name="homePostalAddress" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-homePostalAddress-doc">
        <body>Address-Home - A user's home address. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
