    <ownedAttribute xmi:type="uml:Property" xmi:id="User-msDS-ResultantPSO" name="msDS-ResultantPSO" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-msDS-ResultantPSO-doc">
