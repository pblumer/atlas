        <body>ms-DS-Az-LDAP-Query - A string that defines the LDAP query (max length 4096) which determines the membership of a user object to the group. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msDS-AzObjectGuid" name="msDS-AzObjectGuid" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msDS-AzObjectGuid-doc">
        <body>ms-DS-Az-Object-Guid - The unique and portable identifier of AzMan objects (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msDS-NonMembers" name="msDS-NonMembers" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msDS-NonMembers-doc">
        <body>ms-DS-Non-Members - This attribute serves the same purpose as the Non-Security-Member attribute but with scoping rules applied. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msDS-PrimaryComputer" name="msDS-PrimaryComputer" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msDS-PrimaryComputer-doc">
        <body>ms-DS-Primary-Computer - For a user or group object, identifies the primary computers. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msSFU30Name" name="msSFU30Name" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msSFU30Name-doc">
        <body>msSFU-30-Name - Contains the name of a map. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msSFU30NisDomain" name="msSFU30NisDomain" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msSFU30NisDomain-doc">
        <body>msSFU-30-Nis-Domain - Contains the NIS domain. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-msSFU30PosixMember" name="msSFU30PosixMember" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-msSFU30PosixMember-doc">
        <body>msSFU-30-Posix-Member - Contains the DN display name of the user's part of a group. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-nonSecurityMember" name="nonSecurityMember" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-nonSecurityMember-doc">
        <body>Non-Security-Member - Nonsecurity members of a group. Used for Exchange distribution lists. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-nTGroupMembers" name="nTGroupMembers" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-nTGroupMembers-doc">
        <body>NT-Group-Members - This attribute is not used. | NT-Group-Members attribute (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-operatorCount" name="operatorCount" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-operatorCount-doc">
        <body>Operator-Count - Operator count. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Group-primaryGroupToken" name="primaryGroupToken" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Group-primaryGroupToken-doc">
        <body>Primary-Group-Token - A computed attribute that is used in retrieving the membership list of a group, such as Domain Users. The complete membership of such groups is not stored explicitly for scaling reasons. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="Mail-Recipient" name="Mail-Recipient">
    <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-doc">
      <body>Stores email configuration information. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <generalization xmi:type="uml:Generalization" xmi:id="gen-Mail-Recipient-Top" general="Top"/>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-info" name="info" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-info-doc">
        <body>Comment - The user's comments. This string can be a null string. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-cn" name="cn" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-cn-doc">
        <body>Common-Name - The name that represents an object. Used to perform searches. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-garbageCollPeriod" name="garbageCollPeriod" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-garbageCollPeriod-doc">
        <body>Garbage-Coll-Period - This attribute is located on the CN Directory Service,CN Windows NT,CN Services,CN Configuration,... object. It represents the time, in hours, between DS garbage collection runs. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-labeledURI" name="labeledURI" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-labeledURI-doc">
        <body>labeledURI - A Uniform Resource Identifier followed by a label. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Mail-Recipient-legacyExchangeDN" name="legacyExchangeDN" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Mail-Recipient-legacyExchangeDN-doc">
        <body>Legacy-Exchange-DN - The distinguished name previously used by Exchange. (LDAP-Syntax: String(Teletex))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
