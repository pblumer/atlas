    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-nTSecurityDescriptor" name="nTSecurityDescriptor" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-nTSecurityDescriptor-doc">
        <body>NT-Security-Descriptor - The Windows NT security descriptor for the schema object. A security descriptor is a data structure that contains security information about an object, such as the ownership and permissions of the object. (LDAP-Syntax: String(NT-Sec-Desc))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-objectSid" name="objectSid" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-objectSid-doc">
        <body>Object-Sid - A binary value that specifies the security identifier (SID) of the user. The SID is a unique value used to identify the user as a security principal. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-rid" name="rid" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-rid-doc">
        <body>Rid - The relative Identifier of an object. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-sAMAccountName" name="sAMAccountName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-sAMAccountName-doc">
        <body>SAM-Account-Name - The logon name used to support clients and servers running earlier versions of the operating system, such as Windows NT 4.0, Windows 95, Windows 98, and LAN Manager. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-sAMAccountType" name="sAMAccountType" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-sAMAccountType-doc">
        <body>SAM-Account-Type - This attribute contains information about every account type object. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-securityIdentifier" name="securityIdentifier" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-securityIdentifier-doc">
        <body>Security-Identifier - A unique value of variable length used to identify a user account, group account, or logon session to which an ACE applies. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-sIDHistory" name="sIDHistory" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-sIDHistory-doc">
        <body>SID-History - Contains previous SIDs used for the object if the object was moved from another domain. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-supplementalCredentials" name="supplementalCredentials" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-supplementalCredentials-doc">
        <body>Supplemental-Credentials - Stored credentials for use in authenticating. The encrypted version of the user's password. This attribute is neither readable nor writable. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-tokenGroups" name="tokenGroups" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-tokenGroups-doc">
        <body>Token-Groups - A computed attribute that contains the list of SIDs due to a transitive group membership expansion operation on a given user or computer. Token Groups cannot be retrieved if no Global Catalog is present to retrieve the transitive reverse memberships. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-tokenGroupsGlobalAndUniversal" name="tokenGroupsGlobalAndUniversal" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-tokenGroupsGlobalAndUniversal-doc">
        <body>Token-Groups-Global-And-Universal - Token groups for Exchange. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Security-Principal-tokenGroupsNoGCAcceptable" name="tokenGroupsNoGCAcceptable" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Security-Principal-tokenGroupsNoGCAcceptable-doc">
        <body>Token-Groups-No-GC-Acceptable - This attribute contains the list of SIDs due to a transitive group membership expansion operation on a given user or computer. Token groups cannot be retrieved if a Global Catalog is not present to retrieve the transitive reverse memberships. (LDAP-Syntax: String(Sid))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
  </packagedElement>
  <packagedElement xmi:type="uml:Class" xmi:id="Top" name="Top">
    <ownedComment xmi:type="uml:Comment" xmi:id="Top-doc">
      <body>The top level class from which all classes are derived. (Active-Directory-Schemaklasse, Stand Windows Server 2012)</body>
    </ownedComment>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-adminDescription" name="adminDescription" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-adminDescription-doc">
        <body>Admin-Description - The description displayed on admin screens. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-adminDisplayName" name="adminDisplayName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-adminDisplayName-doc">
        <body>Admin-Display-Name - The name to be displayed on admin screens. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-allowedAttributes" name="allowedAttributes" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-allowedAttributes-doc">
        <body>Allowed-Attributes - Attributes that will be permitted to be assigned to a class. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-allowedAttributesEffective" name="allowedAttributesEffective" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-allowedAttributesEffective-doc">
        <body>Allowed-Attributes-Effective - A list of attributes that can be modified on the object. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-allowedChildClasses" name="allowedChildClasses" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-allowedChildClasses-doc">
        <body>Allowed-Child-Classes - Classes that can be contained by a class. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-allowedChildClassesEffective" name="allowedChildClassesEffective" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-allowedChildClassesEffective-doc">
        <body>Allowed-Child-Classes-Effective - A list of classes that can be modified. (LDAP-Syntax: String(Object-Identifier))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-bridgeheadServerListBL" name="bridgeheadServerListBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-bridgeheadServerListBL-doc">
        <body>Bridgehead-Server-List-BL - The list of servers that are bridgeheads for replication. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-canonicalName" name="canonicalName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-canonicalName-doc">
        <body>Canonical-Name - The name of the object in canonical format. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-cn" name="cn" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-cn-doc">
        <body>Common-Name - The name that represents an object. Used to perform searches. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-createTimeStamp" name="createTimeStamp" type="primitive-dateTime">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-createTimeStamp-doc">
        <body>Create-Time-Stamp - The date when this object was created. This value is replicated. (LDAP-Syntax: String(Generalized-Time))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-description" name="description" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-description-doc">
        <body>Description - Contains the description to display for an object. This value is restricted as single-valued for backward compatibility in some cases but is allowed to be multi-valued in others. See Remarks. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-displayName" name="displayName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-displayName-doc">
        <body>Display-Name - The display name for an object. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-displayNamePrintable" name="displayNamePrintable" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-displayNamePrintable-doc">
        <body>Display-Name-Printable - The printable display name for an object. (LDAP-Syntax: String(IA5))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-dSASignature" name="dSASignature" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-dSASignature-doc">
        <body>DSA-Signature - The DSA-Signature of an object is the Invocation-ID of the last directory to modify the object. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-dSCorePropagationData" name="dSCorePropagationData" type="primitive-dateTime">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-dSCorePropagationData-doc">
        <body>DS-Core-Propagation-Data - The DS-Core-Propagation-Data attribute is for internal use only. (LDAP-Syntax: String(Generalized-Time))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-extensionName" name="extensionName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-extensionName-doc">
        <body>Extension-Name - The name of a property page used to extend the UI of a directory object. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-flags" name="flags" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-flags-doc">
        <body>Flags - To be used by the object to store bit information. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-fromEntry" name="fromEntry" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-fromEntry-doc">
        <body>From-Entry - This is a constructed attribute that is TRUE if the object is writable and FALSE if it is read-only, for example, a GC replica instance. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-frsComputerReferenceBL" name="frsComputerReferenceBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-frsComputerReferenceBL-doc">
        <body>Frs-Computer-Reference-BL - Reference to replica sets to which this computer belongs. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-fRSMemberReferenceBL" name="fRSMemberReferenceBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-fRSMemberReferenceBL-doc">
        <body>FRS-Member-Reference-BL - Reference to subscriber objects for this member. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-fSMORoleOwner" name="fSMORoleOwner" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-fSMORoleOwner-doc">
        <body>FSMO-Role-Owner - Flexible Single-Master Operation The distinguished name of the DC where the schema can be modified. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-instanceType" name="instanceType" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-instanceType-doc">
        <body>Instance-Type - A bitfield that dictates how the object is instantiated on a particular server. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="1"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-isCriticalSystemObject" name="isCriticalSystemObject" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-isCriticalSystemObject-doc">
        <body>Is-Critical-System-Object - If TRUE, the object hosting this attribute must be replicated during installation of a new replica. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-isDeleted" name="isDeleted" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-isDeleted-doc">
        <body>Is-Deleted - If TRUE, this object has been marked for deletion and cannot be instantiated. After the tombstone period has expired, it will be removed from the system. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-memberOf" name="memberOf" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-memberOf-doc">
        <body>Is-Member-Of-DL - The distinguished name of the groups to which this object belongs. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-isPrivilegeHolder" name="isPrivilegeHolder" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-isPrivilegeHolder-doc">
        <body>Is-Privilege-Holder - Backward link to privileges held by a given principal. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-isRecycled" name="isRecycled" type="primitive-boolean">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-isRecycled-doc">
        <body>Is-Recycled - Is the object recycled. For use with AD Recycle Bin. (LDAP-Syntax: Boolean)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-lastKnownParent" name="lastKnownParent" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-lastKnownParent-doc">
        <body>Last-Known-Parent - The Distinguished Name (DN) of the last known parent of an orphaned object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-managedObjects" name="managedObjects" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-managedObjects-doc">
        <body>Managed-Objects - Contains the list of objects that are managed by the user. The objects listed are those that have the property managedBy property set to this user. Each item in the list is a linked reference to the managed object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-masteredBy" name="masteredBy" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-masteredBy-doc">
        <body>Mastered-By - Backward link for Has-Master-NCs attribute. The distinguished name for its NTDS Settings objects. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-modifyTimeStamp" name="modifyTimeStamp" type="primitive-dateTime">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-modifyTimeStamp-doc">
        <body>Modify-Time-Stamp - A computed attribute that represents the date when this object was last changed. This value is not replicated. (LDAP-Syntax: String(Generalized-Time))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-msCOM-PartitionSetLink" name="msCOM-PartitionSetLink" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-msCOM-PartitionSetLink-doc">
        <body>ms-COM-PartitionSetLink - A link used to associate a COM+ Partition with a COM+ PartitionSet object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-msCOM-UserLink" name="msCOM-UserLink" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-msCOM-UserLink-doc">
        <body>ms-COM-UserLink - A link used to associate a COM+ PartitionSet with a User object. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-msDFSR-ComputerReferenceBL" name="msDFSR-ComputerReferenceBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-msDFSR-ComputerReferenceBL-doc">
        <body>ms-DFSR-ComputerReferenceBL - Contains the backward link for the ms-DFSR-ComputerReference attribute. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="Top-msDFSR-MemberReferenceBL" name="msDFSR-MemberReferenceBL" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="Top-msDFSR-MemberReferenceBL-doc">
        <body>ms-DFSR-MemberReferenceBL - Contains the backward link for the ms-DFSR-MemberReference attribute. (LDAP-Syntax: Object(DS-DN))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
