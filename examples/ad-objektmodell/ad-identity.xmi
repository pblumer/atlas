      <ownedComment xmi:type="uml:Comment" xmi:id="Organizational-Person-title-doc">
        <body>Title - Contains the user's job title. This property is commonly used to indicate the formal job title, such as Senior Programmer, rather than occupational class, such as programmer. It is not typically used for suffix titles such as Esq. or DDS. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
