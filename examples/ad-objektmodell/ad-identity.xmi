    <ownedAttribute xmi:type="uml:Property" xmi:id="User-uid" name="uid" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-uid-doc">
        <body>uid - A user ID. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-unicodePwd" name="unicodePwd" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-unicodePwd-doc">
        <body>Unicode-Pwd - The password of the user in Windows NT one-way format (OWF). Windows 2000 uses the Windows NT OWF. This property is used only by the operating system. Note that you cannot derive the clear password back from the OWF form of the password. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userAccountControl" name="userAccountControl" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userAccountControl-doc">
        <body>User-Account-Control - Flags that control the behavior of the user account. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userParameters" name="userParameters" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userParameters-doc">
        <body>User-Parameters - Parameters of the user. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userPKCS12" name="userPKCS12" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userPKCS12-doc">
        <body>userPKCS12 - PKCS \ 12 PFX PDU for exchange of personal identity information. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userPrincipalName" name="userPrincipalName" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userPrincipalName-doc">
        <body>User-Principal-Name - This attribute contains the UPN that is an Internet-style login name for a user based on the Internet standard RFC 822. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userSharedFolder" name="userSharedFolder" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userSharedFolder-doc">
        <body>User-Shared-Folder - Specifies a UNC path to the user's shared documents folder. The path must be a network UNC path of the form \\\\Server\\Share\\Directory. This value can be a null string. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userSharedFolderOther" name="userSharedFolderOther" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userSharedFolderOther-doc">
        <body>User-Shared-Folder-Other - Specifies a UNC path to the user's additional shared documents folder. The path must be a network UNC path of the form \\\\Server\\Share\\Directory. This value can be a null string. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userSMIMECertificate" name="userSMIMECertificate" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userSMIMECertificate-doc">
        <body>User-SMIME-Certificate - Certificate distribution object or tagged certificates. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-userWorkstations" name="userWorkstations" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-userWorkstations-doc">
        <body>User-Workstations - Contains the NetBIOS or DNS names of the computers running Windows NT Workstation or Windows 2000 Professional from which the user can log on. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
