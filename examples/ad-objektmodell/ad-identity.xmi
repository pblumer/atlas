      <ownedComment xmi:type="uml:Comment" xmi:id="User-preferredLanguage-doc">
        <body>preferredLanguage - The preferred written or spoken language for a person. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
