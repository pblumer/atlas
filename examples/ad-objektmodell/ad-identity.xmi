      <ownedComment xmi:type="uml:Comment" xmi:id="User-msDS-Site-Affinity-doc">
        <body>ms-DS-Site-Affinity - The ms-DS-Site-Affinity attribute is used by the Security Accounts Manager for group expansion during token evaluation. (LDAP-Syntax: Object(Replica-Link))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="*"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-msDS-SourceObjectDN" name="msDS-SourceObjectDN" type="primitive-string">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-msDS-SourceObjectDN-doc">
        <body>ms-DS-Source-Object-DN - Contains the string representation of the distinguished name of the object in another forest that corresponds to this object. (LDAP-Syntax: String(Unicode))</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-msDS-SupportedEncryptionTypes" name="msDS-SupportedEncryptionTypes" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-msDS-SupportedEncryptionTypes-doc">
        <body>ms-DS-Supported-Encryption-Types - The encryption algorithms supported by user, computer or trust accounts.Note The KDC uses this information while generating a service ticket for this account. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
    <ownedAttribute xmi:type="uml:Property" xmi:id="User-msDS-User-Account-Control-Computed" name="msDS-User-Account-Control-Computed" type="primitive-number">
      <ownedComment xmi:type="uml:Comment" xmi:id="User-msDS-User-Account-Control-Computed-doc">
        <body>ms-DS-User-Account-Control-Computed - msDS-User-Account-Control-Computed is much like userAccountControl, but the attribute's value can contain additional bits that are not persisted. (LDAP-Syntax: Enumeration)</body>
      </ownedComment>
      <lowerValue xmi:type="uml:LiteralInteger" value="0"/>
      <upperValue xmi:type="uml:LiteralUnlimitedNatural" value="1"/>
    </ownedAttribute>
