<?xml version="1.0" encoding="UTF-8"?>
<!--
Active Directory: Berechtigung über eine Gruppenmitgliedschaft. Ein Lebenszyklus für alle Produkte
ad-recht-*; welche Gruppe ein Produkt meint, sagt die Entscheidung AdBerechtigungen.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_ad_berechtigung" targetNamespace="http://atlas/beispiel/ad-dienste">
  <message id="m_recht_erteilen" name="ad.berechtigung.erteilen"/>
  <message id="m_recht_entziehen" name="ad.berechtigung.entziehen"/>
  <process id="proc_ad_berechtigung" name="Active Directory: Berechtigung" isExecutable="true" atlas:personal="konto,kontoTreffer" atlas:dataSubject="recipient">
    <documentation>Eine Berechtigung auf eine Applikation oder ein Fileshare ist eine Mitgliedschaft in einer AD-Gruppe. Jedes Produkt ad-recht-* ist an diesen einen Lebenszyklus gebunden; die Entscheidung AdBerechtigungen bildet die Produkt-ID (itemId) auf die Gruppe ab (gruppeDn, gruppeCn, bezeichnung, maxTage). Ein neues Recht ist eine Zeile in dieser Tabelle und ein Produkt im Katalog, kein neuer Prozess.

Bereitstellen: Tabelle lesen, aktives Konto der empfangenden Person suchen (konto = ihr Anmeldename), Gruppe lesen, prüfen, ob das Konto schon Mitglied ist, add-group-member, done. Rückgabe: Tabelle, Konto, Mitgliedschaft, remove-group-member, returned; ist das Konto kein Mitglied mehr oder gibt es es nicht mehr, ist nichts zu tun. Genehmigt wird von der verantwortlichen Person der Gruppe (managedBy), siehe proc_ad_genehmigung_gruppenverantwortung. Die Produkte sind befristet (maxDays); die Befristung der Plattform gibt ein abgelaufenes Recht über die Bestellung zurück, und dieser Prozess entzieht es.

Personendaten (ADR-0314): konto (der Anmeldename aus dem Bestellformular) und kontoTreffer (der DN des Kontos) sind versiegelt. Die Engine liest keinen davon: Die Kontosuche prüft die Form des Anmeldenamens im Filterausdruck, die Mitgliedschaft prüft eine Suche mit dem DN im Filter, und die Gateways lesen nur die Wahrheitswerte kontoAktiv, kontoGefunden, gruppeDa und istMitglied. Der DN der Gruppe kommt aus der Tabelle. Worker: ad_verzeichnis.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/><atlas:constant name="AD_PERSONEN_OU" type="string" source="application" value="OU=Personen,DC=contoso,DC=local"/></atlas:constants></extensionElements>
    <startEvent id="s_neu" name="Berechtigung bestellt"><documentation>Start der Operation provision (ad.berechtigung.erteilen).</documentation><outgoing>f_s_neu__br_neu</outgoing><messageEventDefinition messageRef="m_recht_erteilen"/></startEvent>
    <businessRuleTask id="br_neu" name="Berechtigung nachschlagen"><documentation>AdBerechtigungen: itemId → bekannt, gruppeDn, gruppeCn, bezeichnung, maxTage. Ergebnis in recht. Eine Produkt-ID ohne Zeile ergibt bekannt = false (Auffangregel).</documentation><extensionElements><zeebe:calledDecision decisionId="AdBerechtigungen" resultVariable="recht"/><zeebe:ioMapping><zeebe:input source="=itemId" target="itemId"/></zeebe:ioMapping></extensionElements><incoming>f_s_neu__br_neu</incoming><outgoing>f_br_neu__sc_pruefen</outgoing></businessRuleTask>
    <scriptTask id="sc_pruefen" name="Angaben prüfen"><documentation>Kennt die Tabelle das Produkt?</documentation><extensionElements><zeebe:script expression="={ok: recht.bekannt = true, grund: &quot;Für dieses Produkt ist keine Gruppe hinterlegt (AdBerechtigungen).&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_br_neu__sc_pruefen</incoming><outgoing>f_sc_pruefen__gw_pruefen</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen" name="Angaben gültig?" default="f_gw_pruefen__st_ablehnen"><documentation>Fail-closed: Default ist die Ablehnung.</documentation><incoming>f_sc_pruefen__gw_pruefen</incoming><outgoing>f_gw_pruefen__st_neu_konto</outgoing><outgoing>f_gw_pruefen__st_ablehnen</outgoing></exclusiveGateway>
    <serviceTask id="st_neu_konto" name="Konto suchen"><documentation>search nach einem aktiven Konto mit dem Anmeldenamen aus konto; kontoTreffer erhält den DN, kontoAktiv den Wahrheitswert. Der Anmeldename ist versiegelt (atlas:personal), die Engine kann seine Form nicht prüfen. Das tut der Filterausdruck, den erst der Worker auswertet: matches() auf ^[A-Za-z0-9._-]{1,20}$, und der Wert wird nach RFC 4515 maskiert. Hat er die Form nicht, fragt die Suche einen Filter, der nichts findet. select 1.1 liefert nur den DN; das Ergebnis ist versiegelt, das Gateway liest den Wahrheitswert aus foundVariable.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_PERSONEN_OU" scope="sub" filter="=if konto != null and matches(konto, &quot;^[A-Za-z0-9._-]{1,20}$&quot;) then &quot;(&amp;(objectClass=user)(sAMAccountName=&quot; + replace(replace(replace(replace(konto, &quot;\\\\&quot;, &quot;\\5c&quot;), &quot;\\*&quot;, &quot;\\2a&quot;), &quot;\\(&quot;, &quot;\\28&quot;), &quot;\\)&quot;, &quot;\\29&quot;) + &quot;)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))&quot; else &quot;(&amp;(objectClass=user)(!(objectClass=user)))&quot;" select="1.1" maxEntries="1" resultVariable="kontoTreffer" foundVariable="kontoAktiv"/></extensionElements><incoming>f_gw_pruefen__st_neu_konto</incoming><outgoing>f_st_neu_konto__st_neu_gruppe</outgoing></serviceTask>
    <serviceTask id="st_neu_gruppe" name="Gruppe lesen"><documentation>search mit baseDN = recht.gruppeDn und scope base: Gibt es die Gruppe? gruppeDa ist der Wahrheitswert.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=recht.gruppeDn" scope="base" filter="(objectClass=group)" select="1.1" maxEntries="1" foundVariable="gruppeDa"/></extensionElements><incoming>f_st_neu_konto__st_neu_gruppe</incoming><outgoing>f_st_neu_gruppe__sc_pruefen2</outgoing></serviceTask>
    <scriptTask id="sc_pruefen2" name="Ergebnis prüfen"><documentation>ok, wenn das Konto aktiv ist und die Gruppe besteht.</documentation><extensionElements><zeebe:script expression="={ok: kontoAktiv = true and gruppeDa = true, grund: if kontoAktiv != true then &quot;Zu diesem Anmeldenamen gibt es kein aktives Konto im Active Directory (1 bis 20 Zeichen: Buchstaben, Ziffern, Punkt, Bindestrich, Unterstrich).&quot; else &quot;Die Gruppe &quot; + recht.gruppeCn + &quot; fehlt im Verzeichnis; bitte die AD-Administration informieren.&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_st_neu_gruppe__sc_pruefen2</incoming><outgoing>f_sc_pruefen2__gw_pruefen2</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen2" name="Bereit?" default="f_gw_pruefen2__st_ablehnen"><documentation>Fail-closed: Default ist die Ablehnung.</documentation><incoming>f_sc_pruefen2__gw_pruefen2</incoming><outgoing>f_gw_pruefen2__st_neu_mitglied</outgoing><outgoing>f_gw_pruefen2__st_ablehnen</outgoing></exclusiveGateway>
    <serviceTask id="st_neu_mitglied" name="Schon Mitglied?"><documentation>search mit baseDN = recht.gruppeDn, scope base, und dem DN des Kontos in member (maskiert nach RFC 4515). istMitglied ist der Wahrheitswert; den DN liest nur der Worker.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=recht.gruppeDn" scope="base" filter="=&quot;(&amp;(objectClass=group)(member=&quot; + replace(replace(replace(replace(kontoTreffer.dn, &quot;\\\\&quot;, &quot;\\5c&quot;), &quot;\\*&quot;, &quot;\\2a&quot;), &quot;\\(&quot;, &quot;\\28&quot;), &quot;\\)&quot;, &quot;\\29&quot;) + &quot;))&quot;" select="1.1" maxEntries="1" foundVariable="istMitglied"/></extensionElements><incoming>f_gw_pruefen2__st_neu_mitglied</incoming><outgoing>f_st_neu_mitglied__gw_mitglied</outgoing></serviceTask>
    <exclusiveGateway id="gw_mitglied" name="Schon Mitglied?" default="f_gw_mitglied__st_add"><documentation>Ist das Konto schon Mitglied, ist das Recht erteilt. Sonst (Default) wird es aufgenommen; ein Konto, das wider Erwarten schon Mitglied ist, weist AD dann ab, und der Task meldet einen Incident, statt still etwas Falsches zu bestätigen.</documentation><incoming>f_st_neu_mitglied__gw_mitglied</incoming><outgoing>f_gw_mitglied__gw_join</outgoing><outgoing>f_gw_mitglied__st_add</outgoing></exclusiveGateway>
    <serviceTask id="st_add" name="In die Gruppe aufnehmen"><documentation>add-group-member mit memberDN = kontoTreffer.dn; der Worker liest den versiegelten DN.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="add-group-member" dn="=recht.gruppeDn" memberDN="=kontoTreffer.dn"/></extensionElements><incoming>f_gw_mitglied__st_add</incoming><outgoing>f_st_add__gw_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_join"><incoming>f_gw_mitglied__gw_join</incoming><incoming>f_st_add__gw_join</incoming><outgoing>f_gw_join__st_done</outgoing></exclusiveGateway>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit steht das Recht im Bestand der empfangenden Person. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;done&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_join__st_done</incoming><outgoing>f_st_done__e_bereit</outgoing></serviceTask>
    <endEvent id="e_bereit" name="Berechtigung erteilt"><incoming>f_st_done__e_bereit</incoming></endEvent>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Lehnt die Position über POST /api/v1/orders/{orderId}/lines/{positionId}/decision ab, mit dem Grund aus pruefung.grund. Eine verletzte Regel ist eine Entscheidung und keine Störung: kein Incident, und die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId) + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;Prüfung der Bestellung&quot;" target="by"/><zeebe:input source="=pruefung.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_pruefen__st_ablehnen</incoming><incoming>f_gw_pruefen2__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt"><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <startEvent id="s_weg" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (ad.berechtigung.entziehen): Rückgabe im Shop, durch den Betrieb oder durch die Befristung der Plattform.</documentation><outgoing>f_s_weg__br_weg</outgoing><messageEventDefinition messageRef="m_recht_entziehen"/></startEvent>
    <businessRuleTask id="br_weg" name="Berechtigung nachschlagen"><documentation>AdBerechtigungen: itemId → bekannt, gruppeDn, gruppeCn, bezeichnung, maxTage. Ergebnis in recht. Eine Produkt-ID ohne Zeile ergibt bekannt = false (Auffangregel).</documentation><extensionElements><zeebe:calledDecision decisionId="AdBerechtigungen" resultVariable="recht"/><zeebe:ioMapping><zeebe:input source="=itemId" target="itemId"/></zeebe:ioMapping></extensionElements><incoming>f_s_weg__br_weg</incoming><outgoing>f_br_weg__gw_weg_k</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_weg_k" name="Produkt bekannt?" default="f_gw_weg_k__st_rf"><documentation>Kennt die Tabelle das Produkt nicht mehr, weiss der Prozess nicht, was er entziehen soll: returnFailed (Default), das Recht bleibt im Bestand.</documentation><incoming>f_br_weg__gw_weg_k</incoming><outgoing>f_gw_weg_k__st_weg_konto</outgoing><outgoing>f_gw_weg_k__st_rf</outgoing></exclusiveGateway>
    <serviceTask id="st_weg_konto" name="Konto suchen"><documentation>search nach dem Anmeldenamen aus konto, auch einem gesperrten Konto; kontoGefunden ist der Wahrheitswert. Der Anmeldename ist versiegelt (atlas:personal), die Engine kann seine Form nicht prüfen. Das tut der Filterausdruck, den erst der Worker auswertet: matches() auf ^[A-Za-z0-9._-]{1,20}$, und der Wert wird nach RFC 4515 maskiert. Hat er die Form nicht, fragt die Suche einen Filter, der nichts findet. select 1.1 liefert nur den DN; das Ergebnis ist versiegelt, das Gateway liest den Wahrheitswert aus foundVariable.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_PERSONEN_OU" scope="sub" filter="=if konto != null and matches(konto, &quot;^[A-Za-z0-9._-]{1,20}$&quot;) then &quot;(&amp;(objectClass=user)(sAMAccountName=&quot; + replace(replace(replace(replace(konto, &quot;\\\\&quot;, &quot;\\5c&quot;), &quot;\\*&quot;, &quot;\\2a&quot;), &quot;\\(&quot;, &quot;\\28&quot;), &quot;\\)&quot;, &quot;\\29&quot;) + &quot;))&quot; else &quot;(&amp;(objectClass=user)(!(objectClass=user)))&quot;" select="1.1" maxEntries="1" resultVariable="kontoTreffer" foundVariable="kontoGefunden"/></extensionElements><incoming>f_gw_weg_k__st_weg_konto</incoming><outgoing>f_st_weg_konto__gw_weg_da</outgoing></serviceTask>
    <exclusiveGateway id="gw_weg_da" name="Konto vorhanden?" default="f_gw_weg_da__gw_weg_join"><documentation>Gibt es das Konto nicht mehr (oder hat der Anmeldename eine Form, die es nie geben kann), ist nichts zu entziehen.</documentation><incoming>f_st_weg_konto__gw_weg_da</incoming><outgoing>f_gw_weg_da__st_weg_mitglied</outgoing><outgoing>f_gw_weg_da__gw_weg_join</outgoing></exclusiveGateway>
    <serviceTask id="st_weg_mitglied" name="Schon Mitglied?"><documentation>search mit baseDN = recht.gruppeDn, scope base, und dem DN des Kontos in member (maskiert nach RFC 4515). istMitglied ist der Wahrheitswert; den DN liest nur der Worker.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=recht.gruppeDn" scope="base" filter="=&quot;(&amp;(objectClass=group)(member=&quot; + replace(replace(replace(replace(kontoTreffer.dn, &quot;\\\\&quot;, &quot;\\5c&quot;), &quot;\\*&quot;, &quot;\\2a&quot;), &quot;\\(&quot;, &quot;\\28&quot;), &quot;\\)&quot;, &quot;\\29&quot;) + &quot;))&quot;" select="1.1" maxEntries="1" foundVariable="istMitglied"/></extensionElements><incoming>f_gw_weg_da__st_weg_mitglied</incoming><outgoing>f_st_weg_mitglied__gw_weg</outgoing></serviceTask>
    <exclusiveGateway id="gw_weg" name="Noch Mitglied?" default="f_gw_weg__gw_weg_join"><documentation>Nur ein Mitglied wird entfernt; sonst ist nichts zu tun.</documentation><incoming>f_st_weg_mitglied__gw_weg</incoming><outgoing>f_gw_weg__st_remove</outgoing><outgoing>f_gw_weg__gw_weg_join</outgoing></exclusiveGateway>
    <serviceTask id="st_remove" name="Aus der Gruppe entfernen"><documentation>remove-group-member mit memberDN = kontoTreffer.dn.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="remove-group-member" dn="=recht.gruppeDn" memberDN="=kontoTreffer.dn"/></extensionElements><incoming>f_gw_weg__st_remove</incoming><outgoing>f_st_remove__gw_weg_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_weg_join"><incoming>f_gw_weg_da__gw_weg_join</incoming><incoming>f_gw_weg__gw_weg_join</incoming><incoming>f_st_remove__gw_weg_join</incoming><outgoing>f_gw_weg_join__st_returned</outgoing></exclusiveGateway>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Eine Rückgabe erhält die Variable atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;returned&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_weg_join__st_returned</incoming><outgoing>f_st_returned__e_weg</outgoing></serviceTask>
    <endEvent id="e_weg" name="Berechtigung entzogen"><incoming>f_st_returned__e_weg</incoming></endEvent>
    <serviceTask id="st_rf" name="Rückgabe gescheitert melden"><documentation>status "returnFailed": Die Tabelle kennt das Produkt nicht mehr. Das Recht bleibt im Bestand, bis die AD-Administration die Mitgliedschaft geprüft und die Rückgabe wiederholt hat.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;returnFailed&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_weg_k__st_rf</incoming><outgoing>f_st_rf__e_rf</outgoing></serviceTask>
    <endEvent id="e_rf" name="Nicht entzogen"><incoming>f_st_rf__e_rf</incoming></endEvent>
    <sequenceFlow id="f_s_neu__br_neu" sourceRef="s_neu" targetRef="br_neu"/>
    <sequenceFlow id="f_br_neu__sc_pruefen" sourceRef="br_neu" targetRef="sc_pruefen"/>
    <sequenceFlow id="f_sc_pruefen__gw_pruefen" sourceRef="sc_pruefen" targetRef="gw_pruefen"/>
    <sequenceFlow id="f_gw_pruefen__st_neu_konto" sourceRef="gw_pruefen" targetRef="st_neu_konto" name="ja"><conditionExpression>=pruefung.ok = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_pruefen__st_ablehnen" sourceRef="gw_pruefen" targetRef="st_ablehnen" name="nein"/>
    <sequenceFlow id="f_st_neu_konto__st_neu_gruppe" sourceRef="st_neu_konto" targetRef="st_neu_gruppe"/>
    <sequenceFlow id="f_st_neu_gruppe__sc_pruefen2" sourceRef="st_neu_gruppe" targetRef="sc_pruefen2"/>
    <sequenceFlow id="f_sc_pruefen2__gw_pruefen2" sourceRef="sc_pruefen2" targetRef="gw_pruefen2"/>
    <sequenceFlow id="f_gw_pruefen2__st_neu_mitglied" sourceRef="gw_pruefen2" targetRef="st_neu_mitglied" name="ja"><conditionExpression>=pruefung.ok = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_pruefen2__st_ablehnen" sourceRef="gw_pruefen2" targetRef="st_ablehnen" name="nein"/>
    <sequenceFlow id="f_st_neu_mitglied__gw_mitglied" sourceRef="st_neu_mitglied" targetRef="gw_mitglied"/>
    <sequenceFlow id="f_gw_mitglied__gw_join" sourceRef="gw_mitglied" targetRef="gw_join" name="schon Mitglied"><conditionExpression>=istMitglied = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_mitglied__st_add" sourceRef="gw_mitglied" targetRef="st_add" name="aufnehmen"/>
    <sequenceFlow id="f_st_add__gw_join" sourceRef="st_add" targetRef="gw_join"/>
    <sequenceFlow id="f_gw_join__st_done" sourceRef="gw_join" targetRef="st_done"/>
    <sequenceFlow id="f_st_done__e_bereit" sourceRef="st_done" targetRef="e_bereit"/>
    <sequenceFlow id="f_st_ablehnen__e_abgelehnt" sourceRef="st_ablehnen" targetRef="e_abgelehnt"/>
    <sequenceFlow id="f_s_weg__br_weg" sourceRef="s_weg" targetRef="br_weg"/>
    <sequenceFlow id="f_br_weg__gw_weg_k" sourceRef="br_weg" targetRef="gw_weg_k"/>
    <sequenceFlow id="f_gw_weg_k__st_weg_konto" sourceRef="gw_weg_k" targetRef="st_weg_konto" name="ja"><conditionExpression>=recht.bekannt = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_weg_k__st_rf" sourceRef="gw_weg_k" targetRef="st_rf" name="nein"/>
    <sequenceFlow id="f_st_weg_konto__gw_weg_da" sourceRef="st_weg_konto" targetRef="gw_weg_da"/>
    <sequenceFlow id="f_gw_weg_da__st_weg_mitglied" sourceRef="gw_weg_da" targetRef="st_weg_mitglied" name="ja"><conditionExpression>=kontoGefunden = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_weg_da__gw_weg_join" sourceRef="gw_weg_da" targetRef="gw_weg_join" name="nein"/>
    <sequenceFlow id="f_st_weg_mitglied__gw_weg" sourceRef="st_weg_mitglied" targetRef="gw_weg"/>
    <sequenceFlow id="f_gw_weg__st_remove" sourceRef="gw_weg" targetRef="st_remove" name="ja"><conditionExpression>=istMitglied = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_weg__gw_weg_join" sourceRef="gw_weg" targetRef="gw_weg_join" name="nein"/>
    <sequenceFlow id="f_st_remove__gw_weg_join" sourceRef="st_remove" targetRef="gw_weg_join"/>
    <sequenceFlow id="f_gw_weg_join__st_returned" sourceRef="gw_weg_join" targetRef="st_returned"/>
    <sequenceFlow id="f_st_returned__e_weg" sourceRef="st_returned" targetRef="e_weg"/>
    <sequenceFlow id="f_st_rf__e_rf" sourceRef="st_rf" targetRef="e_rf"/>
  </process>
  <bpmndi:BPMNDiagram id="proc_ad_berechtigung_diagram">
    <bpmndi:BPMNPlane id="proc_ad_berechtigung_plane" bpmnElement="proc_ad_berechtigung">
      <bpmndi:BPMNShape id="s_neu_di" bpmnElement="s_neu"><omgdc:Bounds x="162" y="112" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="130" y="152" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
