      "texts": {
        "de": "Active Directory: Admin-Konto",
        "en": "Active Directory: admin account"
      },
      "descriptions": {
        "de": "Ein persönliches Admin-Konto adm-<Anmeldename> neben dem Hauptkonto, befristet auf höchstens ein Jahr. Genehmigt von der Informationssicherheit. Danach: entsperren, Passwort zurücksetzen.",
        "en": "A personal admin account adm-<logon name> next to the main account, limited to at most one year. Approved by information security. Afterwards: unlock, reset the password."
