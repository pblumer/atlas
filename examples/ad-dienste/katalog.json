    {
      "id": "ad-sicherheitsgruppe",
      "homeCatalog": "cat-ad-dienste",
      "state": "active",
      "multipleAllowed": true,
      "texts": {
        "de": "Active Directory: Sicherheitsgruppe",
        "en": "Active Directory: security group"
      },
      "descriptions": {
        "de": "Eine Sicherheitsgruppe mit verantwortlicher Person (managedBy); Mitglieder kommen über die Aktionen im Shop dazu. Name nach der Namensregel (SG-…). Zurückgeben lässt sich nur eine leere Gruppe.",
        "en": "A security group with a responsible person (managedBy); members are added through the shop's actions. Name per the naming rule (SG-…). Only an empty group can be returned."
      },
      "approval": {
        "kind": "superior"
      },
      "lifecycleProcess": "proc_ad_sicherheitsgruppe",
      "configForm": "ad-sicherheitsgruppe-bestellung",
      "actions": [
        {
          "key": "provision",
          "message": "ad.gruppe.erstellen",
          "effect": "provision"
        },
        {
          "key": "deprovision",
          "message": "ad.gruppe.entfernen",
          "effect": "deprovision",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Gruppe löschen",
            "en": "Delete the group"
          }
        },
        {
          "key": "mitglied",
          "message": "ad.gruppe.mitglied",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Mitglied aufnehmen",
            "en": "Add a member"
          },
          "form": "ad-gruppe-mitglied"
        },
        {
          "key": "mitglied-weg",
          "message": "ad.gruppe.mitglied-weg",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Mitglied entfernen",
            "en": "Remove a member"
          },
          "form": "ad-gruppe-mitglied"
        },
        {
          "key": "verantwortung",
          "message": "ad.gruppe.verantwortung",
          "effect": "change",
          "triggers": [
            "customer",
            "operator"
          ],
          "labels": {
            "de": "Verantwortung übergeben",
            "en": "Hand over responsibility"
          },
          "form": "ad-gruppe-verantwortung"
        }
      ],
      "keywords": [
