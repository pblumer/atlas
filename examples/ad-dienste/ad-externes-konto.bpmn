<?xml version="1.0" encoding="UTF-8"?>
<!--
Active Directory: Konto für eine externe Person, mit der empfangenden Person als Sponsor (manager).
Lebenszyklus mit Rückgabe, Entsperren und Passwort zurücksetzen.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_ad_externes_konto" targetNamespace="http://atlas/beispiel/ad-dienste">
  <message id="m_extern_anlegen" name="ad.extern.anlegen"/>
  <message id="m_extern_entfernen" name="ad.extern.entfernen"/>
  <message id="m_extern_entsperren" name="ad.extern.entsperren"/>
  <message id="m_extern_passwort" name="ad.extern.passwort"/>
  <process id="proc_ad_externes_konto" name="Active Directory: Externes Konto" isExecutable="true" atlas:personal="vorname,nachname,firma,email,passwort" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus eines Kontos für eine externe Person, Produkt ad-externes-konto. Die empfangende Person ist der Sponsor: Das Recht steht in ihrem Bestand, ist auf 180 Tage befristet, und ihr Konto steht im Attribut manager.

Bereitstellen: Angaben prüfen (Kennung des Sponsors, Ablaufdatum höchstens 180 Tage), Sponsor suchen, Namensregel (ext-&lt;Kennung&gt;), verbindliche Prüfung, Konto gesperrt anlegen (accountExpires), Initialpasswort durch den Sponsor, set-password, Passwort aus der Instanz entfernen, aktivieren, done.

Personendaten: vorname, nachname, firma und email sind deklariert und verschlüsselt; die Passwort-Aufgabe zeigt sie dem Sponsor. Ins Verzeichnis schreibt der Prozess sie nicht: Der AD-Worker nimmt die Attribute aus einer Variablen, die die Engine bildet (entryVariable), und die Engine liest keinen versiegelten Wert. Das Konto heisst deshalb ext-&lt;12 Zeichen der Auftrags-ID&gt; statt ext-&lt;vorname&gt;.&lt;nachname&gt; und trägt keinen Namen (README, «Personendaten»). Worker: ad_verzeichnis.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/><atlas:constant name="AD_DOMAIN_DN" type="string" source="application" value="DC=contoso,DC=local"/><atlas:constant name="AD_UPN_SUFFIX" type="string" source="application" value="contoso.ch"/><atlas:constant name="AD_PERSONEN_OU" type="string" source="application" value="OU=Personen,DC=contoso,DC=local"/><atlas:constant name="AD_EXTERN_OU" type="string" source="application" value="OU=Extern,OU=Atlas,DC=contoso,DC=local"/></atlas:constants></extensionElements>
    <startEvent id="s_neu" name="Externes Konto bestellt"><documentation>Start der Operation provision (ad.extern.anlegen).</documentation><outgoing>f_s_neu__sc_pruefen</outgoing><messageEventDefinition messageRef="m_extern_anlegen"/></startEvent>
    <scriptTask id="sc_pruefen" name="Angaben prüfen"><documentation>Kennung des Sponsors und Ablaufdatum (höchstens 180 Tage).</documentation><extensionElements><zeebe:script expression="={ok: sponsor != null and matches(sponsor, &quot;^[A-Za-z0-9._-]{1,20}$&quot;) and ablaufdatum != null and matches(ablaufdatum, &quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}$&quot;) and date(ablaufdatum) &gt; today() and date(ablaufdatum) &lt;= today() + duration(&quot;P180D&quot;), grund: if not(sponsor != null and matches(sponsor, &quot;^[A-Za-z0-9._-]{1,20}$&quot;)) then &quot;Die Kennung des Sponsors ist ungültig.&quot; else &quot;Das Ablaufdatum muss in der Zukunft liegen und höchstens 180 Tage entfernt sein.&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_s_neu__sc_pruefen</incoming><outgoing>f_sc_pruefen__gw_pruefen</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen" name="Angaben gültig?" default="f_gw_pruefen__st_ablehnen"><documentation>Fail-closed: Default ist die Ablehnung.</documentation><incoming>f_sc_pruefen__gw_pruefen</incoming><outgoing>f_gw_pruefen__st_sponsor</outgoing><outgoing>f_gw_pruefen__st_ablehnen</outgoing></exclusiveGateway>
    <serviceTask id="st_sponsor" name="Sponsor suchen"><documentation>search nach sponsor; sponsorKonto = {gefunden, dn, aktiv, name, upn}.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_PERSONEN_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(sAMAccountName=&quot; + sponsor + &quot;))&quot;" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, dn: if suche.found = true then suche.dn else null, aktiv: suche.found = true and modulo(floor(number(suche.entries[1].attributes.userAccountControl[1]) / 2), 2) = 0, name: if suche.found = true then suche.entries[1].attributes.displayName[1] else null, upn: if suche.found = true then suche.entries[1].attributes.userPrincipalName[1] else null}" target="sponsorKonto"/></zeebe:ioMapping></extensionElements><incoming>f_gw_pruefen__st_sponsor</incoming><outgoing>f_st_sponsor__br_name</outgoing></serviceTask>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>AdNamensregel, objekttyp extern: ext-&lt;bezeichnung&gt;. Die Bezeichnung ist der Teil der Auftrags-ID nach «ord_», 12 Zeichen: eindeutig je Auftrag und kein Personendatum.</documentation><extensionElements><zeebe:calledDecision decisionId="AdNamensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=&quot;extern&quot;" target="objekttyp"/><zeebe:input source="=null" target="bereich"/><zeebe:input source="=substring(orderId, 5, 12)" target="bezeichnung"/><zeebe:input source="=null" target="hauptkonto"/></zeebe:ioMapping></extensionElements><incoming>f_st_sponsor__br_name</incoming><outgoing>f_br_name__st_belegt</outgoing></businessRuleTask>
    <serviceTask id="st_belegt" name="Name schon vergeben?"><documentation>search in der ganzen Domäne.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_DOMAIN_DN" scope="sub" filter="=&quot;(|&quot; + &quot;(sAMAccountName=&quot; + regel.sAMAccountName + &quot;)(cn=&quot; + regel.cn + &quot;)&quot; + &quot;(userPrincipalName=&quot; + regel.sAMAccountName + &quot;@&quot; + application.AD_UPN_SUFFIX + &quot;)&quot; + &quot;)&quot;" maxEntries="10" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="=suche.found = true" target="belegt"/></zeebe:ioMapping></extensionElements><incoming>f_br_name__st_belegt</incoming><outgoing>f_st_belegt__sc_pruefen2</outgoing></serviceTask>
    <scriptTask id="sc_pruefen2" name="Ergebnis prüfen"><documentation>ok, wenn der Sponsor aktiv und der Name erlaubt und frei ist.</documentation><extensionElements><zeebe:script expression="={ok: sponsorKonto.gefunden = true and sponsorKonto.aktiv = true and regel.erlaubt = true and belegt = false, grund: if sponsorKonto.gefunden != true then &quot;Zur Kennung des Sponsors gibt es kein Konto.&quot; else if sponsorKonto.aktiv != true then &quot;Das Konto des Sponsors ist gesperrt.&quot; else if regel.erlaubt != true then regel.grund else &quot;Der Name &quot; + regel.sAMAccountName + &quot; ist bereits vergeben.&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_st_belegt__sc_pruefen2</incoming><outgoing>f_sc_pruefen2__gw_pruefen2</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen2" name="Bereit zum Anlegen?" default="f_gw_pruefen2__st_ablehnen"><documentation>Fail-closed wie oben.</documentation><incoming>f_sc_pruefen2__gw_pruefen2</incoming><outgoing>f_gw_pruefen2__sc_eintrag</outgoing><outgoing>f_gw_pruefen2__st_ablehnen</outgoing></exclusiveGateway>
    <scriptTask id="sc_eintrag" name="Konto beschreiben"><documentation>eintrag: sAMAccountName, userPrincipalName, displayName «Externe Person &lt;Kennung&gt;», description mit dem Sponsor, info, manager (DN des Sponsors), accountExpires, userAccountControl 514.</documentation><extensionElements><zeebe:script expression="={sAMAccountName: regel.sAMAccountName, userPrincipalName: regel.sAMAccountName + &quot;@&quot; + application.AD_UPN_SUFFIX, displayName: regel.displayName, description: &quot;Externe Person, Sponsor &quot; + sponsor + &quot; (Atlas-Katalog, Auftrag &quot; + orderId + &quot;)&quot;, info: &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId), manager: sponsorKonto.dn, accountExpires: string((109572 + ((date(ablaufdatum) + duration(&quot;P1D&quot;)) - date(&quot;1901-01-01&quot;)).days) * 864000000000), userAccountControl: &quot;514&quot;}" resultVariable="eintrag"/></extensionElements><incoming>f_gw_pruefen2__sc_eintrag</incoming><outgoing>f_sc_eintrag__st_anlegen</outgoing></scriptTask>
    <serviceTask id="st_anlegen" name="Konto anlegen"><documentation>create-user in AD_EXTERN_OU, gesperrt.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="create-user" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_EXTERN_OU" entryVariable="eintrag"/></extensionElements><incoming>f_sc_eintrag__st_anlegen</incoming><outgoing>f_st_anlegen__ut_pw</outgoing></serviceTask>
    <userTask id="ut_pw" name="Initialpasswort eingeben"><documentation>Die Aufgabe geht an die empfangende Person (assignee = recipient). Sie gibt das Passwort im Formular ad-konto-passwort ein; passwort ist als Personendatum deklariert und wird verschlüsselt gespeichert (ADR-0314). Eine Passwort-Ablage (Vault, Passwortmanager) ist die empfohlene Ablösung; das entscheidet die Installation (README).</documentation><extensionElements><zeebe:formDefinition formId="ad-konto-passwort"/><zeebe:assignmentDefinition assignee="=recipient"/></extensionElements><incoming>f_st_anlegen__ut_pw</incoming><outgoing>f_ut_pw__st_pw</outgoing></userTask>
    <serviceTask id="st_pw" name="Passwort setzen"><documentation>set-password (unicodePwd). AD nimmt ein Passwort nur über LDAPS an; die Directory-Verbindung des Workers muss ldaps:// sein. Ein Passwort, das die Kennwortrichtlinie verletzt, lässt den Task scheitern (Incident); die Aufgabe lässt sich dann über die Betriebsansicht erneut stellen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="set-password" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_EXTERN_OU" newPassword="=passwort"/></extensionElements><incoming>f_ut_pw__st_pw</incoming><outgoing>f_st_pw__st_pw_weg</outgoing></serviceTask>
    <serviceTask id="st_pw_weg" name="Passwort aus der Instanz entfernen"><documentation>Die Engine darf ein Personendatum nicht schreiben (ADR-0314: nur ein Formular, ein Worker-Ergebnis oder der Betrieb versiegeln), also auch nicht leeren. Deshalb überschreibt ein Worker-Ergebnis die Variable passwort: Diese Suche liest das Konto (scope base) und legt das Ergebnis unter dem Namen passwort ab. Danach steht das Passwort nicht mehr in den Variablen der Instanz; im Verlauf bleibt der frühere Wert verschlüsselt, bis der Schlüssel der Person gelöscht wird.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_EXTERN_OU" scope="base" filter="(objectClass=user)" maxEntries="1" resultVariable="passwort"/></extensionElements><incoming>f_st_pw__st_pw_weg</incoming><outgoing>f_st_pw_weg__st_enable</outgoing></serviceTask>
    <serviceTask id="st_enable" name="Konto aktivieren"><documentation>enable löscht das Bit ACCOUNTDISABLE aus userAccountControl (514 → 512). Erst jetzt, mit gesetztem Passwort, ist das Konto benutzbar.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="enable" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_EXTERN_OU"/></extensionElements><incoming>f_st_pw_weg__st_enable</incoming><outgoing>f_st_enable__st_done</outgoing></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit steht das Recht im Bestand der empfangenden Person. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;done&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_enable__st_done</incoming><outgoing>f_st_done__e_bereit</outgoing></serviceTask>
    <endEvent id="e_bereit" name="Externes Konto bereit"><incoming>f_st_done__e_bereit</incoming></endEvent>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Lehnt die Position über POST /api/v1/orders/{orderId}/lines/{positionId}/decision ab, mit dem Grund aus pruefung.grund. Eine verletzte Regel ist eine Entscheidung und keine Störung: kein Incident, und die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId) + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;Prüfung der Bestellung&quot;" target="by"/><zeebe:input source="=pruefung.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_pruefen__st_ablehnen</incoming><incoming>f_gw_pruefen2__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt"><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <startEvent id="s_weg" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (ad.extern.entfernen).</documentation><outgoing>f_s_weg__st_finden</outgoing><messageEventDefinition messageRef="m_extern_entfernen"/></startEvent>
    <serviceTask id="st_finden" name="Konto finden"><documentation>search unter AD_EXTERN_OU nach der Herkunftskennzeichnung im Attribut info; konto = {gefunden, dn}.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_EXTERN_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, dn: if suche.found = true then suche.dn else null}" target="konto"/></zeebe:ioMapping></extensionElements><incoming>f_s_weg__st_finden</incoming><outgoing>f_st_finden__gw_gef</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef" name="Konto vorhanden?" default="f_gw_gef__gw_join"><documentation>Ein schon gelöschtes Konto ist zurückgegeben.</documentation><incoming>f_st_finden__gw_gef</incoming><outgoing>f_gw_gef__st_disable</outgoing><outgoing>f_gw_gef__gw_join</outgoing></exclusiveGateway>
    <serviceTask id="st_disable" name="Konto sperren"><documentation>disable setzt das Bit ACCOUNTDISABLE, bevor das Konto gelöscht wird: Scheitert das Löschen, ist es wenigstens gesperrt.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="disable" dn="=konto.dn"/></extensionElements><incoming>f_gw_gef__st_disable</incoming><outgoing>f_st_disable__st_delete</outgoing></serviceTask>
    <serviceTask id="st_delete" name="Konto löschen"><documentation>delete. Endgültig; wo der AD-Papierkorb aktiv ist, lässt es sich dort während seiner Aufbewahrungszeit wiederherstellen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="delete" dn="=konto.dn"/></extensionElements><incoming>f_st_disable__st_delete</incoming><outgoing>f_st_delete__gw_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_join"><incoming>f_gw_gef__gw_join</incoming><incoming>f_st_delete__gw_join</incoming><outgoing>f_gw_join__st_returned</outgoing></exclusiveGateway>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Eine Rückgabe erhält die Variable atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + (if positionId = null then itemId else positionId)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;returned&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_join__st_returned</incoming><outgoing>f_st_returned__e_weg</outgoing></serviceTask>
    <endEvent id="e_weg" name="Externes Konto entfernt"><incoming>f_st_returned__e_weg</incoming></endEvent>
    <startEvent id="s_auf" name="Entsperren angefragt"><documentation>Start der Aktion entsperren (Service).</documentation><outgoing>f_s_auf__st_auf_finden</outgoing><messageEventDefinition messageRef="m_extern_entsperren"/></startEvent>
    <serviceTask id="st_auf_finden" name="Konto finden"><documentation>Über die Herkunftskennzeichnung.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_EXTERN_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, dn: if suche.found = true then suche.dn else null}" target="konto"/></zeebe:ioMapping></extensionElements><incoming>f_s_auf__st_auf_finden</incoming><outgoing>f_st_auf_finden__gw_auf</outgoing></serviceTask>
    <exclusiveGateway id="gw_auf" name="Konto vorhanden?" default="f_gw_auf__sd_auf_rej"><documentation>Ohne Konto wird die Aktion abgelehnt.</documentation><incoming>f_st_auf_finden__gw_auf</incoming><outgoing>f_gw_auf__st_auf</outgoing><outgoing>f_gw_auf__sd_auf_rej</outgoing></exclusiveGateway>
    <serviceTask id="st_auf" name="Sperre aufheben"><documentation>update-attributes setzt lockoutTime auf "0"; das hebt eine Sperre nach zu vielen Fehlversuchen auf (nicht die Deaktivierung). Die Attribute stehen im Input-Mapping, weil der Worker sie aus einer Variablen nimmt.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="update-attributes" dn="=konto.dn" entryVariable="entsperrung"/><zeebe:ioMapping><zeebe:input source="={lockoutTime: &quot;0&quot;}" target="entsperrung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_auf__st_auf</incoming><outgoing>f_st_auf__sd_auf_ok</outgoing></serviceTask>
    <sendTask id="sd_auf_ok" name="Aktion als erledigt melden"><documentation>outcome completed für entsperren.</documentation><extensionElements><atlas:shopTask mode="outcome" action="entsperren" outcome="completed"/></extensionElements><incoming>f_st_auf__sd_auf_ok</incoming><outgoing>f_sd_auf_ok__e_auf_ok</outgoing></sendTask>
    <endEvent id="e_auf_ok" name="Entsperrt"><incoming>f_sd_auf_ok__e_auf_ok</incoming></endEvent>
    <sendTask id="sd_auf_rej" name="Aktion ablehnen"><documentation>outcome rejected für entsperren.</documentation><extensionElements><atlas:shopTask mode="outcome" action="entsperren" outcome="rejected"/></extensionElements><incoming>f_gw_auf__sd_auf_rej</incoming><outgoing>f_sd_auf_rej__e_auf_rej</outgoing></sendTask>
    <endEvent id="e_auf_rej" name="Kein Konto"><incoming>f_sd_auf_rej__e_auf_rej</incoming></endEvent>
    <startEvent id="s_pw" name="Passwort angefragt"><documentation>Start der Aktion passwort (Service).</documentation><outgoing>f_s_pw__st_pw_finden</outgoing><messageEventDefinition messageRef="m_extern_passwort"/></startEvent>
    <serviceTask id="st_pw_finden" name="Konto finden"><documentation>Über die Herkunftskennzeichnung.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_EXTERN_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, dn: if suche.found = true then suche.dn else null}" target="konto"/></zeebe:ioMapping></extensionElements><incoming>f_s_pw__st_pw_finden</incoming><outgoing>f_st_pw_finden__gw_pw</outgoing></serviceTask>
    <exclusiveGateway id="gw_pw" name="Konto vorhanden?" default="f_gw_pw__sd_pw_rej"><documentation>Ohne Konto wird die Aktion abgelehnt.</documentation><incoming>f_st_pw_finden__gw_pw</incoming><outgoing>f_gw_pw__ut_pw2</outgoing><outgoing>f_gw_pw__sd_pw_rej</outgoing></exclusiveGateway>
    <userTask id="ut_pw2" name="Neues Passwort eingeben"><documentation>Die Aufgabe geht an die empfangende Person (assignee = recipient). Sie gibt das Passwort im Formular ad-konto-passwort ein; passwort ist als Personendatum deklariert und wird verschlüsselt gespeichert (ADR-0314). Eine Passwort-Ablage (Vault, Passwortmanager) ist die empfohlene Ablösung; das entscheidet die Installation (README).</documentation><extensionElements><zeebe:formDefinition formId="ad-konto-passwort"/><zeebe:assignmentDefinition assignee="=recipient"/></extensionElements><incoming>f_gw_pw__ut_pw2</incoming><outgoing>f_ut_pw2__st_pw2</outgoing></userTask>
    <serviceTask id="st_pw2" name="Passwort setzen"><documentation>set-password schreibt unicodePwd; AD nimmt das nur über eine verschlüsselte Verbindung an (LDAPS), und das Passwort muss der Kennwortrichtlinie der Domäne genügen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="set-password" dn="=konto.dn" newPassword="=passwort"/></extensionElements><incoming>f_ut_pw2__st_pw2</incoming><outgoing>f_st_pw2__st_pw2_weg</outgoing></serviceTask>
    <serviceTask id="st_pw2_weg" name="Passwort aus der Instanz entfernen"><documentation>Die Engine darf ein Personendatum nicht schreiben (ADR-0314: nur ein Formular, ein Worker-Ergebnis oder der Betrieb versiegeln), also auch nicht leeren. Deshalb überschreibt ein Worker-Ergebnis die Variable passwort: Diese Suche liest das Konto (scope base) und legt das Ergebnis unter dem Namen passwort ab. Danach steht das Passwort nicht mehr in den Variablen der Instanz; im Verlauf bleibt der frühere Wert verschlüsselt, bis der Schlüssel der Person gelöscht wird.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=konto.dn" scope="base" filter="(objectClass=user)" maxEntries="1" resultVariable="passwort"/></extensionElements><incoming>f_st_pw2__st_pw2_weg</incoming><outgoing>f_st_pw2_weg__sd_pw_ok</outgoing></serviceTask>
    <sendTask id="sd_pw_ok" name="Aktion als erledigt melden"><documentation>outcome completed für passwort.</documentation><extensionElements><atlas:shopTask mode="outcome" action="passwort" outcome="completed"/></extensionElements><incoming>f_st_pw2_weg__sd_pw_ok</incoming><outgoing>f_sd_pw_ok__e_pw_ok</outgoing></sendTask>
    <endEvent id="e_pw_ok" name="Passwort gesetzt"><incoming>f_sd_pw_ok__e_pw_ok</incoming></endEvent>
    <sendTask id="sd_pw_rej" name="Aktion ablehnen"><documentation>outcome rejected für passwort.</documentation><extensionElements><atlas:shopTask mode="outcome" action="passwort" outcome="rejected"/></extensionElements><incoming>f_gw_pw__sd_pw_rej</incoming><outgoing>f_sd_pw_rej__e_pw_rej</outgoing></sendTask>
    <endEvent id="e_pw_rej" name="Kein Konto"><incoming>f_sd_pw_rej__e_pw_rej</incoming></endEvent>
