<?xml version="1.0" encoding="UTF-8"?>
<!--
Active Directory: Testkonto (tst-<Bezeichnung>), höchstens 90 Tage. Der Prozess wartet bis zum Ablaufdatum
und gibt das Konto dann selbst zurück.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_ad_testkonto" targetNamespace="http://atlas/beispiel/ad-dienste">
  <message id="m_test_anlegen" name="ad.test.anlegen"/>
  <message id="m_test_entfernen" name="ad.test.entfernen"/>
  <message id="m_test_entsperren" name="ad.test.entsperren"/>
  <message id="m_test_passwort" name="ad.test.passwort"/>
  <error id="err_befehl" name="Rückgabe nicht möglich" errorCode="SHOP_COMMAND_REFUSED"/>
  <process id="proc_ad_testkonto" name="Active Directory: Testkonto" isExecutable="true" atlas:personal="passwort" atlas:dataSubject="recipient">
    <documentation>Lebenszyklus eines Testkontos, Produkt ad-testkonto: ein Konto für Tests, das von selbst endet. Das Ablaufdatum (höchstens 90 Tage) steht in accountExpires, sodass AD die Anmeldung danach ablehnt, auch wenn sonst nichts läuft.

Nach der Bereitstellung wartet die Instanz bis 00:00 UTC nach dem Ablaufdatum und gibt die Position dann mit einer Shop-Aufgabe im Modus command zurück (Aktion deprovision; das Produkt nennt die eigene Applikation beispiel-ad-dienste in commandedBy). Die Rückgabe startet die Operation deprovision dieses Prozesses, die das Konto sperrt, löscht und returned meldet. Den Status returned direkt zu melden geht nicht: Die Bestellung nimmt ihn nur von der Rückgabe an, um die gebeten wurde. Wurde das Konto vorher zurückgegeben, lehnt die Bestellung den Befehl ab (SHOP_COMMAND_REFUSED), und die Instanz endet still. Daneben gibt die Befristung der Plattform (maxDays 90, examples/befristung.bpmn) ein überfälliges Recht zurück, falls diese Instanz nicht mehr läuft.

Personendaten: passwort. Name und DN des Testkontos benennen keine Person. Worker: ad_verzeichnis.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/><atlas:constant name="AD_DOMAIN_DN" type="string" source="application" value="DC=contoso,DC=local"/><atlas:constant name="AD_UPN_SUFFIX" type="string" source="application" value="contoso.ch"/><atlas:constant name="AD_TEST_OU" type="string" source="application" value="OU=Testkonten,OU=Atlas,DC=contoso,DC=local"/></atlas:constants></extensionElements>
    <startEvent id="s_neu" name="Testkonto bestellt"><documentation>Start der Operation provision (ad.test.anlegen).</documentation><outgoing>f_s_neu__sc_pruefen</outgoing><messageEventDefinition messageRef="m_test_anlegen"/></startEvent>
    <scriptTask id="sc_pruefen" name="Ablaufdatum prüfen"><documentation>In der Zukunft und höchstens 90 Tage entfernt.</documentation><extensionElements><zeebe:script expression="={ok: ablaufdatum != null and matches(ablaufdatum, &quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}$&quot;) and date(ablaufdatum) &gt; today() and date(ablaufdatum) &lt;= today() + duration(&quot;P90D&quot;), grund: &quot;Das Ablaufdatum muss in der Zukunft liegen und höchstens 90 Tage entfernt sein.&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_s_neu__sc_pruefen</incoming><outgoing>f_sc_pruefen__gw_pruefen</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen" name="Datum gültig?" default="f_gw_pruefen__st_ablehnen"><documentation>Fail-closed: Default ist die Ablehnung.</documentation><incoming>f_sc_pruefen__gw_pruefen</incoming><outgoing>f_gw_pruefen__br_name</outgoing><outgoing>f_gw_pruefen__st_ablehnen</outgoing></exclusiveGateway>
    <businessRuleTask id="br_name" name="Namensregel anwenden"><documentation>AdNamensregel, objekttyp test: tst-&lt;bezeichnung&gt;.</documentation><extensionElements><zeebe:calledDecision decisionId="AdNamensregel" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=&quot;test&quot;" target="objekttyp"/><zeebe:input source="=null" target="bereich"/><zeebe:input source="=replace(replace(replace(replace(replace(replace(lower case(bezeichnung), &quot;ä&quot;, &quot;ae&quot;), &quot;ö&quot;, &quot;oe&quot;), &quot;ü&quot;, &quot;ue&quot;), &quot;[éèê]&quot;, &quot;e&quot;), &quot;[^a-z0-9]+&quot;, &quot;-&quot;), &quot;^-+|-+$&quot;, &quot;&quot;)" target="bezeichnung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_pruefen__br_name</incoming><outgoing>f_br_name__st_belegt</outgoing></businessRuleTask>
    <serviceTask id="st_belegt" name="Name schon vergeben?"><documentation>search in der ganzen Domäne; belegt ist der Wahrheitswert.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_DOMAIN_DN" scope="sub" filter="=if regel.erlaubt = true then &quot;(|&quot; + &quot;(sAMAccountName=&quot; + regel.sAMAccountName + &quot;)(cn=&quot; + regel.cn + &quot;)&quot; + &quot;(userPrincipalName=&quot; + regel.sAMAccountName + &quot;@&quot; + application.AD_UPN_SUFFIX + &quot;)&quot; + &quot;)&quot; else &quot;(&amp;(objectClass=user)(!(objectClass=user)))&quot;" maxEntries="10" foundVariable="belegt"/></extensionElements><incoming>f_br_name__st_belegt</incoming><outgoing>f_st_belegt__sc_pruefen2</outgoing></serviceTask>
    <scriptTask id="sc_pruefen2" name="Ergebnis prüfen"><documentation>ok, wenn der Name erlaubt und frei ist.</documentation><extensionElements><zeebe:script expression="={ok: regel.erlaubt = true and belegt = false, grund: if regel.erlaubt != true then regel.grund else &quot;Der Name &quot; + regel.sAMAccountName + &quot; ist bereits vergeben.&quot;}" resultVariable="pruefung"/></extensionElements><incoming>f_st_belegt__sc_pruefen2</incoming><outgoing>f_sc_pruefen2__gw_pruefen2</outgoing></scriptTask>
    <exclusiveGateway id="gw_pruefen2" name="Bereit zum Anlegen?" default="f_gw_pruefen2__st_ablehnen"><documentation>Fail-closed wie oben.</documentation><incoming>f_sc_pruefen2__gw_pruefen2</incoming><outgoing>f_gw_pruefen2__st_anlegen</outgoing><outgoing>f_gw_pruefen2__st_ablehnen</outgoing></exclusiveGateway>
    <serviceTask id="st_anlegen" name="Konto anlegen"><documentation>create-user in AD_TEST_OU, gesperrt, die Attribute inline (attributes), mit accountExpires (FILETIME bis 00:00 UTC nach dem Ablaufdatum) und userAccountControl 514.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="create-user" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_TEST_OU" attributes="{&quot;sAMAccountName&quot;: &quot;=regel.sAMAccountName&quot;, &quot;userPrincipalName&quot;: &quot;=regel.sAMAccountName + \&quot;@\&quot; + application.AD_UPN_SUFFIX&quot;, &quot;displayName&quot;: &quot;=regel.displayName&quot;, &quot;description&quot;: &quot;=\&quot;Testkonto bis \&quot; + ablaufdatum + \&quot; (Atlas-Katalog, Auftrag \&quot; + orderId + \&quot;)\&quot;&quot;, &quot;info&quot;: &quot;=\&quot;atlas-katalog \&quot; + orderId + \&quot;/\&quot; + (if positionId = null then itemId else positionId)&quot;, &quot;accountExpires&quot;: &quot;=string((109572 + ((date(ablaufdatum) + duration(\&quot;P1D\&quot;)) - date(\&quot;1901-01-01\&quot;)).days) * 864000000000)&quot;, &quot;userAccountControl&quot;: &quot;514&quot;}"/></extensionElements><incoming>f_gw_pruefen2__st_anlegen</incoming><outgoing>f_st_anlegen__ut_pw</outgoing></serviceTask>
    <userTask id="ut_pw" name="Initialpasswort eingeben"><documentation>Die Aufgabe geht an die empfangende Person (assignee = recipient). Sie gibt das Passwort im Formular ad-konto-passwort ein; passwort ist als Personendatum deklariert und wird verschlüsselt gespeichert (ADR-0314). Eine Passwort-Ablage (Vault, Passwortmanager) ist die empfohlene Ablösung; das entscheidet die Installation (README).</documentation><extensionElements><zeebe:formDefinition formId="ad-konto-passwort"/><zeebe:assignmentDefinition assignee="=recipient"/></extensionElements><incoming>f_st_anlegen__ut_pw</incoming><outgoing>f_ut_pw__st_pw</outgoing></userTask>
    <serviceTask id="st_pw" name="Passwort setzen"><documentation>set-password (unicodePwd). AD nimmt ein Passwort nur über LDAPS an; die Directory-Verbindung des Workers muss ldaps:// sein. Ein Passwort, das die Kennwortrichtlinie verletzt, lässt den Task scheitern (Incident); die Aufgabe lässt sich dann über die Betriebsansicht erneut stellen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="set-password" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_TEST_OU" newPassword="=passwort"/></extensionElements><incoming>f_ut_pw__st_pw</incoming><outgoing>f_st_pw__st_pw_weg</outgoing></serviceTask>
    <serviceTask id="st_pw_weg" name="Passwort aus der Instanz entfernen"><documentation>Die Engine darf ein Personendatum nicht schreiben (ADR-0314: nur ein Formular, ein Worker-Ergebnis oder der Betrieb versiegeln), also auch nicht leeren. Deshalb überschreibt ein Worker-Ergebnis die Variable passwort: Diese Suche liest das Konto (scope base, select 1.1: nur der DN) und legt das Ergebnis unter dem Namen passwort ab. Danach steht das Passwort nicht mehr in den Variablen der Instanz; im Verlauf bleibt der frühere Wert verschlüsselt, bis der Schlüssel der Person gelöscht wird.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_TEST_OU" scope="base" filter="(objectClass=user)" select="1.1" maxEntries="1" resultVariable="passwort"/></extensionElements><incoming>f_st_pw__st_pw_weg</incoming><outgoing>f_st_pw_weg__st_enable</outgoing></serviceTask>
    <serviceTask id="st_enable" name="Konto aktivieren"><documentation>enable löscht das Bit ACCOUNTDISABLE aus userAccountControl (514 → 512). Erst jetzt, mit gesetztem Passwort, ist das Konto benutzbar.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="enable" dn="=&quot;CN=&quot; + regel.cn + &quot;,&quot; + application.AD_TEST_OU"/></extensionElements><incoming>f_st_pw_weg__st_enable</incoming><outgoing>f_st_enable__st_done</outgoing></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>Meldet die Position über POST /api/v1/orders/{orderId}/lines/{positionId} als erledigt (status "done"). Erst damit steht das Recht im Bestand der empfangenden Person. Braucht das Secret "atlas" mit einem API-Token der Rolle operator. Die Adresse ist atlasApiBase, sonst die Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;done&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_enable__st_done</incoming><outgoing>f_st_done__t_ablauf</outgoing></serviceTask>
    <intermediateCatchEvent id="t_ablauf" name="Ablaufdatum erreicht"><documentation>Wartet bis 00:00 UTC des Tages nach dem Ablaufdatum, demselben Moment, den accountExpires trägt.</documentation><incoming>f_st_done__t_ablauf</incoming><outgoing>f_t_ablauf__sd_rueckgabe</outgoing><timerEventDefinition><timeDate>=string(date(ablaufdatum) + duration("P1D")) + "T00:00:00Z"</timeDate></timerEventDefinition></intermediateCatchEvent>
    <sendTask id="sd_rueckgabe" name="Testkonto zurückgeben"><documentation>Shop-Aufgabe im Modus command: deprovision dieser Position, im Namen der Applikation beispiel-ad-dienste. Die Bestellung startet daraufhin die Rückgabe (s_weg).</documentation><extensionElements><atlas:shopTask mode="command" product="ad-testkonto" action="deprovision" order="=orderId" position="=(if positionId = null then itemId else positionId)" resultVariable="rueckgabe"/></extensionElements><incoming>f_t_ablauf__sd_rueckgabe</incoming><outgoing>f_sd_rueckgabe__e_abgelaufen</outgoing></sendTask>
    <boundaryEvent id="b_schon" name="Schon zurückgegeben" attachedToRef="sd_rueckgabe"><documentation>SHOP_COMMAND_REFUSED: Die Position ist nicht mehr im Bestand, meist weil sie vorher zurückgegeben wurde.</documentation><outgoing>f_b_schon__e_schon</outgoing><errorEventDefinition errorRef="err_befehl"/></boundaryEvent>
    <endEvent id="e_abgelaufen" name="Rückgabe angestossen"><incoming>f_sd_rueckgabe__e_abgelaufen</incoming></endEvent>
    <endEvent id="e_schon" name="Nichts mehr zu tun"><incoming>f_b_schon__e_schon</incoming></endEvent>
    <serviceTask id="st_ablehnen" name="Ablehnung melden"><documentation>Lehnt die Position über POST /api/v1/orders/{orderId}/lines/{positionId}/decision ab, mit dem Grund aus pruefung.grund. Eine verletzte Regel ist eine Entscheidung und keine Störung: kein Incident, und die bestellende Person liest den Grund im Shop.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;) + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;Prüfung der Bestellung&quot;" target="by"/><zeebe:input source="=pruefung.grund" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_pruefen__st_ablehnen</incoming><incoming>f_gw_pruefen2__st_ablehnen</incoming><outgoing>f_st_ablehnen__e_abgelehnt</outgoing></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt"><incoming>f_st_ablehnen__e_abgelehnt</incoming></endEvent>
    <startEvent id="s_weg" name="Rückgabe angefordert"><documentation>Start der Operation deprovision (ad.test.entfernen).</documentation><outgoing>f_s_weg__st_finden</outgoing><messageEventDefinition messageRef="m_test_entfernen"/></startEvent>
    <serviceTask id="st_finden" name="Konto finden"><documentation>search unter AD_TEST_OU nach der Herkunftskennzeichnung im Attribut info; konto erhält den DN, kontoGefunden, ob es das Konto gibt.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_TEST_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" select="1.1" maxEntries="1" resultVariable="konto" foundVariable="kontoGefunden"/></extensionElements><incoming>f_s_weg__st_finden</incoming><outgoing>f_st_finden__gw_gef</outgoing></serviceTask>
    <exclusiveGateway id="gw_gef" name="Konto vorhanden?" default="f_gw_gef__gw_join"><documentation>Ein schon gelöschtes Konto ist zurückgegeben.</documentation><incoming>f_st_finden__gw_gef</incoming><outgoing>f_gw_gef__st_disable</outgoing><outgoing>f_gw_gef__gw_join</outgoing></exclusiveGateway>
    <serviceTask id="st_disable" name="Konto sperren"><documentation>disable setzt das Bit ACCOUNTDISABLE, bevor das Konto gelöscht wird: Scheitert das Löschen, ist es wenigstens gesperrt.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="disable" dn="=konto.dn"/></extensionElements><incoming>f_gw_gef__st_disable</incoming><outgoing>f_st_disable__st_delete</outgoing></serviceTask>
    <serviceTask id="st_delete" name="Konto löschen"><documentation>delete. Endgültig; wo der AD-Papierkorb aktiv ist, lässt es sich dort während seiner Aufbewahrungszeit wiederherstellen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="delete" dn="=konto.dn"/></extensionElements><incoming>f_st_disable__st_delete</incoming><outgoing>f_st_delete__gw_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_join"><incoming>f_gw_gef__gw_join</incoming><incoming>f_st_delete__gw_join</incoming><outgoing>f_gw_join__st_returned</outgoing></exclusiveGateway>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>Meldet die Rückgabe (status "returned") über die Positionsroute; damit endet das Recht im Bestand. Eine Rückgabe erhält die Variable atlasApiBase nicht; die Adresse kommt dann aus der Applikationskonstante ATLAS_API_BASE.</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;)" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;returned&quot;" target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_join__st_returned</incoming><outgoing>f_st_returned__e_weg</outgoing></serviceTask>
    <endEvent id="e_weg" name="Testkonto entfernt"><incoming>f_st_returned__e_weg</incoming></endEvent>
    <startEvent id="s_auf" name="Entsperren angefragt"><documentation>Start der Aktion entsperren (Service).</documentation><outgoing>f_s_auf__st_auf_finden</outgoing><messageEventDefinition messageRef="m_test_entsperren"/></startEvent>
    <serviceTask id="st_auf_finden" name="Konto finden"><documentation>Über die Herkunftskennzeichnung.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_TEST_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" select="1.1" maxEntries="1" resultVariable="konto" foundVariable="kontoGefunden"/></extensionElements><incoming>f_s_auf__st_auf_finden</incoming><outgoing>f_st_auf_finden__gw_auf</outgoing></serviceTask>
    <exclusiveGateway id="gw_auf" name="Konto vorhanden?" default="f_gw_auf__sd_auf_rej"><documentation>Ohne Konto wird die Aktion abgelehnt.</documentation><incoming>f_st_auf_finden__gw_auf</incoming><outgoing>f_gw_auf__st_auf</outgoing><outgoing>f_gw_auf__sd_auf_rej</outgoing></exclusiveGateway>
    <serviceTask id="st_auf" name="Sperre aufheben"><documentation>update-attributes setzt lockoutTime auf "0" (inline, attributes); das hebt eine Sperre nach zu vielen Fehlversuchen auf, nicht die Deaktivierung.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="update-attributes" dn="=konto.dn" attributes="{&quot;lockoutTime&quot;: &quot;0&quot;}"/></extensionElements><incoming>f_gw_auf__st_auf</incoming><outgoing>f_st_auf__sd_auf_ok</outgoing></serviceTask>
    <sendTask id="sd_auf_ok" name="Aktion als erledigt melden"><documentation>outcome completed für entsperren.</documentation><extensionElements><atlas:shopTask mode="outcome" action="entsperren" outcome="completed"/></extensionElements><incoming>f_st_auf__sd_auf_ok</incoming><outgoing>f_sd_auf_ok__e_auf_ok</outgoing></sendTask>
    <endEvent id="e_auf_ok" name="Entsperrt"><incoming>f_sd_auf_ok__e_auf_ok</incoming></endEvent>
    <sendTask id="sd_auf_rej" name="Aktion ablehnen"><documentation>outcome rejected für entsperren.</documentation><extensionElements><atlas:shopTask mode="outcome" action="entsperren" outcome="rejected"/></extensionElements><incoming>f_gw_auf__sd_auf_rej</incoming><outgoing>f_sd_auf_rej__e_auf_rej</outgoing></sendTask>
    <endEvent id="e_auf_rej" name="Kein Konto"><incoming>f_sd_auf_rej__e_auf_rej</incoming></endEvent>
    <startEvent id="s_pw" name="Passwort angefragt"><documentation>Start der Aktion passwort (Service).</documentation><outgoing>f_s_pw__st_pw_finden</outgoing><messageEventDefinition messageRef="m_test_passwort"/></startEvent>
    <serviceTask id="st_pw_finden" name="Konto finden"><documentation>Über die Herkunftskennzeichnung.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=application.AD_TEST_OU" scope="sub" filter="=&quot;(&amp;(objectClass=user)(info=&quot; + &quot;atlas-katalog &quot; + orderId + &quot;/&quot; + (if positionId = null then itemId else positionId) + &quot;))&quot;" select="1.1" maxEntries="1" resultVariable="konto" foundVariable="kontoGefunden"/></extensionElements><incoming>f_s_pw__st_pw_finden</incoming><outgoing>f_st_pw_finden__gw_pw</outgoing></serviceTask>
    <exclusiveGateway id="gw_pw" name="Konto vorhanden?" default="f_gw_pw__sd_pw_rej"><documentation>Ohne Konto wird die Aktion abgelehnt.</documentation><incoming>f_st_pw_finden__gw_pw</incoming><outgoing>f_gw_pw__ut_pw2</outgoing><outgoing>f_gw_pw__sd_pw_rej</outgoing></exclusiveGateway>
    <userTask id="ut_pw2" name="Neues Passwort eingeben"><documentation>Die Aufgabe geht an die empfangende Person (assignee = recipient). Sie gibt das Passwort im Formular ad-konto-passwort ein; passwort ist als Personendatum deklariert und wird verschlüsselt gespeichert (ADR-0314). Eine Passwort-Ablage (Vault, Passwortmanager) ist die empfohlene Ablösung; das entscheidet die Installation (README).</documentation><extensionElements><zeebe:formDefinition formId="ad-konto-passwort"/><zeebe:assignmentDefinition assignee="=recipient"/></extensionElements><incoming>f_gw_pw__ut_pw2</incoming><outgoing>f_ut_pw2__st_pw2</outgoing></userTask>
    <serviceTask id="st_pw2" name="Passwort setzen"><documentation>set-password schreibt unicodePwd; AD nimmt das nur über eine verschlüsselte Verbindung an (LDAPS), und das Passwort muss der Kennwortrichtlinie der Domäne genügen.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="set-password" dn="=konto.dn" newPassword="=passwort"/></extensionElements><incoming>f_ut_pw2__st_pw2</incoming><outgoing>f_st_pw2__st_pw2_weg</outgoing></serviceTask>
    <serviceTask id="st_pw2_weg" name="Passwort aus der Instanz entfernen"><documentation>Die Engine darf ein Personendatum nicht schreiben (ADR-0314: nur ein Formular, ein Worker-Ergebnis oder der Betrieb versiegeln), also auch nicht leeren. Deshalb überschreibt ein Worker-Ergebnis die Variable passwort: Diese Suche liest das Konto (scope base, select 1.1: nur der DN) und legt das Ergebnis unter dem Namen passwort ab. Danach steht das Passwort nicht mehr in den Variablen der Instanz; im Verlauf bleibt der frühere Wert verschlüsselt, bis der Schlüssel der Person gelöscht wird.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=konto.dn" scope="base" filter="(objectClass=user)" select="1.1" maxEntries="1" resultVariable="passwort"/></extensionElements><incoming>f_st_pw2__st_pw2_weg</incoming><outgoing>f_st_pw2_weg__sd_pw_ok</outgoing></serviceTask>
    <sendTask id="sd_pw_ok" name="Aktion als erledigt melden"><documentation>outcome completed für passwort.</documentation><extensionElements><atlas:shopTask mode="outcome" action="passwort" outcome="completed"/></extensionElements><incoming>f_st_pw2_weg__sd_pw_ok</incoming><outgoing>f_sd_pw_ok__e_pw_ok</outgoing></sendTask>
    <endEvent id="e_pw_ok" name="Passwort gesetzt"><incoming>f_sd_pw_ok__e_pw_ok</incoming></endEvent>
