<?xml version="1.0" encoding="UTF-8"?>
<!--
Active Directory: Genehmigung einer Berechtigung durch die Person, die die Gruppe verantwortet (managedBy).
Aufgabe an ihr Atlas-Konto, sonst an die Ersatzgruppe.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_ad_genehmigung_gruppenverantwortung" targetNamespace="http://atlas/beispiel/ad-dienste">
  <process id="proc_ad_genehmigung_gruppenverantwortung" name="Active Directory: Genehmigung durch die Gruppenverantwortung" isExecutable="true">
    <documentation>Eigene Genehmigungsart der Produkte ad-recht-* (approval.kind = proc_ad_genehmigung_gruppenverantwortung). Über den Zugang zu einer Gruppe entscheidet, wer sie verantwortet: die Person im Attribut managedBy der Gruppe.

Ablauf: AdBerechtigungen nennt die Gruppe; search liest sie (managedBy); search liest das Konto, auf das managedBy zeigt (scope base), mit userPrincipalName und displayName; GET /api/v1/users/assignable findet das Atlas-Konto wie die Genehmigung der Microsoft-365-Dienste (Benutzername gleich der UPN, sonst genau ein Benutzername gleich dem Teil vor dem «@» mit gleichem Anzeigenamen). Aufgabe «Berechtigung genehmigen» an dieses Konto, sonst an die Ersatzgruppe: approval.ref des Produkts (im Katalog {{ad-administration}}), wenn leer die Gruppe AD-Administration. Ergebnis an den Auftrag: …/start mit approvedBy oder …/decision mit der Begründung.

Startvariablen: orderId, itemId, positionId, recipient, orderer, approvalRef, atlasApiBase, portalBaseUrl und die Antworten des Bestellformulars (konto). Personendaten: keine deklariert. konto ist eine Kennung (siehe README); die verantwortliche Person ist nicht die empfangende Person, und Gateway und Kontosuche müssen sie lesen, wie den Vorgesetzten in proc_m365_genehmigung_vorgesetzter. Das Suchergebnis selbst bleibt in der Aufgabe.

Nicht modelliert: Erinnerung und Eskalation; eine Genehmigung, die liegen bleibt, zeigt Atlas unter den festgefahrenen Genehmigungen. Worker: ad_verzeichnis, Secret atlas.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/></atlas:constants></extensionElements>
    <startEvent id="s" name="Genehmigung nötig"><documentation>Vom Auftrag gestartet, wenn die Position an der Reihe ist und ihr Produkt diesen Prozess als Genehmigungsart nennt.</documentation><outgoing>f_s__sc_ersatz</outgoing></startEvent>
    <scriptTask id="sc_ersatz" name="Ersatzgruppe bestimmen"><documentation>approval.ref des Produkts, sonst die Gruppe AD-Administration (über ihren Namen).</documentation><extensionElements><zeebe:script expression="=if approvalRef = null or approvalRef = &quot;&quot; then &quot;AD-Administration&quot; else approvalRef" resultVariable="ersatzgruppe"/><zeebe:ioMapping><zeebe:output source="=if approvalRef = null or approvalRef = &quot;&quot; then &quot;AD-Administration&quot; else approvalRef" target="ersatzgruppe"/><zeebe:output source="=null" target="verantwortlichKonto"/><zeebe:output source="={gefunden: false, verantwortlich: null}" target="gruppeInfo"/><zeebe:output source="={gefunden: false, aktiv: false, name: null, upn: null}" target="verantwortlich"/></zeebe:ioMapping></extensionElements><incoming>f_s__sc_ersatz</incoming><outgoing>f_sc_ersatz__br_recht</outgoing></scriptTask>
    <businessRuleTask id="br_recht" name="Gruppe nachschlagen"><documentation>AdBerechtigungen wie im Lebenszyklus.</documentation><extensionElements><zeebe:calledDecision decisionId="AdBerechtigungen" resultVariable="recht"/><zeebe:ioMapping><zeebe:input source="=itemId" target="itemId"/></zeebe:ioMapping></extensionElements><incoming>f_sc_ersatz__br_recht</incoming><outgoing>f_br_recht__gw_bekannt</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_bekannt" name="Gruppe bekannt?" default="f_gw_bekannt__gw_merge"><documentation>Ohne Tabelleneintrag entscheidet die Ersatzgruppe.</documentation><incoming>f_br_recht__gw_bekannt</incoming><outgoing>f_gw_bekannt__st_gruppe</outgoing><outgoing>f_gw_bekannt__gw_merge</outgoing></exclusiveGateway>
    <serviceTask id="st_gruppe" name="Gruppe lesen"><documentation>search mit baseDN = recht.gruppeDn, scope base. gruppeInfo = {gefunden, verantwortlich}; verantwortlich ist der DN aus managedBy oder null.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=recht.gruppeDn" scope="base" filter="(objectClass=group)" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, verantwortlich: if suche.found = true then suche.entries[1].attributes.managedBy[1] else null}" target="gruppeInfo"/></zeebe:ioMapping></extensionElements><incoming>f_gw_bekannt__st_gruppe</incoming><outgoing>f_st_gruppe__gw_hat</outgoing></serviceTask>
    <exclusiveGateway id="gw_hat" name="Verantwortung gepflegt?" default="f_gw_hat__gw_mx"><documentation>Ohne managedBy entscheidet die Ersatzgruppe.</documentation><incoming>f_st_gruppe__gw_hat</incoming><outgoing>f_gw_hat__st_owner</outgoing><outgoing>f_gw_hat__gw_mx</outgoing></exclusiveGateway>
    <serviceTask id="st_owner" name="Verantwortliche Person lesen"><documentation>search mit baseDN = dem DN aus managedBy, scope base: liest genau dieses Konto. In den Prozess kommt verantwortlich = {gefunden, dn, aktiv, name, upn}. managedBy kann auch auf eine Gruppe zeigen; dann findet der Filter (objectClass=user) nichts, und die Ersatzgruppe entscheidet.</documentation><extensionElements><atlas:adConnector connector="ad_verzeichnis" operation="search" baseDN="=gruppeInfo.verantwortlich" scope="base" filter="(objectClass=user)" maxEntries="1" resultVariable="suche"/><zeebe:ioMapping><zeebe:output source="={gefunden: suche.found = true, aktiv: suche.found = true and modulo(floor(number(suche.entries[1].attributes.userAccountControl[1]) / 2), 2) = 0, name: if suche.found = true then suche.entries[1].attributes.displayName[1] else null, upn: if suche.found = true then suche.entries[1].attributes.userPrincipalName[1] else null}" target="verantwortlich"/></zeebe:ioMapping></extensionElements><incoming>f_gw_hat__st_owner</incoming><outgoing>f_st_owner__gw_owner</outgoing></serviceTask>
    <exclusiveGateway id="gw_owner" name="Aktives Konto?" default="f_gw_owner__gw_mx"><documentation>Ein gesperrtes Konto oder eines ohne UPN: Ersatzgruppe.</documentation><incoming>f_st_owner__gw_owner</incoming><outgoing>f_gw_owner__st_konto</outgoing><outgoing>f_gw_owner__gw_mx</outgoing></exclusiveGateway>
    <serviceTask id="st_konto" name="Atlas-Konto suchen"><documentation>GET /api/v1/users/assignable. Treffer: ein Benutzername gleich der UPN (Gross-/Kleinschreibung egal); sonst genau ein Benutzername gleich dem Teil vor dem «@» (kleingeschrieben, nur a-z 0-9 . - _), dessen Anzeigename übereinstimmt. Nur der Treffer kommt in den Prozess (verantwortlichKonto); die Liste bleibt in der Aufgabe.</documentation><extensionElements><atlas:restConnector method="GET" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/users/assignable&quot;" resultVariable="konten" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=verantwortlich" target="gesucht"/><zeebe:output source="={exakt: (for k in konten return if gesucht.upn != null and lower case(k.username) = lower case(gesucht.upn) then k.username else null)[item != null], teil: if gesucht.upn = null then null else replace(lower case(substring before(gesucht.upn, &quot;@&quot;)), &quot;[^a-z0-9._-]&quot;, &quot;&quot;), name: if gesucht.name = null then null else lower case(gesucht.name), lokal: (for k in konten return if teil != null and lower case(k.username) = teil and (k.displayName = null or lower case(k.displayName) = name) then k.username else null)[item != null], treffer: if count(exakt) &gt; 0 then exakt[1] else if count(lokal) = 1 then lokal[1] else null}.treffer" target="verantwortlichKonto"/></zeebe:ioMapping></extensionElements><incoming>f_gw_owner__st_konto</incoming><outgoing>f_st_konto__gw_merge</outgoing></serviceTask>
    <exclusiveGateway id="gw_mx"><incoming>f_gw_hat__gw_mx</incoming><incoming>f_gw_owner__gw_mx</incoming><outgoing>f_gw_mx__gw_merge</outgoing></exclusiveGateway>
    <exclusiveGateway id="gw_merge"><incoming>f_gw_bekannt__gw_merge</incoming><incoming>f_gw_mx__gw_merge</incoming><incoming>f_st_konto__gw_merge</incoming><outgoing>f_gw_merge__sc_entscheider</outgoing></exclusiveGateway>
    <scriptTask id="sc_entscheider" name="Entscheider festlegen"><documentation>Ein Konto gefunden: Die Aufgabe geht an diese Person. Sonst an die Ersatzgruppe; entscheidungsweg hält fest, warum.</documentation><extensionElements><zeebe:script expression="=if verantwortlichKonto = null then ersatzgruppe else verantwortlichKonto" resultVariable="entscheider"/><zeebe:ioMapping><zeebe:output source="=verantwortlichKonto" target="zuweisung"/><zeebe:output source="=if verantwortlichKonto = null then ersatzgruppe else verantwortlichKonto" target="entscheider"/><zeebe:output source="=if verantwortlichKonto != null then &quot;Verantwortliche Person der Gruppe&quot; else if recht.bekannt != true then &quot;Ersatzgruppe: für dieses Produkt ist keine Gruppe hinterlegt&quot; else if gruppeInfo.verantwortlich = null then &quot;Ersatzgruppe: für die Gruppe ist keine verantwortliche Person gepflegt (managedBy)&quot; else if verantwortlich.aktiv != true then &quot;Ersatzgruppe: das Konto der verantwortlichen Person ist gesperrt oder unbekannt&quot; else &quot;Ersatzgruppe: die verantwortliche Person hat kein Atlas-Konto&quot;" target="entscheidungsweg"/></zeebe:ioMapping></extensionElements><incoming>f_gw_merge__sc_entscheider</incoming><outgoing>f_sc_entscheider__gw_wer</outgoing></scriptTask>
    <exclusiveGateway id="gw_wer" name="Wer entscheidet?" default="f_gw_wer__ut_gruppe"><documentation>Zwei Aufgaben statt einer, weil eine Zuweisung nur an einen Namen geht.</documentation><incoming>f_sc_entscheider__gw_wer</incoming><outgoing>f_gw_wer__ut_person</outgoing><outgoing>f_gw_wer__ut_gruppe</outgoing></exclusiveGateway>
    <userTask id="ut_person" name="Berechtigung genehmigen"><documentation>An das Atlas-Konto der verantwortlichen Person. Formular genehmigung der Plattform: Genehmigen, Ablehnen mit Begründung, die Angaben der Bestellung.</documentation><extensionElements><zeebe:formDefinition formId="genehmigung"/><zeebe:assignmentDefinition assignee="=zuweisung"/></extensionElements><incoming>f_gw_wer__ut_person</incoming><outgoing>f_ut_person__gw_wer_join</outgoing></userTask>
    <userTask id="ut_gruppe" name="Berechtigung genehmigen (Ersatzgruppe)"><documentation>Wer aus der Ersatzgruppe zuerst übernimmt, entscheidet; entscheidungsweg sagt, warum die Gruppe gefragt ist.</documentation><extensionElements><zeebe:formDefinition formId="genehmigung"/><zeebe:assignmentDefinition candidateGroups="=ersatzgruppe"/></extensionElements><incoming>f_gw_wer__ut_gruppe</incoming><outgoing>f_ut_gruppe__gw_wer_join</outgoing></userTask>
    <exclusiveGateway id="gw_wer_join"><incoming>f_ut_person__gw_wer_join</incoming><incoming>f_ut_gruppe__gw_wer_join</incoming><outgoing>f_gw_wer_join__gw_ok</outgoing></exclusiveGateway>
    <exclusiveGateway id="gw_ok" name="Genehmigt?" default="f_gw_ok__st_decision"><documentation>genehmigt schreibt das Formular genehmigung.</documentation><incoming>f_gw_wer_join__gw_ok</incoming><outgoing>f_gw_ok__st_start</outgoing><outgoing>f_gw_ok__st_decision</outgoing></exclusiveGateway>
    <serviceTask id="st_start" name="Bereitstellung starten"><documentation>POST …/lines/{positionId}/start mit approvedBy (wer die Aufgabe abgeschlossen hat, sonst der Entscheider).</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;) + &quot;/start&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=&quot;provision&quot;" target="operation"/><zeebe:input source="=if completedBy != null and completedBy != &quot;&quot; then completedBy else entscheider" target="approvedBy"/></zeebe:ioMapping></extensionElements><incoming>f_gw_ok__st_start</incoming><outgoing>f_st_start__gw_end</outgoing></serviceTask>
    <serviceTask id="st_decision" name="Ablehnung melden"><documentation>POST …/lines/{positionId}/decision mit der Person, die entschieden hat, und ihrer Begründung (begruendung schreibt der Posteingang beim Ablehnen).</documentation><extensionElements><atlas:restConnector method="POST" url="=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + &quot;/api/v1/orders/&quot; + orderId + &quot;/lines/&quot; + replace((if positionId = null then itemId else positionId), &quot;#&quot;, &quot;%23&quot;) + &quot;/decision&quot;" authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=if completedBy != null and completedBy != &quot;&quot; then completedBy else entscheider" target="by"/><zeebe:input source="=begruendung" target="reason"/></zeebe:ioMapping></extensionElements><incoming>f_gw_ok__st_decision</incoming><outgoing>f_st_decision__gw_end</outgoing></serviceTask>
    <exclusiveGateway id="gw_end"><incoming>f_st_start__gw_end</incoming><incoming>f_st_decision__gw_end</incoming><outgoing>f_gw_end__e</outgoing></exclusiveGateway>
    <endEvent id="e" name="Entschieden"><incoming>f_gw_end__e</incoming></endEvent>
    <sequenceFlow id="f_s__sc_ersatz" sourceRef="s" targetRef="sc_ersatz"/>
    <sequenceFlow id="f_sc_ersatz__br_recht" sourceRef="sc_ersatz" targetRef="br_recht"/>
    <sequenceFlow id="f_br_recht__gw_bekannt" sourceRef="br_recht" targetRef="gw_bekannt"/>
    <sequenceFlow id="f_gw_bekannt__st_gruppe" sourceRef="gw_bekannt" targetRef="st_gruppe" name="ja"><conditionExpression>=recht.bekannt = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_bekannt__gw_merge" sourceRef="gw_bekannt" targetRef="gw_merge" name="nein"/>
    <sequenceFlow id="f_st_gruppe__gw_hat" sourceRef="st_gruppe" targetRef="gw_hat"/>
    <sequenceFlow id="f_gw_hat__st_owner" sourceRef="gw_hat" targetRef="st_owner" name="ja"><conditionExpression>=gruppeInfo.verantwortlich != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_hat__gw_mx" sourceRef="gw_hat" targetRef="gw_mx" name="nein"/>
    <sequenceFlow id="f_st_owner__gw_owner" sourceRef="st_owner" targetRef="gw_owner"/>
    <sequenceFlow id="f_gw_owner__st_konto" sourceRef="gw_owner" targetRef="st_konto" name="ja"><conditionExpression>=verantwortlich.aktiv = true and verantwortlich.upn != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_owner__gw_mx" sourceRef="gw_owner" targetRef="gw_mx" name="nein"/>
    <sequenceFlow id="f_gw_mx__gw_merge" sourceRef="gw_mx" targetRef="gw_merge"/>
    <sequenceFlow id="f_st_konto__gw_merge" sourceRef="st_konto" targetRef="gw_merge"/>
    <sequenceFlow id="f_gw_merge__sc_entscheider" sourceRef="gw_merge" targetRef="sc_entscheider"/>
    <sequenceFlow id="f_sc_entscheider__gw_wer" sourceRef="sc_entscheider" targetRef="gw_wer"/>
    <sequenceFlow id="f_gw_wer__ut_person" sourceRef="gw_wer" targetRef="ut_person" name="Person"><conditionExpression>=zuweisung != null</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_wer__ut_gruppe" sourceRef="gw_wer" targetRef="ut_gruppe" name="Gruppe"/>
    <sequenceFlow id="f_ut_person__gw_wer_join" sourceRef="ut_person" targetRef="gw_wer_join"/>
    <sequenceFlow id="f_ut_gruppe__gw_wer_join" sourceRef="ut_gruppe" targetRef="gw_wer_join"/>
    <sequenceFlow id="f_gw_wer_join__gw_ok" sourceRef="gw_wer_join" targetRef="gw_ok"/>
    <sequenceFlow id="f_gw_ok__st_start" sourceRef="gw_ok" targetRef="st_start" name="ja"><conditionExpression>=genehmigt = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_ok__st_decision" sourceRef="gw_ok" targetRef="st_decision" name="nein"/>
    <sequenceFlow id="f_st_start__gw_end" sourceRef="st_start" targetRef="gw_end"/>
    <sequenceFlow id="f_st_decision__gw_end" sourceRef="st_decision" targetRef="gw_end"/>
    <sequenceFlow id="f_gw_end__e" sourceRef="gw_end" targetRef="e"/>
  </process>
  <bpmndi:BPMNDiagram id="proc_ad_genehmigung_gruppenverantwortung_diagram">
    <bpmndi:BPMNPlane id="proc_ad_genehmigung_gruppenverantwortung_plane" bpmnElement="proc_ad_genehmigung_gruppenverantwortung">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><omgdc:Bounds x="162" y="252" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="130" y="292" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_ersatz_di" bpmnElement="sc_ersatz"><omgdc:Bounds x="280" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="br_recht_di" bpmnElement="br_recht"><omgdc:Bounds x="430" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_bekannt_di" bpmnElement="gw_bekannt" isMarkerVisible="true"><omgdc:Bounds x="605" y="245" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="533" y="214" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_gruppe_di" bpmnElement="st_gruppe"><omgdc:Bounds x="730" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_hat_di" bpmnElement="gw_hat" isMarkerVisible="true"><omgdc:Bounds x="905" y="245" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="833" y="214" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_owner_di" bpmnElement="st_owner"><omgdc:Bounds x="1030" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_owner_di" bpmnElement="gw_owner" isMarkerVisible="true"><omgdc:Bounds x="1205" y="245" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="1133" y="214" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_konto_di" bpmnElement="st_konto"><omgdc:Bounds x="1330" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_mx_di" bpmnElement="gw_mx" isMarkerVisible="true"><omgdc:Bounds x="1205" y="385" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_di" bpmnElement="gw_merge" isMarkerVisible="true"><omgdc:Bounds x="1505" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_entscheider_di" bpmnElement="sc_entscheider"><omgdc:Bounds x="1630" y="230" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_wer_di" bpmnElement="gw_wer" isMarkerVisible="true"><omgdc:Bounds x="1805" y="245" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="1733" y="214" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ut_person_di" bpmnElement="ut_person"><omgdc:Bounds x="1930" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ut_gruppe_di" bpmnElement="ut_gruppe"><omgdc:Bounds x="1930" y="370" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_wer_join_di" bpmnElement="gw_wer_join" isMarkerVisible="true"><omgdc:Bounds x="2105" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok" isMarkerVisible="true"><omgdc:Bounds x="2255" y="245" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="2183" y="214" width="70" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_start_di" bpmnElement="st_start"><omgdc:Bounds x="2380" y="90" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_decision_di" bpmnElement="st_decision"><omgdc:Bounds x="2380" y="370" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_end_di" bpmnElement="gw_end" isMarkerVisible="true"><omgdc:Bounds x="2555" y="245" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><omgdc:Bounds x="2712" y="252" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="2680" y="292" width="100" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_s__sc_ersatz_di" bpmnElement="f_s__sc_ersatz"><omgdi:waypoint x="198" y="270"/><omgdi:waypoint x="280" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_ersatz__br_recht_di" bpmnElement="f_sc_ersatz__br_recht"><omgdi:waypoint x="380" y="270"/><omgdi:waypoint x="430" y="270"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_br_recht__gw_bekannt_di" bpmnElement="f_br_recht__gw_bekannt"><omgdi:waypoint x="530" y="270"/><omgdi:waypoint x="605" y="270"/></bpmndi:BPMNEdge>
