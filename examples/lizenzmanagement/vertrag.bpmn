<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_lz_vertrag" targetNamespace="http://atlas/beispiel/lizenzmanagement">
  <message id="m_bestellen" name="lz.vertrag.bestellen"/>
  <message id="m_aufstocken" name="lz.vertrag.aufstocken"/>
  <message id="m_senken" name="lz.vertrag.senken"/>
  <message id="m_verlaengern" name="lz.vertrag.verlaengern"/>
  <message id="m_beenden" name="lz.vertrag.beenden"/>
  <message id="m_regel" name="lz.vertrag.entzugsregel"/>
  <message id="m_form" name="lz.vertrag.verrechnung"/>
  <itemDefinition id="item_Lizenzvertrag" structureRef="Lizenzvertrag"/>
  <itemDefinition id="item_Katalogposition" structureRef="Katalogposition"/>
  <process id="proc_lz_vertrag" name="Lizenzmanagement: Lizenzvertrag" isExecutable="true">
    <documentation>Lebenszyklus des Produkts «Lizenzvertrag» (lz-lizenzvertrag): Ein Kunde oder ein Projekt erhält eine Menge Microsoft-365-Lizenzen pro SKU für eine Laufzeit, verrechnet auf ein PSP-Element. Ein Prozess, Form pro Operation (ADR-0425/0429): Jede Aktion des Produkts startet eine eigene Instanz über ihren Nachrichtenstart. Der Stand des Vertrags liegt nicht hier, sondern im Vertragsbuch (proc_lz_vertragsbuch); jede Aktion bucht dort über proc_lz_buchen.

- Bestellen (P1, provision): Angaben übernehmen, PSP-Element prüfen (LzPspPruefung; ungültig: zurück an die bestellende Person, 10 Tage Frist), Kontingent im Tenant schätzen (Tenant-Kontingent, Buchung schaetzen), Genehmigung durch die Tenant-verantwortliche Person (Mengen anpassbar; nach 7 Tagen Hinweis an den Chef), Vertrag anlegen (startet das Vertragsbuch), bei fehlenden Lizenzen im EA die Aufgabe «Im EA nachkaufen», Bestätigung an den Integrations Manager, Position erledigt.
- Aufstocken (P2): zusätzliche Mengen schätzen, Genehmigung durch die Tenant-verantwortliche Person, Mengen erhöhen, allenfalls nachkaufen.
- Senken (P2): Belegung lesen; reicht die neue Menge nicht für alle Bezüge, wählt der Integrations Manager die Personen, die abgeben, und deren Lizenzen werden über das M365-Produkt zurückgegeben (Shop-Befehl deprovision); dann die Mengen setzen. Keine Genehmigung: Senken spart.
- Verlängern (P2): ein neues Ende innerhalb der EA-Laufzeit (EA_ENDE), sonst abgelehnt.
- Beenden (P2, deprovision): Die Tenant-verantwortliche Person bestätigt mit der Zahl der betroffenen Personen; jede Lizenz des Vertrags wird zurückgegeben, das Vertragsbuch beendet, die Position zurückgegeben.
- Entzugsregel ändern (P2): Die Tabelle des Kunden wird mit Testdaten ausgewertet; nur eine Tabelle, die Prioritäten oder «behalten» liefert, wird im Vertrag eingetragen.
- Form der Verrechnung ändern (P2): Form und Empfänger des monatlichen Exports.

Startvariablen aus dem Shop: orderId, positionId, itemId, recipient und die Antworten des Bestellformulars lz-vertrag-bestellung (kunde, projekt, psp, mengeE3, mengeE5, mengeF3, beginn, ende, integrationsManager, exportForm, exportAn, entzugsregel). Die Vertragsnummer ist "LV-" + orderId.

Gruppen über Applikationskonstanten: GRUPPE_TENANT (die Tenant-verantwortliche Person), GRUPPE_CHEF. Worker: das Secret "atlas" (API-Token der Rolle operator, für die Entzugsregel zusätzlich modeler) und der Mail-Worker mail.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/><atlas:constant name="GRUPPE_TENANT" type="string" source="application" value="Lizenz-Tenantverantwortung"/><atlas:constant name="GRUPPE_CHEF" type="string" source="application" value="Lizenz-Chef"/><atlas:constant name="EA_ENDE" type="string" source="application" value="2029-06-30"/><atlas:constant name="GENEHMIGUNG_FRIST" type="string" source="application" value="P7D"/><atlas:constant name="KORREKTUR_FRIST" type="string" source="application" value="P10D"/></atlas:constants></extensionElements>
    <dataObject id="do_katalogposition" name="Katalogposition" itemSubjectRef="item_Katalogposition"/>
    <dataObject id="do_lizenzvertrag" name="Lizenzvertrag" itemSubjectRef="item_Lizenzvertrag"/>
    <startEvent id="s_bestellt" name="Bestellung eingegangen"><documentation>Start der Operation provision. Das Produkt hat keine Genehmigung im Katalog: Die Tenant-verantwortliche Person genehmigt hier, nach der Prüfung des PSP-Elements und mit der Schätzung des Kontingents, und darf dabei die Mengen anpassen.</documentation><outgoing>f_s_bestellt__gw_angaben</outgoing><messageEventDefinition messageRef="m_bestellen"/></startEvent>
    <exclusiveGateway id="gw_angaben"><incoming>f_s_bestellt__gw_angaben</incoming><incoming>f_ut_korrigieren__gw_angaben</incoming><outgoing>f_gw_angaben__sc_antrag</outgoing></exclusiveGateway>
    <scriptTask id="sc_antrag" name="Angaben übernehmen"><documentation>Bildet antrag aus den Antworten des Bestellformulars. Die Mengen kommen als Text (TestConfigFormsAnswerInText) und werden hier zu Zahlen; eine leere Menge ist 0. Die Vertragsnummer entsteht aus der Bestellnummer.</documentation><extensionElements><zeebe:script expression='={nummer: "LV-" + orderId, kunde: kunde, projekt: if projekt = "" then null else projekt, psp: if psp = null then "" else upper case(replace(psp, "\\s", "")), mengen: {E3: if mengeE3 = null or mengeE3 = "" then 0 else number(mengeE3), E5: if mengeE5 = null or mengeE5 = "" then 0 else number(mengeE5), F3: if mengeF3 = null or mengeF3 = "" then 0 else number(mengeF3)}, beginn: if beginn = null or beginn = "" then string(today()) else beginn, ende: if ende = "" then null else ende, integrationsManager: recipient, exportForm: if exportForm = null then "csv" else exportForm, exportAn: exportAn, entzugsregel: if entzugsregel = null or entzugsregel = "" then "LzEntzugStandard" else entzugsregel}' resultVariable="antrag"/></extensionElements><incoming>f_gw_angaben__sc_antrag</incoming><outgoing>f_sc_antrag__br_psp</outgoing></scriptTask>
    <businessRuleTask id="br_psp" name="PSP-Element prüfen"><documentation>LzPspPruefung prüft das Format des PSP-Elements (Vorschlag: P-nnnn-nn-nn). Vorschlag für später: eine Abfrage gegen SAP an dieser Stelle.</documentation><extensionElements><zeebe:calledDecision decisionId="LzPspPruefung" resultVariable="pspPruefung"/><zeebe:ioMapping><zeebe:input source="=antrag.psp" target="psp"/></zeebe:ioMapping></extensionElements><incoming>f_sc_antrag__br_psp</incoming><outgoing>f_br_psp__gw_psp</outgoing></businessRuleTask>
    <exclusiveGateway id="gw_psp" name="PSP gültig?" default="f_gw_psp__ut_korrigieren"><incoming>f_br_psp__gw_psp</incoming><outgoing>f_gw_psp__ca_schaetzen</outgoing><outgoing>f_gw_psp__ut_korrigieren</outgoing></exclusiveGateway>
    <userTask id="ut_korrigieren" name="Angaben korrigieren"><documentation>Zurück an die bestellende Person (recipient) mit dem Grund der Rückweisung. Sie korrigiert PSP-Element, Kunde und Projekt; danach prüft der Prozess erneut. Nach KORREKTUR_FRIST (Vorschlag 10 Tage) wird die Bestellung als fehlgeschlagen gemeldet.</documentation><extensionElements><zeebe:assignmentDefinition assignee="=recipient"/><zeebe:formDefinition formId="lz-vertrag-korrektur"/><zeebe:ioMapping><zeebe:input source="=pspPruefung.grund" target="pspHinweis"/></zeebe:ioMapping></extensionElements><incoming>f_gw_psp__ut_korrigieren</incoming><outgoing>f_ut_korrigieren__gw_angaben</outgoing></userTask>
    <boundaryEvent id="tm_korrektur" name="Frist abgelaufen" attachedToRef="ut_korrigieren"><outgoing>f_tm_korrektur__st_korr_failed</outgoing><timerEventDefinition><timeDuration>=application.KORREKTUR_FRIST</timeDuration></timerEventDefinition></boundaryEvent>
    <serviceTask id="st_korr_failed" name="Als abgelehnt melden"><documentation>Die Frist ist ohne Korrektur abgelaufen: Die Position wird als fehlgeschlagen gemeldet (status failed); der Grund steht in der Instanz (pspPruefung.grund), weil die Positionsroute nur den Status nimmt.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + (if positionId = null then itemId else positionId)' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="failed"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_tm_korrektur__st_korr_failed</incoming><outgoing>f_st_korr_failed__e_korr</outgoing></serviceTask>
    <endEvent id="e_korr" name="Abgelehnt"><incoming>f_st_korr_failed__e_korr</incoming></endEvent>
    <callActivity id="ca_schaetzen" name="Kontingent im Tenant schätzen"><documentation>Fragt das Tenant-Kontingent (Buchung schaetzen): pro SKU gekauft im EA, Summe der aktiven Verträge und frei nach diesem Vertrag. Frei darf negativ sein; das ist dann der Nachkauf.</documentation><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="TENANT"' target="buchId"/><zeebe:input source='={aktion: "schaetzen", mengen: antrag.mengen, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/bestellen"}' target="auftrag"/><zeebe:output source="=antwort" target="schaetzung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_psp__ca_schaetzen</incoming><outgoing>f_ca_schaetzen__sc_schaetzung</outgoing></callActivity>
    <scriptTask id="sc_schaetzung" name="Schätzung zusammenfassen"><documentation>Ein Satz pro SKU für die Genehmigung («im EA fehlen 40 E5») und die Liste der SKUs, für die nachzukaufen ist.</documentation><extensionElements><zeebe:script expression='={liste: if schaetzung.schaetzung = null then [] else schaetzung.schaetzung[zusatz &gt; 0], fehlt: liste[frei != null and frei &lt; 0], text: if schaetzung.ergebnis != "ok" then "Das Tenant-Kontingent hat nicht geantwortet: " + string(schaetzung.grund) else string join(for s in liste return s.sku + ": " + (if s.frei = null then "noch kein Stand aus dem Tenant" else if s.frei &lt; 0 then "im EA fehlen " + string(-s.frei) else "im EA bleiben " + string(s.frei) + " frei") + " (gekauft " + (if s.gekauft = null then "?" else string(s.gekauft)) + ", in Verträgen " + string(s.vertragsmenge) + ", dieser Vertrag " + string(s.zusatz) + ")", "; "), nachkauf: for s in fehlt return {sku: s.sku, frei: s.frei, empfehlung: -s.frei, gekauft: s.gekauft, vertragsmenge: s.vertragsmenge}}' resultVariable="kontingent"/></extensionElements><incoming>f_ca_schaetzen__sc_schaetzung</incoming><outgoing>f_sc_schaetzung__ut_genehmigen</outgoing></scriptTask>
    <userTask id="ut_genehmigen" name="Vertrag genehmigen"><documentation>Die Tenant-verantwortliche Person (GRUPPE_TENANT) sieht alle Angaben und die Schätzung und genehmigt, lehnt mit Grund ab oder passt die Mengen an (die Felder mengeE3, mengeE5, mengeF3 sind vorbelegt). Nach GENEHMIGUNG_FRIST (Vorschlag 7 Tage, statt 5 Arbeitstagen) erhält der Chef einen Hinweis; die Aufgabe bleibt offen.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="=application.GRUPPE_TENANT"/><zeebe:formDefinition formId="lz-vertrag-genehmigung"/><zeebe:ioMapping><zeebe:input source="=kontingent.text" target="kontingentText"/></zeebe:ioMapping></extensionElements><incoming>f_sc_schaetzung__ut_genehmigen</incoming><outgoing>f_ut_genehmigen__gw_gen</outgoing></userTask>
    <boundaryEvent id="tm_genehmigen" name="Frist" attachedToRef="ut_genehmigen" cancelActivity="false"><outgoing>f_tm_genehmigen__st_eskalation</outgoing><timerEventDefinition><timeDuration>=application.GENEHMIGUNG_FRIST</timeDuration></timerEventDefinition></boundaryEvent>
    <serviceTask id="st_eskalation" name="Chef informieren"><documentation>Mail an GRUPPE_CHEF: Ein Vertrag wartet seit der Frist auf die Genehmigung.</documentation><extensionElements><atlas:mailConnector connector="mail" to="=application.GRUPPE_CHEF" subject='="Lizenzvertrag wartet auf Genehmigung: " + antrag.nummer' body='="Der Lizenzvertrag " + antrag.nummer + " für " + antrag.kunde + " wartet seit " + application.GENEHMIGUNG_FRIST + " auf die Genehmigung durch die Tenant-verantwortliche Person."'/></extensionElements><incoming>f_tm_genehmigen__st_eskalation</incoming><outgoing>f_st_eskalation__e_eskalation</outgoing></serviceTask>
    <endEvent id="e_eskalation" name="Chef informiert"><incoming>f_st_eskalation__e_eskalation</incoming></endEvent>
    <exclusiveGateway id="gw_gen" name="Genehmigt?" default="f_gw_gen__st_abgelehnt"><incoming>f_ut_genehmigen__gw_gen</incoming><outgoing>f_gw_gen__sc_vertrag</outgoing><outgoing>f_gw_gen__st_abgelehnt</outgoing></exclusiveGateway>
    <serviceTask id="st_abgelehnt" name="Ablehnung melden"><documentation>Meldet die Position als fehlgeschlagen (status failed); die Begründung der Tenant-verantwortlichen Person steht in der Instanz (begruendung). Eine Ablehnung im Lebenszyklus ist kein Entscheid einer Genehmigungsart, sondern ein Ergebnis der Bereitstellung.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + (if positionId = null then itemId else positionId)' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="failed"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_gen__st_abgelehnt</incoming><outgoing>f_st_abgelehnt__e_abgelehnt</outgoing></serviceTask>
    <endEvent id="e_abgelehnt" name="Abgelehnt"><incoming>f_st_abgelehnt__e_abgelehnt</incoming></endEvent>
    <scriptTask id="sc_vertrag" name="Vertrag bilden"><documentation>Der Vertrag mit den genehmigten Mengen (die Felder der Genehmigung). Ohne Ende gilt der Vorschlag: der nächste EA-Jahrestag, längstens das Ende der EA-Laufzeit, beide aus dem Tenant-Kontingent.</documentation><extensionElements><zeebe:script expression='=context merge(antrag, {mengen: {E3: if mengeE3 = null or mengeE3 = "" then 0 else number(mengeE3), E5: if mengeE5 = null or mengeE5 = "" then 0 else number(mengeE5), F3: if mengeF3 = null or mengeF3 = "" then 0 else number(mengeF3)}, ende: if antrag.ende != null then antrag.ende else if schaetzung.eaJahrestag = null then application.EA_ENDE else if date(schaetzung.eaJahrestag) &lt; date(schaetzung.eaEnde) then schaetzung.eaJahrestag else schaetzung.eaEnde, orderId: orderId, positionId: if positionId = null then itemId else positionId, genehmigtAm: string(today())})' resultVariable="vertrag"/></extensionElements><incoming>f_gw_gen__sc_vertrag</incoming><outgoing>f_sc_vertrag__st_anlegen</outgoing></scriptTask>
    <serviceTask id="st_anlegen" name="Vertrag anlegen"><documentation>POST /api/v1/processes/proc_lz_vertragsbuch/triggers/lz.vertragsbuch.anlegen mit vertrag: startet das Vertragsbuch (aktiv, belegt 0 pro SKU). Die Vertragsnummer ist die triggerId, ein wiederholter Aufruf startet kein zweites Buch. Ein Fehler wird zum Incident.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/processes/proc_lz_vertragsbuch/triggers/lz.vertragsbuch.anlegen"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source="=vertrag.nummer" target="triggerId"/><zeebe:input source='="lizenzmanagement"' target="source"/><zeebe:input source="={vertrag: vertrag}" target="variables"/></zeebe:ioMapping></extensionElements><incoming>f_sc_vertrag__st_anlegen</incoming><outgoing>f_st_anlegen__gw_nk</outgoing></serviceTask>
    <exclusiveGateway id="gw_nk" name="Nachkauf nötig?" default="f_gw_nk__gw_nk_join"><incoming>f_st_anlegen__gw_nk</incoming><outgoing>f_gw_nk__st_nk</outgoing><outgoing>f_gw_nk__gw_nk_join</outgoing></exclusiveGateway>
    <serviceTask id="st_nk" name="Nachkauf anstossen"><documentation>Fehlen im EA Lizenzen, startet die Aufgabe «Im EA nachkaufen» an den Chef (proc_lz_bestand_aufgaben, wie im täglichen Abgleich). Sie läuft für sich; der Vertrag wartet nicht auf den Kauf.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/messages"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="lz.nachkauf.start"' target="name"/><zeebe:input source='={kandidaten: kontingent.nachkauf, anlass: "Lizenzvertrag " + vertrag.nummer + " (" + vertrag.kunde + ")"}' target="variables"/></zeebe:ioMapping></extensionElements><incoming>f_gw_nk__st_nk</incoming><outgoing>f_st_nk__gw_nk_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_nk_join"><incoming>f_gw_nk__gw_nk_join</incoming><incoming>f_st_nk__gw_nk_join</incoming><outgoing>f_gw_nk_join__st_bestaetigen</outgoing></exclusiveGateway>
    <serviceTask id="st_bestaetigen" name="Vertrag bestätigen"><documentation>Mail an den Integrations Manager mit Vertragsnummer, Mengen, Laufzeit und PSP-Element.</documentation><extensionElements><atlas:mailConnector connector="mail" to="=vertrag.integrationsManager" subject='="Lizenzvertrag " + vertrag.nummer + " ist aktiv"' body='="Guten Tag\n\nDer Lizenzvertrag " + vertrag.nummer + " für " + vertrag.kunde + (if vertrag.projekt = null then "" else " (" + vertrag.projekt + ")") + " ist aktiv.\n\nMengen: E3 " + string(vertrag.mengen.E3) + ", E5 " + string(vertrag.mengen.E5) + ", F3 " + string(vertrag.mengen.F3) + "\nLaufzeit: " + vertrag.beginn + " bis " + vertrag.ende + "\nPSP-Element: " + vertrag.psp + "\n\nBei jeder Lizenzbestellung im Microsoft-365-Katalog wählt ihr diesen Vertrag.\n\nFreundliche Grüsse\nLizenzmanagement"'/></extensionElements><incoming>f_gw_nk_join__st_bestaetigen</incoming><outgoing>f_st_bestaetigen__st_done</outgoing></serviceTask>
    <serviceTask id="st_done" name="Position als erledigt melden"><documentation>POST /api/v1/orders/{orderId}/lines/{positionId} mit status done.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + (if positionId = null then itemId else positionId)' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="done"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_st_bestaetigen__st_done</incoming><outgoing>f_st_done__e_aktiv</outgoing><dataOutputAssociation id="doa_dor_done"><targetRef>dor_done</targetRef></dataOutputAssociation></serviceTask>
    <endEvent id="e_aktiv" name="Vertrag aktiv"><incoming>f_st_done__e_aktiv</incoming></endEvent>
    <startEvent id="s_aufstocken" name="Aufstocken angefragt"><documentation>Aktion aufstocken (change). Das Formular lz-vertrag-aufstocken liefert die zusätzlichen Mengen zusatzE3, zusatzE5, zusatzF3 (Text).</documentation><outgoing>f_s_aufstocken__sc_zusatz</outgoing><messageEventDefinition messageRef="m_aufstocken"/></startEvent>
    <scriptTask id="sc_zusatz" name="Zusatz bilden"><extensionElements><zeebe:script expression='={E3: if zusatzE3 = null or zusatzE3 = "" then 0 else number(zusatzE3), E5: if zusatzE5 = null or zusatzE5 = "" then 0 else number(zusatzE5), F3: if zusatzF3 = null or zusatzF3 = "" then 0 else number(zusatzF3)}' resultVariable="zusatz"/></extensionElements><incoming>f_s_aufstocken__sc_zusatz</incoming><outgoing>f_sc_zusatz__ca_schaetzen2</outgoing></scriptTask>
    <callActivity id="ca_schaetzen2" name="Kontingent im Tenant schätzen"><documentation>Wie beim Bestellen, mit den zusätzlichen Mengen.</documentation><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="TENANT"' target="buchId"/><zeebe:input source='={aktion: "schaetzen", mengen: zusatz, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/aufstocken"}' target="auftrag"/><zeebe:output source="=antwort" target="schaetzung"/></zeebe:ioMapping></extensionElements><incoming>f_sc_zusatz__ca_schaetzen2</incoming><outgoing>f_ca_schaetzen2__sc_schaetzung2</outgoing></callActivity>
    <scriptTask id="sc_schaetzung2" name="Schätzung zusammenfassen"><extensionElements><zeebe:script expression='={liste: if schaetzung.schaetzung = null then [] else schaetzung.schaetzung[zusatz &gt; 0], fehlt: liste[frei != null and frei &lt; 0], text: string join(for s in liste return s.sku + ": " + (if s.frei = null then "noch kein Stand aus dem Tenant" else if s.frei &lt; 0 then "im EA fehlen " + string(-s.frei) else "im EA bleiben " + string(s.frei) + " frei"), "; "), nachkauf: for s in fehlt return {sku: s.sku, frei: s.frei, empfehlung: -s.frei, gekauft: s.gekauft, vertragsmenge: s.vertragsmenge}}' resultVariable="kontingent"/></extensionElements><incoming>f_ca_schaetzen2__sc_schaetzung2</incoming><outgoing>f_sc_schaetzung2__ut_aufstocken</outgoing></scriptTask>
    <userTask id="ut_aufstocken" name="Aufstockung genehmigen"><documentation>Die Tenant-verantwortliche Person genehmigt die zusätzlichen Mengen oder lehnt ab. Die neue Menge gilt ab der Genehmigung und wird ab dem Tag verrechnet (P6).</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="=application.GRUPPE_TENANT"/><zeebe:formDefinition formId="lz-vertrag-aufstockung-genehmigen"/><zeebe:ioMapping><zeebe:input source="=kontingent.text" target="kontingentText"/></zeebe:ioMapping></extensionElements><incoming>f_sc_schaetzung2__ut_aufstocken</incoming><outgoing>f_ut_aufstocken__gw_auf</outgoing></userTask>
    <exclusiveGateway id="gw_auf" name="Genehmigt?" default="f_gw_auf__sd_auf_abl"><incoming>f_ut_aufstocken__gw_auf</incoming><outgoing>f_gw_auf__ca_plus</outgoing><outgoing>f_gw_auf__sd_auf_abl</outgoing></exclusiveGateway>
    <sendTask id="sd_auf_abl" name="Ablehnung melden"><documentation>Shop-Aufgabe: Die Aktion aufstocken ist abgelehnt; der Grund steht in der Instanz (begruendung).</documentation><extensionElements><atlas:shopTask mode="outcome" action="aufstocken" outcome="rejected"/></extensionElements><incoming>f_gw_auf__sd_auf_abl</incoming><outgoing>f_sd_auf_abl__e_auf_abl</outgoing></sendTask>
    <endEvent id="e_auf_abl" name="Abgelehnt"><incoming>f_sd_auf_abl__e_auf_abl</incoming></endEvent>
    <callActivity id="ca_plus" name="Vertragsmenge erhöhen"><documentation>Buchung mengen mit modus plus: Das Vertragsbuch zählt die Zusätze zu den Mengen, die es in dem Moment hält.</documentation><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "mengen", modus: "plus", mengen: zusatz, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/aufstocken"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_auf__ca_plus</incoming><outgoing>f_ca_plus__gw_nk2</outgoing></callActivity>
    <exclusiveGateway id="gw_nk2" name="Nachkauf nötig?" default="f_gw_nk2__gw_nk2_join"><incoming>f_ca_plus__gw_nk2</incoming><outgoing>f_gw_nk2__st_nk2</outgoing><outgoing>f_gw_nk2__gw_nk2_join</outgoing></exclusiveGateway>
    <serviceTask id="st_nk2" name="Nachkauf anstossen"><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/messages"' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="lz.nachkauf.start"' target="name"/><zeebe:input source='={kandidaten: kontingent.nachkauf, anlass: "Aufstockung " + "LV-" + orderId}' target="variables"/></zeebe:ioMapping></extensionElements><incoming>f_gw_nk2__st_nk2</incoming><outgoing>f_st_nk2__gw_nk2_join</outgoing></serviceTask>
    <exclusiveGateway id="gw_nk2_join"><incoming>f_gw_nk2__gw_nk2_join</incoming><incoming>f_st_nk2__gw_nk2_join</incoming><outgoing>f_gw_nk2_join__sd_auf_ok</outgoing></exclusiveGateway>
    <sendTask id="sd_auf_ok" name="Aufstockung melden"><extensionElements><atlas:shopTask mode="outcome" action="aufstocken" outcome="completed"/></extensionElements><incoming>f_gw_nk2_join__sd_auf_ok</incoming><outgoing>f_sd_auf_ok__e_auf</outgoing></sendTask>
    <endEvent id="e_auf" name="Aufgestockt"><incoming>f_sd_auf_ok__e_auf</incoming></endEvent>
    <startEvent id="s_senken" name="Senken angefragt"><documentation>Aktion senken (change): Das Formular lz-vertrag-senken liefert die Mengen danach (neuE3, neuE5, neuF3; leer heisst unverändert).</documentation><outgoing>f_s_senken__ca_lesen</outgoing><messageEventDefinition messageRef="m_senken"/></startEvent>
    <callActivity id="ca_lesen" name="Vertrag lesen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "lesen", ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/senken"}' target="auftrag"/><zeebe:output source="=antwort" target="stand"/></zeebe:ioMapping></extensionElements><incoming>f_s_senken__ca_lesen</incoming><outgoing>f_ca_lesen__sc_senken</outgoing></callActivity>
    <scriptTask id="sc_senken" name="Belegung prüfen"><documentation>Pro SKU die neue Menge gegen belegt. Reicht sie nicht, kommen die Bezüge dieser SKU als Auswahl in die Aufgabe des Integrations Managers (Position im Shop, SKU, seit wann); Namen kennt das Vertragsbuch nicht.</documentation><extensionElements><zeebe:script expression='={alt: stand.stand.skus, neu: context(for s in alt return {key: s.sku, value: if get value({E3: neuE3, E5: neuE5, F3: neuF3}, s.sku) = null or get value({E3: neuE3, E5: neuE5, F3: neuF3}, s.sku) = "" then s.menge else number(get value({E3: neuE3, E5: neuE5, F3: neuF3}, s.sku))}), zuViel: for s in alt return {sku: s.sku, anzahl: s.belegt - get value(neu, s.sku)}, mangel: zuViel[anzahl &gt; 0], reicht: count(mangel) = 0, optionen: for z in stand.bezuege[bis = null and list contains(for m in mangel return m.sku, sku)] return {value: z.id, label: z.sku + " · Position " + z.id + " · seit " + z.von}, text: string join(for m in mangel return m.sku + ": " + string(m.anzahl) + " Personen müssen abgeben", "; ")}' resultVariable="senkung"/></extensionElements><incoming>f_ca_lesen__sc_senken</incoming><outgoing>f_sc_senken__gw_senk</outgoing></scriptTask>
    <exclusiveGateway id="gw_senk" name="Neue Menge ≥ belegt?" default="f_gw_senk__ut_personen"><incoming>f_sc_senken__gw_senk</incoming><outgoing>f_gw_senk__gw_senk_join</outgoing><outgoing>f_gw_senk__ut_personen</outgoing></exclusiveGateway>
    <userTask id="ut_personen" name="Personen wählen, die abgeben"><documentation>Der Integrations Manager des Vertrags wählt aus den Bezügen die Positionen, deren Lizenz zurückgegeben wird (Feld abgeben, eine Liste von Positionen). Der Integrations Manager ist die Person, für die der Vertrag bestellt wurde (recipient, ein Atlas-Konto); ein Operator kann die Aufgabe übernehmen.</documentation><extensionElements><zeebe:assignmentDefinition assignee="=stand.integrationsManager"/><zeebe:formDefinition formId="lz-vertrag-personen"/><zeebe:ioMapping><zeebe:input source="=senkung.text" target="senkungText"/><zeebe:input source="=senkung.optionen" target="senkungOptionen"/></zeebe:ioMapping></extensionElements><incoming>f_gw_senk__ut_personen</incoming><outgoing>f_ut_personen__sh_rueckgabe</outgoing></userTask>
    <sendTask id="sh_rueckgabe" name="Lizenzen zurückgeben"><documentation>Für jede gewählte Position ein Shop-Befehl deprovision an das Produkt m365-lizenz: Die Rückgabe läuft über P4 (lizenz.bpmn), das die Lizenz entzieht und die Belegung im Vertragsbuch freigibt. Mehrfach-Instanz über abgeben.</documentation><extensionElements><atlas:shopTask mode="command" product="m365-lizenz" action="deprovision" order="=substring before(position, &quot;/&quot;)" position="=substring after(position, &quot;/&quot;)" retries="3"/></extensionElements><incoming>f_ut_personen__sh_rueckgabe</incoming><outgoing>f_sh_rueckgabe__gw_senk_join</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=abgeben" inputElement="position"/></extensionElements></multiInstanceLoopCharacteristics></sendTask>
    <exclusiveGateway id="gw_senk_join"><incoming>f_gw_senk__gw_senk_join</incoming><incoming>f_sh_rueckgabe__gw_senk_join</incoming><outgoing>f_gw_senk_join__ca_senken</outgoing></exclusiveGateway>
    <callActivity id="ca_senken" name="Vertragsmenge senken"><documentation>Buchung mengen: die neuen Mengen. Wirkt sofort. Vorschlag aus dem Konzept: im EA erst am Jahrestag (P7) reduzieren; das bleibt Sache des Chefs.</documentation><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "mengen", mengen: senkung.neu, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/senken"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_senk_join__ca_senken</incoming><outgoing>f_ca_senken__sd_senk</outgoing></callActivity>
    <sendTask id="sd_senk" name="Senkung melden"><extensionElements><atlas:shopTask mode="outcome" action="senken" outcome="completed"/></extensionElements><incoming>f_ca_senken__sd_senk</incoming><outgoing>f_sd_senk__e_senk</outgoing></sendTask>
    <endEvent id="e_senk" name="Gesenkt"><incoming>f_sd_senk__e_senk</incoming></endEvent>
    <startEvent id="s_verl" name="Verlängerung angefragt"><documentation>Aktion verlaengern (change): Das Formular lz-vertrag-verlaengern liefert neuesEnde.</documentation><outgoing>f_s_verl__gw_verl</outgoing><messageEventDefinition messageRef="m_verlaengern"/></startEvent>
    <exclusiveGateway id="gw_verl" name="Ende zulässig?" default="f_gw_verl__sd_verl_abl"><documentation>Zulässig ist ein Ende ab heute und nicht nach dem Ende der EA-Laufzeit (EA_ENDE). Eine Bedingung statt einer Tabelle: Die Regel hat nur diese zwei Grenzen.</documentation><incoming>f_s_verl__gw_verl</incoming><outgoing>f_gw_verl__ca_ende</outgoing><outgoing>f_gw_verl__sd_verl_abl</outgoing></exclusiveGateway>
    <callActivity id="ca_ende" name="Ende setzen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "ende", ende: neuesEnde, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/verlaengern"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_verl__ca_ende</incoming><outgoing>f_ca_ende__sd_verl</outgoing></callActivity>
    <sendTask id="sd_verl" name="Verlängerung melden"><extensionElements><atlas:shopTask mode="outcome" action="verlaengern" outcome="completed"/></extensionElements><incoming>f_ca_ende__sd_verl</incoming><outgoing>f_sd_verl__e_verl</outgoing></sendTask>
    <endEvent id="e_verl" name="Verlängert"><incoming>f_sd_verl__e_verl</incoming></endEvent>
    <sendTask id="sd_verl_abl" name="Ablehnung melden"><documentation>Das neue Ende liegt nach dem Ende der EA-Laufzeit oder in der Vergangenheit.</documentation><extensionElements><atlas:shopTask mode="outcome" action="verlaengern" outcome="rejected"/></extensionElements><incoming>f_gw_verl__sd_verl_abl</incoming><outgoing>f_sd_verl_abl__e_verl_abl</outgoing></sendTask>
    <endEvent id="e_verl_abl" name="Abgelehnt"><incoming>f_sd_verl_abl__e_verl_abl</incoming></endEvent>
    <startEvent id="s_beenden" name="Beenden angefragt"><documentation>Operation deprovision: Rückgabe der Position durch den Integrations Manager oder den Betrieb (die Tenant-verantwortliche Person).</documentation><outgoing>f_s_beenden__ca_lesen3</outgoing><messageEventDefinition messageRef="m_beenden"/></startEvent>
    <callActivity id="ca_lesen3" name="Vertrag lesen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "lesen", ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/beenden"}' target="auftrag"/><zeebe:output source="=antwort" target="stand"/></zeebe:ioMapping></extensionElements><incoming>f_s_beenden__ca_lesen3</incoming><outgoing>f_ca_lesen3__sc_betroffen</outgoing></callActivity>
    <scriptTask id="sc_betroffen" name="Betroffene zählen"><documentation>Die Positionen mit einer Lizenz aus diesem Vertrag, die über den Shop vergeben wurde (mit orderId), und ihre Zahl für die Bestätigung.</documentation><extensionElements><zeebe:script expression='={positionen: for z in stand.bezuege[bis = null and orderId != null] return z.orderId + "/" + z.positionId, ohneShop: count(stand.bezuege[bis = null and orderId = null]), anzahl: count(stand.bezuege[bis = null])}' resultVariable="betroffen"/></extensionElements><incoming>f_ca_lesen3__sc_betroffen</incoming><outgoing>f_sc_betroffen__ut_beenden</outgoing></scriptTask>
    <userTask id="ut_beenden" name="Beenden bestätigen"><documentation>Die Tenant-verantwortliche Person sieht die Zahl der betroffenen Personen und bestätigt oder weist zurück. Die letzte Verrechnung (P6) umfasst den Monat des Endes.</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="=application.GRUPPE_TENANT"/><zeebe:formDefinition formId="lz-vertrag-beenden"/></extensionElements><incoming>f_sc_betroffen__ut_beenden</incoming><outgoing>f_ut_beenden__gw_be</outgoing></userTask>
    <exclusiveGateway id="gw_be" name="Beenden?" default="f_gw_be__st_be_failed"><incoming>f_ut_beenden__gw_be</incoming><outgoing>f_gw_be__sh_alle</outgoing><outgoing>f_gw_be__st_be_failed</outgoing></exclusiveGateway>
    <sendTask id="sh_alle" name="Alle Lizenzen zurückgeben"><documentation>Shop-Befehl deprovision an m365-lizenz für jede Position: Die Rückgabe über P4 entzieht die Lizenz und gibt die Belegung frei. Lizenzen aus der Übernahme des Bestands (P9) haben keine Position und bleiben; das Lizenzmanagement entzieht sie von Hand.</documentation><extensionElements><atlas:shopTask mode="command" product="m365-lizenz" action="deprovision" order="=substring before(position, &quot;/&quot;)" position="=substring after(position, &quot;/&quot;)" retries="3"/></extensionElements><incoming>f_gw_be__sh_alle</incoming><outgoing>f_sh_alle__ca_beenden</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=betroffen.positionen" inputElement="position"/></extensionElements></multiInstanceLoopCharacteristics></sendTask>
    <callActivity id="ca_beenden" name="Vertrag beenden"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "beenden", ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/beenden"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_sh_alle__ca_beenden</incoming><outgoing>f_ca_beenden__st_returned</outgoing></callActivity>
    <serviceTask id="st_returned" name="Rückgabe melden"><documentation>status returned: Der Vertrag ist beendet und nicht mehr im Bestand.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + (if positionId = null then itemId else positionId)' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="returned"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_ca_beenden__st_returned</incoming><outgoing>f_st_returned__e_beendet</outgoing></serviceTask>
    <endEvent id="e_beendet" name="Vertrag beendet"><incoming>f_st_returned__e_beendet</incoming></endEvent>
    <serviceTask id="st_be_failed" name="Zurückweisung melden"><documentation>Die Tenant-verantwortliche Person hat das Beenden zurückgewiesen: status failed, die Begründung steht in der Instanz; der Vertrag bleibt.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/orders/" + orderId + "/lines/" + (if positionId = null then itemId else positionId)' authType="bearer" authSecret="atlas"/><zeebe:ioMapping><zeebe:input source='="failed"' target="status"/></zeebe:ioMapping></extensionElements><incoming>f_gw_be__st_be_failed</incoming><outgoing>f_st_be_failed__e_be_failed</outgoing></serviceTask>
    <endEvent id="e_be_failed" name="Vertrag bleibt"><incoming>f_st_be_failed__e_be_failed</incoming></endEvent>
    <startEvent id="s_regel" name="Entzugsregel gemeldet"><documentation>Aktion entzugsregel (change): Das Formular lz-vertrag-entzugsregel liefert die Kennung der Entscheidung (decisionId), die der Integrations Manager des Kunden pflegt, oder LzEntzugStandard.</documentation><outgoing>f_s_regel__gw_std</outgoing><messageEventDefinition messageRef="m_regel"/></startEvent>
    <exclusiveGateway id="gw_std" name="Standardtabelle?" default="f_gw_std__st_regel_suchen"><incoming>f_s_regel__gw_std</incoming><outgoing>f_gw_std__gw_regel_join</outgoing><outgoing>f_gw_std__st_regel_suchen</outgoing></exclusiveGateway>
    <serviceTask id="st_regel_suchen" name="Tabelle suchen"><documentation>GET /api/v1/decision-deployments?decisionId=…: die deployten Versionen der Entscheidung; die aktuelle trägt current.</documentation><extensionElements><atlas:restConnector method="GET" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decision-deployments?decisionId=" + entzugsregelId' authType="bearer" authSecret="atlas" resultVariable="regelVersionen"/></extensionElements><incoming>f_gw_std__st_regel_suchen</incoming><outgoing>f_st_regel_suchen__st_regel_xml</outgoing></serviceTask>
    <serviceTask id="st_regel_xml" name="Tabelle laden"><documentation>GET /api/v1/decision-deployments/{key}/xml der aktuellen Version. Ohne deployte Version: Incident mit 404 (die Tabelle ist zuerst zu deployen).</documentation><extensionElements><atlas:restConnector method="GET" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decision-deployments/" + string(regelVersionen[current = true][1].key) + "/xml"' authType="bearer" authSecret="atlas" resultVariable="regelXml"/></extensionElements><incoming>f_st_regel_suchen__st_regel_xml</incoming><outgoing>f_st_regel_xml__st_regel_test</outgoing></serviceTask>
    <serviceTask id="st_regel_test" name="Tabelle prüfen"><documentation>POST /api/v1/decisions/evaluate mit Testdaten einer Person (extern, seit 400 Tagen bezogen, seit 90 Tagen nicht angemeldet). Die Antwort muss aktion entziehen oder behalten liefern, bei entziehen eine Priorität. Braucht am Secret atlas die Rolle modeler.</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decisions/evaluate"' authType="bearer" authSecret="atlas" resultVariable="regelTest"/><zeebe:ioMapping><zeebe:input source="=regelXml" target="xml"/><zeebe:input source="=entzugsregelId" target="decisionId"/><zeebe:input source='={organisationseinheit: "Test", funktion: "Test", bezogenSeit: "2025-01-01", tageSeitBezug: 400, extern: true, sku: "E5", tageSeitAnmeldung: 90}' target="inputs"/></zeebe:ioMapping></extensionElements><incoming>f_st_regel_xml__st_regel_test</incoming><outgoing>f_st_regel_test__gw_regel_ok</outgoing></serviceTask>
    <exclusiveGateway id="gw_regel_ok" name="Tabelle gültig?" default="f_gw_regel_ok__sd_regel_abl"><incoming>f_st_regel_test__gw_regel_ok</incoming><outgoing>f_gw_regel_ok__gw_regel_join</outgoing><outgoing>f_gw_regel_ok__sd_regel_abl</outgoing></exclusiveGateway>
    <sendTask id="sd_regel_abl" name="Ablehnung melden"><documentation>Die Tabelle kompiliert nicht oder liefert weder entziehen mit Priorität noch behalten; der Fehler der Prüfung steht in regelTest.</documentation><extensionElements><atlas:shopTask mode="outcome" action="entzugsregel" outcome="rejected"/></extensionElements><incoming>f_gw_regel_ok__sd_regel_abl</incoming><outgoing>f_sd_regel_abl__e_regel_abl</outgoing></sendTask>
    <endEvent id="e_regel_abl" name="Abgelehnt"><incoming>f_sd_regel_abl__e_regel_abl</incoming></endEvent>
    <exclusiveGateway id="gw_regel_join"><incoming>f_gw_std__gw_regel_join</incoming><incoming>f_gw_regel_ok__gw_regel_join</incoming><outgoing>f_gw_regel_join__ca_regel</outgoing></exclusiveGateway>
    <callActivity id="ca_regel" name="Verweis im Vertrag setzen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "setzen", werte: {entzugsregel: entzugsregelId}, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/entzugsregel"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_regel_join__ca_regel</incoming><outgoing>f_ca_regel__sd_regel</outgoing></callActivity>
    <sendTask id="sd_regel" name="Änderung melden"><extensionElements><atlas:shopTask mode="outcome" action="entzugsregel" outcome="completed"/></extensionElements><incoming>f_ca_regel__sd_regel</incoming><outgoing>f_sd_regel__e_regel</outgoing></sendTask>
    <endEvent id="e_regel" name="Regel gesetzt"><incoming>f_sd_regel__e_regel</incoming></endEvent>
    <startEvent id="s_form" name="Verrechnung geändert"><documentation>Aktion verrechnung (change): Das Formular lz-vertrag-verrechnung liefert exportForm (csv, mail, sap) und exportAn. Gilt ab dem nächsten Monat, weil die Verrechnung den Vormonat am Monatsanfang erstellt.</documentation><outgoing>f_s_form__ca_form</outgoing><messageEventDefinition messageRef="m_form"/></startEvent>
    <callActivity id="ca_form" name="Feld setzen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="LV-" + orderId' target="buchId"/><zeebe:input source='={aktion: "setzen", werte: {exportForm: exportForm, exportAn: exportAn}, ref: orderId + "/" + (if positionId = null then itemId else positionId) + "/verrechnung"}' target="auftrag"/><zeebe:output source="=antwort" target="buchung"/></zeebe:ioMapping></extensionElements><incoming>f_s_form__ca_form</incoming><outgoing>f_ca_form__sd_form</outgoing></callActivity>
    <sendTask id="sd_form" name="Änderung melden"><extensionElements><atlas:shopTask mode="outcome" action="verrechnung" outcome="completed"/></extensionElements><incoming>f_ca_form__sd_form</incoming><outgoing>f_sd_form__e_form</outgoing></sendTask>
    <endEvent id="e_form" name="Form geändert"><incoming>f_sd_form__e_form</incoming></endEvent>
    <dataObjectReference id="dor_done" name="Katalogposition" dataObjectRef="do_katalogposition"><dataState name="Erledigt"/></dataObjectReference>
    <sequenceFlow id="f_s_bestellt__gw_angaben" sourceRef="s_bestellt" targetRef="gw_angaben"/>
    <sequenceFlow id="f_gw_angaben__sc_antrag" sourceRef="gw_angaben" targetRef="sc_antrag"/>
    <sequenceFlow id="f_sc_antrag__br_psp" sourceRef="sc_antrag" targetRef="br_psp"/>
    <sequenceFlow id="f_br_psp__gw_psp" sourceRef="br_psp" targetRef="gw_psp"/>
    <sequenceFlow id="f_gw_psp__ca_schaetzen" sourceRef="gw_psp" targetRef="ca_schaetzen" name="ja"><conditionExpression>=pspPruefung.gueltig = true</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_psp__ut_korrigieren" sourceRef="gw_psp" targetRef="ut_korrigieren" name="nein"/>
    <sequenceFlow id="f_ut_korrigieren__gw_angaben" sourceRef="ut_korrigieren" targetRef="gw_angaben"/>
    <sequenceFlow id="f_tm_korrektur__st_korr_failed" sourceRef="tm_korrektur" targetRef="st_korr_failed"/>
    <sequenceFlow id="f_st_korr_failed__e_korr" sourceRef="st_korr_failed" targetRef="e_korr"/>
    <sequenceFlow id="f_ca_schaetzen__sc_schaetzung" sourceRef="ca_schaetzen" targetRef="sc_schaetzung"/>
    <sequenceFlow id="f_sc_schaetzung__ut_genehmigen" sourceRef="sc_schaetzung" targetRef="ut_genehmigen"/>
