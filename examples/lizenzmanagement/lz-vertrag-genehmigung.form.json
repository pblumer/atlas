      "properties": {
        "personal": "false"
      }
    },
    {
      "key": "mengeE5",
      "type": "textfield",
      "label": "Menge E5 · Quantity E5",
      "validate": {
        "pattern": "^[0-9]{0,6}$"
      },
      "properties": {
        "personal": "false"
      }
    },
    {
      "key": "mengeF3",
      "type": "textfield",
      "label": "Menge F3 · Quantity F3",
      "validate": {
        "pattern": "^[0-9]{0,6}$"
      },
      "properties": {
        "personal": "false"
      }
