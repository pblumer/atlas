<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_lz_karenz_vertrag" targetNamespace="http://atlas/beispiel/lizenzmanagement">
  <itemDefinition id="item_Lizenzbezug" structureRef="Lizenzbezug"/>
  <itemDefinition id="item_Lizenzvertrag" structureRef="Lizenzvertrag"/>
  <process id="proc_lz_karenz_vertrag" name="Lizenzmanagement: Entzug je Vertrag" isExecutable="true">
    <documentation>P8 Tasks 3 bis 5 für einen Vertrag, aufgerufen von proc_lz_karenz mit nummer, reduktion (art senken oder beenden, mengen, abgeben), entzugsregel und jahrestag. Ergebnis entzug = {nummer, positionen, fehlend, behalten}.

- Die letzte Anmeldung und die Merkmale jeder Person liest Entra get-user mit der Objekt-ID aus dem Bezug (select department, jobTitle, userType, companyName, signInActivity; signInActivity braucht AuditLog.Read.All und Entra ID P1). Das Ergebnis nennt niemanden und ist deshalb nicht als Personendatum deklariert: Die Regel und die Reihenfolge müssen es lesen.
- Die Entzugsregel ist die Tabelle des Vertrags: LzEntzugStandard als Business Rule Task, oder die Tabelle des Kunden. Eine Business Rule Task nennt ihre Entscheidung fest im Modell; eine Tabelle, die der Vertrag erst zur Laufzeit nennt, wertet Atlas deshalb über die API aus (die aktuelle Version laden, dann POST /api/v1/decisions/evaluate je Person; das Secret atlas braucht dafür die Rolle modeler). Ausgabe: aktion (entziehen oder behalten) und prioritaet.
- Reihenfolge: die vom Kunden genannten Positionen, dann Priorität 1, 2 …, innerhalb einer Priorität zuletzt bezogen zuerst, bis die neue Menge erreicht ist. Wer «behalten» trägt, wird nie gewählt; reicht der Rest nicht, ist fehlend &gt; 0.
- Zuletzt setzt das Vertragsbuch die neuen Mengen (senken) bzw. das Ende auf den Jahrestag (beenden). Ab dem Jahrestag verrechnet P6 nur noch die Lizenzen des neuen Vertrags: Ein Bezug, der in der Karenz noch läuft, wird bis zu seinem Ende verrechnet (Vereinfachung gegenüber dem Konzept).</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/></atlas:constants></extensionElements>
    <dataObject id="do_lizenzbezug" name="Lizenzbezug" itemSubjectRef="item_Lizenzbezug"/>
    <dataObject id="do_lizenzvertrag" name="Lizenzvertrag" itemSubjectRef="item_Lizenzvertrag"/>
    <startEvent id="s" name="Vertrag zurückführen"><outgoing>f_s__ca_lesen</outgoing></startEvent>
    <callActivity id="ca_lesen" name="Vertrag lesen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source="=nummer" target="buchId"/><zeebe:input source='={aktion: "lesen", ref: "karenz/" + jahrestag}' target="auftrag"/><zeebe:output source="=antwort" target="buch"/></zeebe:ioMapping></extensionElements><incoming>f_s__ca_lesen</incoming><outgoing>f_ca_lesen__sc_personen</outgoing></callActivity>
    <scriptTask id="sc_personen" name="Personen des Vertrags"><extensionElements><zeebe:script expression="=for z in buch.bezuege[bis = null and konto != null] return {position: z.id, sku: z.sku, konto: z.konto, von: z.von}" resultVariable="kandidaten"/></extensionElements><incoming>f_ca_lesen__sc_personen</incoming><outgoing>f_sc_personen__st_anmeldung</outgoing></scriptTask>
    <serviceTask id="st_anmeldung" name="Letzte Anmeldung lesen"><documentation>Entra get-user je Person (Mehrfach-Instanz): Merkmale und letzte Anmeldung.</documentation><extensionElements><atlas:entraConnector connector="ucc_entra" operation="get-user" userId="=k.konto" select="id,department,jobTitle,userType,companyName,signInActivity" resultVariable="merkmale"/></extensionElements><incoming>f_sc_personen__st_anmeldung</incoming><outgoing>f_st_anmeldung__gw_regel</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=kandidaten" inputElement="k" outputCollection="personen" outputElement='=context merge(k, {organisationseinheit: merkmale.department, funktion: merkmale.jobTitle, extern: merkmale.userType = "Guest", tageSeitBezug: (today() - date(k.von)).days, tageSeitAnmeldung: if merkmale.signInActivity = null or merkmale.signInActivity.lastSuccessfulSignInDateTime = null then null else (today() - date(substring(merkmale.signInActivity.lastSuccessfulSignInDateTime, 1, 10))).days})'/></extensionElements></multiInstanceLoopCharacteristics></serviceTask>
    <exclusiveGateway id="gw_regel" name="Eigene Tabelle?" default="f_gw_regel__st_suchen"><incoming>f_st_anmeldung__gw_regel</incoming><outgoing>f_gw_regel__br_standard</outgoing><outgoing>f_gw_regel__st_suchen</outgoing></exclusiveGateway>
    <businessRuleTask id="br_standard" name="Entzugsregel anwenden"><documentation>LzEntzugStandard je Person (Mehrfach-Instanz).</documentation><extensionElements><zeebe:calledDecision decisionId="LzEntzugStandard" resultVariable="regel"/><zeebe:ioMapping><zeebe:input source="=x.organisationseinheit" target="organisationseinheit"/><zeebe:input source="=x.funktion" target="funktion"/><zeebe:input source="=x.von" target="bezogenSeit"/><zeebe:input source="=x.tageSeitBezug" target="tageSeitBezug"/><zeebe:input source="=x.extern" target="extern"/><zeebe:input source="=x.sku" target="sku"/><zeebe:input source="=x.tageSeitAnmeldung" target="tageSeitAnmeldung"/></zeebe:ioMapping></extensionElements><incoming>f_gw_regel__br_standard</incoming><outgoing>f_br_standard__gw_regel_join</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=personen" inputElement="x" outputCollection="regeln" outputElement="=regel"/></extensionElements></multiInstanceLoopCharacteristics></businessRuleTask>
    <serviceTask id="st_suchen" name="Tabelle suchen"><extensionElements><atlas:restConnector method="GET" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decision-deployments?decisionId=" + entzugsregel' authType="bearer" authSecret="atlas" resultVariable="regelVersionen"/></extensionElements><incoming>f_gw_regel__st_suchen</incoming><outgoing>f_st_suchen__st_xml</outgoing></serviceTask>
    <serviceTask id="st_xml" name="Tabelle laden"><extensionElements><atlas:restConnector method="GET" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decision-deployments/" + string(regelVersionen[current = true][1].key) + "/xml"' authType="bearer" authSecret="atlas" resultVariable="regelXml"/></extensionElements><incoming>f_st_suchen__st_xml</incoming><outgoing>f_st_xml__st_eval</outgoing></serviceTask>
    <serviceTask id="st_eval" name="Tabelle des Kunden anwenden"><documentation>POST /api/v1/decisions/evaluate je Person (Mehrfach-Instanz).</documentation><extensionElements><atlas:restConnector method="POST" url='=(if atlasApiBase = null then application.ATLAS_API_BASE else atlasApiBase) + "/api/v1/decisions/evaluate"' authType="bearer" authSecret="atlas" resultVariable="versuch"/><zeebe:ioMapping><zeebe:input source="=regelXml" target="xml"/><zeebe:input source="=entzugsregel" target="decisionId"/><zeebe:input source="={organisationseinheit: x.organisationseinheit, funktion: x.funktion, bezogenSeit: x.von, tageSeitBezug: x.tageSeitBezug, extern: x.extern, sku: x.sku, tageSeitAnmeldung: x.tageSeitAnmeldung}" target="inputs"/></zeebe:ioMapping></extensionElements><incoming>f_st_xml__st_eval</incoming><outgoing>f_st_eval__gw_regel_join</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=personen" inputElement="x" outputCollection="regeln" outputElement='=if versuch.ok = true then versuch.outputs else {aktion: "behalten", prioritaet: null}'/></extensionElements></multiInstanceLoopCharacteristics></serviceTask>
    <exclusiveGateway id="gw_regel_join"><incoming>f_br_standard__gw_regel_join</incoming><incoming>f_st_eval__gw_regel_join</incoming><outgoing>f_gw_regel_join__sc_reihe</outgoing></exclusiveGateway>
    <scriptTask id="sc_reihe" name="Reihenfolge bilden"><documentation>Genannte Positionen zuerst, dann nach Priorität, innerhalb einer Priorität zuletzt bezogen zuerst, bis die Menge erreicht ist. Eine Tabelle, die für eine Person nicht auswertbar ist, zählt als behalten: kein Entzug ohne Regel.</documentation><extensionElements><zeebe:script expression='={heute: today(), nr: (for n in reduktion.abgeben return n)[item != null], offen: buch.bezuege[bis = null], skus: if reduktion.art = "beenden" then distinct values(for z in offen return z.sku) else (for e in get entries(reduktion.mengen) return if e.value = null then null else e.key)[item != null], bedarf: for s in skus return {sku: s, anzahl: count(offen[sku = s]) - (if reduktion.art = "beenden" or get value(reduktion.mengen, s) = null then 0 else get value(reduktion.mengen, s))}, bewertet: for i in 1..count(personen) return if count(personen) = 0 then null else context merge(personen[i], {aktion: regeln[i].aktion, prioritaet: regeln[i].prioritaet}), liste: bewertet[item != null], proSku: for b in bedarf[anzahl &gt; 0] return {sku: b.sku, anzahl: b.anzahl, genannt: liste[sku = b.sku and list contains(nr, position)], rest: sort(liste[sku = b.sku and not(list contains(nr, position)) and aktion = "entziehen"], function(x, y) if x.prioritaet != y.prioritaet then x.prioritaet &lt; y.prioritaet else x.von &gt; y.von), reihe: concatenate(genannt, rest), wahl: if count(reihe) &lt;= anzahl then reihe else sublist(reihe, 1, anzahl), fehlend: anzahl - count(wahl), behalten: for x in liste[sku = b.sku and aktion = "behalten"] return x.position}, neu: {nummer: nummer, positionen: flatten(for s in proSku return for w in s.wahl return w.position)[item != null], fehlend: sum(concatenate([0], for s in proSku return if s.fehlend &gt; 0 then s.fehlend else 0)), behalten: flatten(for s in proSku return s.behalten)}}.neu' resultVariable="entzug"/></extensionElements><incoming>f_gw_regel_join__sc_reihe</incoming><outgoing>f_sc_reihe__ca_mengen</outgoing></scriptTask>
    <callActivity id="ca_mengen" name="Vertrag anpassen"><documentation>senken: die neuen Mengen; beenden: das Ende auf den Jahrestag.</documentation><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source="=nummer" target="buchId"/><zeebe:input source='=if reduktion.art = "beenden" then {aktion: "ende", ende: jahrestag, ref: "karenz/" + jahrestag} else {aktion: "mengen", mengen: context((get entries(reduktion.mengen))[value != null]), ref: "karenz/" + jahrestag}' target="auftrag"/><zeebe:output source="=antwort" target="angepasst"/></zeebe:ioMapping></extensionElements><incoming>f_sc_reihe__ca_mengen</incoming><outgoing>f_ca_mengen__e</outgoing></callActivity>
    <endEvent id="e" name="Entzug bestimmt"><incoming>f_ca_mengen__e</incoming></endEvent>
    <sequenceFlow id="f_s__ca_lesen" sourceRef="s" targetRef="ca_lesen"/>
    <sequenceFlow id="f_ca_lesen__sc_personen" sourceRef="ca_lesen" targetRef="sc_personen"/>
    <sequenceFlow id="f_sc_personen__st_anmeldung" sourceRef="sc_personen" targetRef="st_anmeldung"/>
    <sequenceFlow id="f_st_anmeldung__gw_regel" sourceRef="st_anmeldung" targetRef="gw_regel"/>
    <sequenceFlow id="f_gw_regel__br_standard" sourceRef="gw_regel" targetRef="br_standard" name="Standard"><conditionExpression>=entzugsregel = null or entzugsregel = "" or entzugsregel = "LzEntzugStandard"</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_regel__st_suchen" sourceRef="gw_regel" targetRef="st_suchen" name="eigene"/>
    <sequenceFlow id="f_br_standard__gw_regel_join" sourceRef="br_standard" targetRef="gw_regel_join"/>
    <sequenceFlow id="f_st_suchen__st_xml" sourceRef="st_suchen" targetRef="st_xml"/>
    <sequenceFlow id="f_st_xml__st_eval" sourceRef="st_xml" targetRef="st_eval"/>
    <sequenceFlow id="f_st_eval__gw_regel_join" sourceRef="st_eval" targetRef="gw_regel_join"/>
    <sequenceFlow id="f_gw_regel_join__sc_reihe" sourceRef="gw_regel_join" targetRef="sc_reihe"/>
    <sequenceFlow id="f_sc_reihe__ca_mengen" sourceRef="sc_reihe" targetRef="ca_mengen"/>
    <sequenceFlow id="f_ca_mengen__e" sourceRef="ca_mengen" targetRef="e"/>
  </process>
  <bpmndi:BPMNDiagram id="proc_lz_karenz_vertrag_diagram">
    <bpmndi:BPMNPlane id="proc_lz_karenz_vertrag_plane" bpmnElement="proc_lz_karenz_vertrag">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><omgdc:Bounds x="102" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="80" y="142" width="81" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca_lesen_di" bpmnElement="ca_lesen"><omgdc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_personen_di" bpmnElement="sc_personen"><omgdc:Bounds x="410" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_anmeldung_di" bpmnElement="st_anmeldung"><omgdc:Bounds x="580" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_regel_di" bpmnElement="gw_regel"><omgdc:Bounds x="775" y="95" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="750" y="77" width="100" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="br_standard_di" bpmnElement="br_standard"><omgdc:Bounds x="920" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_suchen_di" bpmnElement="st_suchen"><omgdc:Bounds x="920" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_xml_di" bpmnElement="st_xml"><omgdc:Bounds x="1090" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_eval_di" bpmnElement="st_eval"><omgdc:Bounds x="1260" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_regel_join_di" bpmnElement="gw_regel_join"><omgdc:Bounds x="1455" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_reihe_di" bpmnElement="sc_reihe"><omgdc:Bounds x="1600" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca_mengen_di" bpmnElement="ca_mengen"><omgdc:Bounds x="1770" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><omgdc:Bounds x="1972" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1940" y="142" width="100" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_s__ca_lesen_di" bpmnElement="f_s__ca_lesen"><omgdi:waypoint x="138" y="120"/><omgdi:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_ca_lesen__sc_personen_di" bpmnElement="f_ca_lesen__sc_personen"><omgdi:waypoint x="340" y="120"/><omgdi:waypoint x="410" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_personen__st_anmeldung_di" bpmnElement="f_sc_personen__st_anmeldung"><omgdi:waypoint x="510" y="120"/><omgdi:waypoint x="580" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_st_anmeldung__gw_regel_di" bpmnElement="f_st_anmeldung__gw_regel"><omgdi:waypoint x="680" y="120"/><omgdi:waypoint x="775" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_regel__br_standard_di" bpmnElement="f_gw_regel__br_standard"><omgdi:waypoint x="825" y="120"/><omgdi:waypoint x="920" y="120"/><bpmndi:BPMNLabel><omgdc:Bounds x="831" y="102" width="56" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_regel__st_suchen_di" bpmnElement="f_gw_regel__st_suchen"><omgdi:waypoint x="800" y="145"/><omgdi:waypoint x="800" y="260"/><omgdi:waypoint x="920" y="260"/><bpmndi:BPMNLabel><omgdc:Bounds x="806" y="149" width="43" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_br_standard__gw_regel_join_di" bpmnElement="f_br_standard__gw_regel_join"><omgdi:waypoint x="1020" y="120"/><omgdi:waypoint x="1455" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_st_suchen__st_xml_di" bpmnElement="f_st_suchen__st_xml"><omgdi:waypoint x="1020" y="260"/><omgdi:waypoint x="1090" y="260"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_st_xml__st_eval_di" bpmnElement="f_st_xml__st_eval"><omgdi:waypoint x="1190" y="260"/><omgdi:waypoint x="1260" y="260"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_st_eval__gw_regel_join_di" bpmnElement="f_st_eval__gw_regel_join"><omgdi:waypoint x="1360" y="260"/><omgdi:waypoint x="1480" y="260"/><omgdi:waypoint x="1480" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_regel_join__sc_reihe_di" bpmnElement="f_gw_regel_join__sc_reihe"><omgdi:waypoint x="1505" y="120"/><omgdi:waypoint x="1600" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_reihe__ca_mengen_di" bpmnElement="f_sc_reihe__ca_mengen"><omgdi:waypoint x="1700" y="120"/><omgdi:waypoint x="1770" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_ca_mengen__e_di" bpmnElement="f_ca_mengen__e"><omgdi:waypoint x="1870" y="120"/><omgdi:waypoint x="1972" y="120"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
