          "name": "kunde",
          "type": "string",
          "multiplicity": "1"
        },
        {
          "name": "projekt",
          "type": "string",
          "multiplicity": "0..1"
        },
        {
          "name": "psp",
          "type": "string",
          "multiplicity": "1"
        },
        {
          "name": "mengen",
          "type": "string",
          "multiplicity": "1",
          "documentation": "Menge pro SKU (Kontext E3, E5, F3)."
