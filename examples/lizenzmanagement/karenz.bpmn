<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
             xmlns:atlas="http://atlas/schema/1.0"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             id="defs_proc_lz_karenz" targetNamespace="http://atlas/beispiel/lizenzmanagement">
  <message id="m_karenz" name="lz.karenz.start"/>
  <itemDefinition id="item_Lizenzbezug" structureRef="Lizenzbezug"/>
  <itemDefinition id="item_TenantKontingent" structureRef="TenantKontingent"/>
  <process id="proc_lz_karenz" name="Lizenzmanagement: Rückführung in der Abo-Karenz" isExecutable="true">
    <documentation>P8: Nach dem Jahrestag sind im Tenant mehr Lizenzen belegt, als im EA verlängert wurden. In den KARENZ_TAGE (90) der Abo-Karenz führt Atlas die Belegung pro SKU auf die neue Menge zurück, nach den Angaben der Kunden (P7) und ihren Entzugsregeln. Gestartet von P7 mit jahrestag und neueMengen.

- Fristen: Ende der Karenz = Jahrestag + KARENZ_TAGE; Entzug ENTZUG_VORLAUF_TAGE (Vorschlag 30) vor dem Ende; Kontrolle KONTROLLE_TAGE (14) vor dem Ende.
- Pro Vertrag mit einer Reduktion (gesenkt oder beendet) läuft proc_lz_karenz_vertrag: die genannten Positionen zuerst, dann die Entzugsregel des Vertrags, bis die neue Menge des Vertrags erreicht ist.
- Bleibt danach zu viel, weil zu viele Personen «behalten» tragen, klärt das Lizenzmanagement (Personen nennen oder aufstocken); sonst kein stiller Entzug.
- Die Integrations Manager erhalten die Liste und das Datum des Entzugs. Vereinfachung: Die einzelnen Personen erhalten keine eigene Mail; das Vertragsbuch kennt ihre Adressen nicht, und der Integrations Manager informiert sie.
- Am Datum des Entzugs gibt Atlas jede Position über das M365-Produkt zurück (Shop-Befehl deprovision; P4 entzieht und gibt die Belegung frei).
- 14 Tage vor dem Ende der Karenz kontrolliert Atlas belegt pro SKU gegen die neue Menge. Ist immer noch zu viel belegt, hält die Instanz am Gateway «Überbelegung gelöst?» mit einem Incident an: Das Lizenzmanagement kauft nach (P5) oder bestimmt weitere Personen, setzt die Variable ueberbelegungGeloest auf true und löst den Incident.</documentation>
    <extensionElements><atlas:constants><atlas:constant name="ATLAS_API_BASE" type="string" source="application" value="http://127.0.0.1:8080"/><atlas:constant name="GRUPPE_LIZENZMANAGEMENT" type="string" source="application" value="Lizenzmanagement"/><atlas:constant name="KARENZ_TAGE" type="number" source="application" value="90"/><atlas:constant name="ENTZUG_VORLAUF_TAGE" type="number" source="application" value="30"/><atlas:constant name="KONTROLLE_TAGE" type="number" source="application" value="14"/></atlas:constants></extensionElements>
    <dataObject id="do_lizenzbezug" name="Lizenzbezug" itemSubjectRef="item_Lizenzbezug"/>
    <dataObject id="do_tenantkontingent" name="TenantKontingent" itemSubjectRef="item_TenantKontingent"/>
    <startEvent id="s" name="Karenz beginnt"><outgoing>f_s__sc_fristen</outgoing><messageEventDefinition messageRef="m_karenz"/></startEvent>
    <scriptTask id="sc_fristen" name="Fristen bestimmen"><extensionElements><zeebe:script expression='={ende: date(jahrestag) + duration("P" + string(application.KARENZ_TAGE) + "D"), entzug: string(ende - duration("P" + string(application.ENTZUG_VORLAUF_TAGE) + "D")), kontrolle: string(ende - duration("P" + string(application.KONTROLLE_TAGE) + "D")), karenzEnde: string(ende)}' resultVariable="fristen"/></extensionElements><incoming>f_s__sc_fristen</incoming><outgoing>f_sc_fristen__ca_lesen</outgoing></scriptTask>
    <callActivity id="ca_lesen" name="Belegung lesen"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="TENANT"' target="buchId"/><zeebe:input source='={aktion: "lesen", tage: 1, ref: "karenz/" + jahrestag}' target="auftrag"/><zeebe:output source="=antwort" target="tenantStand"/></zeebe:ioMapping></extensionElements><incoming>f_sc_fristen__ca_lesen</incoming><outgoing>f_ca_lesen__sc_anteil</outgoing></callActivity>
    <scriptTask id="sc_anteil" name="Pro Vertrag Anteil bestimmen"><documentation>Zu viel belegt pro SKU (belegt laut Atlas − neue Menge) und die Verträge, die gesenkt oder beendet wurden.</documentation><extensionElements><zeebe:script expression="={zuViel: for n in neueMengen return {sku: n.sku, anzahl: (if count(tenantStand.summe[sku = n.sku]) = 0 then 0 else tenantStand.summe[sku = n.sku][1].belegtAtlas) - n.menge}, betroffen: tenantStand.vertraege[reduktion != null and reduktion.jahrestag = jahrestag]}" resultVariable="rueckfuehrung"/></extensionElements><incoming>f_ca_lesen__sc_anteil</incoming><outgoing>f_sc_anteil__ca_vertrag</outgoing></scriptTask>
    <callActivity id="ca_vertrag" name="Entzug je Vertrag bestimmen"><documentation>proc_lz_karenz_vertrag je betroffenem Vertrag (Mehrfach-Instanz, parallel).</documentation><extensionElements><zeebe:calledElement processId="proc_lz_karenz_vertrag" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source="=v.nummer" target="nummer"/><zeebe:input source="=v.reduktion" target="reduktion"/><zeebe:input source="=v.entzugsregel" target="entzugsregel"/><zeebe:input source="=jahrestag" target="jahrestag"/><zeebe:output source="=entzug" target="entzug"/></zeebe:ioMapping></extensionElements><incoming>f_sc_anteil__ca_vertrag</incoming><outgoing>f_ca_vertrag__sc_sammeln</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=rueckfuehrung.betroffen" inputElement="v" outputCollection="entzuege" outputElement="=entzug"/></extensionElements></multiInstanceLoopCharacteristics></callActivity>
    <scriptTask id="sc_sammeln" name="Genug frei?"><extensionElements><zeebe:script expression='={positionen: flatten(for e in entzuege return e.positionen), fehlend: sum(concatenate([0], for e in entzuege return e.fehlend)), text: string join(for e in entzuege return e.nummer + ": " + string(count(e.positionen)) + " Lizenzen, fehlend " + string(e.fehlend) + (if count(e.behalten) &gt; 0 then ", behalten: " + string join(e.behalten, ", ") else ""), "\n")}' resultVariable="entzugsplan"/></extensionElements><incoming>f_ca_vertrag__sc_sammeln</incoming><outgoing>f_sc_sammeln__gw_genug</outgoing></scriptTask>
    <exclusiveGateway id="gw_genug" name="Zu viele behalten?" default="f_gw_genug__ut_klaeren"><incoming>f_sc_sammeln__gw_genug</incoming><outgoing>f_gw_genug__gw_join</outgoing><outgoing>f_gw_genug__ut_klaeren</outgoing></exclusiveGateway>
    <userTask id="ut_klaeren" name="Rückführung klären"><documentation>Das Lizenzmanagement (GRUPPE_LIZENZMANAGEMENT, die Tenant-verantwortliche Person) bestimmt zusätzliche Positionen (Feld weiterePositionen) oder stockt die Verträge auf (P2).</documentation><extensionElements><zeebe:assignmentDefinition candidateGroups="=application.GRUPPE_LIZENZMANAGEMENT"/><zeebe:formDefinition formId="lz-rueckfuehrung"/><zeebe:ioMapping><zeebe:input source="=entzugsplan.text" target="entzugsplanText"/></zeebe:ioMapping></extensionElements><incoming>f_gw_genug__ut_klaeren</incoming><outgoing>f_ut_klaeren__sc_weitere</outgoing></userTask>
    <scriptTask id="sc_weitere" name="Positionen ergänzen"><extensionElements><zeebe:script expression='=context put(entzugsplan, "positionen", concatenate(entzugsplan.positionen, if weiterePositionen = null or weiterePositionen = "" then [] else split(weiterePositionen, "\\s*[,;\\n]\\s*")))' resultVariable="entzugsplan"/></extensionElements><incoming>f_ut_klaeren__sc_weitere</incoming><outgoing>f_sc_weitere__gw_join</outgoing></scriptTask>
    <exclusiveGateway id="gw_join"><incoming>f_gw_genug__gw_join</incoming><incoming>f_sc_weitere__gw_join</incoming><outgoing>f_gw_join__st_ankuendigen</outgoing></exclusiveGateway>
    <serviceTask id="st_ankuendigen" name="Betroffene ankündigen"><documentation>Mail an die Integrations Manager der betroffenen Verträge mit den Positionen und dem Datum des Entzugs.</documentation><extensionElements><atlas:mailConnector connector="mail" to='=string join(distinct values(for v in rueckfuehrung.betroffen return v.integrationsManager), ",")' subject='="Lizenzen enden am " + fristen.entzug' body='="Guten Tag\n\nIm EA wurden am Jahrestag " + jahrestag + " weniger Lizenzen verlängert. Am " + fristen.entzug + " entzieht Atlas die Lizenzen dieser Positionen:\n\n" + entzugsplan.text + "\n\nBitte informiert die betroffenen Personen.\n\nFreundliche Grüsse\nLizenzmanagement"'/></extensionElements><incoming>f_gw_join__st_ankuendigen</incoming><outgoing>f_st_ankuendigen__tm_entzug</outgoing></serviceTask>
    <intermediateCatchEvent id="tm_entzug" name="Datum des Entzugs abwarten"><incoming>f_st_ankuendigen__tm_entzug</incoming><outgoing>f_tm_entzug__sh_rueckgabe</outgoing><timerEventDefinition><timeDate>=date and time(fristen.entzug + "T06:00:00Z")</timeDate></timerEventDefinition></intermediateCatchEvent>
    <sendTask id="sh_rueckgabe" name="Lizenzen zurückgeben"><documentation>Shop-Befehl deprovision an m365-lizenz je Position (P4 Zurückgeben), parallel.</documentation><extensionElements><atlas:shopTask mode="command" product="m365-lizenz" action="deprovision" order="=substring before(position, &quot;/&quot;)" position="=substring after(position, &quot;/&quot;)" retries="3"/></extensionElements><incoming>f_tm_entzug__sh_rueckgabe</incoming><outgoing>f_sh_rueckgabe__tm_kontrolle</outgoing><multiInstanceLoopCharacteristics><extensionElements><zeebe:loopCharacteristics inputCollection="=entzugsplan.positionen" inputElement="position"/></extensionElements></multiInstanceLoopCharacteristics></sendTask>
    <intermediateCatchEvent id="tm_kontrolle" name="Kontrolle abwarten"><incoming>f_sh_rueckgabe__tm_kontrolle</incoming><outgoing>f_tm_kontrolle__ca_kontrolle</outgoing><timerEventDefinition><timeDate>=date and time(fristen.kontrolle + "T06:00:00Z")</timeDate></timerEventDefinition></intermediateCatchEvent>
    <callActivity id="ca_kontrolle" name="Belegung kontrollieren"><extensionElements><zeebe:calledElement processId="proc_lz_buchen" propagateAllParentVariables="false" propagateAllChildVariables="false"/><zeebe:ioMapping><zeebe:input source='="TENANT"' target="buchId"/><zeebe:input source='={aktion: "summe", ref: "karenz/" + jahrestag + "/kontrolle"}' target="auftrag"/><zeebe:output source="=antwort" target="kontrolle"/></zeebe:ioMapping></extensionElements><incoming>f_tm_kontrolle__ca_kontrolle</incoming><outgoing>f_ca_kontrolle__sc_kontrolle</outgoing></callActivity>
    <scriptTask id="sc_kontrolle" name="Überbelegung ermitteln"><documentation>Pro SKU belegt im Tenant (letzter Stand aus P5) gegen die neue Menge.</documentation><extensionElements><zeebe:script expression="=(for n in neueMengen return {sku: n.sku, menge: n.menge, belegt: if count(kontrolle.summe[sku = n.sku]) = 0 then 0 else kontrolle.summe[sku = n.sku][1].belegtTenant})[belegt != null and belegt &gt; menge]" resultVariable="ueberbelegung"/></extensionElements><incoming>f_ca_kontrolle__sc_kontrolle</incoming><outgoing>f_sc_kontrolle__gw_ok</outgoing></scriptTask>
    <exclusiveGateway id="gw_ok" name="Belegt ≤ neue Menge?" default="f_gw_ok__gw_inc"><incoming>f_sc_kontrolle__gw_ok</incoming><outgoing>f_gw_ok__e</outgoing><outgoing>f_gw_ok__gw_inc</outgoing></exclusiveGateway>
    <endEvent id="e" name="Zurückgeführt"><incoming>f_gw_ok__e</incoming></endEvent>
    <exclusiveGateway id="gw_inc" name="Überbelegung gelöst?"><documentation>Ein Fluss ohne Default: Solange ueberbelegungGeloest nicht true ist, steht die Instanz hier mit einem Incident (P8 Task 12). Wird nicht still aufgelöst.</documentation><incoming>f_gw_ok__gw_inc</incoming><outgoing>f_gw_inc__e_inc</outgoing></exclusiveGateway>
    <endEvent id="e_inc" name="Gelöst"><incoming>f_gw_inc__e_inc</incoming></endEvent>
    <sequenceFlow id="f_s__sc_fristen" sourceRef="s" targetRef="sc_fristen"/>
    <sequenceFlow id="f_sc_fristen__ca_lesen" sourceRef="sc_fristen" targetRef="ca_lesen"/>
    <sequenceFlow id="f_ca_lesen__sc_anteil" sourceRef="ca_lesen" targetRef="sc_anteil"/>
    <sequenceFlow id="f_sc_anteil__ca_vertrag" sourceRef="sc_anteil" targetRef="ca_vertrag"/>
    <sequenceFlow id="f_ca_vertrag__sc_sammeln" sourceRef="ca_vertrag" targetRef="sc_sammeln"/>
    <sequenceFlow id="f_sc_sammeln__gw_genug" sourceRef="sc_sammeln" targetRef="gw_genug"/>
    <sequenceFlow id="f_gw_genug__gw_join" sourceRef="gw_genug" targetRef="gw_join" name="nein"><conditionExpression>=entzugsplan.fehlend &lt;= 0</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_genug__ut_klaeren" sourceRef="gw_genug" targetRef="ut_klaeren" name="ja"/>
    <sequenceFlow id="f_ut_klaeren__sc_weitere" sourceRef="ut_klaeren" targetRef="sc_weitere"/>
    <sequenceFlow id="f_sc_weitere__gw_join" sourceRef="sc_weitere" targetRef="gw_join"/>
    <sequenceFlow id="f_gw_join__st_ankuendigen" sourceRef="gw_join" targetRef="st_ankuendigen"/>
    <sequenceFlow id="f_st_ankuendigen__tm_entzug" sourceRef="st_ankuendigen" targetRef="tm_entzug"/>
    <sequenceFlow id="f_tm_entzug__sh_rueckgabe" sourceRef="tm_entzug" targetRef="sh_rueckgabe"/>
    <sequenceFlow id="f_sh_rueckgabe__tm_kontrolle" sourceRef="sh_rueckgabe" targetRef="tm_kontrolle"/>
    <sequenceFlow id="f_tm_kontrolle__ca_kontrolle" sourceRef="tm_kontrolle" targetRef="ca_kontrolle"/>
    <sequenceFlow id="f_ca_kontrolle__sc_kontrolle" sourceRef="ca_kontrolle" targetRef="sc_kontrolle"/>
    <sequenceFlow id="f_sc_kontrolle__gw_ok" sourceRef="sc_kontrolle" targetRef="gw_ok"/>
    <sequenceFlow id="f_gw_ok__e" sourceRef="gw_ok" targetRef="e" name="ja"><conditionExpression>=count(ueberbelegung) = 0</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_gw_ok__gw_inc" sourceRef="gw_ok" targetRef="gw_inc" name="nein"/>
    <sequenceFlow id="f_gw_inc__e_inc" sourceRef="gw_inc" targetRef="e_inc" name="gelöst"><conditionExpression>=ueberbelegungGeloest = true</conditionExpression></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="proc_lz_karenz_diagram">
    <bpmndi:BPMNPlane id="proc_lz_karenz_plane" bpmnElement="proc_lz_karenz">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><omgdc:Bounds x="102" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="73" y="142" width="94" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_fristen_di" bpmnElement="sc_fristen"><omgdc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca_lesen_di" bpmnElement="ca_lesen"><omgdc:Bounds x="410" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_anteil_di" bpmnElement="sc_anteil"><omgdc:Bounds x="580" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca_vertrag_di" bpmnElement="ca_vertrag"><omgdc:Bounds x="750" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_sammeln_di" bpmnElement="sc_sammeln"><omgdc:Bounds x="920" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_genug_di" bpmnElement="gw_genug"><omgdc:Bounds x="1115" y="95" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="1109" y="63" width="62" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ut_klaeren_di" bpmnElement="ut_klaeren"><omgdc:Bounds x="1090" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_weitere_di" bpmnElement="sc_weitere"><omgdc:Bounds x="1260" y="220" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_join_di" bpmnElement="gw_join"><omgdc:Bounds x="1455" y="95" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_ankuendigen_di" bpmnElement="st_ankuendigen"><omgdc:Bounds x="1600" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tm_entzug_di" bpmnElement="tm_entzug"><omgdc:Bounds x="1802" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="1789" y="142" width="62" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sh_rueckgabe_di" bpmnElement="sh_rueckgabe"><omgdc:Bounds x="1940" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tm_kontrolle_di" bpmnElement="tm_kontrolle"><omgdc:Bounds x="2142" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="2129" y="142" width="62" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ca_kontrolle_di" bpmnElement="ca_kontrolle"><omgdc:Bounds x="2280" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sc_kontrolle_di" bpmnElement="sc_kontrolle"><omgdc:Bounds x="2450" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_ok_di" bpmnElement="gw_ok"><omgdc:Bounds x="2645" y="95" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="2627" y="63" width="87" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><omgdc:Bounds x="2822" y="102" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="2797" y="142" width="87" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_inc_di" bpmnElement="gw_inc"><omgdc:Bounds x="2645" y="235" width="50" height="50"/><bpmndi:BPMNLabel><omgdc:Bounds x="2630" y="289" width="81" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_inc_di" bpmnElement="e_inc"><omgdc:Bounds x="2822" y="242" width="36" height="36"/><bpmndi:BPMNLabel><omgdc:Bounds x="2819" y="282" width="43" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_s__sc_fristen_di" bpmnElement="f_s__sc_fristen"><omgdi:waypoint x="138" y="120"/><omgdi:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_fristen__ca_lesen_di" bpmnElement="f_sc_fristen__ca_lesen"><omgdi:waypoint x="340" y="120"/><omgdi:waypoint x="410" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_ca_lesen__sc_anteil_di" bpmnElement="f_ca_lesen__sc_anteil"><omgdi:waypoint x="510" y="120"/><omgdi:waypoint x="580" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_anteil__ca_vertrag_di" bpmnElement="f_sc_anteil__ca_vertrag"><omgdi:waypoint x="680" y="120"/><omgdi:waypoint x="750" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_ca_vertrag__sc_sammeln_di" bpmnElement="f_ca_vertrag__sc_sammeln"><omgdi:waypoint x="850" y="120"/><omgdi:waypoint x="920" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_sammeln__gw_genug_di" bpmnElement="f_sc_sammeln__gw_genug"><omgdi:waypoint x="1020" y="120"/><omgdi:waypoint x="1115" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_genug__gw_join_di" bpmnElement="f_gw_genug__gw_join"><omgdi:waypoint x="1165" y="120"/><omgdi:waypoint x="1455" y="120"/><bpmndi:BPMNLabel><omgdc:Bounds x="1171" y="102" width="31" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_genug__ut_klaeren_di" bpmnElement="f_gw_genug__ut_klaeren"><omgdi:waypoint x="1140" y="145"/><omgdi:waypoint x="1140" y="220"/><bpmndi:BPMNLabel><omgdc:Bounds x="1146" y="149" width="18" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_ut_klaeren__sc_weitere_di" bpmnElement="f_ut_klaeren__sc_weitere"><omgdi:waypoint x="1190" y="260"/><omgdi:waypoint x="1260" y="260"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sc_weitere__gw_join_di" bpmnElement="f_sc_weitere__gw_join"><omgdi:waypoint x="1360" y="260"/><omgdi:waypoint x="1480" y="260"/><omgdi:waypoint x="1480" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_gw_join__st_ankuendigen_di" bpmnElement="f_gw_join__st_ankuendigen"><omgdi:waypoint x="1505" y="120"/><omgdi:waypoint x="1600" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_st_ankuendigen__tm_entzug_di" bpmnElement="f_st_ankuendigen__tm_entzug"><omgdi:waypoint x="1700" y="120"/><omgdi:waypoint x="1802" y="120"/></bpmndi:BPMNEdge>
