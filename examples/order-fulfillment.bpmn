<?xml version="1.0" encoding="UTF-8"?>
<!--
  Order Fulfillment — Atlas engine showcase / self-completing test scenario.

  This model is deliberately built to run to completion with NO external workers
  attached: every activity is an inline FEEL script task (evaluated inside the
  engine), and every route is decided from variables the process seeds itself.
  Start an instance and it drives straight to an end event, which makes it usable
  as a deterministic smoke/regression scenario — see examples/README.md for the
  expected per-element visit counts.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
            xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
            xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
            xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
            xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
            id="defs_order_fulfillment" targetNamespace="http://atlas/examples">
  <process id="order-fulfillment" name="Order Fulfillment (Atlas showcase)" isExecutable="true">

    <!-- Entry point. -->
    <startEvent id="order_received" name="Order received"/>

    <!-- Seed the case data as a FEEL context. Inline scripts run in-engine, so no
         worker is needed and the token never parks here. -->
    <scriptTask id="register_order" name="Register order">
      <extensionElements>
        <zeebe:script expression="= {amount: 4200, region: &quot;EU&quot;, priority: true, items: 7}" resultVariable="order"/>
      </extensionElements>
    </scriptTask>

    <!-- Reads the variable the previous task wrote — demonstrates data flowing
         between automatic steps. riskScore = 4200/100 + 7 = 49. -->
    <scriptTask id="score_risk" name="Score risk">
      <extensionElements>
        <zeebe:script expression="= order.amount / 100 + order.items" resultVariable="riskScore"/>
      </extensionElements>
    </scriptTask>

    <!-- Data-based exclusive gateway: high-value orders get full processing,
         everything else is fast-tracked (the default flow). -->
    <exclusiveGateway id="value_gw" name="Order value?" default="flow_express"/>

    <!-- Parallel split: reserve stock and prepare the invoice concurrently. -->
    <parallelGateway id="fanout" name="Handle in parallel"/>
    <scriptTask id="reserve_stock" name="Reserve stock">
      <extensionElements>
        <zeebe:script expression="= order.items" resultVariable="reservedUnits"/>
      </extensionElements>
    </scriptTask>
    <scriptTask id="prepare_invoice" name="Prepare invoice">
      <extensionElements>
        <zeebe:script expression="= order.amount * 1.19" resultVariable="grossAmount"/>
      </extensionElements>
    </scriptTask>
    <!-- Synchronizing parallel join: waits for BOTH branches before continuing. -->
    <parallelGateway id="fanin" name="Stock &amp; invoice ready"/>

    <!-- Inclusive split: any subset of these branches may run. Priority and EU
         both match for this case, so two branches activate; the default is
         suppressed because at least one condition held. -->
    <inclusiveGateway id="notify_split" name="Which notifications?" default="flow_notify_standard"/>
    <scriptTask id="notify_priority" name="Priority handling">
      <extensionElements>
        <zeebe:script expression="= &quot;expedited&quot;" resultVariable="handling"/>
      </extensionElements>
    </scriptTask>
    <scriptTask id="notify_eu" name="EU compliance check">
      <extensionElements>
        <zeebe:script expression="= true" resultVariable="euChecked"/>
      </extensionElements>
    </scriptTask>
    <scriptTask id="notify_standard" name="Standard notification">
      <extensionElements>
        <zeebe:script expression="= &quot;standard&quot;" resultVariable="notice"/>
      </extensionElements>
    </scriptTask>
    <!-- Synchronizing inclusive join: waits for exactly the branches that were
         activated at the split (here: two). -->
    <inclusiveGateway id="notify_join" name="Notifications sent"/>

    <endEvent id="order_fulfilled" name="Order fulfilled"/>

    <!-- Fast-track branch for low-value orders (not taken by the seeded case). -->
    <scriptTask id="auto_approve" name="Auto-approve small order">
      <extensionElements>
        <zeebe:script expression="= &quot;fast-tracked&quot;" resultVariable="decision"/>
      </extensionElements>
    </scriptTask>
    <endEvent id="order_fast_tracked" name="Order fast-tracked"/>

    <sequenceFlow id="f1" sourceRef="order_received" targetRef="register_order"/>
    <sequenceFlow id="f2" sourceRef="register_order" targetRef="score_risk"/>
    <sequenceFlow id="f3" sourceRef="score_risk" targetRef="value_gw"/>

    <sequenceFlow id="flow_high" name="&#8805; 1000" sourceRef="value_gw" targetRef="fanout">
      <conditionExpression>= order.amount &gt; 1000</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_express" name="otherwise" sourceRef="value_gw" targetRef="auto_approve"/>

    <sequenceFlow id="f_fork_a" sourceRef="fanout" targetRef="reserve_stock"/>
    <sequenceFlow id="f_fork_b" sourceRef="fanout" targetRef="prepare_invoice"/>
    <sequenceFlow id="f_join_a" sourceRef="reserve_stock" targetRef="fanin"/>
    <sequenceFlow id="f_join_b" sourceRef="prepare_invoice" targetRef="fanin"/>
    <sequenceFlow id="f_to_notify" sourceRef="fanin" targetRef="notify_split"/>

    <sequenceFlow id="flow_priority" name="priority" sourceRef="notify_split" targetRef="notify_priority">
      <conditionExpression>= order.priority</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_eu" name="EU region" sourceRef="notify_split" targetRef="notify_eu">
      <conditionExpression>= order.region = "EU"</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_notify_standard" name="otherwise" sourceRef="notify_split" targetRef="notify_standard"/>
    <sequenceFlow id="f_pj_a" sourceRef="notify_priority" targetRef="notify_join"/>
    <sequenceFlow id="f_pj_b" sourceRef="notify_eu" targetRef="notify_join"/>
    <sequenceFlow id="f_pj_c" sourceRef="notify_standard" targetRef="notify_join"/>

    <sequenceFlow id="f_confirm" sourceRef="notify_join" targetRef="order_fulfilled"/>

    <sequenceFlow id="f_express_end" sourceRef="auto_approve" targetRef="order_fast_tracked"/>
  </process>

  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="di_order_received" bpmnElement="order_received">
        <dc:Bounds x="160" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="222" width="82" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_register_order" bpmnElement="register_order">
        <dc:Bounds x="250" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_score_risk" bpmnElement="score_risk">
        <dc:Bounds x="400" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_value_gw" bpmnElement="value_gw" isMarkerVisible="true">
        <dc:Bounds x="550" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="542" y="140" width="66" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_fanout" bpmnElement="fanout">
        <dc:Bounds x="650" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="632" y="140" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_reserve_stock" bpmnElement="reserve_stock">
        <dc:Bounds x="760" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_prepare_invoice" bpmnElement="prepare_invoice">
        <dc:Bounds x="760" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_fanin" bpmnElement="fanin">
        <dc:Bounds x="930" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="880" y="232" width="98" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_split" bpmnElement="notify_split">
        <dc:Bounds x="1030" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1012" y="140" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_priority" bpmnElement="notify_priority">
        <dc:Bounds x="1140" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_eu" bpmnElement="notify_eu">
        <dc:Bounds x="1140" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_standard" bpmnElement="notify_standard">
        <dc:Bounds x="1140" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_join" bpmnElement="notify_join">
        <dc:Bounds x="1310" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1292" y="258" width="86" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_order_fulfilled" bpmnElement="order_fulfilled">
        <dc:Bounds x="1410" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1386" y="222" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_auto_approve" bpmnElement="auto_approve">
        <dc:Bounds x="650" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_order_fast_tracked" bpmnElement="order_fast_tracked">
        <dc:Bounds x="820" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="792" y="362" width="92" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="di_f1" bpmnElement="f1">
        <di:waypoint x="196" y="200"/><di:waypoint x="250" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f2" bpmnElement="f2">
        <di:waypoint x="350" y="200"/><di:waypoint x="400" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f3" bpmnElement="f3">
        <di:waypoint x="500" y="200"/><di:waypoint x="550" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_high" bpmnElement="flow_high">
        <di:waypoint x="600" y="200"/><di:waypoint x="650" y="200"/>
        <bpmndi:BPMNLabel><dc:Bounds x="601" y="178" width="50" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_express" bpmnElement="flow_express">
        <di:waypoint x="575" y="225"/><di:waypoint x="575" y="340"/><di:waypoint x="650" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="583" y="270" width="62" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_fork_a" bpmnElement="f_fork_a">
        <di:waypoint x="675" y="175"/><di:waypoint x="675" y="60"/><di:waypoint x="760" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_fork_b" bpmnElement="f_fork_b">
        <di:waypoint x="700" y="200"/><di:waypoint x="760" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_join_a" bpmnElement="f_join_a">
        <di:waypoint x="860" y="60"/><di:waypoint x="955" y="60"/><di:waypoint x="955" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_join_b" bpmnElement="f_join_b">
        <di:waypoint x="860" y="200"/><di:waypoint x="930" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_to_notify" bpmnElement="f_to_notify">
        <di:waypoint x="980" y="200"/><di:waypoint x="1030" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_priority" bpmnElement="flow_priority">
        <di:waypoint x="1055" y="175"/><di:waypoint x="1055" y="60"/><di:waypoint x="1140" y="60"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1063" y="100" width="52" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_eu" bpmnElement="flow_eu">
        <di:waypoint x="1080" y="200"/><di:waypoint x="1140" y="200"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1082" y="178" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_flow_notify_standard" bpmnElement="flow_notify_standard">
        <di:waypoint x="1055" y="225"/><di:waypoint x="1055" y="340"/><di:waypoint x="1140" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1063" y="280" width="62" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_pj_a" bpmnElement="f_pj_a">
        <di:waypoint x="1240" y="60"/><di:waypoint x="1335" y="60"/><di:waypoint x="1335" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_pj_b" bpmnElement="f_pj_b">
        <di:waypoint x="1240" y="200"/><di:waypoint x="1310" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_pj_c" bpmnElement="f_pj_c">
        <di:waypoint x="1240" y="340"/><di:waypoint x="1335" y="340"/><di:waypoint x="1335" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_confirm" bpmnElement="f_confirm">
        <di:waypoint x="1360" y="200"/><di:waypoint x="1410" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_f_express_end" bpmnElement="f_express_end">
        <di:waypoint x="750" y="340"/><di:waypoint x="820" y="340"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
