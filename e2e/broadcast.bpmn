<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_bcast" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- The one property that tells a signal and a message apart: a signal is a broadcast and
       reaches every catch waiting for it, a message is correlated and reaches exactly one. Two
       branches wait for the same signal and then for the same message; the signal releases
       both, the message releases one. -->
  <bpmn:signal id="Sig" name="Ready" />
  <bpmn:message id="Msg" name="Order" />
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gw">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>sa</bpmn:outgoing>
      <bpmn:outgoing>sb</bpmn:outgoing>
      <bpmn:outgoing>sc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Prepare"><bpmn:incoming>sa</bpmn:incoming><bpmn:outgoing>a1</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="SigThrow">
      <bpmn:incoming>a1</bpmn:incoming><bpmn:outgoing>a2</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SigThrowDef" signalRef="Sig" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="MsgThrow">
      <bpmn:incoming>a2</bpmn:incoming><bpmn:outgoing>a3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgThrowDef" messageRef="Msg" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndA"><bpmn:incoming>a3</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="SigCatchB">
      <bpmn:incoming>sb</bpmn:incoming><bpmn:outgoing>b1</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SigCatchBDef" signalRef="Sig" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="MsgCatchB">
      <bpmn:incoming>b1</bpmn:incoming><bpmn:outgoing>b2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgCatchBDef" messageRef="Msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndB"><bpmn:incoming>b2</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="SigCatchC">
      <bpmn:incoming>sc</bpmn:incoming><bpmn:outgoing>c1</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SigCatchCDef" signalRef="Sig" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="MsgCatchC">
      <bpmn:incoming>c1</bpmn:incoming><bpmn:outgoing>c2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgCatchCDef" messageRef="Msg" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndC"><bpmn:incoming>c2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw" />
    <bpmn:sequenceFlow id="sa" sourceRef="Gw" targetRef="Prepare" />
    <bpmn:sequenceFlow id="sb" sourceRef="Gw" targetRef="SigCatchB" />
    <bpmn:sequenceFlow id="sc" sourceRef="Gw" targetRef="SigCatchC" />
    <bpmn:sequenceFlow id="a1" sourceRef="Prepare" targetRef="SigThrow" />
    <bpmn:sequenceFlow id="a2" sourceRef="SigThrow" targetRef="MsgThrow" />
    <bpmn:sequenceFlow id="a3" sourceRef="MsgThrow" targetRef="EndA" />
    <bpmn:sequenceFlow id="b1" sourceRef="SigCatchB" targetRef="MsgCatchB" />
    <bpmn:sequenceFlow id="b2" sourceRef="MsgCatchB" targetRef="EndB" />
    <bpmn:sequenceFlow id="c1" sourceRef="SigCatchC" targetRef="MsgCatchC" />
    <bpmn:sequenceFlow id="c2" sourceRef="MsgCatchC" targetRef="EndC" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_di" bpmnElement="Gw"><dc:Bounds x="190" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prepare_di" bpmnElement="Prepare"><dc:Bounds x="300" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SigThrow_di" bpmnElement="SigThrow"><dc:Bounds x="450" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MsgThrow_di" bpmnElement="MsgThrow"><dc:Bounds x="550" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndA_di" bpmnElement="EndA"><dc:Bounds x="650" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SigCatchB_di" bpmnElement="SigCatchB"><dc:Bounds x="330" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MsgCatchB_di" bpmnElement="MsgCatchB"><dc:Bounds x="450" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB"><dc:Bounds x="570" y="242" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SigCatchC_di" bpmnElement="SigCatchC"><dc:Bounds x="330" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MsgCatchC_di" bpmnElement="MsgCatchC"><dc:Bounds x="450" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndC_di" bpmnElement="EndC"><dc:Bounds x="570" y="382" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="136" y="240" /><di:waypoint x="190" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sa_di" bpmnElement="sa"><di:waypoint x="215" y="215" /><di:waypoint x="215" y="100" /><di:waypoint x="300" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sb_di" bpmnElement="sb"><di:waypoint x="240" y="240" /><di:waypoint x="330" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sc_di" bpmnElement="sc"><di:waypoint x="215" y="265" /><di:waypoint x="215" y="400" /><di:waypoint x="330" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="400" y="100" /><di:waypoint x="450" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2"><di:waypoint x="486" y="100" /><di:waypoint x="550" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a3_di" bpmnElement="a3"><di:waypoint x="586" y="100" /><di:waypoint x="650" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1"><di:waypoint x="366" y="260" /><di:waypoint x="450" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b2_di" bpmnElement="b2"><di:waypoint x="486" y="260" /><di:waypoint x="570" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c1_di" bpmnElement="c1"><di:waypoint x="366" y="400" /><di:waypoint x="450" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c2_di" bpmnElement="c2"><di:waypoint x="486" y="400" /><di:waypoint x="570" y="400" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
