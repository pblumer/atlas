<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_mi" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Two multi-instance activities: MICard pins a fixed loop cardinality of 3 (the model
       wins), while MIDefault is data-driven (no cardinality) and falls back to the
       toolbar-configurable default. Each lives in its own pool so a test can drive one. -->
  <bpmn:collaboration id="Collaboration_mi">
    <bpmn:participant id="Part_C" name="cardinality = 3" processRef="Process_C" />
    <bpmn:participant id="Part_D" name="data-driven (default)" processRef="Process_D" />
  </bpmn:collaboration>
  <bpmn:process id="Process_C" isExecutable="true">
    <bpmn:startEvent id="StartC"><bpmn:outgoing>c1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="MICard" name="per item (3)">
      <bpmn:incoming>c1</bpmn:incoming>
      <bpmn:outgoing>c2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>3</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:endEvent id="EndC"><bpmn:incoming>c2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="c1" sourceRef="StartC" targetRef="MICard" />
    <bpmn:sequenceFlow id="c2" sourceRef="MICard" targetRef="EndC" />
  </bpmn:process>
  <bpmn:process id="Process_D" isExecutable="true">
    <bpmn:startEvent id="StartD"><bpmn:outgoing>d1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="MIDefault" name="per item">
      <bpmn:incoming>d1</bpmn:incoming>
      <bpmn:outgoing>d2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:task>
    <bpmn:endEvent id="EndD"><bpmn:incoming>d2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="d1" sourceRef="StartD" targetRef="MIDefault" />
    <bpmn:sequenceFlow id="d2" sourceRef="MIDefault" targetRef="EndD" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration_mi">
      <bpmndi:BPMNShape id="Part_C_di" bpmnElement="Part_C" isHorizontal="true"><dc:Bounds x="150" y="80" width="440" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartC_di" bpmnElement="StartC"><dc:Bounds x="210" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MICard_di" bpmnElement="MICard"><dc:Bounds x="340" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndC_di" bpmnElement="EndC"><dc:Bounds x="520" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c1_di" bpmnElement="c1"><di:waypoint x="246" y="140" /><di:waypoint x="340" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c2_di" bpmnElement="c2"><di:waypoint x="440" y="140" /><di:waypoint x="520" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Part_D_di" bpmnElement="Part_D" isHorizontal="true"><dc:Bounds x="150" y="240" width="440" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartD_di" bpmnElement="StartD"><dc:Bounds x="210" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MIDefault_di" bpmnElement="MIDefault"><dc:Bounds x="340" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndD_di" bpmnElement="EndD"><dc:Bounds x="520" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="d1_di" bpmnElement="d1"><di:waypoint x="246" y="300" /><di:waypoint x="340" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="d2_di" bpmnElement="d2"><di:waypoint x="440" y="300" /><di:waypoint x="520" y="300" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
