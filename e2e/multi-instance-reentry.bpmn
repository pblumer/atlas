<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_mire" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- A multi-instance activity entered twice, with an interrupting boundary cancelling the
       first visit part-way through its three instances. The second visit is a fresh activity
       and must run three again — a count left behind by the cancelled visit would make it run
       whatever was left of the first. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gw">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>sa</bpmn:outgoing>
      <bpmn:outgoing>sb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Batch">
      <bpmn:incoming>sa</bpmn:incoming>
      <bpmn:incoming>hb</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopCardinality xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">3</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:task>
    <bpmn:boundaryEvent id="Abort" attachedToRef="Batch">
      <bpmn:outgoing>b1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="AbortDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="EndAbort"><bpmn:incoming>b1</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Hold">
      <bpmn:incoming>sb</bpmn:incoming><bpmn:outgoing>hb</bpmn:outgoing>
      <bpmn:timerEventDefinition id="HoldDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End"><bpmn:incoming>s2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw" />
    <bpmn:sequenceFlow id="sa" sourceRef="Gw" targetRef="Batch" />
    <bpmn:sequenceFlow id="sb" sourceRef="Gw" targetRef="Hold" />
    <bpmn:sequenceFlow id="hb" sourceRef="Hold" targetRef="Batch" />
    <bpmn:sequenceFlow id="s2" sourceRef="Batch" targetRef="End" />
    <bpmn:sequenceFlow id="b1" sourceRef="Abort" targetRef="EndAbort" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_di" bpmnElement="Gw"><dc:Bounds x="210" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Batch_di" bpmnElement="Batch"><dc:Bounds x="340" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abort_di" bpmnElement="Abort"><dc:Bounds x="372" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndAbort_di" bpmnElement="EndAbort"><dc:Bounds x="500" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Hold_di" bpmnElement="Hold"><dc:Bounds x="220" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="560" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="200" /><di:waypoint x="210" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sa_di" bpmnElement="sa"><di:waypoint x="235" y="175" /><di:waypoint x="235" y="120" /><di:waypoint x="340" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sb_di" bpmnElement="sb"><di:waypoint x="235" y="225" /><di:waypoint x="235" y="302" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="hb_di" bpmnElement="hb"><di:waypoint x="256" y="320" /><di:waypoint x="390" y="320" /><di:waypoint x="390" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="440" y="120" /><di:waypoint x="560" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1"><di:waypoint x="400" y="178" /><di:waypoint x="400" y="240" /><di:waypoint x="500" y="240" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
