<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_term" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- A terminate end at the process level (ADR-0116): Fork sends one token to Catch, which
       waits for a message, and one through Work to Term. Term ends the process, so the
       waiting token is gone and nothing is left to fire. -->
  <bpmn:message id="Msg" name="storno" />
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Fork"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="Catch"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Abort"><bpmn:incoming>f2</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Work"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="Term"><bpmn:incoming>f4</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="Start" targetRef="Fork" />
    <bpmn:sequenceFlow id="f1" sourceRef="Fork" targetRef="Catch" />
    <bpmn:sequenceFlow id="f2" sourceRef="Catch" targetRef="Abort" />
    <bpmn:sequenceFlow id="f3" sourceRef="Fork" targetRef="Work" />
    <bpmn:sequenceFlow id="f4" sourceRef="Work" targetRef="Term" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fork_di" bpmnElement="Fork"><dc:Bounds x="185" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_di" bpmnElement="Catch"><dc:Bounds x="292" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abort_di" bpmnElement="Abort"><dc:Bounds x="460" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Work_di" bpmnElement="Work"><dc:Bounds x="260" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Term_di" bpmnElement="Term"><dc:Bounds x="460" y="292" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f0_di" bpmnElement="f0"><di:waypoint x="136" y="240" /><di:waypoint x="185" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="210" y="215" /><di:waypoint x="210" y="160" /><di:waypoint x="292" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="328" y="160" /><di:waypoint x="460" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="210" y="265" /><di:waypoint x="210" y="310" /><di:waypoint x="260" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="360" y="310" /><di:waypoint x="460" y="310" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
