<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_term" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Terminate end at the process root (ADR-0116). A parallel split runs three branches:
       one reaches a terminate end, one parks on a timer catch, one enters a subprocess whose
       inner flow parks too. Reaching EndTerm must end the whole instance — the parked token,
       the subprocess and the token inside it all go with it. A plain end would complete only
       its own token and leave the other two branches running for ever. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gw_s">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>sa</bpmn:outgoing>
      <bpmn:outgoing>sb</bpmn:outgoing>
      <bpmn:outgoing>sc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="TaskA"><bpmn:incoming>sa</bpmn:incoming><bpmn:outgoing>a1</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndTerm">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TermDef" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CatchB">
      <bpmn:incoming>sb</bpmn:incoming>
      <bpmn:outgoing>b1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerB" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndB"><bpmn:incoming>b1</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="Sub">
      <bpmn:incoming>sc</bpmn:incoming>
      <bpmn:outgoing>c1</bpmn:outgoing>
      <bpmn:startEvent id="InnerStart"><bpmn:outgoing>i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:intermediateCatchEvent id="InnerCatch">
        <bpmn:incoming>i1</bpmn:incoming>
        <bpmn:outgoing>i2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerInner" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="InnerEnd"><bpmn:incoming>i2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="i1" sourceRef="InnerStart" targetRef="InnerCatch" />
      <bpmn:sequenceFlow id="i2" sourceRef="InnerCatch" targetRef="InnerEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndC"><bpmn:incoming>c1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw_s" />
    <bpmn:sequenceFlow id="sa" sourceRef="Gw_s" targetRef="TaskA" />
    <bpmn:sequenceFlow id="sb" sourceRef="Gw_s" targetRef="CatchB" />
    <bpmn:sequenceFlow id="sc" sourceRef="Gw_s" targetRef="Sub" />
    <bpmn:sequenceFlow id="a1" sourceRef="TaskA" targetRef="EndTerm" />
    <bpmn:sequenceFlow id="b1" sourceRef="CatchB" targetRef="EndB" />
    <bpmn:sequenceFlow id="c1" sourceRef="Sub" targetRef="EndC" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_s_di" bpmnElement="Gw_s"><dc:Bounds x="210" y="275" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="320" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndTerm_di" bpmnElement="EndTerm"><dc:Bounds x="490" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchB_di" bpmnElement="CatchB"><dc:Bounds x="340" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB"><dc:Bounds x="460" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="300" y="380" width="380" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerStart_di" bpmnElement="InnerStart"><dc:Bounds x="330" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerCatch_di" bpmnElement="InnerCatch"><dc:Bounds x="430" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerEnd_di" bpmnElement="InnerEnd"><dc:Bounds x="570" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndC_di" bpmnElement="EndC"><dc:Bounds x="740" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="300" /><di:waypoint x="210" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sa_di" bpmnElement="sa"><di:waypoint x="235" y="275" /><di:waypoint x="235" y="140" /><di:waypoint x="320" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sb_di" bpmnElement="sb"><di:waypoint x="260" y="300" /><di:waypoint x="340" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sc_di" bpmnElement="sc"><di:waypoint x="235" y="325" /><di:waypoint x="235" y="460" /><di:waypoint x="300" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="420" y="140" /><di:waypoint x="490" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1"><di:waypoint x="376" y="300" /><di:waypoint x="460" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i1_di" bpmnElement="i1"><di:waypoint x="366" y="460" /><di:waypoint x="430" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i2_di" bpmnElement="i2"><di:waypoint x="466" y="460" /><di:waypoint x="570" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c1_di" bpmnElement="c1"><di:waypoint x="680" y="460" /><di:waypoint x="740" y="460" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
