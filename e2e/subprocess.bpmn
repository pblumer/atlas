<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_sub" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Embedded subprocess: the token descends into Sub, runs InnerStart -> InnerTask ->
       InnerEnd, and only then continues from Sub to End. A flat walk-over would light End
       without ever entering the subprocess. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="Sub">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:startEvent id="InnerStart"><bpmn:outgoing>i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="InnerTask"><bpmn:incoming>i1</bpmn:incoming><bpmn:outgoing>i2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="InnerEnd"><bpmn:incoming>i2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="i1" sourceRef="InnerStart" targetRef="InnerTask" />
      <bpmn:sequenceFlow id="i2" sourceRef="InnerTask" targetRef="InnerEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End"><bpmn:incoming>s2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Sub" />
    <bpmn:sequenceFlow id="s2" sourceRef="Sub" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="250" y="140" width="360" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerStart_di" bpmnElement="InnerStart"><dc:Bounds x="290" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerTask_di" bpmnElement="InnerTask"><dc:Bounds x="380" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerEnd_di" bpmnElement="InnerEnd"><dc:Bounds x="540" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="680" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="196" y="240" /><di:waypoint x="250" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i1_di" bpmnElement="i1"><di:waypoint x="326" y="240" /><di:waypoint x="380" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i2_di" bpmnElement="i2"><di:waypoint x="480" y="240" /><di:waypoint x="540" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="610" y="240" /><di:waypoint x="680" y="240" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
