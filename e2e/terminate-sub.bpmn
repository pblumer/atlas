<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_term_sub" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Terminate end inside an embedded subprocess (ADR-0116). The scope is what ends, not the
       instance: the parallel branch parked on the inner timer catch dies with the subprocess,
       the subprocess completes, and the outer token continues on to End. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="Sub">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:startEvent id="InnerStart"><bpmn:outgoing>i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:parallelGateway id="InnerGw">
        <bpmn:incoming>i1</bpmn:incoming>
        <bpmn:outgoing>ia</bpmn:outgoing>
        <bpmn:outgoing>ib</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="InnerTaskA"><bpmn:incoming>ia</bpmn:incoming><bpmn:outgoing>ia2</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="InnerTerm">
        <bpmn:incoming>ia2</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TermDef" />
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="InnerCatch">
        <bpmn:incoming>ib</bpmn:incoming>
        <bpmn:outgoing>ib2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerInner" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="InnerEnd"><bpmn:incoming>ib2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="i1" sourceRef="InnerStart" targetRef="InnerGw" />
      <bpmn:sequenceFlow id="ia" sourceRef="InnerGw" targetRef="InnerTaskA" />
      <bpmn:sequenceFlow id="ia2" sourceRef="InnerTaskA" targetRef="InnerTerm" />
      <bpmn:sequenceFlow id="ib" sourceRef="InnerGw" targetRef="InnerCatch" />
      <bpmn:sequenceFlow id="ib2" sourceRef="InnerCatch" targetRef="InnerEnd" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End"><bpmn:incoming>s2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Sub" />
    <bpmn:sequenceFlow id="s2" sourceRef="Sub" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="210" y="140" width="520" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerStart_di" bpmnElement="InnerStart"><dc:Bounds x="240" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerGw_di" bpmnElement="InnerGw"><dc:Bounds x="320" y="255" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerTaskA_di" bpmnElement="InnerTaskA"><dc:Bounds x="430" y="170" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerTerm_di" bpmnElement="InnerTerm"><dc:Bounds x="600" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerCatch_di" bpmnElement="InnerCatch"><dc:Bounds x="460" y="332" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerEnd_di" bpmnElement="InnerEnd"><dc:Bounds x="600" y="332" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="790" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="280" /><di:waypoint x="210" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i1_di" bpmnElement="i1"><di:waypoint x="276" y="280" /><di:waypoint x="320" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ia_di" bpmnElement="ia"><di:waypoint x="345" y="255" /><di:waypoint x="345" y="210" /><di:waypoint x="430" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ia2_di" bpmnElement="ia2"><di:waypoint x="530" y="210" /><di:waypoint x="600" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ib_di" bpmnElement="ib"><di:waypoint x="345" y="305" /><di:waypoint x="345" y="350" /><di:waypoint x="460" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ib2_di" bpmnElement="ib2"><di:waypoint x="496" y="350" /><di:waypoint x="600" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="730" y="280" /><di:waypoint x="790" y="280" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
