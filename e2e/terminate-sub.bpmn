<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_term_sub" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- A terminate end inside a subprocess (ADR-0116): Fork sends one token to Catch, which
       waits for a message, and one through Work to Term. Term ends Sub — Catch's token goes
       with it — so Sub completes and the outer token runs on to End. OuterCatch sits on a
       parallel branch *outside* Sub and must keep its token: terminate ends its own scope only. -->
  <bpmn:message id="Msg" name="storno" />
  <bpmn:message id="MsgOuter" name="outer" />
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="OuterFork"><bpmn:incoming>s0</bpmn:incoming><bpmn:outgoing>s1</bpmn:outgoing><bpmn:outgoing>s3</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:intermediateCatchEvent id="OuterCatch"><bpmn:incoming>s3</bpmn:incoming><bpmn:messageEventDefinition messageRef="MsgOuter" /></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Sub">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:startEvent id="InnerStart"><bpmn:outgoing>i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:parallelGateway id="Fork"><bpmn:incoming>i1</bpmn:incoming><bpmn:outgoing>i2</bpmn:outgoing><bpmn:outgoing>i4</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:intermediateCatchEvent id="Catch"><bpmn:incoming>i2</bpmn:incoming><bpmn:outgoing>i3</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg" /></bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="Abort"><bpmn:incoming>i3</bpmn:incoming></bpmn:endEvent>
      <bpmn:task id="Work"><bpmn:incoming>i4</bpmn:incoming><bpmn:outgoing>i5</bpmn:outgoing></bpmn:task>
      <bpmn:endEvent id="Term"><bpmn:incoming>i5</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
      <bpmn:sequenceFlow id="i1" sourceRef="InnerStart" targetRef="Fork" />
      <bpmn:sequenceFlow id="i2" sourceRef="Fork" targetRef="Catch" />
      <bpmn:sequenceFlow id="i3" sourceRef="Catch" targetRef="Abort" />
      <bpmn:sequenceFlow id="i4" sourceRef="Fork" targetRef="Work" />
      <bpmn:sequenceFlow id="i5" sourceRef="Work" targetRef="Term" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End"><bpmn:incoming>s2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s0" sourceRef="Start" targetRef="OuterFork" />
    <bpmn:sequenceFlow id="s1" sourceRef="OuterFork" targetRef="Sub" />
    <bpmn:sequenceFlow id="s2" sourceRef="Sub" targetRef="End" />
    <bpmn:sequenceFlow id="s3" sourceRef="OuterFork" targetRef="OuterCatch" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OuterFork_di" bpmnElement="OuterFork"><dc:Bounds x="175" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OuterCatch_di" bpmnElement="OuterCatch"><dc:Bounds x="182" y="420" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true"><dc:Bounds x="260" y="100" width="480" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="InnerStart_di" bpmnElement="InnerStart"><dc:Bounds x="290" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fork_di" bpmnElement="Fork"><dc:Bounds x="365" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_di" bpmnElement="Catch"><dc:Bounds x="472" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Abort_di" bpmnElement="Abort"><dc:Bounds x="640" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Work_di" bpmnElement="Work"><dc:Bounds x="440" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Term_di" bpmnElement="Term"><dc:Bounds x="640" y="292" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="800" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s0_di" bpmnElement="s0"><di:waypoint x="136" y="240" /><di:waypoint x="175" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="225" y="240" /><di:waypoint x="260" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s3_di" bpmnElement="s3"><di:waypoint x="200" y="265" /><di:waypoint x="200" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i1_di" bpmnElement="i1"><di:waypoint x="326" y="240" /><di:waypoint x="365" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i2_di" bpmnElement="i2"><di:waypoint x="390" y="215" /><di:waypoint x="390" y="160" /><di:waypoint x="472" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i3_di" bpmnElement="i3"><di:waypoint x="508" y="160" /><di:waypoint x="640" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i4_di" bpmnElement="i4"><di:waypoint x="390" y="265" /><di:waypoint x="390" y="310" /><di:waypoint x="440" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i5_di" bpmnElement="i5"><di:waypoint x="540" y="310" /><di:waypoint x="640" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="740" y="240" /><di:waypoint x="800" y="240" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
