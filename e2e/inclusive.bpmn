<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_inc" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Inclusive gateway: the split activates a chosen SUBSET of branches; the OR-join fires
       on quiescence (once no token can still reach it), merging whatever arrived. Activating
       A and C but not B must still converge to one completion. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:inclusiveGateway id="Gw_s">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>fa</bpmn:outgoing>
      <bpmn:outgoing>fb</bpmn:outgoing>
      <bpmn:outgoing>fc</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="TaskA"><bpmn:incoming>fa</bpmn:incoming><bpmn:outgoing>ja</bpmn:outgoing></bpmn:task>
    <bpmn:task id="TaskB"><bpmn:incoming>fb</bpmn:incoming><bpmn:outgoing>jb</bpmn:outgoing></bpmn:task>
    <bpmn:task id="TaskC"><bpmn:incoming>fc</bpmn:incoming><bpmn:outgoing>jc</bpmn:outgoing></bpmn:task>
    <bpmn:inclusiveGateway id="Gw_j">
      <bpmn:incoming>ja</bpmn:incoming>
      <bpmn:incoming>jb</bpmn:incoming>
      <bpmn:incoming>jc</bpmn:incoming>
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="End"><bpmn:incoming>e1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw_s" />
    <bpmn:sequenceFlow id="fa" name="A" sourceRef="Gw_s" targetRef="TaskA" />
    <bpmn:sequenceFlow id="fb" name="B" sourceRef="Gw_s" targetRef="TaskB" />
    <bpmn:sequenceFlow id="fc" name="C" sourceRef="Gw_s" targetRef="TaskC" />
    <bpmn:sequenceFlow id="ja" sourceRef="TaskA" targetRef="Gw_j" />
    <bpmn:sequenceFlow id="jb" sourceRef="TaskB" targetRef="Gw_j" />
    <bpmn:sequenceFlow id="jc" sourceRef="TaskC" targetRef="Gw_j" />
    <bpmn:sequenceFlow id="e1" sourceRef="Gw_j" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="150" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_s_di" bpmnElement="Gw_s"><dc:Bounds x="240" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="360" y="30" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskB_di" bpmnElement="TaskB"><dc:Bounds x="360" y="140" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskC_di" bpmnElement="TaskC"><dc:Bounds x="360" y="250" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_j_di" bpmnElement="Gw_j"><dc:Bounds x="520" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="620" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="186" y="180" /><di:waypoint x="240" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fa_di" bpmnElement="fa"><di:waypoint x="265" y="155" /><di:waypoint x="265" y="70" /><di:waypoint x="360" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fb_di" bpmnElement="fb"><di:waypoint x="290" y="180" /><di:waypoint x="360" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fc_di" bpmnElement="fc"><di:waypoint x="265" y="205" /><di:waypoint x="265" y="290" /><di:waypoint x="360" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ja_di" bpmnElement="ja"><di:waypoint x="460" y="70" /><di:waypoint x="545" y="70" /><di:waypoint x="545" y="155" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jb_di" bpmnElement="jb"><di:waypoint x="460" y="180" /><di:waypoint x="520" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="jc_di" bpmnElement="jc"><di:waypoint x="460" y="290" /><di:waypoint x="545" y="290" /><di:waypoint x="545" y="205" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e1_di" bpmnElement="e1"><di:waypoint x="570" y="180" /><di:waypoint x="620" y="180" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
