<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_tx" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- A BPMN transaction and its cancel end event (ADR-0108). Reaching CancelEnd rolls the
       transaction back: Charge is compensated by UndoCharge, the transaction is torn down, and
       the cancel boundary takes the recovery flow. What must NOT happen is the transaction
       completing normally and the flow leaving by EndOk — the success path of a run that was
       cancelled. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:transaction id="Tx">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:startEvent id="TxStart"><bpmn:outgoing>i1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:task id="Charge"><bpmn:incoming>i1</bpmn:incoming><bpmn:outgoing>i2</bpmn:outgoing></bpmn:task>
      <bpmn:boundaryEvent id="CompB" attachedToRef="Charge">
        <bpmn:compensateEventDefinition id="CompBDef" />
      </bpmn:boundaryEvent>
      <bpmn:task id="UndoCharge" isForCompensation="true" />
      <bpmn:association id="a1" sourceRef="CompB" targetRef="UndoCharge" associationDirection="One" />
      <bpmn:endEvent id="CancelEnd">
        <bpmn:incoming>i2</bpmn:incoming>
        <bpmn:cancelEventDefinition id="CancelDef" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="i1" sourceRef="TxStart" targetRef="Charge" />
      <bpmn:sequenceFlow id="i2" sourceRef="Charge" targetRef="CancelEnd" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="CancelB" attachedToRef="Tx">
      <bpmn:outgoing>c1</bpmn:outgoing>
      <bpmn:cancelEventDefinition id="CancelBDef" />
    </bpmn:boundaryEvent>
    <bpmn:task id="Refunded"><bpmn:incoming>c1</bpmn:incoming><bpmn:outgoing>c2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndCancelled"><bpmn:incoming>c2</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndOk"><bpmn:incoming>s2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Tx" />
    <bpmn:sequenceFlow id="s2" sourceRef="Tx" targetRef="EndOk" />
    <bpmn:sequenceFlow id="c1" sourceRef="CancelB" targetRef="Refunded" />
    <bpmn:sequenceFlow id="c2" sourceRef="Refunded" targetRef="EndCancelled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tx_di" bpmnElement="Tx" isExpanded="true"><dc:Bounds x="210" y="80" width="460" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TxStart_di" bpmnElement="TxStart"><dc:Bounds x="240" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Charge_di" bpmnElement="Charge"><dc:Bounds x="330" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompB_di" bpmnElement="CompB"><dc:Bounds x="362" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UndoCharge_di" bpmnElement="UndoCharge"><dc:Bounds x="330" y="270" width="100" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CancelEnd_di" bpmnElement="CancelEnd"><dc:Bounds x="560" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CancelB_di" bpmnElement="CancelB"><dc:Bounds x="452" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Refunded_di" bpmnElement="Refunded"><dc:Bounds x="420" y="420" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndCancelled_di" bpmnElement="EndCancelled"><dc:Bounds x="600" y="442" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndOk_di" bpmnElement="EndOk"><dc:Bounds x="740" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="200" /><di:waypoint x="210" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i1_di" bpmnElement="i1"><di:waypoint x="276" y="200" /><di:waypoint x="330" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="i2_di" bpmnElement="i2"><di:waypoint x="430" y="200" /><di:waypoint x="560" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="380" y="258" /><di:waypoint x="380" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c1_di" bpmnElement="c1"><di:waypoint x="470" y="378" /><di:waypoint x="470" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c2_di" bpmnElement="c2"><di:waypoint x="520" y="460" /><di:waypoint x="600" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="670" y="200" /><di:waypoint x="740" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
