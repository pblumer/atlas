<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_err_unc" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- An error end at the process root that nothing catches (ADR-0089). The engine raises an
       incident and the instance parks; what must not happen is the diagram reporting a
       completed process. The parallel branch parked on its timer is untouched — an uncaught
       error tears nothing down. -->
  <bpmn:error id="Err1" name="Boom" errorCode="E1" />
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gw_s">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>sa</bpmn:outgoing>
      <bpmn:outgoing>sb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="TaskA"><bpmn:incoming>sa</bpmn:incoming><bpmn:outgoing>a1</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="ErrEnd">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef" errorRef="Err1" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="CatchB">
      <bpmn:incoming>sb</bpmn:incoming>
      <bpmn:outgoing>b1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerB" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndB"><bpmn:incoming>b1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw_s" />
    <bpmn:sequenceFlow id="sa" sourceRef="Gw_s" targetRef="TaskA" />
    <bpmn:sequenceFlow id="sb" sourceRef="Gw_s" targetRef="CatchB" />
    <bpmn:sequenceFlow id="a1" sourceRef="TaskA" targetRef="ErrEnd" />
    <bpmn:sequenceFlow id="b1" sourceRef="CatchB" targetRef="EndB" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_s_di" bpmnElement="Gw_s"><dc:Bounds x="210" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="320" y="100" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ErrEnd_di" bpmnElement="ErrEnd"><dc:Bounds x="490" y="122" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchB_di" bpmnElement="CatchB"><dc:Bounds x="340" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB"><dc:Bounds x="470" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="240" /><di:waypoint x="210" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sa_di" bpmnElement="sa"><di:waypoint x="235" y="215" /><di:waypoint x="235" y="140" /><di:waypoint x="320" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sb_di" bpmnElement="sb"><di:waypoint x="235" y="265" /><di:waypoint x="235" y="320" /><di:waypoint x="340" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="420" y="140" /><di:waypoint x="490" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1"><di:waypoint x="376" y="320" /><di:waypoint x="470" y="320" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
