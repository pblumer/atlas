<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_xor" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Exclusive gateway: the simulation pauses for a choice; the user picks one branch. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_x">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>fa</bpmn:outgoing>
      <bpmn:outgoing>fb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="TaskA"><bpmn:incoming>fa</bpmn:incoming><bpmn:outgoing>a2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="TaskB"><bpmn:incoming>fb</bpmn:incoming><bpmn:outgoing>b2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndA"><bpmn:incoming>a2</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndB"><bpmn:incoming>b2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw_x" />
    <bpmn:sequenceFlow id="fa" name="A" sourceRef="Gw_x" targetRef="TaskA" />
    <bpmn:sequenceFlow id="fb" name="B" sourceRef="Gw_x" targetRef="TaskB" />
    <bpmn:sequenceFlow id="a2" sourceRef="TaskA" targetRef="EndA" />
    <bpmn:sequenceFlow id="b2" sourceRef="TaskB" targetRef="EndB" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="150" y="162" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_x_di" bpmnElement="Gw_x" isMarkerVisible="true"><dc:Bounds x="240" y="155" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="360" y="60" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskB_di" bpmnElement="TaskB"><dc:Bounds x="360" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndA_di" bpmnElement="EndA"><dc:Bounds x="520" y="82" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB"><dc:Bounds x="520" y="282" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="186" y="180" /><di:waypoint x="240" y="180" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fa_di" bpmnElement="fa"><di:waypoint x="265" y="155" /><di:waypoint x="265" y="100" /><di:waypoint x="360" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="fb_di" bpmnElement="fb"><di:waypoint x="265" y="205" /><di:waypoint x="265" y="300" /><di:waypoint x="360" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2"><di:waypoint x="460" y="100" /><di:waypoint x="520" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b2_di" bpmnElement="b2"><di:waypoint x="460" y="300" /><di:waypoint x="520" y="300" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
