<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_timer" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- The three timer forms, each with a different modelled time: a five-minute wait, a
       thirty-day interrupting deadline, and an hourly reminder that leaves its activity
       running. The simulation does not honour the clock — a person fires each one — but which
       of them is which is the whole content of the element. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Wait">
      <bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Work"><bpmn:incoming>s2</bpmn:incoming><bpmn:outgoing>s3</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="Deadline" attachedToRef="Work">
      <bpmn:outgoing>d1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="DeadlineDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Escalate"><bpmn:incoming>d1</bpmn:incoming><bpmn:outgoing>d2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndDeadline"><bpmn:incoming>d2</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="Reminder" attachedToRef="Work" cancelActivity="false">
      <bpmn:outgoing>r1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ReminderDef">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="Remind"><bpmn:incoming>r1</bpmn:incoming><bpmn:outgoing>r2</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndRemind"><bpmn:incoming>r2</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="End"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Wait" />
    <bpmn:sequenceFlow id="s2" sourceRef="Wait" targetRef="Work" />
    <bpmn:sequenceFlow id="s3" sourceRef="Work" targetRef="End" />
    <bpmn:sequenceFlow id="d1" sourceRef="Deadline" targetRef="Escalate" />
    <bpmn:sequenceFlow id="d2" sourceRef="Escalate" targetRef="EndDeadline" />
    <bpmn:sequenceFlow id="r1" sourceRef="Reminder" targetRef="Remind" />
    <bpmn:sequenceFlow id="r2" sourceRef="Remind" targetRef="EndRemind" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait"><dc:Bounds x="220" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Work_di" bpmnElement="Work"><dc:Bounds x="330" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deadline_di" bpmnElement="Deadline"><dc:Bounds x="342" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reminder_di" bpmnElement="Reminder"><dc:Bounds x="392" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Escalate_di" bpmnElement="Escalate"><dc:Bounds x="280" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndDeadline_di" bpmnElement="EndDeadline"><dc:Bounds x="440" y="332" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Remind_di" bpmnElement="Remind"><dc:Bounds x="530" y="310" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRemind_di" bpmnElement="EndRemind"><dc:Bounds x="690" y="332" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="520" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="200" /><di:waypoint x="220" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="256" y="200" /><di:waypoint x="330" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s3_di" bpmnElement="s3"><di:waypoint x="430" y="200" /><di:waypoint x="520" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="d1_di" bpmnElement="d1"><di:waypoint x="350" y="258" /><di:waypoint x="330" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="d2_di" bpmnElement="d2"><di:waypoint x="380" y="350" /><di:waypoint x="440" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="r1_di" bpmnElement="r1"><di:waypoint x="420" y="258" /><di:waypoint x="580" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="r2_di" bpmnElement="r2"><di:waypoint x="630" y="350" /><di:waypoint x="690" y="350" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
