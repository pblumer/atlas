<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_link" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Link events (ADR-0132): BPMN's off-page connector. Reaching Jump is identical to having
       taken a sequence flow straight to Land, which then carries on to TaskB. The pair stands
       in for one line; a run that stops at Jump has read the diagram as two processes. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="TaskA"><bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="Jump">
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:linkEventDefinition id="JumpDef" name="X" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Land">
      <bpmn:outgoing>s3</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LandDef" name="X" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="TaskB"><bpmn:incoming>s3</bpmn:incoming><bpmn:outgoing>s4</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End"><bpmn:incoming>s4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="TaskA" />
    <bpmn:sequenceFlow id="s2" sourceRef="TaskA" targetRef="Jump" />
    <bpmn:sequenceFlow id="s3" sourceRef="Land" targetRef="TaskB" />
    <bpmn:sequenceFlow id="s4" sourceRef="TaskB" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskA_di" bpmnElement="TaskA"><dc:Bounds x="220" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Jump_di" bpmnElement="Jump"><dc:Bounds x="400" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Land_di" bpmnElement="Land"><dc:Bounds x="120" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskB_di" bpmnElement="TaskB"><dc:Bounds x="220" y="240" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="400" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="120" /><di:waypoint x="220" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="320" y="120" /><di:waypoint x="400" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s3_di" bpmnElement="s3"><di:waypoint x="156" y="280" /><di:waypoint x="220" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s4_di" bpmnElement="s4"><di:waypoint x="320" y="280" /><di:waypoint x="400" y="280" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
