<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_comp" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Compensation (ADR-0103). Book carries a compensation boundary linked by an
       <association> to UndoBook, which is not on the normal flow. Once Book has completed it
       is compensable: the compensation throw runs UndoBook and then carries on to End. -->
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Book"><bpmn:incoming>s1</bpmn:incoming><bpmn:outgoing>s2</bpmn:outgoing></bpmn:task>
    <bpmn:boundaryEvent id="CompB" attachedToRef="Book">
      <bpmn:compensateEventDefinition id="CompBDef" />
    </bpmn:boundaryEvent>
    <bpmn:task id="UndoBook" isForCompensation="true" />
    <bpmn:association id="a1" sourceRef="CompB" targetRef="UndoBook" associationDirection="One" />
    <bpmn:intermediateThrowEvent id="Comp">
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompDef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End"><bpmn:incoming>s3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Book" />
    <bpmn:sequenceFlow id="s2" sourceRef="Book" targetRef="Comp" />
    <bpmn:sequenceFlow id="s3" sourceRef="Comp" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Book_di" bpmnElement="Book"><dc:Bounds x="220" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompB_di" bpmnElement="CompB"><dc:Bounds x="252" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UndoBook_di" bpmnElement="UndoBook"><dc:Bounds x="220" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Comp_di" bpmnElement="Comp"><dc:Bounds x="400" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="520" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="160" /><di:waypoint x="220" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s2_di" bpmnElement="s2"><di:waypoint x="320" y="160" /><di:waypoint x="400" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="s3_di" bpmnElement="s3"><di:waypoint x="436" y="160" /><di:waypoint x="520" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="270" y="218" /><di:waypoint x="270" y="270" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
