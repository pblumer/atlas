<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_tasks" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Four pools that talk through the shapes the message picker writes on tasks, not on
       event definitions: a send task names its message by messageRef (ADR-0112) or through an
       operationRef whose inMessageRef is the message (ADR-0112), and a receive task waits on
       its own messageRef (ADR-0102). Pool C races a message against a timer behind an
       event-based gateway (ADR-0110), so the message decides which branch runs. -->
  <bpmn:message id="Msg_order" name="order" />
  <bpmn:message id="Msg_confirm" name="confirm" />
  <bpmn:interface id="If_1" name="Supplier">
    <bpmn:operation id="Op_confirm" name="confirm">
      <bpmn:inMessageRef>Msg_confirm</bpmn:inMessageRef>
    </bpmn:operation>
  </bpmn:interface>
  <bpmn:collaboration id="Collab_tasks">
    <bpmn:participant id="Part_A" name="Pool A" processRef="Process_A" />
    <bpmn:participant id="Part_B" name="Pool B" processRef="Process_B" />
    <bpmn:participant id="Part_C" name="Pool C" processRef="Process_C" />
    <bpmn:participant id="Part_D" name="Pool D" processRef="Process_D" />
    <bpmn:messageFlow id="MF_order" sourceRef="SendA" targetRef="RecvB" />
    <bpmn:messageFlow id="MF_confirm" sourceRef="SendD" targetRef="CatchCMsg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_A" isExecutable="true">
    <bpmn:startEvent id="StartA"><bpmn:outgoing>A1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sendTask id="SendA" name="send order" messageRef="Msg_order">
      <bpmn:incoming>A1</bpmn:incoming><bpmn:outgoing>A2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndA"><bpmn:incoming>A2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="A1" sourceRef="StartA" targetRef="SendA" />
    <bpmn:sequenceFlow id="A2" sourceRef="SendA" targetRef="EndA" />
  </bpmn:process>
  <bpmn:process id="Process_B" isExecutable="true">
    <bpmn:startEvent id="StartB"><bpmn:outgoing>B1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:receiveTask id="RecvB" name="receive order" messageRef="Msg_order">
      <bpmn:incoming>B1</bpmn:incoming><bpmn:outgoing>B2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndB"><bpmn:incoming>B2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="B1" sourceRef="StartB" targetRef="RecvB" />
    <bpmn:sequenceFlow id="B2" sourceRef="RecvB" targetRef="EndB" />
  </bpmn:process>
  <bpmn:process id="Process_C" isExecutable="true">
    <bpmn:startEvent id="StartC"><bpmn:outgoing>C1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:eventBasedGateway id="GwC">
      <bpmn:incoming>C1</bpmn:incoming><bpmn:outgoing>C2</bpmn:outgoing><bpmn:outgoing>C3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="CatchCMsg" name="confirmed">
      <bpmn:incoming>C2</bpmn:incoming><bpmn:outgoing>C4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_c" messageRef="Msg_confirm" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="CatchCTimer" name="timed out">
      <bpmn:incoming>C3</bpmn:incoming><bpmn:outgoing>C5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_c" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndC1"><bpmn:incoming>C4</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="EndC2"><bpmn:incoming>C5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="C1" sourceRef="StartC" targetRef="GwC" />
    <bpmn:sequenceFlow id="C2" sourceRef="GwC" targetRef="CatchCMsg" />
    <bpmn:sequenceFlow id="C3" sourceRef="GwC" targetRef="CatchCTimer" />
    <bpmn:sequenceFlow id="C4" sourceRef="CatchCMsg" targetRef="EndC1" />
    <bpmn:sequenceFlow id="C5" sourceRef="CatchCTimer" targetRef="EndC2" />
  </bpmn:process>
  <bpmn:process id="Process_D" isExecutable="true">
    <bpmn:startEvent id="StartD"><bpmn:outgoing>D1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sendTask id="SendD" name="send confirm" operationRef="Op_confirm">
      <bpmn:incoming>D1</bpmn:incoming><bpmn:outgoing>D2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndD"><bpmn:incoming>D2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="D1" sourceRef="StartD" targetRef="SendD" />
    <bpmn:sequenceFlow id="D2" sourceRef="SendD" targetRef="EndD" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_tasks">
    <bpmndi:BPMNPlane id="Plane_tasks" bpmnElement="Collab_tasks">
      <bpmndi:BPMNShape id="Part_A_di" bpmnElement="Part_A" isHorizontal="true">
        <dc:Bounds x="150" y="40" width="420" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartA_di" bpmnElement="StartA">
        <dc:Bounds x="200" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendA_di" bpmnElement="SendA">
        <dc:Bounds x="290" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndA_di" bpmnElement="EndA">
        <dc:Bounds x="472" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A1_di" bpmnElement="A1">
        <di:waypoint x="236" y="100" /><di:waypoint x="290" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A2_di" bpmnElement="A2">
        <di:waypoint x="390" y="100" /><di:waypoint x="472" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Part_B_di" bpmnElement="Part_B" isHorizontal="true">
        <dc:Bounds x="150" y="180" width="420" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartB_di" bpmnElement="StartB">
        <dc:Bounds x="200" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecvB_di" bpmnElement="RecvB">
        <dc:Bounds x="290" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB">
        <dc:Bounds x="472" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="B1_di" bpmnElement="B1">
        <di:waypoint x="236" y="240" /><di:waypoint x="290" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="B2_di" bpmnElement="B2">
        <di:waypoint x="390" y="240" /><di:waypoint x="472" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Part_C_di" bpmnElement="Part_C" isHorizontal="true">
        <dc:Bounds x="150" y="320" width="420" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartC_di" bpmnElement="StartC">
        <dc:Bounds x="200" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GwC_di" bpmnElement="GwC">
        <dc:Bounds x="285" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchCMsg_di" bpmnElement="CatchCMsg">
        <dc:Bounds x="382" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CatchCTimer_di" bpmnElement="CatchCTimer">
        <dc:Bounds x="382" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndC1_di" bpmnElement="EndC1">
        <dc:Bounds x="472" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndC2_di" bpmnElement="EndC2">
        <dc:Bounds x="472" y="442" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="C1_di" bpmnElement="C1">
        <di:waypoint x="236" y="410" /><di:waypoint x="285" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C2_di" bpmnElement="C2">
        <di:waypoint x="310" y="385" /><di:waypoint x="310" y="360" /><di:waypoint x="382" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C3_di" bpmnElement="C3">
        <di:waypoint x="310" y="435" /><di:waypoint x="310" y="460" /><di:waypoint x="382" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C4_di" bpmnElement="C4">
        <di:waypoint x="418" y="360" /><di:waypoint x="472" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C5_di" bpmnElement="C5">
        <di:waypoint x="418" y="460" /><di:waypoint x="472" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Part_D_di" bpmnElement="Part_D" isHorizontal="true">
        <dc:Bounds x="150" y="520" width="420" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartD_di" bpmnElement="StartD">
        <dc:Bounds x="200" y="562" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendD_di" bpmnElement="SendD">
        <dc:Bounds x="290" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndD_di" bpmnElement="EndD">
        <dc:Bounds x="472" y="562" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="D1_di" bpmnElement="D1">
        <di:waypoint x="236" y="580" /><di:waypoint x="290" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="D2_di" bpmnElement="D2">
        <di:waypoint x="390" y="580" /><di:waypoint x="472" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_order_di" bpmnElement="MF_order">
        <di:waypoint x="340" y="140" /><di:waypoint x="340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MF_confirm_di" bpmnElement="MF_confirm">
        <di:waypoint x="380" y="540" /><di:waypoint x="380" y="510" /><di:waypoint x="540" y="510" /><di:waypoint x="540" y="300" /><di:waypoint x="400" y="300" /><di:waypoint x="400" y="342" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
