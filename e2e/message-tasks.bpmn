<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Defs_msgtask" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- The task forms of a message throw and catch. A send task and a receive task reference
       their message with a messageRef of their own rather than through an event definition, so
       a simulation that only reads event definitions sees neither: the send throws nothing and
       no throw can ever reach the receive. -->
  <bpmn:message id="Msg" name="Order" />
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>s1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gw">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>sa</bpmn:outgoing>
      <bpmn:outgoing>sb</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="Receive" messageRef="Msg">
      <bpmn:incoming>sb</bpmn:incoming>
      <bpmn:outgoing>b1</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndB"><bpmn:incoming>b1</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Prepare"><bpmn:incoming>sa</bpmn:incoming><bpmn:outgoing>a1</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="Send" messageRef="Msg">
      <bpmn:incoming>a1</bpmn:incoming>
      <bpmn:outgoing>a2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndA"><bpmn:incoming>a2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Gw" />
    <bpmn:sequenceFlow id="sa" sourceRef="Gw" targetRef="Prepare" />
    <bpmn:sequenceFlow id="sb" sourceRef="Gw" targetRef="Receive" />
    <bpmn:sequenceFlow id="a1" sourceRef="Prepare" targetRef="Send" />
    <bpmn:sequenceFlow id="a2" sourceRef="Send" targetRef="EndA" />
    <bpmn:sequenceFlow id="b1" sourceRef="Receive" targetRef="EndB" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="P">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="120" y="202" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_di" bpmnElement="Gw"><dc:Bounds x="210" y="195" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Prepare_di" bpmnElement="Prepare"><dc:Bounds x="320" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_di" bpmnElement="Send"><dc:Bounds x="470" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndA_di" bpmnElement="EndA"><dc:Bounds x="630" y="102" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receive_di" bpmnElement="Receive"><dc:Bounds x="320" y="280" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB"><dc:Bounds x="630" y="302" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="s1_di" bpmnElement="s1"><di:waypoint x="156" y="220" /><di:waypoint x="210" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sa_di" bpmnElement="sa"><di:waypoint x="235" y="195" /><di:waypoint x="235" y="120" /><di:waypoint x="320" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sb_di" bpmnElement="sb"><di:waypoint x="235" y="245" /><di:waypoint x="235" y="320" /><di:waypoint x="320" y="320" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1"><di:waypoint x="420" y="120" /><di:waypoint x="470" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2"><di:waypoint x="570" y="120" /><di:waypoint x="630" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="b1_di" bpmnElement="b1"><di:waypoint x="420" y="320" /><di:waypoint x="630" y="320" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
