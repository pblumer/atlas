{
  "apiVersion": "atlas.io/technical-capability/v1alpha1",
  "kind": "TechnicalCapabilityContract",
  "metadata": {
    "id": "io.atlas.calendar.booking.confirm",
    "version": "1.0.0",
    "profile": "free-busy-calendar",
    "name": "Confirm a reserved booking with its subject, body and attendees"
  },
  "spec": {
    "resourceKind": "calendar-booking",
    "identityScope": "calendar",
    "verb": "confirm",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "calendar": { "type": "string", "minLength": 1 },
        "bookingId": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "maxLength": 255 },
        "body": { "type": "string", "maxLength": 8000 },
        "attendees": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "email": { "type": "string", "format": "email" },
              "name": { "type": "string" }
            },
            "required": ["email"],
            "additionalProperties": false
          }
        },
        "timeZone": { "type": "string", "minLength": 1 }
      },
      "required": ["calendar", "bookingId"],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 1 },
        "calendar": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "calendar", "start", "end"],
      "additionalProperties": false
    },
    "errors": [
      {"code": "BOOKING_NOT_FOUND", "description": "The booking no longer exists in the calendar; nothing is changed", "retryable": false},
      {"code": "ATTENDEES_NOT_ALLOWED", "description": "The provider refuses attendees from the caller's identity; nothing is changed", "retryable": false},
      {"code": "CALENDAR_NOT_WRITABLE", "description": "The caller may read the calendar but not write to it; nothing is changed", "retryable": false}
    ],
    "idempotency": "idempotent",
    "consistency": "provider-defined",
    "pagination": "none"
  }
}
