{
  "apiVersion": "atlas.io/technical-capability/v1alpha1",
  "kind": "TechnicalCapabilityContract",
  "metadata": {
    "id": "io.atlas.calendar.slot.find",
    "version": "1.0.0",
    "profile": "free-busy-calendar",
    "name": "Find the free slots of one or more calendars"
  },
  "spec": {
    "resourceKind": "calendar-slot",
    "identityScope": "calendar",
    "verb": "find",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "calendars": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "durationMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
        "gridMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 },
        "bufferMinutes": { "type": "integer", "minimum": 0, "maximum": 240 },
        "minLeadMinutes": { "type": "integer", "minimum": 0 },
        "timeZone": { "type": "string", "minLength": 1 },
        "openingHours": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
          "additionalProperties": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" },
                "to": { "type": "string", "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$" }
              },
              "required": ["from", "to"],
              "additionalProperties": false
            }
          }
        },
        "closedDates": { "type": "array", "maxItems": 400, "items": { "type": "string", "format": "date" } },
        "require": { "enum": ["any", "all"] },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "required": ["calendars", "from", "to", "durationMinutes", "timeZone", "openingHours"],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" },
              "date": { "type": "string", "format": "date" },
              "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "calendars": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "required": ["start", "end", "date", "time", "calendars"],
            "additionalProperties": false
          }
        },
        "truncated": { "type": "boolean" }
      },
      "required": ["slots", "truncated"],
      "additionalProperties": false
    },
    "errors": [
      {"code": "CALENDAR_NOT_FOUND", "description": "A named calendar does not exist or the caller cannot see it; no slot is answered", "retryable": false}
    ],
    "idempotency": "read-only",
    "consistency": "provider-defined",
    "pagination": "none"
  }
}
