{
  "apiVersion": "atlas.io/technical-capability/v1alpha1",
  "kind": "TechnicalCapabilityContract",
  "metadata": {
    "id": "io.atlas.payment.refund.create",
    "version": "1.0.0",
    "profile": "datatrans",
    "name": "Refund a captured payment"
  },
  "spec": {
    "resourceKind": "payment-refund",
    "identityScope": "merchant-account",
    "verb": "create",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "idempotencyKey": {
          "$ref": "#/$defs/idempotencyKey"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "merchantReference": {
          "$ref": "#/$defs/merchantReference"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      },
      "required": [
        "idempotencyKey",
        "transactionId",
        "merchantReference",
        "amount",
        "currency"
      ],
      "additionalProperties": false,
      "$defs": {
        "idempotencyKey": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "description": "Derived from the process instance and element, identical on every retry of the same job"
        },
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "merchantReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Whole minor units of the currency, e.g. 1050 for CHF 10.50"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 alphabetic code"
        }
      }
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refundTransactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "refundedAmount": {
          "$ref": "#/$defs/amount"
        }
      },
      "required": [
        "refundTransactionId",
        "transactionId",
        "refundedAmount"
      ],
      "additionalProperties": false,
      "$defs": {
        "transactionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Whole minor units of the currency, e.g. 1050 for CHF 10.50"
        }
      }
    },
    "errors": [
      {
        "code": "TRANSACTION_NOT_CAPTURED",
        "description": "Only a captured transaction can be refunded; an authorization is canceled instead",
        "retryable": false
      },
      {
        "code": "REFUND_EXCEEDS_CAPTURED",
        "description": "The amount is higher than what remains refundable",
        "retryable": false
      },
      {
        "code": "PROVIDER_UNAVAILABLE",
        "description": "The provider did not answer or answered with a server error; the same key may be retried",
        "retryable": true
      }
    ],
    "idempotency": "conditional",
    "consistency": "provider-defined",
    "pagination": "none"
  }
}
