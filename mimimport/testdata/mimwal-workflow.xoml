  <ns1:UpdateResources x:Name="actionActivity3" ActivityDisplayName="Je Namensmuster ausführen" ActivityExecutionCondition="" Iteration="SplitString([//Target/AssetType/PatternAccountName],&quot;;&quot;)" ActorType="Service" />
  <ns1:GenerateUniqueValue x:Name="actionActivity2" ActivityDisplayName="Eindeutigen Kontonamen erzeugen" PublicationTarget="[//WorkflowData/AccountName]" ConflictFilter="/*[(AccountName = &apos;[//Value]&apos;)]" UniquenessSeed="1" QueryLdap="True">
    <ns1:GenerateUniqueValue.ValueExpressions>
      <ns3:ArrayList xmlns:ns3="clr-namespace:System.Collections;Assembly=mscorlib">
