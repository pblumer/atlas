<ns0:SequentialWorkflow ActorId="00000000-0000-0000-0000-000000000000" x:Name="SequentialWorkflow" WorkflowDefinitionId="00000000-0000-0000-0000-000000000000" xmlns=http://schemas.microsoft.com/winfx/2006/xaml/workflow xmlns:x=http://schemas.microsoft.com/winfx/2006/xaml xmlns:ns0="clr-namespace:Microsoft.ResourceManagement.Workflow.Activities;Assembly=Microsoft.ResourceManagement, Version=4.6.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" xmlns:ns1="clr-namespace:MicrosoftServices.IdentityManagement.WorkflowActivityLibrary.Activities;Assembly=MicrosoftServices.IdentityManagement.WorkflowActivityLibrary, Version=2.20.723.0, Culture=neutral, PublicKeyToken=6da6d3322deda33f">
  <ns1:UpdateResources x:Name="actionActivity1" ActivityDisplayName="Abhängige Objekte abfragen" ActivityExecutionCondition="Not(ParametersContain([//Request/RequestParameter], &quot;ReApplyBusinessObject&quot;))" Iteration="" ActorType="Service" ApplyAuthorizationPolicy="False" QueryResources="True" Advanced="True" ActorString="">
    <ns1:UpdateResources.QueriesTable>
      <ns3:Hashtable xmlns:ns3="clr-namespace:System.Collections;Assembly=mscorlib">
        <ns4:String xmlns:ns4="clr-namespace:System;Assembly=mscorlib">AllGroups<x:Key><ns4:String>0:0</ns4:String></x:Key></ns4:String>
        <ns4:String xmlns:ns4="clr-namespace:System;Assembly=mscorlib">/Group[DependsOn='[//Target/ObjectID]']<x:Key><ns4:String>0:1</ns4:String></x:Key></ns4:String>
        <ns4:Int32 xmlns:ns4="clr-namespace:System;Assembly=mscorlib">1<x:Key><ns4:String>Count</ns4:String></x:Key></ns4:Int32>
      </ns3:Hashtable>
    </ns1:UpdateResources.QueriesTable>
    <ns1:UpdateResources.UpdatesTable>
