        <ns4:String xmlns:ns4="clr-namespace:System;Assembly=mscorlib">[//WorkflowData/AllGroups]<x:Key><ns4:String>0:1</ns4:String></x:Key></ns4:String>
        <ns4:String xmlns:ns4="clr-namespace:System;Assembly=mscorlib">[//Queries/AllGroups]<x:Key><ns4:String>0:0</ns4:String></x:Key></ns4:String>
        <ns4:Boolean xmlns:ns4="clr-namespace:System;Assembly=mscorlib">false<x:Key><ns4:String>0:2</ns4:String></x:Key></ns4:Boolean>
